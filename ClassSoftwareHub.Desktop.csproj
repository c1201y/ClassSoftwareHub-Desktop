<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ClassSoftwareHub.Desktop</RootNamespace>
    <AssemblyName>ClassSoftwareHub</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    

    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    





    <Version>1.2.3-Insider1.0</Version>
    <AssemblyVersion>1.2.3.0</AssemblyVersion>
    <FileVersion>1.2.3.0</FileVersion>
    <InformationalVersion>1.2.3-Insider1.0</InformationalVersion>
    

    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>ClassSoftwareHub</Product>
    <AssemblyTitle>ClassSoftwareHub</AssemblyTitle>
    <Company>ClassSoftwareHub</Company>
  </PropertyGroup>

  









  <ItemGroup Condition="'$(CshBuildStampB64)' != ''">
    <AssemblyMetadata Include="CshBuildStamp" Value="$(CshBuildStampB64)" />
  </ItemGroup>

  


  <ItemGroup>
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
    <Content Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="QRCoder" Version="1.4.3" />
    
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  
  <ItemGroup>
    <EmbeddedResource Include="Web\shell-shim.js" />
    <EmbeddedResource Include="Assets\AppIcon-512.png" />
    <EmbeddedResource Include="Assets\StoreLogo.png" />
    <EmbeddedResource Include="Assets\AppIcon.ico" />
    <EmbeddedResource Include="Assets\ToolIcon.ico" />
    



    <EmbeddedResource Include="Assets\Dict\dict-core.tsv" />
    


    <EmbeddedResource Include="Assets\Pinyin\pinyin.tsv" />
    

    <EmbeddedResource Include="Assets\dv1.2.png" />
    

    <EmbeddedResource Include="Assets\About\about-banner.jpg" />
    

    <EmbeddedResource Include="Assets\Oobe\appearance-system.png" />
    <EmbeddedResource Include="Assets\Oobe\appearance-light.png" />
    <EmbeddedResource Include="Assets\Oobe\appearance-dark.png" />
    


    <EmbeddedResource Include="Assets\Oobe\oobe-slide-downloads-back-light.png" />
    <EmbeddedResource Include="Assets\Oobe\oobe-slide-downloads-back-dark.png" />
    <EmbeddedResource Include="Assets\Oobe\oobe-slide-downloads-front-light.png" />
    <EmbeddedResource Include="Assets\Oobe\oobe-slide-downloads-front-dark.png" />
    <EmbeddedResource Include="Assets\Oobe\oobe-slide-tools-back-light.png" />
    <EmbeddedResource Include="Assets\Oobe\oobe-slide-tools-back-dark.png" />
    <EmbeddedResource Include="Assets\Oobe\oobe-slide-tools-front-light.png" />
    <EmbeddedResource Include="Assets\Oobe\oobe-slide-tools-front-dark.png" />
    <EmbeddedResource Include="Assets\Oobe\oobe-finish-banner.jpg" />
    
    <EmbeddedResource Include="Assets\feedback\report.png" />
    <EmbeddedResource Include="Assets\feedback\suggest.png" />
    


    <EmbeddedResource Include="Assets\feedback\qq-step-album-panel.png" />
    <EmbeddedResource Include="Assets\feedback\qq-step-create-album.png" />
    <EmbeddedResource Include="Assets\feedback\qq-step-upload-button.png" />
    <EmbeddedResource Include="Assets\feedback\qq-step-upload-pick.png" />
    


    <EmbeddedResource Include="Assets\roster\sample-excel.png" />
    <EmbeddedResource Include="Assets\roster\sample-txt.png" />
    <EmbeddedResource Include="Assets\roster\roster-sample.txt" />
    <EmbeddedResource Include="Assets\roster\roster-sample.xlsx" />
    


    <EmbeddedResource Include="Assets\Audio\timer-alarm.wav" />
    

    <EmbeddedResource Include="Assets\Audio\announce-alert.wav" />

    


    <Content Include="Assets\Fonts\HarmonyOS_Sans_SC_Medium.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\HarmonyOS_Sans_SC_Bold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\HarmonyOS_Sans_SC_Light.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Assets\Fonts\HarmonyOS_LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    

    <EmbeddedResource Include="Assets\QuickLinks\GITHUB.svg" />
    <EmbeddedResource Include="Assets\QuickLinks\主页.svg" />
    <EmbeddedResource Include="Assets\QuickLinks\QQ.svg" />
  </ItemGroup>

  





  <ItemGroup>
    <Content Include="WebTools\**" Exclude="WebTools\_superseded-handmade\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  















  <Target Name="VerifyNoBundledContent" AfterTargets="Publish"
          Condition="Exists('$(PublishDir)content')">
    <Error Text="发布产物里还有 content 目录（安装包不该带内容包）：$(PublishDir)content。请先删除它再重新 publish —— 例如 rm -rf dist/app/content。" />
  </Target>

</Project>
