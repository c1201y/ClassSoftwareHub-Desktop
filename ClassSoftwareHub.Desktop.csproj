<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>ClassSoftwareHub.Desktop</RootNamespace>
    <AssemblyName>ClassSoftwareHub</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <!-- ⚠️ 必须开：不开的话 $(AssemblyName).pri（XAML 资源清单）不会进 publish 输出，
         装完启动会 "Cannot locate resource from 'ms-appx:///MainWindow.xaml'" 直接闪退（无窗口） -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- 版本号规则见 Core/ShellConfig.cs 里 ShellVersion 的注释
         （dv + 主.功能.补丁 + -insider架构.迭代），改版本时这里和 ShellConfig 一起改。
         ⚠️ AssemblyVersion / FileVersion 只接受「四段纯数字」，塞不进 -insider 后缀，故固定 1.1.3.0；
         界面上显示的完整版本号以 ShellConfig.ShellVersion 为准，这里只是给文件属性和 NuGet 元数据看。 -->
    <Version>1.1.3-insider1.0</Version>
    <AssemblyVersion>1.1.3.0</AssemblyVersion>
    <FileVersion>1.1.3.0</FileVersion>
    <InformationalVersion>1.1.3-insider1.0</InformationalVersion>
    <!-- 关掉「自动往 InformationalVersion 后面追加 +git提交哈希」——
         否则 exe 属性里会显示成 1.1.0-insider1.0+ed05db5…，版本号就不干净了（没有任何代码读它，纯显示问题） -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>ClassSoftwareHub</Product>
    <AssemblyTitle>ClassSoftwareHub</AssemblyTitle>
    <Company>ClassSoftwareHub</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <!-- 屏幕亮度：笔记本内屏的亮度只能走 WMI（WmiMonitorBrightnessMethods），Windows 自己的亮度滑块也是。dxva2 那套只对外接显示器（DDC/CI）有效。（2026-09-26） -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <!-- 内嵌资源：单文件发布时不需要额外散落文件 -->
  <ItemGroup>
    <EmbeddedResource Include="Web\shell-shim.js" />
    <EmbeddedResource Include="Assets\AppIcon-512.png" />
    <EmbeddedResource Include="Assets\AppIcon.ico" />
    <EmbeddedResource Include="Assets\ToolIcon.ico" />
    <!-- 首页横幅：每个功能版本换一张（文件名跟着版本走，换图时这里和 Pages/WelcomePage.xaml.cs
         的 LoadBanner() 一起改）。⚠️ 文件名一律 ASCII。 -->
    <EmbeddedResource Include="Assets\dv1.1.png" />
    <!-- 反馈中心两张卡片的图：跟网页版 src/assets/feedback 是同一套文件（2026-09-26） -->
    <EmbeddedResource Include="Assets\feedback\report.png" />
    <EmbeddedResource Include="Assets\feedback\suggest.png" />
    <!-- 「在 Q 群中反馈」图文流程的四张操作截图（2026-09-30）：Nick 在 QQ 群里实拍的四步，
         依次对应 打开群相册面板 → 新建相册并填入信息 → 进入相册点上传 → 选照片/视频并上传。
         文件名沿用上面的 ASCII 规矩。 -->
    <EmbeddedResource Include="Assets\feedback\qq-step-album-panel.png" />
    <EmbeddedResource Include="Assets\feedback\qq-step-create-album.png" />
    <EmbeddedResource Include="Assets\feedback\qq-step-upload-button.png" />
    <EmbeddedResource Include="Assets\feedback\qq-step-upload-pick.png" />
    <!-- 随机抽号的「示例名单」（2026-09-29）：两张示意截图 + 两份可直接下载的示例文件。
         ⚠️ 文件名一律用 ASCII —— 中文文件名会被编进 manifest 资源名，匹配时容易出岔子。
         下载时显示的中文名在代码里指定（FileSavePicker.SuggestedFileName）。 -->
    <EmbeddedResource Include="Assets\roster\sample-excel.png" />
    <EmbeddedResource Include="Assets\roster\sample-txt.png" />
    <EmbeddedResource Include="Assets\roster\roster-sample.txt" />
    <EmbeddedResource Include="Assets\roster\roster-sample.xlsx" />
    <!-- 倒计时到点的默认铃声（2026-10-04 Nick）：从他给的屏幕录制里剪出来的音频。
         ⚠️ 运行时由 Services/TimerAlarm.cs 释放到 cache\ 再交给 MediaPlayer ——
            单文件发布下旁边没有散落文件可读，只能走内嵌这条路。 -->
    <EmbeddedResource Include="Assets\Audio\timer-alarm.wav" />
  </ItemGroup>

  <!-- ⛔⛔ 安装包**不带**内容包（2026-10-05 Nick 定案"以后统统只有通过网络获取更新的途径"）。
       桌面版以前会把站点内容包拷进 dist\app\content 随安装包一起发，装机就有清单；
       现在取消 —— 客户端只从网络取，所以发布产物里不该再有 content。

       为什么写成构建步骤而不是人工检查：`dotnet publish -o dist\app` 是**覆盖式写入、不清目录**，
       旧产物里的 content 会一直趟在那儿，没人会注意到（还会让装机首启看起来"有清单"，
       掩盖真正的联网路径到底通不通）。所以这里放一道**硬闸**：发布产物里只要还有 content 就让 publish 失败。

       ⚠️ 为什么是"报错"而不是"顺手删掉"（2026-10-05 实测两轮，别再走回头路）：
          MSBuild 的 RemoveDir/Delete 会走 `\\?\C:\…` 长路径形式、Exec 则是拉起 cmd.exe，
          而本机运行环境对这两者的目录删除一律 `Access denied`（同一目录用普通路径删却正常）。
          结果是：单个 RemoveDir 会把整个 publish **硬失败**在清理这一步上，加 ContinueOnError 又变成
          "只警告、根本没删掉"＝等于没做（cmd 的 rmdir 甚至返回退出码 0 却什么都没删，更具欺骗性）。
          所以放弃"自动清"，改成**宁可挡住发布也不让内容包发出去** —— 清理动作交给发版流程
          （技能 csh-release 的 publish 之前有一步 rm -rf dist/app/content）。
       ⚠️ 别把这条当成可以讨论的"优化项"删掉：删了就等于又把内容包发回给用户。 -->
  <Target Name="VerifyNoBundledContent" AfterTargets="Publish"
          Condition="Exists('$(PublishDir)content')">
    <Error Text="发布产物里还有 content 目录（安装包不该带内容包）：$(PublishDir)content。请先删除它再重新 publish —— 例如 rm -rf dist/app/content。" />
  </Target>

</Project>
