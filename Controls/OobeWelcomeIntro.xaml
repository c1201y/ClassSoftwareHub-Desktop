<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClassSoftwareHub.Desktop.Controls.OobeWelcomeIntro"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">

    











    <Grid x:Name="Stage" Background="Transparent">
        
        <Canvas x:Name="MarqueeCanvas" Opacity="0">
            <Grid x:Name="MarqueeLayer" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <CompositeTransform x:Name="MarqueeShift" Rotation="-20" />
                </Grid.RenderTransform>
                <StackPanel x:Name="MarqueeRows" VerticalAlignment="Center" Spacing="10" />
            </Grid>
        </Canvas>

        

        <Canvas x:Name="LineCanvas" Opacity="0">
            <Canvas x:Name="SloganLine" />
        </Canvas>

        
        

        <StackPanel x:Name="FinalStack" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="Logo" Width="84" Height="84" Stretch="Uniform"
                   HorizontalAlignment="Center" Opacity="0"
                   RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <CompositeTransform x:Name="LogoShift" />
                </Image.RenderTransform>
            </Image>

            <TextBlock x:Name="WelcomeLine" Text="欢迎使用(。・∀・)/～"
                       FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"
                       Margin="0,14,0,0" Opacity="0">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="WelcomeShift" />
                </TextBlock.RenderTransform>
            </TextBlock>

            <StackPanel x:Name="Wordmark" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,16,0,0" Opacity="0"
                        RenderTransformOrigin="0.5,0.5">
                <StackPanel.RenderTransform>
                    <CompositeTransform x:Name="WordmarkShift" />
                </StackPanel.RenderTransform>
            </StackPanel>

            <TextBlock x:Name="VersionLine" FontSize="11.5" HorizontalAlignment="Center"
                       Margin="0,8,0,0" Opacity="0"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                <TextBlock.RenderTransform>
                    <TranslateTransform x:Name="VersionShift" />
                </TextBlock.RenderTransform>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
