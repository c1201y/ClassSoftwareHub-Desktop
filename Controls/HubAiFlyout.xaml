<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClassSoftwareHub.Desktop.Controls.HubAiFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20">

    <!--
      Hub AI 提问浮层（2026-10-30 从 Pages/SoftwarePage 抽出来变成公共控件）。

      来由：需求 1:23「在其他页面增加 AI 入口」。软件下载页那套浮层做得对 ——
      它**不做对话**，只是"把问题带去完整页"的入口；再复制三份到别的页面，
      就会出现四份各自维护的动画与发送逻辑（这正是代码审计里点过的毛病）。
      抽成一个控件，各页只放一行 + 一个按钮。

      ⚠️ 浮层与完整页的分工没变：浮层收集问题 → 交给 HubAiPage → 收起。
         不要在浮层里做对话（2026-10-18 定，理由见 HubAiPage 的 PendingQuestion）。
      ⚠️ 尺寸固定 380×420（2026-10-18 Nick：矮了「不那么让人注意到」）。
    -->

    <Border x:Name="Card" Width="380" Height="420" Visibility="Collapsed"
            CornerRadius="14" BorderThickness="1"
            RenderTransformOrigin="0.5,1"
            Background="{ThemeResource HubAiPanelBackground}"
            BorderBrush="{ThemeResource HubAiPanelBorder}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="CardTransform" />
        </Border.RenderTransform>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Padding="16,12,8,10" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="28" Height="28" CornerRadius="7"
                        Background="{ThemeResource HubAiIconBackground}">
                    <FontIcon Glyph="&#xE8F2;" FontSize="13"
                              Foreground="{ThemeResource HubAiIconForeground}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="Hub AI" FontSize="13" FontWeight="SemiBold"
                               Foreground="{ThemeResource HubAiTitleForeground}" />
                    <TextBlock Text="电脑顾问" FontSize="11"
                               Foreground="{ThemeResource HubAiSubForeground}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <Button Padding="7" Background="Transparent" BorderThickness="0"
                            Click="Expand_Click" ToolTipService.ToolTip="在页面中打开">
                        <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                    </Button>
                    <Button Padding="7" Background="Transparent" BorderThickness="0"
                            Click="Close_Click" ToolTipService.ToolTip="收起">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" Padding="16,0,16,6" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Messages" Spacing="10">
                    <Border Background="{ThemeResource HubAiBubbleBackground}" CornerRadius="10"
                            Padding="14,11">
                        <StackPanel Spacing="6">
                            <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="20"
                                       Text="描述你的需求，按回车后会在 Hub AI 页面继续。" />
                            <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                       Text="那里会读取本机硬件与存储概况，再给出建议。全程只读。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="2" Padding="12,6,12,12" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="Input" PlaceholderText="描述你的需求" KeyDown="Input_KeyDown" />

                <Button Grid.Column="1" Padding="11,6"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="Send_Click" ToolTipService.ToolTip="发送">
                    <FontIcon Glyph="&#xE724;" FontSize="13" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</UserControl>
