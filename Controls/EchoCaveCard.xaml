<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClassSoftwareHub.Desktop.Controls.EchoCaveCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    





















    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        
        <ProgressRing x:Name="LoadingRing" Grid.Column="0"
                      Width="20" Height="20" Margin="0,1,8,0"
                      VerticalAlignment="Top" IsActive="True" />

        
        <TextBlock x:Name="MessageText" Grid.Column="1" TextWrapping="Wrap" />
    </Grid>
</UserControl>
