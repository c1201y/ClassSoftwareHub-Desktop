<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClassSoftwareHub.Desktop.Controls.EchoCaveCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      回声洞卡片 —— 对应网页版的 src/gallery/EchoCaveCard.vue，
      嵌在设置页「软件内容」与「更新」之间，不另开页面。

      交互照 ClassIsland 的回声洞（2026-10-03 按 Nick 要求改，见 _refs/ClassIsland）：
        · **点击换一条 + 打字机逐字**，不再 5 秒自动轮播（原来的走动条一并去掉）；
        · 进页面先静静显示一条，不打扰；点一下才动；
        · 打字期间再点无效（不打断正在打的这一遍）；
        · 一轮之内不重复：整份数据洗成队列逐条出队，抽完才重洗。

      数据源：站点仓库根目录「回声洞/messages/」——**一条一个文件**
      （message1.json、message2.json……，文件里只有 text 一个字段），
      与网页版、CSHcontroller 控制台读的是同一套文件（见 Services/EchoCaveService.cs）。

      卡面只有正文 + 页脚两个链接：不放"点击换一条"之类的提示文字，
      能点这件事靠悬停底色 + 鼠标手型 + ToolTip 表达（ClassIsland 原版也没有提示行）。
    -->

    <UserControl.Resources>
        <!--
          可点击舞台：把内容区整块做成 Button。
          用系统按钮而不是自己叠 Tapped —— 悬停 / 按下 / 键盘可达性都由系统给，
          外观压平（透明底、无描边）只借它的交互态。
          ⚠️ Background 设 Transparent 不会吃掉悬停反馈：WinUI 的 Button 模板在
             PointerOver 状态下由 VisualState 直接改 ContentPresenter.Background。
        -->
        <Style x:Key="EchoStageButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Border x:Name="CardHost" Style="{StaticResource CshCardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- 0 舞台：点一下换一条 -->
                <RowDefinition Height="Auto" />  <!-- 1 页脚链接 -->
            </Grid.RowDefinitions>

            <!-- ===== 0 舞台（整块可点） ===== -->
            <Button x:Name="StageButton" Grid.Row="0"
                    Style="{StaticResource EchoStageButtonStyle}"
                    Click="Stage_Click"
                    ToolTipService.ToolTip="点击换一条">
                <Grid MinHeight="52">
                    <StackPanel x:Name="MessagePanel" VerticalAlignment="Center">
                        <TextBlock x:Name="MessageText" FontSize="17" LineHeight="26"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock x:Name="EmptyText" VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>
            </Button>

            <!-- ===== 1 页脚 ===== -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
                <HyperlinkButton x:Name="SubmitLink" Content="投稿一条" Padding="0" MinWidth="0"
                                 Click="Submit_Click" />
                <HyperlinkButton x:Name="RefreshLink" Content="刷新" Padding="0" MinWidth="0"
                                 Click="Refresh_Click" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
