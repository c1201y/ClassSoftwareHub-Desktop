<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.HubAiSettingsPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    Background="{x:Null}">

    <!--
      Hub AI 二级设置页（2026-10-18）。
      ⚠️ 不在导航栏里 —— 入口是「设置 → Hub AI」那张卡，返回靠导航栏（项目统一规矩）。
      版式照 SettingsPage：整页透明（让 Mica 透上来）+ 三列把内容钉在 960 + 间距写在内部 Grid 的
      Margin 上（ScrollViewer.Padding 的底部不参与滚动范围计算，是 WinUI 3 已知坑）。

      ⚠️ 本轮只做**总闸 + 定位说明**。服务商、模型、思考强度、上下文档位、发送范围这些
         要等 AiClient 定型后再填 —— 先把空壳铺满会让用户以为能配，配了又不生效更糟。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" MaxWidth="960" Margin="0,36,0,44" Spacing="0">

                <TextBlock Text="Hub AI" FontSize="28" FontWeight="Bold" />
                <TextBlock Margin="0,6,0,0" FontSize="13" Opacity="0.65" TextWrapping="Wrap"
                           Text="电脑顾问：读取硬件与存储概况，判断瓶颈，再从软件库里给出建议。全程只读。" />

                <!-- 「会动系统」的功能一律常驻红条 —— 这一页反过来：它是唯一**不会**动系统的东西，
                     所以用 Informational 把边界写清楚，省得用户自己猜。
                     要动文件/设置时，一律跳到既有页面去执行。 -->
                <InfoBar Margin="0,16,0,0" Severity="Informational" IsOpen="True" IsClosable="False"
                         Title="只读取，不修改"
                         Message="Hub AI 不会删除文件、不会修改设置，也不会代替你执行任何操作。给出的建议需要你点进对应页面自行确认。" />

                <!-- ================= 总开关 ================= -->
                <TextBlock Text="总开关" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                <StackPanel Spacing="4">
                    <controls:SettingsCard Header="启用 Hub AI"
                                           Description="关闭后，软件下载页的入口与导航中的 Hub AI 一并隐藏。已经填过的配置会保留。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8F2;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="EnableToggle" Toggled="EnableToggle_Toggled" />
                    </controls:SettingsCard>
                </StackPanel>

                <!-- ================= 模型服务（2026-10-18 重做） ================= -->
                <!--
                  旧版把「服务商 / 地址 / 模型名 / 密钥 / 思考 / 上下文」全部平铺在页面上，
                  用户根本分不清哪块属于哪个模型，配一个已知厂商的模型要填五项（Nick：「恶心」）。
                  现在：**上面是模型列表，下面是"添加模型"按钮**，所有字段都收进对话框里。
                -->
                <TextBlock Text="模型服务" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                <StackPanel Spacing="8">
                    <StackPanel x:Name="ModelListPanel" Spacing="4" />
                    <Button Content="添加模型" Click="AddModel_Click" HorizontalAlignment="Left" />
                </StackPanel>

                <InfoBar x:Name="TestBar" Margin="0,8,0,0" IsOpen="False" IsClosable="True" />

                <!-- ================= 个人资料 ================= -->
                <TextBlock Text="个人资料" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                <StackPanel Spacing="4">
                    <controls:SettingsCard Header="称呼"
                                           Description="AI 在对话中如何称呼你。留空则直接使用「你」。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE77B;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBox x:Name="UserNameBox" MinWidth="220" PlaceholderText="例如：尼克"
                                 LostFocus="UserNameBox_LostFocus" />
                    </controls:SettingsCard>
                </StackPanel>

                <!-- ================= 工具 ================= -->
                <!--
                  工具包 = 可选安装（2026-10-18 Nick 要）：不装就一个字节都没有。
                  ⚠️ 包里只有**声明式 JSON**（工具名 / 说明 / 参数 schema），没有可执行代码，
                     所以体积几 KB，杀软也不会拦。执行永远在主程序里，见 ToolPack 的注释。
                -->
                <TextBlock Text="工具" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                <StackPanel Spacing="4">

                    <controls:SettingsCard Header="启用工具"
                                           Description="允许 Hub AI 调用只读工具（查看磁盘明细、检索软件库等）。首次启用会从仓库下载工具包。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE71D;" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ProgressRing x:Name="ToolPackRing" IsActive="False" Width="18" Height="18" />
                            <ToggleSwitch x:Name="ToolsToggle" Toggled="ToolsToggle_Toggled" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="工具包"
                                           Description="只包含能力声明，不包含程序代码。下载走「软件下载」里选定的线路。">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="ToolPackState" VerticalAlignment="Center" FontSize="12" Opacity="0.6" />
                            <Button x:Name="ToolPackUpdateBtn" Content="重新下载" Click="UpdateToolPack_Click" />
                            <Button x:Name="ToolPackRemoveBtn" Content="移除" Click="RemoveToolPack_Click" />
                        </StackPanel>
                    </controls:SettingsCard>

                </StackPanel>

                <InfoBar x:Name="ToolBar" Margin="0,8,0,0" IsOpen="False" IsClosable="True" />

                <!-- ================= 数据与隐私 ================= -->
                <TextBlock Text="数据" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                <StackPanel Spacing="4">
                    <controls:SettingsCard Header="发送范围"
                                           Description="硬件概况、磁盘占用、已装软件清单。发送前可以逐项关闭，路径中的用户名会被抹掉。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE72E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock Text="下一版" FontSize="12.5" Opacity="0.6" VerticalAlignment="Center" />
                    </controls:SettingsCard>
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
