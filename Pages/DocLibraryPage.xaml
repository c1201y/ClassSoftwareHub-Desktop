<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.DocLibraryPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:docs="using:ClassSoftwareHub.Desktop.Services.Docs">

    <!--
      文档库（需求 15）：文章存放在桌面端仓库的「文档库/」目录，桌面端只拉清单；
      点开某篇时才下载正文，正文落地为无扩展名随机文件（见 Services/Docs/DocLibrary.cs）。
      版式照更新日志页：标题 → 工具条 → 列表，内容列 960 上限。
    -->
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" MaxWidth="960" Margin="0,36,0,44" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="5">
                <TextBlock Text="文档库" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="电脑优化与使用技巧的图文教程" FontSize="13" Opacity="0.65"
                           TextWrapping="Wrap" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox" PlaceholderText="搜索标题、简介或标签"
                         TextChanged="SearchBox_TextChanged"
                         VerticalAlignment="Center" />

                <Button x:Name="RefreshButton" Grid.Column="1" Click="Refresh_Click" Padding="8,6"
                        ToolTipService.ToolTip="重新检查文档库">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                </Button>

                <Button Grid.Column="2" Click="Submit_Click">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE898;" FontSize="13" />
                        <TextBlock Text="投稿文章" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="11.5" Opacity="0.55"
                       TextWrapping="Wrap" />

            <Grid Grid.Row="3">
                <ListView x:Name="ArticleList" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="ArticleList_ItemClick" Margin="0,0,0,0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="docs:DocArticle">
                            <Border Style="{StaticResource CshCardStyle}" Padding="18,14,18,14">
                                <StackPanel Spacing="5">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{x:Bind Title}" FontSize="15.5"
                                                   FontWeight="SemiBold" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" MaxLines="2" />

                                        <Border Grid.Column="1" CornerRadius="9" Padding="7,1"
                                                VerticalAlignment="Top" BorderThickness="1"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                            <TextBlock Text="{x:Bind TypeLabel}" FontSize="11"
                                                       Opacity="0.75" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{x:Bind Summary}" FontSize="13" Opacity="0.72"
                                               TextWrapping="Wrap" MaxLines="2"
                                               TextTrimming="CharacterEllipsis"
                                               Visibility="{x:Bind SummaryVisibility}" />

                                    <TextBlock Text="{x:Bind ByLine}" FontSize="11.5" Opacity="0.5"
                                               TextWrapping="Wrap"
                                               Visibility="{x:Bind ByLineVisibility}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel x:Name="EmptyPanel" Spacing="10" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8A5;" FontSize="30" Opacity="0.4"
                              HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText" MaxWidth="420" TextAlignment="Center"
                               TextWrapping="Wrap" FontSize="13" Opacity="0.7" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
