<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.EasiNoteGuardPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <!--
      版式跟「本机核实」同源：三列 Grid 把内容钉在中间 960 宽。
      ⚠️ 别用 Stretch + MaxWidth：一旦触发上限 WinUI 会把整列右甩。

      卡片语言（2026-10-02 二改，向设置页看齐）：圆角 4、间距 4、内边距 16,12，
      手写 Border 一律走 CshCardStyle；标题块自带 20 的底部呼吸。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,36,24,44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" MaxWidth="960" Spacing="4">

                <!-- 标题 + 实验性标记 -->
                <StackPanel Spacing="6" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="白板专杀" FontSize="28" FontWeight="Bold" />
                        <Border CornerRadius="4" Padding="8,3" Margin="0,0,0,6" VerticalAlignment="Bottom"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SystemFillColorCautionBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xEA80;" FontSize="11"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock Text="实验性功能" FontSize="12"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="希沃白板5 在退出后，进程可能仍驻留于任务管理器的后台进程中，导致应用无法再次启动。到达设定时间点后自动结束此类后台滞留进程；存在可见窗口（即正在使用）的进程不处理。" />
                </StackPanel>

                <!-- 开关：SettingsCard 原生控件（与设置页同一套），不再手叠 Border -->
                <controls:SettingsCard Header="自动执行">
                    <controls:SettingsCard.Description>
                        <TextBlock x:Name="SwitchHint" FontSize="12" Opacity="0.6" TextWrapping="Wrap" Text="" />
                    </controls:SettingsCard.Description>
                    <ToggleSwitch x:Name="EnableSwitch" OnContent="开" OffContent="关"
                                  MinWidth="0" Toggled="EnableSwitch_Toggled" />
                </controls:SettingsCard>

                <!-- 时间点 -->
                <Border Style="{StaticResource CshCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="结束时间点" FontSize="14" />
                        <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                   Text="每天到达设定时间点检查一次。检查时进程若正在使用（存在可见窗口）则跳过，等待下一个时间点，不会持续重试。" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TimePicker x:Name="TimePick" ClockIdentifier="24HourClock" MinuteIncrement="5" />
                            <Button x:Name="AddTimeButton" Content="添加" Click="AddTime_Click"
                                    VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="TimeHost" Spacing="6" />
                    </StackPanel>
                </Border>

                <!-- 手动执行 -->
                <Border Style="{StaticResource CshCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="立即执行一次" FontSize="14" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="CheckButton" Content="仅检测" Click="Check_Click" />
                            <Button x:Name="CleanButton" Content="立即结束" Click="Clean_Click" />
                        </StackPanel>
                        <TextBlock x:Name="ResultText" FontSize="12" TextWrapping="Wrap" Opacity="0.75" Text="" />
                    </StackPanel>
                </Border>

                <!-- 当前进程 -->
                <Border Style="{StaticResource CshCardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="本机白板5 进程" FontSize="14" VerticalAlignment="Center" />
                            <Button x:Name="RefreshButton" Content="刷新" Click="Refresh_Click"
                                    FontSize="12" Padding="10,4,10,4" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="ProcHost" Spacing="4" />
                    </StackPanel>
                </Border>

                <!-- 页脚：讲清楚依据和局限，不含糊 -->
                <Border Style="{StaticResource CshCardStyle}">
                    <StackPanel Spacing="7">
                        <TextBlock Text="执行依据与限制" FontSize="12" FontWeight="Bold" Opacity="0.85" />
                        <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="· 匹配范围：进程名以 EasiNote 开头者均视为白板5（EasiNote.exe、EasiNote.Mirror.exe、EasiNote5.exe 等）。学校希沃集控端（EasiAgent）与更新组件（EasiUpdate*）不在此列，不会被结束。" />
                        <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="· 判「是否正在使用」：仅检查该进程有无可见的顶层窗口。存在可见窗口即判定为正在使用，予以跳过；无可见窗口的后台滞留进程才会被结束。" />
                        <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="· 生效条件：本程序需处于运行状态。本程序完全退出后，到达设定时间点也不会执行（执行依赖本程序自身的计时，未向系统注册计划任务）。" />
                        <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="· 结束失败的常见原因：白板5 以管理员身份运行时，本程序权限不足，无法结束其进程。此时结果区会如实记录，不会标记为成功。" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
