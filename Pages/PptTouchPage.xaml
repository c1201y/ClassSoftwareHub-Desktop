<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.PptTouchPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <!--
      PowerPoint 触控优化（需求清单第 2 条）。

      版式照「白板专杀」/「系统功能」那一套：三列 Grid 把内容钉在中间 960 宽。
      ⚠️ 别用 Stretch + MaxWidth —— 触发上限后 WinUI 会把整列右甩。
      卡片只用 controls:SettingsCard，不手搭 Border。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,36,24,44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" MaxWidth="960" Spacing="4">

                <StackPanel Spacing="6" Margin="0,0,0,20">
                    <TextBlock Text="PowerPoint 触控优化" FontSize="28" FontWeight="Bold" />
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="放映时轻点屏幕翻到下一页，点视频、音频或按钮仍按原来的方式响应。" />
                </StackPanel>

                <controls:SettingsCard Header="轻点翻页">
                    <controls:SettingsCard.Description>
                        <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                   Text="只对 PowerPoint 的幻灯片放映生效，WPS 不需要开启。" />
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE786;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="EnableSwitch" MinWidth="0"
                                  OnContent="已开启" OffContent="已关闭"
                                  Toggled="EnableSwitch_Toggled" />
                </controls:SettingsCard>

                <TextBlock Text="当前状态" FontSize="14" Margin="0,18,0,2" />

                <controls:SettingsCard Header="运行状态">
                    <controls:SettingsCard.Description>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="RunStateText" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock x:Name="ShowStateText" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                        </StackPanel>
                    </controls:SettingsCard.Description>
                    <TextBlock x:Name="TapCountText" FontSize="13" Opacity="0.75"
                               VerticalAlignment="Center" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="适用说明">
                    <controls:SettingsCard.Description>
                        <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                   Text="轻点是还原成鼠标点击交给 PowerPoint 判断，所以点空白才翻页；滑动与长按保持 PowerPoint 原有行为。程序未运行时不会生效。" />
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
