<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.PptTouchPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:ClassSoftwareHub.Desktop.Controls">

    <!--
      PowerPoint 触控优化（需求清单第 2 条）。

      版式照「白板专杀」/「系统功能」那一套：三列 Grid 把内容钉在中间 960 宽。
      ⚠️ 别用 Stretch + MaxWidth —— 触发上限后 WinUI 会把整列右甩。
      卡片只用 controls:SettingsCard，不手搭 Border。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,36,24,44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" MaxWidth="960" Spacing="4">

                <StackPanel Spacing="6" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="PowerPoint 触控优化" FontSize="28" FontWeight="Bold" />
                        <ui:ExperimentalBadge FeatureId="ppttouch" />
                    </StackPanel>
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="放映时轻点屏幕：点在空白处翻页，点在视频、音频或链接上则按它自身的方式响应。上下滑动切换页面，长按弹出操作菜单。" />
                </StackPanel>

                <controls:SettingsCard Header="触控手势">
                    <controls:SettingsCard.Description>
                        <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                   Text="只对 PowerPoint 的幻灯片放映生效。" />
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE786;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="EnableSwitch" MinWidth="0"
                                  OnContent="已开启" OffContent="已关闭"
                                  Toggled="EnableSwitch_Toggled" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="长按菜单">
                    <controls:SettingsCard.Description>
                        <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                   Text="长按屏幕后松手，弹出本程序的菜单，用于翻页、指针、暂停与结束放映。" />
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="MenuSwitch" MinWidth="0"
                                  OnContent="已开启" OffContent="已关闭"
                                  Toggled="MenuSwitch_Toggled" />
                </controls:SettingsCard>

                <!-- 额外菜单项：清单来自 PptMenu.Extras（唯一真源），这里只负责铺出来。 -->
                <controls:SettingsExpander x:Name="ExtraExpander" Header="菜单项目"
                                           Description="长按菜单默认只放最常用的几项，其余可以在这里单独打开。"
                                           IsExpanded="False">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8FD;" />
                    </controls:SettingsExpander.HeaderIcon>
                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard Header="可加入菜单的项目">
                            <controls:SettingsCard.Description>
                                <StackPanel x:Name="ExtraHost" Spacing="0" Margin="0,6,0,2" />
                            </controls:SettingsCard.Description>
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <TextBlock Text="当前状态" FontSize="14" Margin="0,18,0,2" />

                <controls:SettingsCard Header="运行状态">
                    <controls:SettingsCard.Description>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="RunStateText" FontSize="12" TextWrapping="Wrap" />
                            <TextBlock x:Name="ShowStateText" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                        </StackPanel>
                    </controls:SettingsCard.Description>
                    <TextBlock x:Name="TapCountText" FontSize="13" Opacity="0.75"
                               VerticalAlignment="Center" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="适用说明">
                    <controls:SettingsCard.Description>
                        <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                   Text="以上手势与菜单只在幻灯片放映时生效，程序未运行时不会生效。菜单里的动作作用于当前放映的演示文稿。" />
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE946;" />
                    </controls:SettingsCard.HeaderIcon>
                </controls:SettingsCard>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
