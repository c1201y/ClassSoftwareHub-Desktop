<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.SubmitPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      和其余页面同一套版式：外层三列 Grid 把内容（含标题）一起钉在中间 960 宽。
      ⚠️ 标题必须在 960 列**里面** —— 曾经它横跨整宽、卡片居中，
         宽窗口下标题贴最左、卡片在中间，两套左缘对不齐。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,36,24,44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" MaxWidth="960" Spacing="4">
                <StackPanel Spacing="4" Margin="0,0,0,20">
                    <TextBlock Text="提交软件" FontSize="28" FontWeight="Bold" />
                    <TextBlock FontSize="12.5" Opacity="0.65" TextWrapping="Wrap"
                               Text="提交内容先以草稿形式存入仓库（submissions/），审核通过后上架。带 * 的为必填项。" />
                </StackPanel>

                    <!-- ═══ 从 GitHub 一键读取 ═══ -->
                    <Border CornerRadius="4" Padding="20" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="12">
                            <TextBlock Text="从 GitHub 读取" FontSize="18" FontWeight="Bold" />
                            <TextBlock FontSize="12.5" Opacity="0.7" TextWrapping="Wrap"
                                       Text="填写 GitHub 仓库地址，自动读取简介、版本号与各安装包的直链，无需手动抄录。读取使用公开接口，不会改动任何内容。" />

                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RepoBox" PlaceholderText="github.com/owner/repo 或 owner/repo" />
                                <Button x:Name="ImportButton" Grid.Column="1" Content="读取" MinWidth="100"
                                        Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Bottom"
                                        Click="Import_Click" />
                            </Grid>

                            <CheckBox x:Name="OverwriteBox" Content="覆盖已填写的内容" />
                            <TextBlock FontSize="12" Opacity="0.6" Margin="28,0,0,0" TextWrapping="Wrap"
                                       Text="默认仅填写空白字段；勾选后已填写的内容也会被覆盖。" />
                            <CheckBox x:Name="PrereleaseBox" Content="优先取最新预发布版（Beta / Alpha）" />

                            <InfoBar x:Name="ImportErrorBar" IsOpen="False" IsClosable="False" Severity="Error"
                                     Title="读取失败" />
                            <InfoBar x:Name="ImportOkBar" IsOpen="False" IsClosable="False" Severity="Success"
                                     Title="读取完成" />
                            <Border x:Name="ImportReport" Visibility="Collapsed" CornerRadius="4" Padding="12"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <StackPanel x:Name="ImportReportHost" Spacing="6" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ═══ 基本信息 ═══ -->
                    <Border CornerRadius="4" Padding="20" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="基本信息" FontSize="18" FontWeight="Bold" />

                            <TextBox x:Name="IdBox" PlaceholderText="小写字母 / 数字 / 短横线，如 7-zip"
                                     Description="详情页网址为 #/download/&lt;id&gt;，不可包含 ? &amp; = 等符号">
                                <TextBox.Header>
                                    <TextBlock><Run Text="软件 ID" /><Run Text=" *" Foreground="{ThemeResource SystemFillColorCriticalBrush}" /></TextBlock>
                                </TextBox.Header>
                            </TextBox>

                            <TextBox x:Name="NameBox" PlaceholderText="如 7-Zip">
                                <TextBox.Header>
                                    <TextBlock><Run Text="软件名称" /><Run Text=" *" Foreground="{ThemeResource SystemFillColorCriticalBrush}" /></TextBlock>
                                </TextBox.Header>
                            </TextBox>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- 图标可以填现成的链接，也可以选本地图片传上来（2026-10-06 对齐网页版）。
                                     按钮排法照「从 GitHub 读取」那行：框占满、按钮贴在框右侧。 -->
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="IconBox" Header="图标链接（选填，256×256 方图最佳）"
                                             PlaceholderText="https://…/icon.png" />
                                    <Button x:Name="IconUploadButton" Grid.Column="1" Content="上传图片" MinWidth="90"
                                            VerticalAlignment="Bottom" Click="IconUpload_Click" />
                                </Grid>
                                <ComboBox x:Name="CategoryCombo" Grid.Column="1" Header="分类 *"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Top"
                                          PlaceholderText="选择分类" />
                            </Grid>
                            <TextBlock x:Name="IconUploadHint" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                       Visibility="Collapsed" />

                            <TextBox x:Name="TaglineBox" PlaceholderText="一句话简介，显示在首页卡片上">
                                <TextBox.Header>
                                    <TextBlock><Run Text="一句话简介" /><Run Text=" *" Foreground="{ThemeResource SystemFillColorCriticalBrush}" /></TextBlock>
                                </TextBox.Header>
                            </TextBox>

                            <TextBox x:Name="DescBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120"
                                     PlaceholderText="详细介绍：软件的用途与使用注意事项（可换行）">
                                <TextBox.Header>
                                    <TextBlock><Run Text="详细介绍" /><Run Text=" *" Foreground="{ThemeResource SystemFillColorCriticalBrush}" /></TextBlock>
                                </TextBox.Header>
                            </TextBox>

                            <TextBox x:Name="ContactBox" PlaceholderText="如 QQ / 邮箱 / 站内留言方式"
                                     Description="您的联系方式将在本地加密后提交，仅管理员可解密查看">
                                <TextBox.Header>
                                    <TextBlock><Run Text="联系方式" /><Run Text=" *" Foreground="{ThemeResource SystemFillColorCriticalBrush}" /></TextBlock>
                                </TextBox.Header>
                            </TextBox>
                        </StackPanel>
                    </Border>

                    <!-- ═══ 补充信息 ═══ -->
                    <Border CornerRadius="4" Padding="20" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="14">
                            <TextBlock Text="补充信息" FontSize="18" FontWeight="Bold" />

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="VersionBox" Header="版本号" PlaceholderText="如 24.09" />
                                <TextBox x:Name="SizeBox" Grid.Column="1" Header="体积" PlaceholderText="如 1.6 MB" />
                            </Grid>

                            <TextBox x:Name="SystemBox" PlaceholderText="如 Windows 10/11（x86 / x64 / ARM64）">
                                <TextBox.Header>
                                    <TextBlock><Run Text="系统限制" /><Run Text=" *" Foreground="{ThemeResource SystemFillColorCriticalBrush}" /></TextBlock>
                                </TextBox.Header>
                            </TextBox>

                            <TextBox x:Name="WebsiteBox" Header="官网地址（选填）" PlaceholderText="https://…" />
                            <TextBox x:Name="GithubBox" Header="GitHub 仓库（选填）" PlaceholderText="https://github.com/…" />
                            <TextBox x:Name="NoticeBox" Header="提示条（选填）"
                                     PlaceholderText="显示在下载区上方的蓝色提示，适合「更新频繁、直链易失效」的软件" />
                            <TextBox x:Name="StoreBox" Header="应用商店地址（选填）"
                                     PlaceholderText="填写后会额外显示一张「商店下载」卡片" />
                            <TextBox x:Name="SortBox" Header="排序值（选填）" PlaceholderText="数字越小越靠前，留空排最后"
                                     InputScope="Number" />
                        </StackPanel>
                    </Border>

                    <!-- ═══ 下载项 ═══ -->
                    <TextBlock Text="下载项" FontSize="18" FontWeight="Bold" Margin="0,6,0,0" />
                    <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                               Text="直链需填写文件本身（.exe / .zip / .msi 等），单击后直接开始下载；请勿填写官网下载页。" />
                    <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                               Text="没有自己的网盘也可以：点「上传到本站」把文件传到站点存储，回填的文件键在下载时同样走票据闸门（单文件上限 2.5 GB，超过请改填官网或 GitHub Releases 直链）。" />
                    <StackPanel x:Name="DownloadsHost" Spacing="12" />
                    <Button Content="+ 添加下载项" Click="AddDownload_Click" HorizontalAlignment="Left" />

                    <!-- ═══ 提交 ═══ -->
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right" Margin="0,6,0,0">
                        <Button x:Name="RestoreDraftButton" Content="恢复上次未提交的内容"
                                Click="RestoreDraft_Click" Visibility="Collapsed" />
                        <Button x:Name="SubmitButton" Content="提交" MinWidth="130"
                                Style="{StaticResource AccentButtonStyle}" Click="Submit_Click" />
                    </StackPanel>

                    <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="False" />

                    <!-- 连不上提交服务时的兜底 -->
                    <StackPanel x:Name="FallbackPanel" Spacing="10" Visibility="Collapsed">
                        <InfoBar x:Name="FallbackBar" IsOpen="True" IsClosable="False" Severity="Warning"
                                 Title="无法连接提交服务"
                                 Message="内容已保存于本机，不会丢失。可稍后重试，或将提交文件下载后手动放入仓库，亦可直接前往 GitHub 提交 Pull Request。" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="FallbackRetryButton" Content="重试" Click="Submit_Click"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <Button Content="下载提交文件" Click="DownloadSubmission_Click" />
                            <Button Content="复制 JSON" Click="CopySubmission_Click" />
                            <Button Content="在 GitHub 提交" Click="OpenGithubSubmit_Click" />
                        </StackPanel>
                        <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                   Text="在 GitHub 提交：打开「新建文件」页面并携带文件名，粘贴内容后保存即可（无写权限时，GitHub 会引导 fork 并提交 PR），合并后同样生成审核工单。" />
                    </StackPanel>

                    <TextBlock x:Name="Toast" FontSize="12" Opacity="0.75" Margin="0,4,0,10" />
                </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
