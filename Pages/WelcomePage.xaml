<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.WelcomePage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:ClassSoftwareHub.Desktop.Data">

    <Page.Resources>
        


        <DataTemplate x:Key="QuickLinkNormal">
            <Border CornerRadius="8" Padding="12,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Height="24">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.95"
                                  Visibility="{Binding IconSvg, Converter={StaticResource NotNullToCollapsed}}" />
                        <Image Source="{Binding IconSource}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IconSource, Converter={StaticResource NullToCollapsed}}" />
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontSize="14" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        
        <Style x:Key="InfoRowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>

        


        <Style x:Key="CardIcon" TargetType="FontIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            

            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CardSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.68" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CardChevron" TargetType="FontIcon">
            <Setter Property="Glyph" Value="&#xE76C;" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Page.Resources>


    


    <ScrollViewer VerticalScrollBarVisibility="Auto">
        



        <Grid Margin="24,36,24,44">
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" MaxWidth="960" Spacing="8">

            


            <TextBlock Text="ClassSoftwareHub - Desktop" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />

            



            



            





            <StackPanel x:Name="NoticeHost" Spacing="8" />

            
            <Grid ColumnSpacing="20" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border CornerRadius="12" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Image x:Name="Banner" Height="140" Stretch="Uniform" />
                </Border>

                



                <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="2" HorizontalAlignment="Left">
                    


                    <TextBlock x:Name="ShellVersionText" FontSize="28" FontWeight="Bold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="CodeNameText" Text="Synesthesia" FontSize="28" FontWeight="Bold"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            





            






            <Grid x:Name="RecommendSection" Visibility="Collapsed" Margin="0,22,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="推荐应用" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="换一批" Click="Recommend_Reroll"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Background="Transparent" BorderThickness="0" Padding="8,2"
                            FontSize="12" Opacity="0.7" />
                </Grid>

                <Border Grid.Row="1" x:Name="RecommendViewport" HorizontalAlignment="Stretch"
                        MaxWidth="960" VerticalAlignment="Top" Background="Transparent"
                        PointerEntered="Recommend_PointerEntered" PointerExited="Recommend_PointerExited">
                    <StackPanel x:Name="RecommendStrip" Orientation="Horizontal" Spacing="12"
                                HorizontalAlignment="Left" VerticalAlignment="Top">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="RecommendTransform" />
                        </StackPanel.RenderTransform>
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="快速开始" FontSize="20" FontWeight="Bold" Margin="0,20,0,4" />

            



            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="WebCard" Grid.Column="0" Tag="web" CornerRadius="8" Padding="16,18"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                        Tapped="Card_Tapped">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE774;" FontSize="20" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="访问网页版" FontSize="14"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            <TextBlock Text="在浏览器中打开完整站点" FontSize="12" Opacity="0.78"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Grid>
                </Border>

                


                <Border x:Name="ChangelogCard" Grid.Column="1" Tag="changelog" CornerRadius="8" Padding="16,18"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                        Tapped="ChangelogCard_Tapped">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        

                        <FontIcon x:Name="ChangelogIcon" Glyph="&#xE81C;" FontSize="20" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock x:Name="ChangelogCardTitle" Text="查看更新内容" FontSize="14"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                            <TextBlock x:Name="ChangelogCardSubtitle" FontSize="12" Opacity="0.78"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </StackPanel>
                        <FontIcon x:Name="ChangelogChevron" Grid.Column="2" Glyph="&#xE8A7;" FontSize="12"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        
                        <Button x:Name="UpdateInstallButton" Grid.Column="2" VerticalAlignment="Center"
                                Content="立即安装" Visibility="Collapsed" Click="InstallPending_Click" />
                        



                        <Button x:Name="QuickUpdateButton" Grid.Column="2" VerticalAlignment="Center"
                                Content="立即更新" Visibility="Collapsed" Click="QuickUpdate_Click" />
                    </Grid>
                </Border>
            </Grid>

            
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Tag="apps" CornerRadius="8" Padding="14,18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                        Tapped="Card_Tapped">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE896;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="下载首页" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="浏览并下载常用软件" Style="{StaticResource CardSubtitle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Tag="tools-classroom" CornerRadius="8" Padding="14,18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                        Tapped="Card_Tapped">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE71D;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="课堂工具" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="抽号、计时、时钟与学科工具" Style="{StaticResource CardSubtitle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" />
                    </Grid>
                </Border>
            </Grid>

            







            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Tag="announce" CornerRadius="8" Padding="14,18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                        Tapped="Card_Tapped">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE720;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="教室喊话" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="全屏提醒，同网段与远程都能收到" Style="{StaticResource CardSubtitle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" />
                    </Grid>
                </Border>

                <Border Grid.Column="1" Tag="function-plot" CornerRadius="8" Padding="14,18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                        Tapped="Card_Tapped">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9D2;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="函数图像" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="函数曲线、圆锥曲线与几何作图" Style="{StaticResource CardSubtitle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" />
                    </Grid>
                </Border>
            </Grid>

            



            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Tag="tools-system" CornerRadius="8" Padding="14,18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                        Tapped="Card_Tapped">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE945;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="系统工具" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="取色、编码、关机与磁盘空间" Style="{StaticResource CardSubtitle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" />
                    </Grid>
                </Border>

                
                <Border Grid.Column="1" Tag="hubai" CornerRadius="8" Padding="14,18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                        Tapped="Card_Tapped">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8BD;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="Hub AI" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="查看本机状况并给出建议" Style="{StaticResource CardSubtitle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" />
                    </Grid>
                </Border>
            </Grid>

            
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Tag="sidebar" CornerRadius="8" Padding="14,18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                        Tapped="Card_Tapped">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8A0;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="侧边布局" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="调整侧边栏的位置与模式" Style="{StaticResource CardSubtitle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" />
                    </Grid>
                </Border>

                




                <Border Grid.Column="1" Tag="experimental" CornerRadius="8" Padding="14,18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                        Tapped="Card_Tapped">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xEA80;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="实验性功能" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="尚未成熟的新功能" Style="{StaticResource CardSubtitle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" />
                    </Grid>
                </Border>
            </Grid>

            





            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Tag="submit" CornerRadius="8" Padding="14,18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                        Tapped="Card_Tapped">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE898;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="提交软件" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="把手上的软件推给更多同学" Style="{StaticResource CardSubtitle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" />
                    </Grid>
                </Border>

                
                <Border Grid.Column="1" Tag="feedback" CornerRadius="8" Padding="14,18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                        Tapped="Card_Tapped">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE939;" Style="{StaticResource CardIcon}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Text="反馈中心" Style="{StaticResource CardTitle}" />
                            <TextBlock Text="问题与建议都写在这里" Style="{StaticResource CardSubtitle}" />
                        </StackPanel>
                        <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" />
                    </Grid>
                </Border>
            </Grid>

            
            <Border Tag="settings" CornerRadius="8" Padding="14,18"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                    Tapped="Card_Tapped">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE713;" Style="{StaticResource CardIcon}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="设置" Style="{StaticResource CardTitle}" />
                        <TextBlock Text="更新、内容源与外观" Style="{StaticResource CardSubtitle}" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" Style="{StaticResource CardChevron}" />
                </Grid>
            </Border>

            








            <InfoBar x:Name="CollectedBar" IsOpen="False" IsClosable="False"
                     Severity="Informational" Margin="0,4,0,0" />

            


            <GridView x:Name="QuickGrid" Margin="0,14,0,0" Padding="0" SelectionMode="None"
                      IsItemClickEnabled="True" ItemClick="Quick_ItemClick"
                      ItemTemplate="{StaticResource QuickLinkNormal}"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="192" ItemHeight="88" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>

            
            <TextBlock Text="硬件信息" FontSize="20" FontWeight="Bold" Margin="0,20,0,2" />
            <StackPanel x:Name="HardwareList" Margin="2,0,0,0" />

            <TextBlock Text="系统信息" FontSize="20" FontWeight="Bold" Margin="0,22,0,2" />
            <StackPanel x:Name="SystemList" Margin="2,0,0,0" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
