<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.WelcomePage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:ClassSoftwareHub.Desktop.Core">

    <Page.Resources>
        <!-- 快捷入口两套模板：颜色全走 {ThemeResource}（它认识"这棵树"的主题，浅色/深色自己会变） -->
        <DataTemplate x:Key="QuickLinkNormal">
            <Border CornerRadius="8" Padding="12,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="{Binding Glyph}" FontSize="24" HorizontalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.95" />
                    <TextBlock Text="{Binding Name}" FontSize="13" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="QuickLinkAccent">
            <Border CornerRadius="8" Padding="12,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                <StackPanel Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="{Binding Glyph}" FontSize="24" HorizontalAlignment="Center"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Opacity="0.95" />
                    <TextBlock Text="{Binding Name}" FontSize="13" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <core:QuickLinkSelector x:Key="QuickLinkSelector"
                                Normal="{StaticResource QuickLinkNormal}"
                                Accent="{StaticResource QuickLinkAccent}" />

        <!-- 「硬件信息 / 系统信息」列表的行间分隔线（跟主题走） -->
        <Style x:Key="InfoRowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>


    <ScrollViewer Padding="24,36,24,44" VerticalScrollBarVisibility="Auto">
        <!--
          ⚠️ 别用 Stretch + MaxWidth：一旦触发上限 WinUI 会把整列**右甩**（左边空一大块）→ 看起来就是「变形」。
          这里用「三列 Grid：* / 960 / *」把内容钉在中间 960 宽，导航展开或收起都不动。
        -->
        <Grid>
            <!-- 中间列 = 想要 960 宽：窗口够宽就正好 960 且居中（剩余给两侧星列），窗口太窄就自动缩、不裁切 -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="998*" MaxWidth="960" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Spacing="14">

            <TextBlock Text="ClassSoftwareHub" FontSize="44" FontWeight="Bold" />

            <TextBlock x:Name="HomeTitleText" FontSize="24" FontWeight="Bold" TextWrapping="Wrap" />

            <!-- 图片（高 140，宽按比例）+ 版本号（左）+ 代号 Tack（右，别跟版本号挤一起） -->
            <Grid ColumnSpacing="20" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border CornerRadius="8" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Image x:Name="Banner" Height="140" Stretch="Uniform" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Top" Spacing="2" HorizontalAlignment="Left">
                    <TextBlock x:Name="SiteVersionText" FontSize="28" FontWeight="Bold" />
                    <TextBlock x:Name="AppVersionText" FontSize="12.5" Opacity="0.65" />
                </StackPanel>

                <!-- 应用代号：贴右（跟顶上那串版本号岔开，不打架） -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                    <TextBlock Text="代号" FontSize="11" Opacity="0.6" HorizontalAlignment="Right" />
                    <TextBlock x:Name="CodeNameText" Text="Tack" FontSize="30" FontWeight="Bold"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="快速开始" FontSize="22" FontWeight="Bold" Margin="0,20,0,4" />

            <!-- 更宽的一行：体验网页版（主题色底） -->
            <Border x:Name="WebCard" Tag="web" Height="60" CornerRadius="8" Padding="20,0"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                    Tapped="Card_Tapped">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE774;" FontSize="20" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    <TextBlock Grid.Column="1" Text="体验网页版" FontSize="15" FontWeight="Bold"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="13" VerticalAlignment="Center"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Grid>
            </Border>

            <!-- 两张等大卡片 -->
            <Grid ColumnSpacing="16" Height="60">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Tag="apps" CornerRadius="8" Padding="20,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                        Tapped="Card_Tapped">
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE896;" FontSize="20" />
                        <TextBlock Text="下载首页" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Tag="tools" CornerRadius="8" Padding="20,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                        Tapped="Card_Tapped">
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE71D;" FontSize="20" />
                        <TextBlock Text="内置工具" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== 一行快捷入口：图标在上、文字在下（不用卡片、不加标题） ===== -->
            <GridView x:Name="QuickGrid" Margin="0,14,0,0" Padding="0" SelectionMode="None"
                      IsItemClickEnabled="True" ItemClick="Quick_ItemClick"
                      ItemTemplateSelector="{StaticResource QuickLinkSelector}"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <GridView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="192" ItemHeight="88" />
                    </ItemsPanelTemplate>
                </GridView.ItemsPanel>
            </GridView>

            <!-- ===== 硬件信息 / 系统信息：列表形式（不用卡片），行在 code-behind 里填 ===== -->
            <TextBlock Text="硬件信息" FontSize="22" FontWeight="Bold" Margin="0,20,0,2" />
            <StackPanel x:Name="HardwareList" Margin="2,0,0,0" />

            <TextBlock Text="系统信息" FontSize="22" FontWeight="Bold" Margin="0,22,0,2" />
            <StackPanel x:Name="SystemList" Margin="2,0,0,0" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
