<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.AboutPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:ClassSoftwareHub.Desktop.Controls">

    <!--
      「关于」页（2026-11-13）。

      版式**与设置页同一套**：分组小标题（BodyStrong）+ 一列 SettingsCard，卡片间距 4、组间 24。
      ⛔ 不用 SettingsExpander 堆层级：那会让每张卡多一层缩进，标题行右侧再挂个版本号，
         整页看着忽左忽右（第一版就是这么被否的）。
      ⛔ 只借 ClassIsland 的"顶部横幅 → 标题 → 分组"这个顺序，不搬它的卡片形态。

      横幅铺满内容区宽度，下缘渐隐融进内容区；实现见 AboutPage.xaml.cs 的 LoadBanner
      （WinUI 3 没有 UIElement.OpacityMask，只能走合成层遮罩）。
    -->

    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== 铺满顶部的横幅（图与渐隐在代码里挂合成视觉） ===== -->
            <Grid x:Name="BannerHost" Grid.Row="0" Height="320" IsHitTestVisible="False" />

            <!-- ===== 内容区（本站母版：三列，中间 960） ===== -->
            <Grid Grid.Row="1" Margin="24,0,24,44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" MaxWidth="960">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <TextBlock Text="关于 ClassSoftwareHub" FontSize="28" FontWeight="SemiBold" Margin="0,4,0,4" />

                    <!-- ================= 应用信息 ================= -->
                    <TextBlock Text="应用信息" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,20,0,8" />
                    <StackPanel Spacing="4">

                        <controls:SettingsCard Header="ClassSoftwareHub" Description="班级电教委员的装机与课堂工具集">
                            <controls:SettingsCard.HeaderIcon>
                                <ImageIcon x:Name="AppIcon" />
                            </controls:SettingsCard.HeaderIcon>
                            <TextBlock x:Name="VersionText" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Name="CopyrightCard" Header="版权信息"
                                               IsActionIconVisible="False">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8A5;" />
                            </controls:SettingsCard.HeaderIcon>
                            <controls:SettingsCard.Description>
                                <TextBlock x:Name="CopyrightText" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" />
                            </controls:SettingsCard.Description>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <HyperlinkButton Content="开源许可" Padding="6,0" Click="OpenLicenseText_Click" />
                                <HyperlinkButton Content="隐私政策" Padding="6,0" Click="OpenPrivacy_Click" />
                            </StackPanel>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="常用链接" IsActionIconVisible="False">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE774;" />
                            </controls:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <HyperlinkButton Content="项目仓库" Padding="6,0" Click="OpenRepo_Click" />
                                <HyperlinkButton Content="作者主页" Padding="6,0" Click="OpenAuthor_Click" />
                                <HyperlinkButton Content="加入群聊" Padding="6,0" Click="OpenGroup_Click" />
                                <HyperlinkButton Content="赞助作者" Padding="6,0" Click="OpenSponsor_Click" />
                            </StackPanel>
                        </controls:SettingsCard>

                    </StackPanel>

                    <!-- ================= 帮助与反馈 ================= -->
                    <!-- 反馈中心与更新日志原来各占一颗底部导航项，2026-11-13 收进这里 -->
                    <TextBlock Text="帮助与反馈" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                    <StackPanel Spacing="4">

                        <controls:SettingsCard Header="问题反馈" Description="提交问题与功能建议"
                                               IsClickEnabled="True" Click="OpenFeedback_Click">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE939;" />
                            </controls:SettingsCard.HeaderIcon>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="更新日志" Description="各版本的改动记录"
                                               IsClickEnabled="True" Click="OpenChangelog_Click">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE81C;" />
                            </controls:SettingsCard.HeaderIcon>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="运行日志" Description="本机日志与诊断信息"
                                               IsClickEnabled="True" Click="OpenLogs_Click">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE9D9;" />
                            </controls:SettingsCard.HeaderIcon>
                        </controls:SettingsCard>

                    </StackPanel>

                    <!-- ================= 回声洞 ================= -->
                    <!-- 2026-11-13 从设置页整块搬来，形态与文案一字未改：
                         一个 SettingsExpander，默认折叠，展开区里只有一张卡片（字条 + 投稿）。
                         ⚠️ 那句「请点击这里收看…」是 Nick 亲手定的（MustRead §2.2 的例外），⛔ 别改。
                         ⚠️ CollapseEchoCave 那套「先拨 true 再拨 false」的收折手法原样保留。 -->
                    <TextBlock Text="回声洞" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                    <StackPanel Spacing="4">

                        <controls:SettingsExpander x:Name="EchoCaveExpander" Header="回声洞"
                                                   Description="请点击这里收看 ClassSoftwareHub 群友的逆天发言！"
                                                   IsExpanded="False">
                            <controls:SettingsExpander.HeaderIcon>
                                <FontIcon Glyph="&#xE8BD;" />
                            </controls:SettingsExpander.HeaderIcon>
                            <controls:SettingsExpander.Items>

                            <controls:SettingsCard IsClickEnabled="True" Click="EchoCave_Click"
                                                   IsActionIconVisible="False"
                                                   ToolTipService.ToolTip="换一条">
                                <controls:SettingsCard.Header>
                                    <ui:EchoCaveCard x:Name="EchoCave" />
                                </controls:SettingsCard.Header>
                                <Button Content="投稿" VerticalAlignment="Center">
                                    <Button.Flyout>
                                        <Flyout x:Name="EchoSubmitFlyout" Placement="Bottom">
                                            <StackPanel Width="320" Spacing="10">
                                                <TextBlock Text="投稿到回声洞"
                                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBox x:Name="EchoSubmitBox"
                                                         PlaceholderText="不超过 200 字"
                                                         AcceptsReturn="True" TextWrapping="Wrap"
                                                         MinHeight="76" MaxLength="200" />
                                                <TextBlock x:Name="EchoSubmitStatus" TextWrapping="Wrap"
                                                           Visibility="Collapsed"
                                                           Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <HyperlinkButton x:Name="EchoSubmitFallback"
                                                                 Content="改用 GitHub 网页投稿"
                                                                 Padding="0" MinWidth="0" Visibility="Collapsed"
                                                                 Click="SubmitEchoCaveFallback_Click" />
                                                <Button x:Name="EchoSubmitButton" Content="提交"
                                                        HorizontalAlignment="Right"
                                                        Style="{ThemeResource AccentButtonStyle}"
                                                        Click="SubmitEchoCave_Click" />
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </controls:SettingsCard>

                            </controls:SettingsExpander.Items>
                        </controls:SettingsExpander>

                    </StackPanel>

                    <!-- ================= 授权 ================= -->
                    <!-- 2026-11-13 从设置页搬来，判定与文案未改：官方包不摆按钮；激活码激活的只报激活时间。 -->
                    <TextBlock Text="授权" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                    <StackPanel Spacing="4">

                        <controls:SettingsCard Header="授权状态" IsActionIconVisible="False">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE73E;" />
                            </controls:SettingsCard.HeaderIcon>
                            <controls:SettingsCard.Description>
                                <TextBlock x:Name="LicenseStatus" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </controls:SettingsCard.Description>
                            <Button x:Name="LicenseActionButton" Content="输入激活码" Click="LicenseAction_Click" />
                        </controls:SettingsCard>

                    </StackPanel>

                    <!-- ================= 条款与声明 ================= -->
                    <!-- 三份文本与站点同源（站点 public/legal.json ⇒ Services/LegalTextSource），
                         ⛔ 卡片标题与说明不许在 XAML 里写死，一律按数据刷（RefreshLegalCards）。 -->
                    <TextBlock Text="条款与声明" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                    <StackPanel Spacing="4">

                        <controls:SettingsCard x:Name="LegalAgreementCard" Header="用户协议"
                                               IsClickEnabled="True" Click="OpenLegal_Click" Tag="agreement">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8A5;" />
                            </controls:SettingsCard.HeaderIcon>
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Name="LegalPrivacyCard" Header="隐私政策"
                                               IsClickEnabled="True" Click="OpenLegal_Click" Tag="privacy">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE72E;" />
                            </controls:SettingsCard.HeaderIcon>
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Name="LegalDisclaimerCard" Header="免责声明"
                                               IsClickEnabled="True" Click="OpenLegal_Click" Tag="disclaimer">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7BA;" />
                            </controls:SettingsCard.HeaderIcon>
                        </controls:SettingsCard>

                    </StackPanel>

                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
