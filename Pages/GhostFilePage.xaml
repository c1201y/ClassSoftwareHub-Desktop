<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.GhostFilePage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:ClassSoftwareHub.Desktop.Pages"
    xmlns:ui="using:ClassSoftwareHub.Desktop.Controls">

    <!--
      幽灵文件清理（实验性功能，2026-11-03）。

      版式照「PowerPoint 触控优化」那一套：三列 Grid 把内容钉在中间 960 宽。
      ⚠️ 别用 Stretch + MaxWidth —— 触发上限后 WinUI 会把整列右甩。
      卡片只用 controls:SettingsCard，不手搭 Border。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,36,24,44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" MaxWidth="960" Spacing="4">

                <StackPanel Spacing="6" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="幽灵文件清理" FontSize="28" FontWeight="Bold" />
                        <ui:ExperimentalBadge FeatureId="ghostfile" />
                    </StackPanel>
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="文件已经删掉，资源管理器里却还留着图标、双击提示找不到路径时，用这里清理。" />
                </StackPanel>

                <controls:SettingsCard Header="目标目录">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8B7;" />
                    </controls:SettingsCard.HeaderIcon>
                    <controls:SettingsCard.Description>
                        <StackPanel Spacing="8" Margin="0,6,0,2">
                            <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                       Text="填幽灵文件所在的那一级文件夹，只检查这一层，不会往下翻。" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBox x:Name="PathBox" Width="400" MinWidth="200"
                                         PlaceholderText="例如 C:\Users\Public\Desktop" />
                                <Button Content="浏览" Click="Browse_Click" />
                                <Button Content="开始扫描" Style="{StaticResource AccentButtonStyle}"
                                        Click="Scan_Click" />
                            </StackPanel>
                        </StackPanel>
                    </controls:SettingsCard.Description>
                </controls:SettingsCard>

                <TextBlock x:Name="ResultTitle" Text="扫描结果" FontSize="14" Margin="0,18,0,2" />

                <!-- 有结果 -->
                <StackPanel x:Name="ResultPanel" Spacing="10" Visibility="Collapsed">
                    <ListView x:Name="ResultList" SelectionMode="None" MaxHeight="380"
                              IsItemClickEnabled="False" HorizontalContentAlignment="Stretch">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:GhostRow">
                                <Grid ColumnSpacing="12" Padding="0,8" MinHeight="56">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{x:Bind Selected, Mode=TwoWay}"
                                              MinWidth="0" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{x:Bind DisplayName}" FontSize="14"
                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                        <TextBlock Text="{x:Bind SubText}" FontSize="12" Opacity="0.6"
                                                   TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="2" Text="{x:Bind SizeText}" FontSize="12"
                                               Opacity="0.6" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="DeleteButton" Content="删除选中" Click="Delete_Click" />
                    </StackPanel>

                    <TextBlock x:Name="DeleteHint" FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                               Text="删除是永久的，不进回收站。" />
                </StackPanel>

                <!-- 没结果 / 出错 -->
                <InfoBar x:Name="MessageBar" IsOpen="False" IsClosable="False" Severity="Informational" />

                <!-- 显示缓存那一路的出口：扫不到东西时，让资源管理器重读一遍 -->
                <StackPanel x:Name="RefreshRow" Orientation="Horizontal" Spacing="8"
                            Margin="0,4,0,0" Visibility="Collapsed">
                    <Button Content="刷新资源管理器" Click="Refresh_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
