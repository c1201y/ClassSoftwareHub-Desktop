<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.ChangelogPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClassSoftwareHub.Desktop.Pages">

    <!--
      ⛔⛔ 版式要点（2026-10-17 改版，Nick 的七条意见）：
      1. 顶部那张「巨无霸版本卡」删了 —— 版本号 + 通道 + 数据来源压成标题下方一行副标题。
      2. 操作栏不再左右分家：筛选、刷新、在浏览器打开全收进左栏列表正上方，
         它们控制的就是这个列表，主次关系一目了然。单选按钮换成下拉（不用 RadioButton 占版面）。
      3. 左侧列表用**原生 ListView**（系统自带的选中高亮、悬停、键盘导航），
         条目是「主标题（版本号）+ 副标题（日期 · 通道）」两行文本，不自绘选中底色。
      4. 右侧正文按 Markdown 的标题**分组**，组标题 14.5 SemiBold、组间留白，
         版本之间用分隔线而不是层层卡片 —— 像读文档，不是往灰盒子里塞记事本。
    -->
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" MaxWidth="960" Margin="0,36,0,44" RowSpacing="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ===== 标题区（原来那张大卡的信息压缩成一行） ===== -->
            <StackPanel Spacing="5">
                <TextBlock Text="更新日志" FontSize="28" FontWeight="Bold" />
                <TextBlock x:Name="HeaderMeta" FontSize="12" Opacity="0.62"
                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
            </StackPanel>

            <Grid Grid.Row="1" ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="264" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== 左栏：工具栏 + 版本列表 + 计数 ===== -->
                <Border Style="{StaticResource CshCardStyle}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 工具栏：筛选在左，两个图标操作靠右，全部属于「这个列表」 -->
                        <Grid Margin="12,12,12,8" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- ⚠️ 必须给 SelectedIndex：不给的话框里是空的，看着像坏了 -->
                            <ComboBox x:Name="FilterBox" SelectedIndex="0" HorizontalAlignment="Stretch"
                                      SelectionChanged="Filter_Changed"
                                      ToolTipService.ToolTip="按发布通道筛选">
                                <ComboBoxItem Content="全部版本" />
                                <ComboBoxItem Content="仅正式版本" />
                            </ComboBox>

                            <Button Grid.Column="1" Click="Refresh_Click" Padding="8,6"
                                    ToolTipService.ToolTip="重新读取发布说明">
                                <FontIcon Glyph="&#xE72C;" FontSize="13" />
                            </Button>

                            <Button Grid.Column="2" Click="OpenWeb_Click" Padding="8,6"
                                    ToolTipService.ToolTip="在浏览器中查看全部发布">
                                <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                            </Button>
                        </Grid>

                        <!-- 原生 ListView：选中/悬停/键盘导航全交给系统默认视觉，不自绘 -->
                        <ListView x:Name="VersionList" Grid.Row="1"
                                  SelectionMode="Single" Margin="0,0,0,4"
                                  SelectionChanged="VersionList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ReleaseRow">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{x:Bind Tag}" FontSize="13.5"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind SubLine}" FontSize="11.5"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock x:Name="StateText" Grid.Row="2" FontSize="11.5" Opacity="0.55"
                                   Margin="14,6,14,12" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!-- ===== 右栏：文档式正文（不套大边框） ===== -->
                <Grid Grid.Column="1">
                    <ScrollViewer x:Name="ReleaseScroll" VerticalScrollBarVisibility="Auto"
                                  Padding="2,0,10,0">
                        <ItemsControl x:Name="ReleaseList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="local:ReleaseRow">
                                    <StackPanel Spacing="0" Margin="0,0,0,26">
                                        <!-- 版本头：版本号 + 通道徽标 + 右对齐日期 -->
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{x:Bind Tag}" FontSize="19" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />

                                            <Border Grid.Column="1" CornerRadius="9" Padding="7,1"
                                                    VerticalAlignment="Center"
                                                    BorderThickness="1"
                                                    BorderBrush="{x:Bind BadgeBrush}">
                                                <TextBlock Text="{x:Bind ChannelText}" FontSize="11"
                                                           Foreground="{x:Bind BadgeBrush}" />
                                            </Border>

                                            <TextBlock Grid.Column="2" Text="{x:Bind DateText}" FontSize="11.5"
                                                       Opacity="0.5" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <Border Height="1" Margin="0,10,0,14"
                                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <!-- 按 Markdown 标题分组：组标题 + 组内条目 -->
                                        <ItemsControl ItemsSource="{x:Bind Blocks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="local:NoteBlock">
                                                    <StackPanel Spacing="5" Margin="{x:Bind Margin}">
                                                        <TextBlock Text="{x:Bind Title}" FontSize="15.5"
                                                                   FontWeight="SemiBold"
                                                                   Visibility="{x:Bind TitleVisibility}"
                                                                   TextWrapping="Wrap" />
                                                        <ItemsControl ItemsSource="{x:Bind Lines}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="local:NoteLine">
                                                                    <Grid ColumnSpacing="8" Margin="0,0,0,3">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <TextBlock Text="•" FontSize="13"
                                                                                   Opacity="0.45"
                                                                                   Visibility="{x:Bind BulletVisibility}"
                                                                                   VerticalAlignment="Top" />

                                                                        <TextBlock Grid.Column="1" Text="{x:Bind Text}"
                                                                                   FontSize="13" LineHeight="21"
                                                                                   TextWrapping="Wrap"
                                                                                   IsTextSelectionEnabled="True"
                                                                                   Opacity="{x:Bind Opacity}" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel x:Name="LoadingPanel" Spacing="12" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <ProgressRing x:Name="LoadingRing" IsActive="True" Width="34" Height="34"
                                      HorizontalAlignment="Center" />
                        <TextBlock Text="正在从更新仓库读取发布说明。" FontSize="12" Opacity="0.7"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="FallbackPanel" Spacing="10" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE81C;" FontSize="32" Opacity="0.45" HorizontalAlignment="Center" />
                        <TextBlock x:Name="FallbackText" MaxWidth="420" TextAlignment="Center"
                                   TextWrapping="Wrap" FontSize="12" Opacity="0.7" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
