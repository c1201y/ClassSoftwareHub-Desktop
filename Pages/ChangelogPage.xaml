<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.ChangelogPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClassSoftwareHub.Desktop.Pages">

    <!-- 和其余页面同一套版式：内容钉在中间 960 宽 -->
    <Grid Padding="24,36,24,44">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="998*" MaxWidth="960" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="更新日志" FontSize="30" FontWeight="Bold" />
                <TextBlock FontSize="12.5" Opacity="0.65" TextWrapping="Wrap"
                           Text="各版本的更新内容，读取自更新仓库的发布说明，与应用内「检查更新」显示的内容一致。左侧点版本号可以直接跳到那一版。" />
            </StackPanel>

            <!-- 当前版本 -->
            <Border Grid.Row="1" CornerRadius="8" Padding="20,16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Name="CurrentVersionText" FontSize="20" FontWeight="Bold" />
                        <Border CornerRadius="4" Padding="8,2" BorderThickness="1"
                                VerticalAlignment="Center"
                                BorderBrush="{ThemeResource TextFillColorSecondaryBrush}">
                            <TextBlock x:Name="ChannelBadgeText" FontSize="11.5"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="CurrentHint" FontSize="12.5" Opacity="0.65" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 工具行：左边操作，右边筛版本范围 -->
            <Grid Grid.Row="2" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="RefreshButton" Content="刷新" Click="Refresh_Click" />
                <Button Grid.Column="1" Content="在浏览器里看全部发布" Click="OpenWeb_Click" />

                <!--
                  只分「全部版本 / 正式版本」两种。**故意不做「预览版」这一档** ——
                  Nick 2026-09-26：预览版用户本来就会收到正式版更新，单独开一档预览没意义。
                -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <RadioButton x:Name="FilterAll" GroupName="ChangelogFilter" Content="全部版本"
                                 Tag="all" MinWidth="0" IsChecked="True" Checked="Filter_Changed" />
                    <RadioButton x:Name="FilterStable" GroupName="ChangelogFilter" Content="正式版本"
                                 Tag="stable" MinWidth="0" Checked="Filter_Changed" />
                </StackPanel>
            </Grid>

            <!-- ===== 左边版本清单（快速跳版本）+ 右边发布内容 ===== -->
            <Grid Grid.Row="3" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="216" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="8" Padding="0,14,0,12"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="VersionListTitle" Text="版本" FontSize="12" Opacity="0.6"
                                   Margin="16,0,16,8" />

                        <ListView x:Name="VersionList" Grid.Row="1" SelectionMode="Single"
                                  IsItemClickEnabled="True" ItemClick="VersionList_ItemClick"
                                  Padding="4,0,4,0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:ReleaseRow">
                                    <StackPanel Spacing="1" Padding="0,5,0,5">
                                        <TextBlock Text="{x:Bind Tag}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <!-- 日期 + 通道：一眼能认出哪几条是预览版发出来的，不用另开一档 -->
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind DateShort}" FontSize="11" Opacity="0.6" />
                                            <TextBlock Text="{x:Bind ChannelShort}" FontSize="11" Opacity="0.6"
                                                       Foreground="{x:Bind BadgeBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="StateText" FontSize="12.5" Opacity="0.6" TextWrapping="Wrap"
                               Margin="2,0,0,8" />

                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="ReleaseScroll" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ReleaseList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:ReleaseRow">
                                        <Border CornerRadius="8" Padding="20,16,20,18" Margin="0,0,0,12"
                                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1">
                                            <StackPanel Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{x:Bind Tag}" FontSize="17" FontWeight="Bold"
                                                               VerticalAlignment="Center" />
                                                    <Border CornerRadius="4" Padding="8,2" BorderThickness="1"
                                                            VerticalAlignment="Center"
                                                            BorderBrush="{x:Bind BadgeBrush}">
                                                        <TextBlock Text="{x:Bind ChannelText}" FontSize="11.5"
                                                                   Foreground="{x:Bind BadgeBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{x:Bind DateText}" FontSize="12" Opacity="0.6"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>

                                                <!-- 发布说明（把 Markdown 轻量转成若干行 TextBlock） -->
                                                <ItemsControl ItemsSource="{x:Bind Lines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="local:NoteLine">
                                                            <TextBlock Text="{x:Bind Text}" FontSize="{x:Bind Size}"
                                                                       FontWeight="{x:Bind Weight}"
                                                                       Margin="{x:Bind Margin}"
                                                                       TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel x:Name="LoadingPanel" Spacing="12" HorizontalAlignment="Center"
                                    VerticalAlignment="Center" Visibility="Collapsed">
                            <ProgressRing x:Name="LoadingRing" IsActive="True" Width="34" Height="34"
                                          HorizontalAlignment="Center" />
                            <TextBlock Text="正在从更新仓库读取发布说明……" FontSize="13" Opacity="0.7"
                                       HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- 兜底文案（没网 / 没发布过） -->
                        <StackPanel x:Name="FallbackPanel" Spacing="10" Visibility="Collapsed"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE81C;" FontSize="34" Opacity="0.45" HorizontalAlignment="Center" />
                            <TextBlock x:Name="FallbackText" MaxWidth="420" TextAlignment="Center" TextWrapping="Wrap"
                                       FontSize="13" Opacity="0.7" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
