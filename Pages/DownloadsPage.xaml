<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.DownloadsPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:ClassSoftwareHub.Desktop.Services">

    <!-- 和首页 / 设置同一套版式：ScrollViewer 在外（滚动条贴窗口最右）+ 内容钉在中间 960 宽。
         ⛔ 必须加 VerticalContentAlignment="Stretch"：ScrollViewer 的内容默认**不拉伸**，
            内容矮的时候（空状态）整块只占内容自然高，下面的视口空间吃不到 ——
            表现就是底部按钮行悬在半空（Nick 2026-10-03：「这个按钮位置为什么这么奇怪」）。
            拉伸后 `*` 行才吸收得到剩余高度，按钮才会落在页面底部。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Stretch">
        <Grid Margin="24,36,24,44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="1" MaxWidth="960" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- 列表 / 空状态：必须是 `*` —— 它吸收"标题与按钮行之间"的全部剩余高度，
                         空状态才会竖直居中、按钮行才会落在页面底部。
                         ⛔ 写 Auto 会让这块只有内容自然高，按钮行跟着浮在半空（2026-10-03）。 -->
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="任务进行" FontSize="28" FontWeight="Bold" />
                    <TextBlock x:Name="SummaryText" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                </StackPanel>

                <!-- 任务列表：不用 ListView —— 这里不需要选中，用 ItemsControl 省掉一整套容器 chrome -->
                <ItemsControl x:Name="TaskList" Grid.Row="1" Padding="0,2,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="svc:DownloadTask">
                            <Border Style="{StaticResource CshCardStyle}" Padding="20,16" Margin="0,0,0,12">
                                <Grid ColumnSpacing="16" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <FontIcon Grid.Row="0" Grid.Column="0" Glyph="{x:Bind HeaderGlyph}" FontSize="20"
                                              VerticalAlignment="Center" />

                                    <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}"
                                                   FontSize="14" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <!-- 更新包才有的一行说明：这条是应用更新、装在哪一步走 -->
                                        <TextBlock Text="{x:Bind Note}" FontSize="12" Opacity="0.65"
                                                   TextWrapping="Wrap"
                                                   Visibility="{x:Bind NoteVisibility}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <Button Content="取消" Tag="{x:Bind}" Click="Cancel_Click"
                                                Visibility="{x:Bind RunningVisibility, Mode=OneWay}" />
                                        <!-- 普通下载下完后的那一步：安装包写「安装」、压缩包写「解压」（文案由类型决定）。
                                             和更新包的「安装」互斥出现，所以同屏不会有两颗强调按钮。 -->
                                        <Button Content="{x:Bind ActionText, Mode=OneWay}" Tag="{x:Bind}"
                                                Click="PackageAction_Click"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Visibility="{x:Bind ActionVisibility, Mode=OneWay}" />
                                        <!-- 解压过之后顶替「解压」的那颗：产物已经在硬盘上了，下一步就是去拿。
                                             和「打开文件夹」不同 —— 那颗定位的是压缩包本身，解压后就不需要了。 -->
                                        <Button Content="打开解压后的文件夹" Tag="{x:Bind}"
                                                Click="OpenExtracted_Click"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Visibility="{x:Bind ExtractFolderVisibility, Mode=OneWay}" />
                                        <!-- 更新包下完 → 唯一正解是走这条「安装」：应用先退、安装程序后起。
                                             ⛔ 不给「打开」（双击安装包会被单实例 Mutex 拦成静默失败）。 -->
                                        <Button Content="安装" Tag="{x:Bind}" Click="Install_Click"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Visibility="{x:Bind InstallVisibility, Mode=OneWay}" />
                                        <Button Content="重试" Tag="{x:Bind}" Click="Retry_Click"
                                                Visibility="{x:Bind RetryVisibility, Mode=OneWay}" />
                                        <Button Content="打开" Tag="{x:Bind}" Click="Open_Click"
                                                Visibility="{x:Bind OpenVisibility, Mode=OneWay}" />
                                        <Button Content="打开文件夹" Tag="{x:Bind}" Click="Reveal_Click"
                                                Visibility="{x:Bind RevealVisibility, Mode=OneWay}" />
                                        <!-- 行尾「⋯」：从列表移除 / 删除文件。
                                             ⚠️ 2026-10-16 起改成菜单 —— 以前这里只有"从列表移除"，
                                                文件留在硬盘上，用户想删得自己摸到下载文件夹里找
                                                （Nick：「删除已下载安装程序（即使未安装）」）。 -->
                                        <Button Tag="{x:Bind}" Click="More_Click" Padding="9,5"
                                                AutomationProperties.Name="更多操作"
                                                ToolTipService.ToolTip="更多操作"
                                                Visibility="{x:Bind RemoveVisibility, Mode=OneWay}">
                                            <FontIcon Glyph="&#xE712;" FontSize="12" />
                                        </Button>
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Spacing="6">
                                        <ProgressBar Minimum="0" Maximum="100"
                                                     Value="{x:Bind BarValue, Mode=OneWay}"
                                                     IsIndeterminate="{x:Bind BarIndeterminate, Mode=OneWay}"
                                                     Visibility="{x:Bind BarVisibility, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind StatusText, Mode=OneWay}" FontSize="12" Opacity="0.7"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!-- 解压中 / 解压完：
                                         解压时上面那条下载进度条会收起来（它已经停在 100%），只留这条不确定进度条。
                                         解压没有可靠的百分比可报（系统 bsdtar 不给），所以不给数字。 -->
                                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Spacing="6"
                                                Visibility="{x:Bind WorkTextVisibility, Mode=OneWay}">
                                        <ProgressBar Minimum="0" Maximum="100" IsIndeterminate="True"
                                                     Visibility="{x:Bind WorkingVisibility, Mode=OneWay}" />
                                        <TextBlock Text="{x:Bind WorkText, Mode=OneWay}" FontSize="12" Opacity="0.7"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 空状态：一条任务都没有的时候。
                     ⛔ 不再写 MinHeight 硬撑居中 —— 那是在 Row1 还是 Auto 时的权宜之计
                        （撑出一个假高度，让按钮行往下掉一截）。现在 Row1 是 `*`，
                        这块竖直居中在"标题与按钮行之间"就是自然的，加 MinHeight 反而会在
                        窗口很矮时把内容顶出滚动区。 -->
                <StackPanel x:Name="EmptyPanel" Grid.Row="1" Spacing="12" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE896;" FontSize="28" Opacity="0.45" HorizontalAlignment="Center" />
                    <TextBlock Text="当前无下载任务" FontSize="14" FontWeight="SemiBold" Opacity="0.75"
                               HorizontalAlignment="Center" />
                    <TextBlock MaxWidth="440" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Opacity="0.6"
                               Text="在「软件下载」中打开任意软件并开始下载，任务将显示在此处。软件更新选择「后台下载」时同样显示于此。下载完成的安装包可在此直接安装，压缩包可在此解压。下载期间可继续使用其他功能，左侧入口显示进行中的任务数。" />
                </StackPanel>

                <!-- 底部：左边是页面级操作，右边是「完成后自动删除」开关。
                     开关放在这一行而不是藏进设置页 —— 它跟这一页的行为绑得死死的，
                     用户在这儿下完东西，想的就是在哪儿能顺手改它。 -->
                <Grid Grid.Row="2" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button Content="打开下载文件夹" Click="OpenFolder_Click" />
                        <Button x:Name="ClearButton" Content="清除已完成" Click="ClearFinished_Click" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                        <CheckBox x:Name="AutoOpenBox" Content="解压完成后自动打开所在文件夹"
                                  Checked="AutoOpen_Changed" Unchecked="AutoOpen_Changed" />
                        <CheckBox x:Name="AutoDeleteBox" Content="安装或解压完成后自动删除安装包或压缩包"
                                  Checked="AutoDelete_Changed" Unchecked="AutoDelete_Changed" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
