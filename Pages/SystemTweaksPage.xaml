<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.SystemTweaksPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:ClassSoftwareHub.Desktop.Controls">

    <!--
      系统优化（需求清单第 20 条，2026-10-31；对齐 Dism++「系统优化」的能力）。
      口径：这些项的真实落点就在当前用户（HKCU），改完即时生效、**不需要管理员**；
      「新用户」那一列不做（学校不常建账户）；安全 / 服务 / 更新策略那几类不抄。
      ⛔ 只有真正机器级的项（休眠、快速启动、分页文件）才需要提权，走另一个页面（系统功能）。

      骨架**逐字照抄** Pages/AutoShutdownPage.xaml：ScrollViewer > Grid Margin 24,36,24,44 > 三列 > StackPanel MaxWidth 960。
      每一行也逐字照抄它那张「自动执行」卡的写法（SettingsCard + 说明用 TextBlock + ToggleSwitch MinWidth=0）。
      ⛔ 不改骨架、不换容器、不套模板 —— Nick 2026-10-31：「能抄就抄，能看就看，别猜」。
    -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,36,24,44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="RowsPanel" Grid.Column="1" MaxWidth="960" Spacing="4">

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="系统优化" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />

                        <!--
                            Hub AI 入口（2026-10-31，与「软件下载」「AppData 管理」「应用卸载」一致）：
                            这一项到底改了哪个注册表值、对教学有没有影响，问一句比翻说明快。
                            浮层是公共控件 Controls/HubAiFlyout，别在这一页另写一套。
                        -->
                        <Button x:Name="HubAiEntry" Grid.Column="1" Padding="12,6" Click="HubAiEntry_Click"
                                VerticalAlignment="Center" ToolTipService.ToolTip="打开 Hub AI 顾问">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8F2;" FontSize="13" />
                                <TextBlock Text="AI" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!--
                        InfoBar 平时不占位：IsOpen=False 之外还要收 Visibility，
                        否则它那 8px 外边距会在页头与第一组之间再撑一道空档（2026-10-31 截图里那段空白）。
                    -->
                    <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="True" Visibility="Collapsed"
                             Severity="Informational" Message="" Margin="0,0,0,8"
                             Closed="NoticeBar_Closed" />

                    <!--
                        待应用入口：**只有「有改动、且底部提示被用户收起来」时**才出现。
                        2026-10-31 按 Nick 要求：原来顶部那条常驻的应用横幅整条删掉，应用只从底部提示里发起，
                        页面平时保持干净；提示被点掉后，这个小按钮就是回到提示的入口。
                    -->
                    <Button x:Name="PendingButton" Visibility="Collapsed" Click="PendingButton_Click"
                            Margin="0,0,0,10" HorizontalAlignment="Left" />

                    <TextBlock Text="任务栏与开始菜单" FontSize="14" Margin="0,6,0,2" />
                    <controls:SettingsCard Header="任务栏图标靠左对齐">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="恢复 Windows 10 的左侧对齐。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_taskbar_align_left" Tag="taskbar-align-left" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="任务栏搜索框">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="隐藏或只留图标可腾出位置。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ComboBox x:Name="Cmb_taskbar_hide_search" Tag="taskbar-hide-search" MinWidth="180"
                                  SelectionChanged="Row_SelectionChanged" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="隐藏任务视图按钮">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="隐藏后仍可用 Win+Tab 调出。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_taskbar_hide_taskview" Tag="taskbar-hide-taskview" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="隐藏小组件按钮">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="关闭后不再推送天气与资讯。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_taskbar_hide_widgets" Tag="taskbar-hide-widgets" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="任务栏按钮合并方式">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="每个窗口单独占位，窗口多时较拥挤。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ComboBox x:Name="Cmb_taskbar_merge_never" Tag="taskbar-merge-never" MinWidth="180"
                                  SelectionChanged="Row_SelectionChanged" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="任务栏时钟显示秒">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="会增加少量重绘开销。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_taskbar_clock_seconds" Tag="taskbar-clock-seconds" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="关闭通知中心">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="所有程序的通知都不再弹出。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_start_no_notification_center" Tag="start-no-notification-center" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>


                    <controls:SettingsCard Header="始终显示所有托盘图标">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="图标全部平铺，不再收进「^」。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_taskbar_all_tray_icons" Tag="taskbar-all-tray-icons" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="任务栏使用小图标">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="多放几个窗口。仅 Windows 10 有效。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_taskbar_small_icons" Tag="taskbar-small-icons" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="隐藏任务栏上的人脉按钮">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="仅 Windows 10 有效。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_taskbar_hide_people" Tag="taskbar-hide-people" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>

                    <TextBlock Text="推荐内容与建议" FontSize="14" Margin="0,18,0,2" />
                    <controls:SettingsCard Header="开始菜单不显示推荐建议">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="仅保留自己固定的程序。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_start_no_suggestions" Tag="start-no-suggestions" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="关闭商店应用推广">
                        <ToggleSwitch x:Name="Sw_start_no_recommended_apps" Tag="start-no-recommended-apps" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="禁止自动安装推荐的应用">
                        <ToggleSwitch x:Name="Sw_start_no_silent_install" Tag="start-no-silent-install" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="关闭锁屏的聚焦推广">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="锁屏固定为所选图片，不推送壁纸。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_lockscreen_no_spotlight" Tag="lockscreen-no-spotlight" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="关闭使用技巧与建议提示">
                        <ToggleSwitch x:Name="Sw_windows_no_tips" Tag="windows-no-tips" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="关闭新安装程序的突出显示">
                        <ToggleSwitch x:Name="Sw_start_no_new_app_highlight" Tag="start-no-new-app-highlight" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <TextBlock Text="资源管理器" FontSize="14" Margin="0,18,0,2" />
                    <controls:SettingsCard Header="显示文件扩展名">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="便于识别伪装文件。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_explorer_show_ext" Tag="explorer-show-ext" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="显示隐藏文件">
                        <ToggleSwitch x:Name="Sw_explorer_show_hidden" Tag="explorer-show-hidden" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="显示受保护的系统文件">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="含系统属性文件，误删会影响系统。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_explorer_show_superhidden" Tag="explorer-show-superhidden" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="打开资源管理器时显示">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="选「此电脑」即打开磁盘列表。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ComboBox x:Name="Cmb_explorer_launch_thispc" Tag="explorer-launch-thispc" MinWidth="180"
                                  SelectionChanged="Row_SelectionChanged" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="导航窗格展开到当前文件夹">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="打开深层目录时自动定位。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_explorer_nav_expand" Tag="explorer-nav-expand" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="不使用缩略图缓存">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="图片多的目录打开会变慢。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_explorer_no_thumb_cache" Tag="explorer-no-thumb-cache" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="标题栏显示完整路径">
                        <ToggleSwitch x:Name="Sw_explorer_full_path" Tag="explorer-full-path" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>


                    <controls:SettingsCard Header="禁止自动播放">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="插入 U 盘、光盘后不自动运行。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_explorer_no_autoplay" Tag="explorer-no-autoplay" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="每个文件夹窗口独立进程">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="单个窗口卡死不影响其它窗口。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_explorer_separate_process" Tag="explorer-separate-process" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="快速访问不显示常用文件夹">
                        <ToggleSwitch x:Name="Sw_explorer_quickaccess_no_frequent" Tag="explorer-quickaccess-no-frequent" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="快速访问不显示最近文件">
                        <ToggleSwitch x:Name="Sw_explorer_quickaccess_no_recent" Tag="explorer-quickaccess-no-recent" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="资源管理器常显菜单栏">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="不用每次按 Alt 调出。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_explorer_always_menu_bar" Tag="explorer-always-menu-bar" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>

                    <TextBlock Text="桌面图标" FontSize="14" Margin="0,18,0,2" />
                    <controls:SettingsCard Header="桌面显示「此电脑」">
                        <ToggleSwitch x:Name="Sw_desktop_show_thispc" Tag="desktop-show-thispc" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="桌面显示「回收站」">
                        <ToggleSwitch x:Name="Sw_desktop_show_recyclebin" Tag="desktop-show-recyclebin" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <TextBlock Text="外观与动画" FontSize="14" Margin="0,18,0,2" />
                    <controls:SettingsCard Header="应用使用深色模式">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="只影响本应用，不改系统设置。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_visual_apps_dark" Tag="visual-apps-dark" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="系统界面使用深色模式">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="任务栏与开始菜单使用深色。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_visual_system_dark" Tag="visual-system-dark" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="关闭透明效果">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="老机器可减少合成开销。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_visual_transparency" Tag="visual-transparency" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>


                    <controls:SettingsCard Header="强调色显示到任务栏与开始菜单">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="任务栏不再固定为深灰。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_visual_accent_on_taskbar" Tag="visual-accent-on-taskbar" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <TextBlock Text="输入法与记事本" FontSize="14" Margin="0,18,0,2" />
                    <controls:SettingsCard Header="关闭拼音输入法的云候选">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="候选词只取本地词库，不联网。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_ime_no_cloud" Tag="ime-no-cloud" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>


                    <controls:SettingsCard Header="拼音输入法默认英文">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="避免中文输入法抢先上屏。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_ime_default_english" Tag="ime-default-english" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="开启拼音模糊音">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="不区分平翘舌与前后鼻音。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_ime_fuzzy" Tag="ime-fuzzy" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="记事本自动换行">
                        <ToggleSwitch x:Name="Sw_notepad_wrap" Tag="notepad-wrap" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="记事本显示状态栏">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="显示行列号与字符数。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="Sw_notepad_statusbar" Tag="notepad-statusbar" MinWidth="0"
                                      OnContent="开" OffContent="关" Toggled="Row_Toggled" />
                    </controls:SettingsCard>

                </StackPanel>
            </Grid>
        </ScrollViewer>
        <!--
            应用提示：非目标式 TeachingTip，固定在窗口右下角浮出。
            ⚠️ 必须挂在 ScrollViewer **外面**（页面根 Grid 的第二个子元素），否则会随内容一起滚走，
               用户拨完开关还得滚回顶部才看得到它 —— 那就等于没解决。
        -->
        <TeachingTip x:Name="ApplyTip"
                     PreferredPlacement="BottomRight"
                     IsLightDismissEnabled="False"
                     MinWidth="320"
                     ActionButtonContent="应用更改"
                     CloseButtonContent="暂不应用"
                     ActionButtonClick="ApplyTip_ActionClick"
                     CloseButtonClick="ApplyTip_CloseClick"
                     Closed="ApplyTip_Closed">
            <TeachingTip.Content>
                <!--
                    任务列表：列出这次要写进去的每一项，可逐项取消。
                    ⚠️ 用 ItemsControl + 代码里逐项构造（跟本页下拉框选项一个套路）：
                       ⛔ 不用 ItemsRepeater / ListView + 模板 —— 这套组合在这份 XamlCompiler 上出过事
                       （2026-10-30 把 ItemsRepeater 塞进 SettingsExpander.Items，一进页面进程就被杀）。

                    ⛔ 这里**不许写宽度**（2026-10-31 连错两次）：
                       写大了（比如 Width=340）会超出 TeachingTip 的内容区，行里的「取消」被裁得只剩一条边；
                       写 ItemsControl.MinWidth 也一样。
                    正确做法是让 ScrollViewer 吃满内容区：不设 Width，只把水平滚动关掉
                       （Disabled 才会把 viewport 宽度传给子项；否则子项拿到的是"无限宽"，TextBlock 不换行）。
                       这样行内 * 列能算出真实可用宽度，文本自己换行，按钮永远留在里面。
                -->
                <!--
                    外边距是给"内容"与"副标题 / 底部按钮"之间留气口用的：
                    2026-10-31 第一版没留，清单贴着副标题、又贴着按钮，看着很挤。
                -->
                <ScrollViewer MaxHeight="260" Margin="0,8,0,14"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PendingList" />
                </ScrollViewer>
            </TeachingTip.Content>
        </TeachingTip>

        <!-- 提问浮层：与其它页面同一个控件，显示与否跟着「设置 → 启用 Hub AI」总闸走 -->
        <ui:HubAiFlyout x:Name="AiFlyout" />
    </Grid>
</Page>
