<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.SystemTweaksPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:local="using:ClassSoftwareHub.Desktop.Pages">

    <!--
      系统优化（需求清单第 20 条，2026-10-31；对齐 Dism++「系统优化」的能力）。
      口径：只做系统级（HKLM）、不做「新用户」那一列、不抄安全 / 服务 / 更新策略那几类。

      ⛔ 不逐项弹 UAC：切换只排队，点「应用更改」时整批写成一份 .reg 一次提权导入。

      ⛔ 骨架照 Pages/AutoShutdownPage.xaml；每行是 controls:SettingsCard（行模板声明在 Resources 里）；
         列表用 ItemsControl 而不是 ListView —— 外面已经有 ScrollViewer，嵌套两个滚动区会抢滚轮。
    -->
    <Page.Resources>
        <DataTemplate x:Key="TweakRowTemplate" x:DataType="local:TweakRow">
            <controls:SettingsCard Header="{x:Bind Header}" Description="{x:Bind Description}"
                                   HorizontalAlignment="Stretch">
                <ToggleSwitch MinWidth="0" OnContent="开" OffContent="关"
                              IsOn="{x:Bind IsOn, Mode=OneWay}"
                              Toggled="Row_Toggled"
                              Tag="{x:Bind Def.Id}" />
            </controls:SettingsCard>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,36,24,44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" MaxWidth="900" HorizontalAlignment="Left" Spacing="4">

                <StackPanel Spacing="6" Margin="0,0,0,16">
                    <TextBlock Text="系统优化" FontSize="28" FontWeight="Bold" />
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="修改的是整台机器的系统设置，所有账户都会受影响。切换开关只是选中，点「应用更改」时统一请求一次管理员授权；标注需重启资源管理器的项，改完点右侧按钮即可看到效果。" />
                </StackPanel>

                <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="True"
                         Severity="Informational" Message="" Margin="0,0,0,8" />

                <!-- 待应用条：只在有改动时出现 -->
                <Border x:Name="PendingBar" Visibility="Collapsed" Margin="0,0,0,10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="16,10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="PendingText" VerticalAlignment="Center" FontSize="13" />

                        <Button Grid.Column="1" Content="应用更改" Click="Apply_Click" />
                        <Button Grid.Column="2" x:Name="RestartButton" Content="重启资源管理器"
                                Click="RestartExplorer_Click" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <TextBlock Text="任务栏与开始菜单" FontSize="14" Margin="0,8,0,2" />
                <ItemsControl x:Name="TaskbarRows" ItemTemplate="{StaticResource TweakRowTemplate}" />

                <TextBlock Text="资源管理器" FontSize="14" Margin="0,18,0,2" />
                <ItemsControl x:Name="ExplorerRows" ItemTemplate="{StaticResource TweakRowTemplate}" />

                <TextBlock Text="外观与动画" FontSize="14" Margin="0,18,0,2" />
                <ItemsControl x:Name="VisualRows" ItemTemplate="{StaticResource TweakRowTemplate}" />

                <TextBlock Text="输入法" FontSize="14" Margin="0,18,0,2" />
                <ItemsControl x:Name="InputRows" ItemTemplate="{StaticResource TweakRowTemplate}" />

                <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,18,0,0"
                           Text="未收录的项：安全相关（UAC、SmartScreen、Defender）、系统服务（搜索索引、打印后台等）、Windows 更新策略。这些一旦改错，用户只会看到「打印机打不了」「找不到文件」，很难联想到是优化工具改的，因此不提供。" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
