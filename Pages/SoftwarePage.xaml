<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.SoftwarePage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:ClassSoftwareHub.Desktop.Data">

    <!-- 卡片容器样式（关掉 GridViewItem 自带的焦点框/悬停底色）在 App.xaml 里：CshCardItemStyle -->

    <!--
      和首页 / 设置页同一套版式：三列 Grid 把内容钉在中间 960 宽（导航展开收起都不动）。
      ⚠️ 别用 Stretch + MaxWidth：一旦触发上限 WinUI 会把整列右甩。
    -->
    <!-- ⚠️ Background="Transparent" 是给滚轮接力用的（见 Core/WheelRelay.cs）：不画任何像素，
         但要让两侧留白参与命中测试 —— 否则鼠标停在留白上滚，列表纹丝不动（与首页手感不一致）。 -->
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>

        <!-- 2026-10-02：间距从根 Grid.Padding 挪到这里（Margin）。Padding 在最外层会把高度约束
             传坏 —— 实测 GridView 视口只剩 454 DIP、Extent=视口（VScrollable=False），
             内容一超出就"底部截断且滚不动"。设置页（ScrollViewer 挂最外 + 内部 Margin）无此问题。

             ⛔⛔ 2026-10-03：中间列底部间距分两种写法（别一刀切）。
                 本页最后一行是**自滚容器**（GridView，`*` 高度、自带 Padding="0,2,0,44"）
                 ⇒ 底部写 0，留白交给滚动内容自己。写 44 会把视口整体上提、GridView 又要
                 自己再加一遍 44 —— 同一份留白算两遍，视口够不到窗口底边，底下空出一条
                 页面底色带（Nick：「整个页面高度没用完，有个框给框起来了」）。
                 反例：末行若是页脚 / 卡片等非自滚元素，必须写 44，否则怼到窗口下边框。 -->
        <Grid Grid.Column="1" MaxWidth="960" RowSpacing="14" Margin="0,36,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Text="软件下载" FontSize="30" FontWeight="Bold" />

            <!--
              工具条（2026-10-18 重排）：**分类 · 视图 · AI 一行解决**。
              ⚠️ 原来这里是「一整张 AI 大卡 + 单选按钮组 + 一条横向滚动 chip 列表」，
                 三层各占一行，Nick 说"太混乱"。现在：
                 · 分类换成系统 SelectorBar（自带下划线指示器与键盘导航，比自绘 ToggleButton 规矩）
                 · 视图切换收进下拉（两个选项不值得占一整行）
                 · AI 缩成右侧一个小按钮，点开仍是右下浮层
            -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <SelectorBar x:Name="CategoryBar" Grid.Column="0" HorizontalAlignment="Left"
                             SelectionChanged="CategoryBar_SelectionChanged" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <ComboBox x:Name="ViewPicker" MinWidth="112"
                              SelectionChanged="ViewPicker_SelectionChanged">
                        <ComboBoxItem Content="磁贴视图" Tag="tile" />
                        <ComboBoxItem Content="网格视图" Tag="grid" />
                    </ComboBox>

                    <Button x:Name="HubAiEntry" Padding="12,6" Click="HubAiEntry_Click"
                            ToolTipService.ToolTip="打开 Hub AI 顾问">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8F2;" FontSize="13" />
                            <TextBlock Text="AI" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <!-- ===== 磁贴视图（3 列 = 302 + 16 间距，正好 960；带简介） ===== -->
                <GridView x:Name="TileGrid" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="AppGrid_ItemClick" Padding="0,2,0,44"
                          ItemContainerStyle="{StaticResource CshCardItemStyle}">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="data:SoftwareApp">
                            <Border Style="{StaticResource CshCardStyle}" Width="302" Height="120" Padding="16,14" Margin="0,0,16,14"
                                    PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                                <Grid RowSpacing="8" ColumnSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 图标统一成 1:1 正方形：ImageBrush + UniformToFill + AlignmentX/Y=Center
                                         ＝ 等比放大填满正方形，多出来的边从**正中间**裁掉（不是左上角） -->
                                    <Border Width="44" Height="44" CornerRadius="9" VerticalAlignment="Top"
                                            HorizontalAlignment="Left">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Bind IconImage, Mode=OneWay}" Stretch="UniformToFill"
                                                        AlignmentX="Center" AlignmentY="Center" />
                                        </Border.Background>
                                        <Grid>
                                            <!-- 占位字形先兜底；图标加载成功才收掉（加载中/失败/没图都显示） -->
                                            <FontIcon Glyph="&#xE7B8;" FontSize="20" Opacity="0.35"
                                                      Visibility="{x:Bind IconPlaceholder, Mode=OneWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Top">
                                        <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="Bold"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Tagline}" FontSize="12" Opacity="0.75"
                                                   MaxLines="2" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind MetaText}"
                                               FontSize="11.5" Opacity="0.7" MaxLines="1"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" />
                                    <FontIcon Grid.Row="1" Grid.Column="2" Glyph="&#xE8A7;" FontSize="13"
                                              Opacity="0.45" VerticalAlignment="Bottom" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- ===== 网格视图（5 列 = 174 + 16 间距，正好 960；紧凑） ===== -->
                <GridView x:Name="CompactGrid" Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="AppGrid_ItemClick" Padding="0,2,0,44"
                          ItemContainerStyle="{StaticResource CshCardItemStyle}">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="data:SoftwareApp">
                            <Border Style="{StaticResource CshCardStyle}" Width="174" Height="112" Padding="12,10" Margin="0,0,16,14"
                                    PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                                <Grid RowSpacing="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Left"
                                            VerticalAlignment="Top">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Bind IconImage, Mode=OneWay}" Stretch="UniformToFill"
                                                        AlignmentX="Center" AlignmentY="Center" />
                                        </Border.Background>
                                        <Grid>
                                            <FontIcon Glyph="&#xE7B8;" FontSize="16" Opacity="0.35"
                                                      Visibility="{x:Bind IconPlaceholder, Mode=OneWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontSize="13.5" FontWeight="Bold"
                                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="2" Text="{x:Bind Tagline}" FontSize="11.5" Opacity="0.75"
                                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="3" Text="{x:Bind CompactMeta}" FontSize="11" Opacity="0.7"
                                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- 空状态：把「为什么没有」和「怎么办」说清楚（正在联网取 / 没取到 / 搜索没命中） -->
                <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" Spacing="10" MaxWidth="520"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE946;" FontSize="30" Opacity="0.45" />
                    <TextBlock x:Name="EmptyTitle" Text="软件清单为空" FontSize="17" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText" FontSize="12.5" Opacity="0.75" TextWrapping="Wrap"
                               TextAlignment="Center"
                               Text="软件清单不随安装包提供，需要联网获取。" />
                    <TextBlock x:Name="EmptyDetail" FontSize="11.5" Opacity="0.55" TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <Button x:Name="EmptyRetry" Content="重新获取清单" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Center" Click="EmptyRetry_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ════════════ Hub AI 浮层（2026-10-18）════════════
             贴右下角浮在内容之上，不挤压列表（Nick 选的 Copilot 叠加形态）。
             放在最外层 Grid 的最后一格 = 天然盖住三列内容；盖不到左侧导航栏 ——
             导航在 NavigationView 的 Pane 里，不在这棵树，所以它永远压不过来。
             ⚠️ 宽 380 ≈ 960 内容区的 40%：再宽列表就看不出东西，再窄推荐的软件会挤成一行字。
             ⚠️ 内容目前全是假消息，只为看形态；接模型是下一步（AiClient 还没写）。 -->
        <!--
          浮窗（2026-10-18 调整）：
          ⚠️ 高度改成**固定 420**，原来只有 MaxHeight + 按内容自适应，实际展开时矮得像条提示，
             根本不像一个能对话的窗口（Nick：「太低的不那么让人注意到」）。
          动画见 ShowHubAiPanel：从下往上滑 24px + 淡入，收起时反向。
        -->
        <Border x:Name="HubAiPanel" Grid.ColumnSpan="3"
                Width="380" Height="420"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,20,20" Visibility="Collapsed"
                CornerRadius="14" BorderThickness="1"
                RenderTransformOrigin="0.5,1"
                Background="{ThemeResource HubAiPanelBackground}"
                BorderBrush="{ThemeResource HubAiPanelBorder}">
            <Border.RenderTransform>
                <TranslateTransform x:Name="HubAiPanelTransform" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Padding="16,12,8,10" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="7"
                            Background="{ThemeResource HubAiIconBackground}">
                        <FontIcon Glyph="&#xE8F2;" FontSize="13"
                                  Foreground="{ThemeResource HubAiIconForeground}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="0">
                        <TextBlock Text="Hub AI" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource HubAiTitleForeground}" />
                        <TextBlock Text="电脑顾问" FontSize="11"
                                   Foreground="{ThemeResource HubAiSubForeground}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                        <Button Padding="7" Background="Transparent" BorderThickness="0"
                                Click="HubAiExpand_Click" ToolTipService.ToolTip="在页面中打开">
                            <FontIcon Glyph="&#xE8A7;" FontSize="12" />
                        </Button>
                        <Button Padding="7" Background="Transparent" BorderThickness="0"
                                Click="HubAiClose_Click" ToolTipService.ToolTip="收起">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" Padding="16,0,16,6" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="HubAiMessages" Spacing="10">
                        <!--
                          浮层**不做对话**（2026-10-18 改）：它只是个"提问入口"。
                          理由：完整页那边有历史、工具调用、推荐卡片、用量统计，
                          在这里重做一套只会两套逻辑各说各话（之前这里挂着假消息，用户以为坏了）。
                          发送后把问题交给 HubAiPage，浮层收起。
                        -->
                        <Border Background="{ThemeResource HubAiBubbleBackground}" CornerRadius="10"
                                Padding="14,11">
                            <StackPanel Spacing="6">
                                <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="20"
                                           Text="描述你的需求，按回车后会在 Hub AI 页面继续。" />
                                <TextBlock FontSize="11" Opacity="0.55" TextWrapping="Wrap"
                                           Text="那里会读取本机硬件与存储概况，再给出建议。全程只读。" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Padding="12,6,12,12" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="HubAiInput" PlaceholderText="描述你的需求"
                             KeyDown="HubAiInput_KeyDown" />
                    <Button Grid.Column="1" Padding="11,6"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="HubAiSend_Click" ToolTipService.ToolTip="发送">
                        <FontIcon Glyph="&#xE724;" FontSize="13" />
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
