<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.SoftwarePage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:ClassSoftwareHub.Desktop.Data">

    <!-- 卡片容器样式（关掉 GridViewItem 自带的焦点框/悬停底色）在 App.xaml 里：CshCardItemStyle -->

    <!--
      和首页 / 设置页同一套版式：三列 Grid 把内容钉在中间 960 宽（导航展开收起都不动）。
      ⚠️ 别用 Stretch + MaxWidth：一旦触发上限 WinUI 会把整列右甩。
    -->
    <Grid Padding="24,36,24,44">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="998*" MaxWidth="960" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Text="软件下载" FontSize="30" FontWeight="Bold" />

            <StackPanel Grid.Row="1" Spacing="10">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="SearchBox" MaxWidth="460" HorizontalAlignment="Left"
                                    PlaceholderText="搜索软件（名称 / 简介 / id）" QueryIcon="Find"
                                    TextChanged="SearchBox_TextChanged" />
                    <!-- 视图切换：磁贴（3 列，带简介）/ 网格（5 列，紧凑） -->
                    <RadioButtons x:Name="ViewChoice" Grid.Column="1" MaxColumns="2" VerticalAlignment="Center"
                                  SelectionChanged="ViewChoice_SelectionChanged">
                        <RadioButton Content="磁贴视图" Tag="tile" />
                        <RadioButton Content="网格视图" Tag="grid" />
                    </RadioButtons>
                </Grid>
                <ScrollViewer HorizontalScrollMode="Auto" VerticalScrollMode="Disabled"
                              HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="Chips" Orientation="Horizontal" Spacing="8" />
                </ScrollViewer>
            </StackPanel>

            <Grid Grid.Row="2">
                <!-- ===== 磁贴视图（3 列 = 302 + 16 间距，正好 960；带简介） ===== -->
                <GridView x:Name="TileGrid" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="AppGrid_ItemClick" Padding="0,2,0,0"
                          ItemContainerStyle="{StaticResource CshCardItemStyle}">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="data:SoftwareApp">
                            <Border Width="302" Height="120" CornerRadius="8" Padding="16,14" Margin="0,0,16,14"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                                <Grid RowSpacing="8" ColumnSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 图标统一成 1:1 正方形：ImageBrush + UniformToFill + AlignmentX/Y=Center
                                         ＝ 等比放大填满正方形，多出来的边从**正中间**裁掉（不是左上角） -->
                                    <Border Width="44" Height="44" CornerRadius="9" VerticalAlignment="Top"
                                            HorizontalAlignment="Left">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Bind IconImage}" Stretch="UniformToFill"
                                                        AlignmentX="Center" AlignmentY="Center" />
                                        </Border.Background>
                                        <Grid>
                                            <!-- 占位字形先兜底；图标加载成功才收掉（加载中/失败/没图都显示） -->
                                            <FontIcon Glyph="&#xE7B8;" FontSize="20" Opacity="0.35"
                                                      Visibility="{x:Bind IconPlaceholder, Mode=OneWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Top">
                                        <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="Bold"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Tagline}" FontSize="12" Opacity="0.75"
                                                   MaxLines="2" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind MetaText}"
                                               FontSize="11.5" Opacity="0.7" MaxLines="1"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" />
                                    <FontIcon Grid.Row="1" Grid.Column="2" Glyph="&#xE8A7;" FontSize="13"
                                              Opacity="0.45" VerticalAlignment="Bottom" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- ===== 网格视图（5 列 = 174 + 16 间距，正好 960；紧凑） ===== -->
                <GridView x:Name="CompactGrid" Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="AppGrid_ItemClick" Padding="0,2,0,0"
                          ItemContainerStyle="{StaticResource CshCardItemStyle}">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="data:SoftwareApp">
                            <Border Width="174" Height="112" CornerRadius="8" Padding="12,10" Margin="0,0,16,14"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                                <Grid RowSpacing="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Left"
                                            VerticalAlignment="Top">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Bind IconImage}" Stretch="UniformToFill"
                                                        AlignmentX="Center" AlignmentY="Center" />
                                        </Border.Background>
                                        <Grid>
                                            <FontIcon Glyph="&#xE7B8;" FontSize="16" Opacity="0.35"
                                                      Visibility="{x:Bind IconPlaceholder, Mode=OneWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontSize="13.5" FontWeight="Bold"
                                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="2" Text="{x:Bind Tagline}" FontSize="11.5" Opacity="0.75"
                                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="3" Text="{x:Bind CompactMeta}" FontSize="11" Opacity="0.7"
                                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- 空状态：把「为什么没有」和「怎么办」说清楚（内容包没同步 / 搜索没命中） -->
                <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" Spacing="10" MaxWidth="520"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE946;" FontSize="30" Opacity="0.45" />
                    <TextBlock x:Name="EmptyTitle" Text="软件清单还是空的" FontSize="17" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText" FontSize="12.5" Opacity="0.75" TextWrapping="Wrap"
                               TextAlignment="Center"
                               Text="清单来自「内容包」：安装包里自带一份，联网后会自动从站点更新。" />
                    <TextBlock x:Name="EmptyDetail" FontSize="11.5" Opacity="0.55" TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <Button x:Name="EmptyRetry" Content="重新同步内容包" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Center" Click="EmptyRetry_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
