<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.SoftwarePage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:ClassSoftwareHub.Desktop.Data"
    xmlns:ui="using:ClassSoftwareHub.Desktop.Controls">

    <!-- 卡片容器样式（关掉 GridViewItem 自带的焦点框/悬停底色）在 App.xaml 里：CshCardItemStyle -->

    <Page.Resources>
        <!-- 2026-10-24：卡片宽度改成自适应之后的容器样式。
             ⚠️ 不能直接改 App.xaml 里的 CshCardItemStyle —— 机器核实页也用它，那边是定宽卡片，
                HorizontalContentAlignment 改成 Stretch 会把它拉变形。所以这里基于它派生一份。 -->
        <Style x:Key="CshCardItemStretchStyle" TargetType="GridViewItem"
               BasedOn="{StaticResource CshCardItemStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <!--
      和首页 / 设置页同一套版式：三列 Grid 把内容钉在中间（导航展开收起都不动）。
      ⚠️ 别用 Stretch + MaxWidth：一旦触发上限 WinUI 会把整列右甩。

      2026-10-24：本页取消 960 宽度上限（Nick 反馈右侧空出一条竖直空白带）。
      原因：960 是固定值，卡片 312×3 正好 960，窗口一宽内容就居中、两侧各甩出
      137 DIP 空白，卡片根本用不到多出来的宽度。
      同日再进一步：卡片宽度改为**按可用宽度自适应**（见 SoftwarePage.FitCards）——
      列数取塞得下的最多列、余量平摊给各列，右侧不再留空白
      （Nick：「右边空的能开蜜雪冰城了」；侧边栏收起时内容区更宽，定宽卡片尤其明显）。
      ⚠️ 仅本页如此：其余页面仍是 960（HubAiPage 早在 2026-10-19 已单独铺满）。
    -->
    <!-- ⚠️ Background="Transparent" 是给滚轮接力用的（见 Core/WheelRelay.cs）：不画任何像素，
         但要让两侧留白参与命中测试 —— 否则鼠标停在留白上滚，列表纹丝不动（与首页手感不一致）。 -->
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>

        <!-- 2026-10-02：间距从根 Grid.Padding 挪到这里（Margin）。Padding 在最外层会把高度约束
             传坏 —— 实测 GridView 视口只剩 454 DIP、Extent=视口（VScrollable=False），
             内容一超出就"底部截断且滚不动"。设置页（ScrollViewer 挂最外 + 内部 Margin）无此问题。

             ⛔⛔ 2026-10-03：中间列底部间距分两种写法（别一刀切）。
                 本页最后一行是**自滚容器**（GridView，`*` 高度、自带 Padding="0,2,0,44"）
                 ⇒ 底部写 0，留白交给滚动内容自己。写 44 会把视口整体上提、GridView 又要
                 自己再加一遍 44 —— 同一份留白算两遍，视口够不到窗口底边，底下空出一条
                 页面底色带（Nick：「整个页面高度没用完，有个框给框起来了」）。
                 反例：末行若是页脚 / 卡片等非自滚元素，必须写 44，否则怼到窗口下边框。 -->
        <Grid Grid.Column="1" RowSpacing="14" Margin="0,36,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TitleText" Text="软件下载" FontSize="30" FontWeight="Bold" />

            <!--
              工具条（2026-10-18 重排）：**分类 · 视图 · AI 一行解决**。
              ⚠️ 原来这里是「一整张 AI 大卡 + 单选按钮组 + 一条横向滚动 chip 列表」，
                 三层各占一行，Nick 说"太混乱"。现在：
                 · 分类换成系统 SelectorBar（自带下划线指示器与键盘导航，比自绘 ToggleButton 规矩）
                 · 视图切换收进下拉（两个选项不值得占一整行）
                 · AI 缩成右侧一个小按钮，点开仍是右下浮层
            -->
            <Grid Grid.Row="1" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <SelectorBar x:Name="CategoryBar" Grid.Column="0" HorizontalAlignment="Left"
                             SelectionChanged="CategoryBar_SelectionChanged" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">
                    <!-- 系统筛选（2026-10-24 对齐网页版 HomePage.vue 的 platform-filter）：
                         与左边分类条是「且」的关系；没有 platforms.json 时整个下拉不出现。 -->
                    <ComboBox x:Name="PlatformPicker" MinWidth="120"
                              ToolTipService.ToolTip="按适用的操作系统筛选"
                              SelectionChanged="PlatformPicker_SelectionChanged" />

                    <ComboBox x:Name="ViewPicker" MinWidth="112"
                              SelectionChanged="ViewPicker_SelectionChanged">
                        <ComboBoxItem Content="磁贴视图" Tag="tile" />
                        <ComboBoxItem Content="网格视图" Tag="grid" />
                    </ComboBox>

                    <!--
                      提交软件（2026-10-30）：导航栏那个入口挪到这里 ——
                      软件生态已够丰富，不必再占一个一级导航位；这里离「想要什么软件」最近。
                    -->
                    <Button x:Name="SubmitEntry" Padding="12,6" Click="SubmitEntry_Click"
                            ToolTipService.ToolTip="把自己手上的软件推荐给更多同学">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE898;" FontSize="13" />
                            <TextBlock Text="提交软件" FontSize="12.5" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="HubAiEntry" Padding="12,6" Click="HubAiEntry_Click"
                            ToolTipService.ToolTip="打开 Hub AI 顾问">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8F2;" FontSize="13" />
                            <TextBlock Text="AI" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
                <!-- ===== 磁贴视图（带简介）：卡片宽由 code-behind 按可用宽度算，一行尽量铺满 ===== -->
                <GridView x:Name="TileGrid" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="AppGrid_ItemClick" Padding="0,2,0,44"
                          ItemContainerStyle="{StaticResource CshCardItemStretchStyle}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- 初值只是"第一帧别抖"，真正的宽度由 FitCards() 在 Loaded / SizeChanged 时算 -->
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="308" ItemHeight="134" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="data:SoftwareApp">
                            <Border Style="{StaticResource CshNavCardStyle}" Height="126" Padding="16,12" Margin="0,0,8,8"
                                    PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                                <Grid RowSpacing="8" ColumnSpacing="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 图标统一成 1:1 正方形：ImageBrush + UniformToFill + AlignmentX/Y=Center
                                         ＝ 等比放大填满正方形，多出来的边从**正中间**裁掉（不是左上角） -->
                                    <Border Width="48" Height="48" CornerRadius="10" VerticalAlignment="Top"
                                            HorizontalAlignment="Left">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Bind IconImage, Mode=OneWay}" Stretch="UniformToFill"
                                                        AlignmentX="Center" AlignmentY="Center" />
                                        </Border.Background>
                                        <Grid>
                                            <!-- 占位字形先兜底；图标加载成功才收掉（加载中/失败/没图都显示） -->
                                            <FontIcon Glyph="&#xE7B8;" FontSize="20" Opacity="0.35"
                                                      Visibility="{x:Bind IconPlaceholder, Mode=OneWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Top">
                                        <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="SemiBold"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Tagline}" FontSize="12" Opacity="0.75"
                                                   MaxLines="2" TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind MetaText}"
                                               FontSize="11.5" Opacity="0.7" MaxLines="1"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" />
                                    <FontIcon Grid.Row="1" Grid.Column="2" Glyph="&#xE8A7;" FontSize="13"
                                              Opacity="0.45" VerticalAlignment="Bottom" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- ===== 网格视图（紧凑）：同样自适应宽度，卡片比磁贴窄 ===== -->
                <GridView x:Name="CompactGrid" Visibility="Collapsed" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="AppGrid_ItemClick" Padding="0,2,0,44"
                          ItemContainerStyle="{StaticResource CshCardItemStretchStyle}">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="192" ItemHeight="122" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="data:SoftwareApp">
                            <!--
                              ⚠️ 2026-10-22 Nick：「把首页那些卡片的样式移植过来」。
                              首页入口卡 = CshNavCardStyle（圆角 8、更宽松的留白），
                              之前这里用的是内容卡 CshCardStyle（圆角 4），看着就是两套东西。
                              ⚠️ 内联 Padding/Height 优先于 Style，所以这里要另写一份适配紧凑卡的值。
                            -->
                            <Border Style="{StaticResource CshNavCardStyle}" Height="114" Padding="14,12" Margin="0,0,8,8"
                                    PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                                <Grid RowSpacing="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="6" HorizontalAlignment="Left"
                                            VerticalAlignment="Top">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Bind IconImage, Mode=OneWay}" Stretch="UniformToFill"
                                                        AlignmentX="Center" AlignmentY="Center" />
                                        </Border.Background>
                                        <Grid>
                                            <FontIcon Glyph="&#xE7B8;" FontSize="16" Opacity="0.35"
                                                      Visibility="{x:Bind IconPlaceholder, Mode=OneWay}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Grid.Row="1" Text="{x:Bind Name}" FontSize="13.5" FontWeight="SemiBold"
                                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="2" Text="{x:Bind Tagline}" FontSize="11.5" Opacity="0.75"
                                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Row="3" Text="{x:Bind CompactMeta}" FontSize="11" Opacity="0.7"
                                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- 空状态：把「为什么没有」和「怎么办」说清楚（正在联网取 / 没取到 / 搜索没命中） -->
                <StackPanel x:Name="EmptyPanel" Visibility="Collapsed" Spacing="10" MaxWidth="520"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE946;" FontSize="30" Opacity="0.45" />
                    <TextBlock x:Name="EmptyTitle" Text="软件清单为空" FontSize="17" FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText" FontSize="12.5" Opacity="0.75" TextWrapping="Wrap"
                               TextAlignment="Center"
                               Text="软件清单不随安装包提供，需要联网获取。" />
                    <TextBlock x:Name="EmptyDetail" FontSize="11.5" Opacity="0.55" TextWrapping="Wrap"
                               TextAlignment="Center" />
                    <Button x:Name="EmptyRetry" Content="重新获取清单" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Center" Click="EmptyRetry_Click" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Hub AI 提问浮层（2026-10-30 抽成公共控件，各页共用一份，见 Controls/HubAiFlyout.xaml） -->
        <ui:HubAiFlyout x:Name="AiFlyout" Grid.ColumnSpan="3" />
    </Grid>
</Page>
