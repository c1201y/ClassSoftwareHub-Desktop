<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.SystemFeaturesPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:services="using:ClassSoftwareHub.Desktop.Services">

    <!--
      系统功能（需求清单第 20 条，2026-10-30 第一版）：
      休眠、快速启动的查看与开关，外加分页文件（第 19 条）的只读体检。

      ⛔⛔ 全原生，别手拼：
        · 骨架照 Pages/AutoShutdownPage.xaml —— ScrollViewer > Grid 三列 24 / * / 24 >
          内容 StackPanel MaxWidth="960"；页头 = 28 号粗体 + 12 号 0.65 说明；
        · 每一行都是 controls:SettingsCard，可折叠区块是 controls:SettingsExpander
          （箭头与展开动画由控件自带，⛔ 别拿字形码自己画）；
        · 列表用 ItemsRepeater + DataTemplate 绑定，⛔ 不在代码里 new StackPanel 拼行、⛔ 不用 Border 手搭"卡片"。
          （2026-10-30 Nick：「不要自己画卡片，WinUI 的那么多控件你不用……拿网页思维写应用」。
            第一版就是拿 Border + StackPanel 拼的，已整体重写。）

      ⛔ 分页文件只读：改它要重建文件 + 重启，误设成 0 会让系统在内存吃紧时直接崩进程。
    -->

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">

            <StackPanel MaxWidth="960" Spacing="4" Margin="24,36,24,44">

                <TextBlock Text="系统功能" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="休眠、快速启动与分页文件的查看与开关。改动系统设置时会请求一次管理员授权，本程序自身不提权。"
                           FontSize="12" Opacity="0.65" TextWrapping="Wrap" Margin="0,0,0,12" />

                <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="True"
                         Severity="Informational" Message="" Margin="0,0,0,8" />

                <controls:SettingsExpander Header="电源与启动"
                                           Description="休眠决定系统能否把内存写入磁盘；快速启动依赖休眠文件，两者共用同一份文件。"
                                           IsExpanded="True">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </controls:SettingsExpander.HeaderIcon>

                    <controls:SettingsExpander.Items>
                        <controls:SettingsCard x:Name="HibernateCard" Header="休眠"
                                               Description="关闭后系统不再写休眠文件，可释放与内存等量的磁盘空间；快速启动会随之失效。">
                            <ToggleSwitch x:Name="HibernateSwitch" MinWidth="0"
                                          OnContent="已开启" OffContent="已关闭"
                                          Toggled="Hibernate_Toggled" />
                        </controls:SettingsCard>

                        <controls:SettingsCard x:Name="FastStartupCard" Header="快速启动"
                                               Description="关机时把系统状态写入休眠文件，下次开机更快；依赖休眠，关闭休眠后本项不会生效。">
                            <ToggleSwitch x:Name="FastStartupSwitch" MinWidth="0"
                                          OnContent="已开启" OffContent="已关闭"
                                          Toggled="FastStartup_Toggled" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="休眠文件"
                                               Description="系统盘根目录下的 hiberfil.sys，关闭休眠后会被删除。">
                            <TextBlock x:Name="HibernateFileText" FontSize="13" Opacity="0.85"
                                       VerticalAlignment="Center" Text="读取中…" />
                        </controls:SettingsCard>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

                <controls:SettingsExpander Header="虚拟内存（仅查看）"
                                           Description="分页文件即虚拟内存。修改其大小或位置需要重建文件并重启，设置不当会使内存吃紧时的程序被强行结束，因此本页只呈现当前配置。"
                                           IsExpanded="True" Margin="0,8,0,0">
                    <controls:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE7F1;" />
                    </controls:SettingsExpander.HeaderIcon>

                    <controls:SettingsExpander.Items>
                        <ItemsRepeater x:Name="PageFileList">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="8" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="services:PageFileEntry">
                                    <controls:SettingsCard Header="{x:Bind ConfigText}"
                                                           Description="{x:Bind OccupancyText}">
                                        <TextBlock Text="{x:Bind SizeText}" FontSize="13" Opacity="0.85"
                                                   VerticalAlignment="Center" />
                                    </controls:SettingsCard>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </controls:SettingsExpander.Items>
                </controls:SettingsExpander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
