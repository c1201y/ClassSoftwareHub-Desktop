<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.SystemFeaturesPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <!--
      系统功能（需求清单第 20 条，2026-10-30）：休眠、快速启动的查看与开关，
      分页文件（第 19 条）的只读体检。

      版式**逐字照抄** Pages/AutoShutdownPage.xaml —— 它自己那段注释已经写明：
      三列 Grid 把内容钉在中间 960 宽，⚠️ 别用 Stretch + MaxWidth（一旦触发上限 WinUI 会把整列右甩）。
      2026-10-30 我第一次就栽在这上面：卡片被推到窗口右边缘、右侧开关整个跑到可视区外。
      卡片只用 controls:SettingsCard 与 CshCardStyle 两种，不手搭。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,36,24,44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" MaxWidth="960" Spacing="4">

                <StackPanel Spacing="6" Margin="0,0,0,20">
                    <TextBlock Text="系统功能" FontSize="28" FontWeight="Bold" />
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="休眠、快速启动与分页文件的查看与开关。改动系统设置时会请求一次管理员授权，本程序自身不提权。" />
                </StackPanel>

                <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="True"
                         Severity="Informational" Message="" Margin="0,0,0,8" />

                <TextBlock Text="电源与启动" FontSize="14" Margin="0,8,0,2" />

                <controls:SettingsCard x:Name="HibernateCard" Header="休眠"
>
                    <controls:SettingsCard.Description>
                        <TextBlock Text="关闭后系统不再写休眠文件，可释放与内存等量的磁盘空间；快速启动会随之失效。" TextWrapping="Wrap" />
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7E8;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="HibernateSwitch" MinWidth="0"
                                  OnContent="已开启" OffContent="已关闭"
                                  Toggled="Hibernate_Toggled" />
                </controls:SettingsCard>

                <controls:SettingsCard Header="快速启动"
>
                    <controls:SettingsCard.Description>
                        <TextBlock Text="关机时把系统状态写入休眠文件，下次开机更快；依赖休眠，关闭休眠后本项不会生效。" TextWrapping="Wrap" />
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE945;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="FastStartupSwitch" MinWidth="0"
                                  OnContent="已开启" OffContent="已关闭"
                                  Toggled="FastStartup_Toggled" />
                </controls:SettingsCard>

                <TextBlock Text="磁盘" FontSize="14" Margin="0,18,0,2" />

                <controls:SettingsCard Header="休眠文件"
>
                    <controls:SettingsCard.Description>
                        <TextBlock Text="系统盘根目录下的 hiberfil.sys，关闭休眠后会被删除。" TextWrapping="Wrap" />
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7C3;" />
                    </controls:SettingsCard.HeaderIcon>
                    <TextBlock x:Name="HibernateFileText" FontSize="13" Opacity="0.85"
                               VerticalAlignment="Center" Text="读取中…" />
                </controls:SettingsCard>

                <controls:SettingsCard x:Name="PageFileCard" Header="分页文件（虚拟内存）">
                    <controls:SettingsCard.Description>
                        <TextBlock x:Name="PageFileDescText" Text="读取中…" TextWrapping="Wrap" />
                    </controls:SettingsCard.Description>
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE7F1;" />
                    </controls:SettingsCard.HeaderIcon>
                    <TextBlock x:Name="PageFileSizeText" FontSize="13" Opacity="0.85"
                               VerticalAlignment="Center" Text="—" />
                </controls:SettingsCard>

                <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,10,0,0"
                           Text="分页文件即虚拟内存。修改其大小或位置需要重建文件并重启，设置不当会使内存吃紧时的程序被强行结束，因此本页只呈现当前配置。" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
