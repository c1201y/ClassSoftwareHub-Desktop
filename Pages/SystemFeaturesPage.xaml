<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.SystemFeaturesPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:ClassSoftwareHub.Desktop.Controls">

    <!--
      系统功能（需求清单第 20 条，2026-10-31 重做）。

      版式**逐字照抄** Pages/AutoShutdownPage.xaml：三列 Grid 把内容钉在中间 960 宽。
      ⚠️ 别用 Stretch + MaxWidth —— 一旦触发上限 WinUI 会把整列右甩，开关跑到可视区外。

      交互与「系统优化」页一致（Nick 2026-10-31 定「排队 + 一次弹 UAC」）：
      拨开关只排队，点右下角提示条的主按钮时把所有改动拼成一个脚本、弹一次授权。
      ⛔ 那套提示条代码目前与 SystemTweaksPage 各一份，第三处出现时再抽公共控件 ——
         现在抽会连带动已经稳的页面，不划算。

      卡片只用 controls:SettingsCard，不手搭 Border。
    -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,36,24,44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>

                <StackPanel x:Name="RowsPanel" Grid.Column="1" MaxWidth="960" Spacing="4">

                    <Grid Margin="0,0,0,16" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="系统功能" FontSize="28" FontWeight="Bold" />
                            <ui:ExperimentalBadge FeatureId="sysfeatures" />
                        </StackPanel>

                        <!-- 提示条被收起后的回入口：两个入口不同时出现 -->
                        <Button x:Name="PendingButton" Grid.Column="1" Visibility="Collapsed"
                                VerticalAlignment="Center" Click="PendingButton_Click" />

                        <Button x:Name="HubAiEntry" Grid.Column="2" Padding="12,6" Click="HubAiEntry_Click"
                                VerticalAlignment="Center" ToolTipService.ToolTip="打开 Hub AI 顾问">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8F2;" FontSize="13" />
                                <TextBlock Text="AI" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <InfoBar x:Name="NoticeBar" IsOpen="False" IsClosable="True" Visibility="Collapsed"
                             Severity="Informational" Message="" Margin="0,0,0,8" />

                    <!-- ═════════ 电源与启动 ═════════ -->
                    <TextBlock Text="电源与启动" FontSize="14" Margin="0,6,0,2" />

                    <controls:SettingsCard Header="休眠">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="关闭可释放与内存等量的磁盘空间。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7E8;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="Sw_hibernate" Tag="hibernate" MinWidth="0"
                                      OnContent="已开启" OffContent="已关闭" Toggled="Row_Toggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="快速启动">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="依赖休眠，关闭休眠后本项失效。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE945;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="Sw_fast_startup" Tag="fast-startup" MinWidth="0"
                                      OnContent="已开启" OffContent="已关闭" Toggled="Row_Toggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="电源计划">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="高性能会提高功耗与发热。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE9D9;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="Cmb_power_plan" Tag="power-plan" MinWidth="150"
                                  SelectionChanged="Row_SelectionChanged" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="关闭显示器">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="无操作后自动关屏。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7F4;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="Cmb_screen_off" Tag="screen-off" MinWidth="150"
                                  SelectionChanged="Row_SelectionChanged" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="自动睡眠">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="无操作后进入睡眠。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE708;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="Cmb_sleep_timeout" Tag="sleep-timeout" MinWidth="150"
                                  SelectionChanged="Row_SelectionChanged" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="电源按钮">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="按下机箱电源键时的行为。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7E8;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="Cmb_power_button" Tag="power-button" MinWidth="150"
                                  SelectionChanged="Row_SelectionChanged" />
                    </controls:SettingsCard>

                    <!-- ═════════ 磁盘与内存 ═════════ -->
                    <TextBlock Text="磁盘与内存" FontSize="14" Margin="0,18,0,2" />

                    <controls:SettingsCard Header="休眠文件">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="关闭休眠后此文件会被删除。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7C3;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:Name="HibernateFileText" FontSize="13" Opacity="0.85"
                                   VerticalAlignment="Center" Text="读取中…" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="内存压缩">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="关掉可省一点 CPU，但换页会变多。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE950;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="Sw_memory_compression" Tag="memory-compression" MinWidth="0"
                                      OnContent="已开启" OffContent="已关闭" Toggled="Row_Toggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="NTFS 长路径">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="解开路径过长导致的解压失败。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8A5;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="Sw_long_paths" Tag="long-paths" MinWidth="0"
                                      OnContent="已开启" OffContent="已关闭" Toggled="Row_Toggled" />
                    </controls:SettingsCard>

                    <!-- ═════════ 故障与恢复 ═════════ -->
                    <TextBlock Text="故障与恢复" FontSize="14" Margin="0,18,0,2" />

                    <controls:SettingsCard Header="崩溃转储">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="转储越大越占系统盘空间。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7BA;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="Cmb_crash_dump" Tag="crash-dump" MinWidth="150"
                                  SelectionChanged="Row_SelectionChanged" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="蓝屏后自动重启">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="关闭后蓝屏会停在错误界面。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE777;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="Sw_auto_reboot" Tag="auto-reboot" MinWidth="0"
                                      OnContent="已开启" OffContent="已关闭" Toggled="Row_Toggled" />
                    </controls:SettingsCard>

                    <!-- ═════════ 隐私与共享 ═════════ -->
                    <TextBlock Text="隐私与共享" FontSize="14" Margin="0,18,0,2" />

                    <controls:SettingsCard Header="Windows 错误报告">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="关闭后崩溃信息不再上报。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE730;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="Sw_error_reporting" Tag="error-reporting" MinWidth="0"
                                      OnContent="已开启" OffContent="已关闭" Toggled="Row_Toggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="客户体验改善计划">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="关闭后不再上传使用情况统计。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE9D2;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="Sw_ceip" Tag="ceip" MinWidth="0"
                                      OnContent="已开启" OffContent="已关闭" Toggled="Row_Toggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="远程桌面">
                        <controls:SettingsCard.Description>
                            <TextBlock Text="教室机建议保持关闭。" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8AF;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="Sw_remote_desktop" Tag="remote-desktop" MinWidth="0"
                                      OnContent="已开启" OffContent="已关闭" Toggled="Row_Toggled" />
                    </controls:SettingsCard>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!--
            应用提示：非目标式 TeachingTip，固定在右下角浮出。
            ⚠️ 必须挂在 ScrollViewer **外面**，否则会随内容一起滚走 —— 这一页 14 张卡，
               用户拨完最下面那张，滚回顶部才能点应用的话就等于没解决。
        -->
        <TeachingTip x:Name="ApplyTip"
                     PreferredPlacement="BottomRight"
                     IsLightDismissEnabled="False"
                     ActionButtonContent="应用更改"
                     CloseButtonContent="暂不应用"
                     ActionButtonClick="ApplyTip_ActionClick"
                     CloseButtonClick="ApplyTip_CloseClick"
                     Closed="ApplyTip_Closed">
            <TeachingTip.Content>
                <!--
                    任务清单：逐项列出这次要写进系统的内容，可单项取消。
                    ⚠️ 用 ItemsControl + 代码里构造（与系统优化页同一套）：⛔ 不用 ItemsRepeater
                       —— 这套组合塞进模板容器时进程会被直接杀掉（2026-10-30 实测）。
                -->
                <ScrollViewer MaxHeight="260"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="PendingList" />
                </ScrollViewer>
            </TeachingTip.Content>
        </TeachingTip>

        <ui:HubAiFlyout x:Name="AiFlyout" />
    </Grid>
</Page>
