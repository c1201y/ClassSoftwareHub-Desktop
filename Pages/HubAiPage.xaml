<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.HubAiPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hub="using:ClassSoftwareHub.Desktop.Services.HubAi">

    <!--
      Hub AI 完整对话页（2026-10-20 整体重做）。

      三栏：**历史 248 / 对话 * / 本机状态 300**，左右两栏都能折叠。
      版式借鉴三份前端参考件里真正立得住的部分：
        · 左栏是"任务列表"的密度（图标、状态、时间），不是裸标题列表；
        · 中间是**无气泡纯文本流**，用户消息才用气泡；
        · 右栏把「本机概况 / 初步判断」这些**状态快照**挪出对话流 ——
          它们不是对话内容，挤在消息里会把第一屏顶得很长（这是主要动机）。

      ⛔ 与「软件下载」页右下那个浮层是同一个内核的两种外壳：浮层只负责把问题送进来
         （见 HubAiPage.PendingQuestion），对话/历史/工具/用量都只在这一页实现。
      ⛔ 主题色一律走 ThemeBrush / ThemeResource，别在代码里查 Application.Current.Resources
         （应用级主题与窗口主题不一致时会刷出反色，这个坑本页踩过三次）。
    -->
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>

        <!-- 2026-10-19 Nick 特批：本页取消 960 宽度限制、直接铺满。⛔ 别扩散到其它页面。 -->
        <Grid Grid.Column="1" Margin="0,28,0,32">
            <Grid.ColumnDefinitions>
                <!-- 左右两栏都可折叠。⚠️ 列宽用 Auto，由面板自身的 Width 决定 ——
                     GridLength 不是 double，没法直接做宽度动画；动画打在面板的 Width 上才有滑入滑出手感。 -->
                <ColumnDefinition x:Name="HistoryCol" Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══════════════ 左：历史对话 ═══════════════ -->
            <Grid x:Name="HistoryPanel" Width="248" Margin="0,0,16,0" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="历史对话" FontSize="12" FontWeight="SemiBold"
                           Foreground="{ThemeResource HubAiSubForeground}" Margin="2,0,0,2" />

                <Button Grid.Row="1" Content="新对话" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center" Click="NewChat_Click" />

                <!-- 原生 ListView：选中/悬停/键盘导航交给系统默认视觉 -->
                <ListView x:Name="SessionList" Grid.Row="2"
                          SelectionMode="Single"
                          SelectionChanged="SessionList_SelectionChanged"
                          RightTapped="SessionList_RightTapped">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="hub:ChatSession">
                            <!-- ⚠️ 右键菜单不要挂在 DataTemplate 元素上：ListViewItem 会吞掉 ContextFlyout。
                                 统一走 ListView 的 RightTapped（见 code-behind）。 -->
                            <StackPanel Spacing="2" Padding="0,6">
                                <TextBlock Text="{x:Bind Title}" FontSize="13"
                                           MaxLines="1" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind DateText}" FontSize="11"
                                           Foreground="{ThemeResource HubAiSubForeground}"
                                           Opacity="0.7" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- ═══════════════ 中：对话 ═══════════════ -->
            <!-- ⚠️ 左右各留 6：两栏都收起时内容会直接贴到窗口边，看着像位置歪了 -->
            <Grid Grid.Column="1" RowSpacing="0" Margin="6,0,6,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 标题行：折叠按钮 / 标题 / 右栏开关 -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="ToggleHistoryBtn" Click="ToggleHistory_Click"
                            Background="Transparent" BorderThickness="0" Padding="7,5"
                            VerticalAlignment="Center"
                            ToolTipService.ToolTip="收起或展开历史对话">
                        <FontIcon Glyph="&#xE700;" FontSize="15" />
                    </Button>

                    <TextBlock Grid.Column="1" Text="Hub AI" FontSize="26" FontWeight="Bold"
                               VerticalAlignment="Center" Margin="8,0,0,0" />

                </Grid>

                <!-- 已配置模型时这条自动收起（见 ApplyEnabledState） -->
                <InfoBar x:Name="NotWiredBar" Grid.Row="1" Severity="Informational"
                         IsOpen="True" IsClosable="False" Margin="0,0,0,10"
                         Title="模型尚未配置"
                         Message="下面这些是本机实时概况，由本地采集，不经过网络。配置模型之后，这里才会出现针对这台电脑的建议。" />

                <!-- 总闸关闭时的替身 -->
                <Border x:Name="DisabledPanel" Grid.Row="1" Visibility="Collapsed"
                        Background="{ThemeResource HubAiCardBackground}"
                        BorderBrush="{ThemeResource HubAiCardBorder}" BorderThickness="1"
                        CornerRadius="12" Padding="24,22" Margin="0,0,0,10">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Hub AI 处于关闭状态" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{ThemeResource HubAiTitleForeground}" />
                        <TextBlock FontSize="13" TextWrapping="Wrap" LineHeight="21"
                                   Foreground="{ThemeResource HubAiSubForeground}"
                                   Text="在设置里启用之后，这里会显示对话与诊断建议。已填过的配置不会因为关闭而丢失。" />
                        <Button Content="去启用" Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Left" Click="GoEnable_Click" />
                    </StackPanel>
                </Border>

                <!-- 消息区：居中 860，铺满时两侧留白也不至于让人要把头转来转去 -->
                <ScrollViewer x:Name="ChatScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <!-- ⛔ 不要在这里写 MaxWidth：StackPanel 一旦比 ScrollViewer 视口宽就会溢出并被裁，
                         里面的 HorizontalAlignment=Center 会按溢出后的宽度居中，整体看起来偏右。 -->
                    <StackPanel x:Name="HubAiMessages" Spacing="22" Padding="0,4,0,16"
                                HorizontalAlignment="Stretch">

                        <!-- 欢迎屏：空对话时露出，发出第一条消息后收起 -->
                        <StackPanel x:Name="WelcomePanel" Spacing="0" Margin="0,48,0,12"
                                    HorizontalAlignment="Center">

                            <Border Width="60" Height="60" CornerRadius="17"
                                    HorizontalAlignment="Center"
                                    Background="{ThemeResource HubAiIconBackground}">
                                <FontIcon Glyph="&#xE8F2;" FontSize="26"
                                          Foreground="{ThemeResource HubAiIconForeground}" />
                            </Border>

                            <TextBlock Text="有什么可以帮你" FontSize="25" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,18,0,8"
                                       Foreground="{ThemeResource HubAiTitleForeground}" />

                            <TextBlock Text="可以直接聊天，也可以结合这台电脑的实际情况回答"
                                       FontSize="13.5" HorizontalAlignment="Center"
                                       Foreground="{ThemeResource HubAiSubForeground}" />
                        </StackPanel>

                        <!--
                          本机状态（2026-10-20 从右栏搬回对话流）：
                          ⚠️ **默认隐藏**，第一次对话之后才出现（Nick：右栏不要了，本机状况等聊过再显示）。
                          ⚠️ 里面用 Padding 而不是 Margin：卡片自身上下留白一致，跟着消息流滚动。
                        -->
                        <StackPanel x:Name="SidePanel" Visibility="Collapsed" Spacing="10" Margin="0,8,0,0">
                            <TextBlock Text="本机状态" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{ThemeResource HubAiSubForeground}" />

                    <TextBlock Text="本机状态" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource HubAiSubForeground}" />

                    <!-- 本机概况：采集层真实输出，不需要模型 -->
                    <Border Background="{ThemeResource HubAiCardBackground}"
                            BorderBrush="{ThemeResource HubAiCardBorder}" BorderThickness="1"
                            CornerRadius="12" Padding="16,14">
                        <StackPanel Spacing="9">
                            <Grid>
                                <TextBlock Text="本机概况" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{ThemeResource HubAiTitleForeground}" />
                                <TextBlock x:Name="SnapshotStatus" HorizontalAlignment="Right"
                                           VerticalAlignment="Center" FontSize="11" Opacity="0.55"
                                           Foreground="{ThemeResource HubAiSubForeground}" />
                            </Grid>

                            <ProgressRing x:Name="SnapshotLoading" IsActive="True" Width="18" Height="18"
                                          HorizontalAlignment="Left" />

                            <Grid x:Name="SnapshotBody" Visibility="Collapsed"
                                  ColumnSpacing="10" RowSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Text="处理器" FontSize="11.5" Opacity="0.55" />
                                <TextBlock x:Name="SnapCpu" Grid.Column="1" FontSize="11.5" FontWeight="SemiBold"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="1" Text="内存" FontSize="11.5" Opacity="0.55" />
                                <TextBlock x:Name="SnapMemory" Grid.Row="1" Grid.Column="1" FontSize="11.5" FontWeight="SemiBold"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="2" Text="系统" FontSize="11.5" Opacity="0.55" />
                                <TextBlock x:Name="SnapOs" Grid.Row="2" Grid.Column="1" FontSize="11.5" FontWeight="SemiBold"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="3" Text="磁盘" FontSize="11.5" Opacity="0.55" />
                                <TextBlock x:Name="SnapDisk" Grid.Row="3" Grid.Column="1" FontSize="11.5" FontWeight="SemiBold"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="4" Text="进程" FontSize="11.5" Opacity="0.55" />
                                <TextBlock x:Name="SnapProcess" Grid.Row="4" Grid.Column="1" FontSize="11.5" FontWeight="SemiBold"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="5" Text="启动项" FontSize="11.5" Opacity="0.55" />
                                <TextBlock x:Name="SnapStartup" Grid.Row="5" Grid.Column="1" FontSize="11.5" FontWeight="SemiBold"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />

                                <TextBlock Grid.Row="6" Text="已装软件" FontSize="11.5" Opacity="0.55" />
                                <TextBlock x:Name="SnapApps" Grid.Row="6" Grid.Column="1" FontSize="11.5" FontWeight="SemiBold"
                                           TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 本地规则结论（MachineDiagnosis）：不经过模型，模型抽风时它仍然是准的 -->
                    <Border Background="{ThemeResource HubAiCardBackground}"
                            BorderBrush="{ThemeResource HubAiCardBorder}" BorderThickness="1"
                            CornerRadius="12" Padding="16,14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="初步判断" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{ThemeResource HubAiTitleForeground}" />
                            <StackPanel x:Name="FindingsPanel" Spacing="10" />
                        </StackPanel>
                    </Border>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <!-- 输入区：整块容器（圆角 + 边框 + 聚焦高亮），不是"一条文本框 + 一个按钮" -->
                <StackPanel x:Name="ChatInput" Grid.Row="3" Spacing="8"
                            HorizontalAlignment="Stretch" Margin="0,10,0,0">

                    <TextBlock x:Name="ChatStatus" FontSize="11.5"
                               Foreground="{ThemeResource HubAiSubForeground}"
                               Visibility="Collapsed" Margin="4,0,0,0" />

                    <Border x:Name="InputShell" CornerRadius="16" BorderThickness="1" Padding="12,10,10,8"
                            Background="{ThemeResource HubAiCardBackground}"
                            BorderBrush="{ThemeResource HubAiCardBorder}">
                        <StackPanel Spacing="6">
                            <TextBox x:Name="HubAiInput" PlaceholderText="描述你的需求，或直接问该装什么"
                                     AcceptsReturn="False" MaxHeight="140" TextWrapping="Wrap"
                                     BorderThickness="0" Background="Transparent" Padding="4,2,4,2"
                                     KeyDown="HubAiInput_KeyDown"
                                     GotFocus="HubAiInput_GotFocus"
                                     LostFocus="HubAiInput_LostFocus" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <ComboBox x:Name="ModelPicker" MinWidth="180" FontSize="12.5"
                                              SelectionChanged="ModelPicker_SelectionChanged" />
                                    <ToggleButton x:Name="ThinkToggle" Content="思考" FontSize="12"
                                                  Padding="10,4" Click="ThinkToggle_Click" />
                                    <!-- 联网开关：跟「思考」对等（2026-10-20） -->
                                    <ToggleButton x:Name="WebToggle" Content="联网" FontSize="12"
                                                  Padding="10,4" Click="WebToggle_Click"
                                                  ToolTipService.ToolTip="开启后允许检索网页" />
                                    <ComboBox x:Name="EffortPicker" MinWidth="88" FontSize="12.5"
                                              SelectionChanged="EffortPicker_SelectionChanged" />
                                </StackPanel>

                                <!-- ⚠️ 发送按钮靠右必须走 Grid 第三列：塞在 StackPanel 里 HorizontalAlignment 是无效的 -->
                                <Button x:Name="SendButton" Grid.Column="2" Padding="14,8"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Click="HubAiSend_Click" ToolTipService.ToolTip="发送">
                                    <FontIcon x:Name="SendIcon" Glyph="&#xE724;" FontSize="14" />
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
