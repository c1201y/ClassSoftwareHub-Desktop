<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.MachineCheckPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClassSoftwareHub.Desktop.Pages"
    xmlns:ui="using:ClassSoftwareHub.Desktop.Controls">

    

    







    




    

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" MaxWidth="960" RowSpacing="14" Margin="0,36,0,44">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            

            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="本机核实" FontSize="28" FontWeight="Bold" />
                    <ui:ExperimentalBadge FeatureId="machinecheck" />
                </StackPanel>
                <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                           Text="对照软件清单核实安装情况，标出未安装与需升级的软件。" />
            </StackPanel>

            
            <Border Grid.Row="1" CornerRadius="4" Padding="18,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="22" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="StatTotal" Text="—" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="条清单" FontSize="12" Opacity="0.6"
                                       VerticalAlignment="Bottom" Margin="0,0,0,3" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="StatInstalled" Text="—" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="已安装" FontSize="12" Opacity="0.6"
                                       VerticalAlignment="Bottom" Margin="0,0,0,3" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="StatOutdated" Text="—" FontSize="20" FontWeight="Bold"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="建议升级" FontSize="12" Opacity="0.6"
                                       VerticalAlignment="Bottom" Margin="0,0,0,3" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="StatMissing" Text="—" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="未安装" FontSize="12" Opacity="0.6"
                                       VerticalAlignment="Bottom" Margin="0,0,0,3" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <ComboBox x:Name="FilterBox" Width="150" SelectionChanged="Filter_Changed" />
                        <TextBlock x:Name="CountText" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            
            <Grid Grid.Row="2">
                <GridView x:Name="ResultGrid" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="Result_ItemClick" Padding="0,2,0,44"
                          ItemContainerStyle="{StaticResource CshCardItemStyle}">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:CheckRow">
                            <Border Style="{StaticResource CshCardStyle}" Width="302" Height="108" Padding="16,14" Margin="0,0,16,14"
                                    PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    

                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="9"
                                            VerticalAlignment="Top">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Bind IconImage}" Stretch="UniformToFill"
                                                        AlignmentX="Center" AlignmentY="Center" />
                                        </Border.Background>
                                        <FontIcon Glyph="&#xE719;" FontSize="18" Opacity="0.4"
                                                  Visibility="{x:Bind PlaceholderVisibility}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{x:Bind Title}" FontSize="14" FontWeight="Bold"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border CornerRadius="4" Padding="7,1" BorderThickness="1"
                                                    BorderBrush="{x:Bind StatusBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind StatusText}" FontSize="12"
                                                           Foreground="{x:Bind StatusBrush}" />
                                            </Border>
                                            <TextBlock Text="{x:Bind VersionText}" FontSize="12" Opacity="0.7"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Note}" FontSize="12" Opacity="0.6"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind Note}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                
                <StackPanel x:Name="LoadingPanel" Spacing="12" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ProgressRing IsActive="True" Width="34" Height="34" HorizontalAlignment="Center" />
                    <TextBlock Text="正在读取本机已安装的软件" FontSize="12" Opacity="0.7"
                               HorizontalAlignment="Center" />
                </StackPanel>

                
                <StackPanel x:Name="EmptyPanel" Spacing="10" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7F4;" FontSize="28" Opacity="0.45" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText" Text="当前筛选条件下没有软件" FontSize="14" Opacity="0.7"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            






            <Border Grid.Row="3" Style="{StaticResource CshCardStyle}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="RescanButton" Content="重新检测" Click="Rescan_Click" />
                        <Button Content="打开软件下载" Click="GoApps_Click" />
                        <TextBlock x:Name="SummaryHint" FontSize="12" Opacity="0.7" MaxLines="1"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="FootNote" FontSize="12" Opacity="0.55" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
