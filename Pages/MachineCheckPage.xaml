<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.MachineCheckPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClassSoftwareHub.Desktop.Pages">

    <!-- 卡片容器样式（关掉 GridViewItem 自带的焦点框/悬停底色）在 App.xaml 里：CshCardItemStyle -->

    <!--
      和首页 / 软件下载 / 设置同一套版式：三列 Grid 把内容钉在中间 960 宽（导航展开收起都不动）。
      ⚠️ 别用 Stretch + MaxWidth：一旦触发上限 WinUI 会把整列右甩。

      版式取舍（2026-09-26 Nick 反馈"一大块区域只有一小条能滚"）：
      统计从"独立大卡片"压成一行工具栏、筛选并到同一行、列表改 3 列卡片网格 ——
      可视条目从一屏约 4 条提到 12 条，纵向空间几乎全留给列表。
    -->
    <Grid Padding="24,36,24,44">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="998*" MaxWidth="960" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 + 实验性标记：本页结论**明显不准**，必须在第一眼就讲清楚，
                 免得被当成装机验收依据（页面只藏在「实验性功能」下面还不够，进来也得看见） -->
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="本机核实" FontSize="30" FontWeight="Bold" />
                    <Border CornerRadius="5" Padding="8,3" Margin="0,0,0,6" VerticalAlignment="Bottom"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource SystemFillColorCautionBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xEA80;" FontSize="11"
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="实验性功能" FontSize="11.5"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock FontSize="12.5" Opacity="0.65" TextWrapping="Wrap"
                           Text="对照软件清单检查这台电脑的安装情况，快速找出漏装和建议升级的软件。检测依据是 Windows 已安装程序记录，Microsoft Store 应用与免安装版不在记录中，可能显示为「未安装」。" />
            </StackPanel>

            <!-- 工具栏：左边统计，右边筛选（合成一行，把纵向空间让给列表） -->
            <Border Grid.Row="1" CornerRadius="8" Padding="18,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="22" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="StatTotal" Text="—" FontSize="19" FontWeight="Bold" />
                            <TextBlock Text="条清单" FontSize="12" Opacity="0.6"
                                       VerticalAlignment="Bottom" Margin="0,0,0,3" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="StatInstalled" Text="—" FontSize="19" FontWeight="Bold" />
                            <TextBlock Text="已装" FontSize="12" Opacity="0.6"
                                       VerticalAlignment="Bottom" Margin="0,0,0,3" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="StatOutdated" Text="—" FontSize="19" FontWeight="Bold"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="建议升级" FontSize="12" Opacity="0.6"
                                       VerticalAlignment="Bottom" Margin="0,0,0,3" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="StatMissing" Text="—" FontSize="19" FontWeight="Bold" />
                            <TextBlock Text="未安装" FontSize="12" Opacity="0.6"
                                       VerticalAlignment="Bottom" Margin="0,0,0,3" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <ComboBox x:Name="FilterBox" Width="150" SelectionChanged="Filter_Changed" />
                        <TextBlock x:Name="CountText" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 列表：3 列卡片网格（302 + 16 间距 = 正好 960，和「软件下载」磁贴同一尺寸） -->
            <Grid Grid.Row="2">
                <GridView x:Name="ResultGrid" SelectionMode="None" IsItemClickEnabled="True"
                          ItemClick="Result_ItemClick" Padding="0,2,0,0"
                          ItemContainerStyle="{StaticResource CshCardItemStyle}">
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="local:CheckRow">
                            <Border Width="302" Height="108" CornerRadius="8" Padding="16,14" Margin="0,0,16,14"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 图标：圆角由 Border 的 ImageBrush 裁出来（和「软件下载」同一手法）。
                                         没图时露一个字形占位，别留一块空白。 -->
                                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="9"
                                            VerticalAlignment="Top">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{x:Bind IconImage}" Stretch="UniformToFill"
                                                        AlignmentX="Center" AlignmentY="Center" />
                                        </Border.Background>
                                        <FontIcon Glyph="&#xE719;" FontSize="18" Opacity="0.4"
                                                  Visibility="{x:Bind PlaceholderVisibility}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{x:Bind Title}" FontSize="15" FontWeight="Bold"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border CornerRadius="4" Padding="7,1" BorderThickness="1"
                                                    BorderBrush="{x:Bind StatusBrush}" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind StatusText}" FontSize="11"
                                                           Foreground="{x:Bind StatusBrush}" />
                                            </Border>
                                            <TextBlock Text="{x:Bind VersionText}" FontSize="11.5" Opacity="0.7"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Note}" FontSize="11.5" Opacity="0.6"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{x:Bind Note}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- 检测中 -->
                <StackPanel x:Name="LoadingPanel" Spacing="12" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ProgressRing IsActive="True" Width="34" Height="34" HorizontalAlignment="Center" />
                    <TextBlock Text="正在读取本机已安装的软件……" FontSize="13" Opacity="0.7"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 空状态 -->
                <StackPanel x:Name="EmptyPanel" Spacing="10" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE7F4;" FontSize="34" Opacity="0.45" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText" Text="当前筛选条件下没有软件" FontSize="14" Opacity="0.7"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 底部：重测 + 概览 + 口径说明 -->
            <StackPanel Grid.Row="3" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="RescanButton" Content="重新检测" Click="Rescan_Click" />
                    <Button Content="打开软件下载" Click="GoApps_Click" />
                    <TextBlock x:Name="SummaryHint" FontSize="12" Opacity="0.7" MaxLines="1"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock x:Name="FootNote" FontSize="11.5" Opacity="0.55" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
