<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.DictionaryPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:ClassSoftwareHub.Desktop.Controls">

    <!--
      查阅单词（需求清单第 17 条，2026-11-01）。

      版式照母版 Pages/AutoShutdownPage.xaml：三列 Grid 把内容钉在中间 960 宽。
      ⚠️ 别用 Stretch + MaxWidth —— 触发上限时 WinUI 会把整列右甩（MustRead §1.1）。

      **查单词与翻译句子是两张独立的卡，各用各的输入框**（2026-11-01 Nick 定：
      不要一个框又查词又翻句）。理由：查词是敲几个字母看候选，翻译是粘一整段句子；
      挤在一个框里，补全列表在翻译时纯属碍事。

      每张卡自己成一体：标题 → 输入 → 结果，结果与输入之间用一条淡分隔线断开。
      结果一律在代码里逐条构造，⛔ 不用 ItemTemplate + x:Bind（MustRead §3）。
    -->
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,36,24,44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" MaxWidth="960" Spacing="4">

                    <!-- ═════════ 页头 ═════════ -->
                    <Grid Margin="0,0,0,14" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="查阅单词" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" />

                        <Button Grid.Column="1" Padding="12,6" Click="HubAiEntry_Click"
                                VerticalAlignment="Center" ToolTipService.ToolTip="打开 Hub AI 顾问">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE8F2;" FontSize="13" />
                                <TextBlock Text="AI" FontSize="12.5" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- ═════════ 一、查单词 ═════════ -->
                    <Border Style="{StaticResource CshCardStyle}" Padding="16,14">
                        <StackPanel Spacing="12">

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8F1;" FontSize="13.5" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock Text="查单词" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>

                            <!--
                              原生 AutoSuggestBox：边打字边给候选词，下拉列表、键盘上下选择、
                              回车提交、右侧查询图标全是控件自带的（⛔ 别自己拼 TextBox + ListView 下拉）。
                              ⚠️ 建议项只塞纯字符串，不设 ItemTemplate —— 见 MustRead §3。
                            -->
                            <AutoSuggestBox x:Name="WordBox" FontSize="14"
                                            PlaceholderText="输入英文单词，边打边选"
                                            QueryIcon="Find"
                                            UpdateTextOnSelect="True"
                                            TextChanged="WordBox_TextChanged"
                                            QuerySubmitted="WordBox_QuerySubmitted" />

                            <InfoBar x:Name="WordNotice" IsOpen="False" IsClosable="False"
                                     Severity="Informational" Message="" />

                            <!-- 空状态：还没查过词时摆几个示例 -->
                            <StackPanel x:Name="WordEmpty" Spacing="8" Margin="0,6,0,2">
                                <TextBlock Text="先查本地词库，没收录的再联网查" FontSize="12" Opacity="0.45" />
                                <StackPanel x:Name="SamplePanel" Orientation="Horizontal" Spacing="8" />
                            </StackPanel>

                            <!-- 词条 -->
                            <StackPanel x:Name="WordBlock" Spacing="12" Visibility="Collapsed">

                                <Border Height="1" Opacity="0.08"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}" />

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock x:Name="WordText" FontSize="25" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />

                                        <Button x:Name="SpeakButton" Padding="6,4" Margin="2,4,0,0"
                                                VerticalAlignment="Center" Click="Speak_Click"
                                                ToolTipService.ToolTip="朗读这个单词">
                                            <FontIcon Glyph="&#xE767;" FontSize="13" />
                                        </Button>

                                        <TextBlock x:Name="PhoneticText" FontSize="13" Opacity="0.58"
                                                   VerticalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Top">
                                        <Border CornerRadius="4" Padding="8,3" VerticalAlignment="Center"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                                            <TextBlock x:Name="WordSource" FontSize="11.5" Opacity="0.7" />
                                        </Border>

                                        <Button Padding="8,4" Click="CopyWord_Click"
                                                ToolTipService.ToolTip="复制这一条的完整解释">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="SensePanel" Spacing="10" />

                                <StackPanel x:Name="ExampleBlock" Spacing="8" Visibility="Collapsed">
                                    <TextBlock Text="例句" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
                                    <StackPanel x:Name="ExamplePanel" Spacing="10" />
                                </StackPanel>

                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- ═════════ 二、翻译句子 ═════════ -->
                    <Border Style="{StaticResource CshCardStyle}" Padding="16,14" Margin="0,14,0,0">
                        <StackPanel Spacing="12">

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8AC;" FontSize="13.5" Opacity="0.7" VerticalAlignment="Center" />
                                <TextBlock Text="翻译句子" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- 多行输入：用控件自带的边框，跟上面那个 AutoSuggestBox 同一视觉语言 -->
                            <TextBox x:Name="SentenceBox" AcceptsReturn="True" TextWrapping="Wrap"
                                     FontSize="14" MinHeight="84" MaxHeight="150"
                                     PlaceholderText="粘贴或输入一段话，中文英文都可以" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="DirectionHint" Text="自动识别方向" FontSize="12" Opacity="0.45"
                                           VerticalAlignment="Center" />

                                <Button x:Name="TranslateButton" Grid.Column="1" Content="翻译"
                                        Style="{StaticResource AccentButtonStyle}"
                                        Padding="24,7" Click="Translate_Click" />
                            </Grid>

                            <InfoBar x:Name="TransNotice" IsOpen="False" IsClosable="False"
                                     Severity="Informational" Message="" />

                            <StackPanel x:Name="TransBlock" Spacing="10" Visibility="Collapsed">

                                <Border Height="1" Opacity="0.08"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}" />

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Name="TransDirection" FontSize="12.5" FontWeight="SemiBold"
                                               Opacity="0.75" VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <Border CornerRadius="4" Padding="8,3"
                                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                                            <TextBlock x:Name="TransProvider" FontSize="11.5" Opacity="0.7" />
                                        </Border>

                                        <Button Padding="8,4" Click="CopyTranslation_Click"
                                                ToolTipService.ToolTip="复制译文">
                                            <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="TransTarget" FontSize="18" LineHeight="26"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />

                                <StackPanel Spacing="2">
                                    <TextBlock Text="原文" FontSize="11" Opacity="0.4" />
                                    <TextBlock x:Name="TransSource" FontSize="12.5" Opacity="0.6"
                                               TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                </StackPanel>

                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- ═════════ 最近查过的词 ═════════ -->
                    <StackPanel x:Name="HistoryBlock" Spacing="2" Margin="2,20,2,0" Visibility="Collapsed">
                        <Grid Margin="0,0,0,2">
                            <TextBlock Text="最近查过的词" FontSize="12.5" FontWeight="SemiBold" Opacity="0.7"
                                       VerticalAlignment="Center" />
                            <HyperlinkButton Content="清空" FontSize="12" Opacity="0.6"
                                             HorizontalAlignment="Right" Padding="6,0,0,0"
                                             Click="ClearHistory_Click" />
                        </Grid>
                        <StackPanel x:Name="HistoryPanel" Spacing="0" />
                    </StackPanel>

                </StackPanel>
            </Grid>
        </ScrollViewer>

        <ui:HubAiFlyout x:Name="AiFlyout" />
    </Grid>
</Page>
