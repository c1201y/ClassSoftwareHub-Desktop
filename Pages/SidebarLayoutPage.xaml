<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.SidebarLayoutPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="WorkspaceRoot" Padding="24,36,24,44">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="998*" MaxWidth="960" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <!-- 整页可滚：内容长得超过窗口时靠它，别再用小滚动区裁掉东西（拖动时会误会"模块消失"）
             右边留 18 的空：不然页面滚动条会压在预览条上，很难看 -->
        <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <Grid RowSpacing="14" Margin="0,0,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="5">
                    <TextBlock Text="侧边布局" FontSize="30" FontWeight="Bold" />
                    <TextBlock FontSize="13" Opacity="0.7" TextWrapping="Wrap"
                               Text="从左侧模块库选择模块，拖入右侧侧边栏预览（亦可单击卡片添加）；在预览区拖动可调整顺序，拖出即移除。右侧即侧边栏的实际效果。触摸屏操作：按住卡片约半秒且手指不移动即可拖动；直接滑动则为滚动整页。" />
                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：模块库 -->
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="模块库" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="拖入右侧，或单击卡片" FontSize="12" Opacity="0.6"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel x:Name="LibraryPanel" Grid.Row="1" Spacing="10" Margin="0,2,0,0" />
                    </Grid>

                    <!-- 右：侧边栏预览（宽度照真实侧边栏来，所见即所得） -->
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="侧边栏预览" FontSize="16" FontWeight="Bold" />

                        <Border x:Name="PreviewStrip" Width="240" CornerRadius="10" Padding="4"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <!-- 让位的"空档"画在这一层：它**不参与布局**，所以空档挪位置时不会有哪一行被布局瞬间顶走
                                     （之前是往下面的 StackPanel 里插/移一个 spacer，跨过一行那一行就跳一格）。
                                     放在行**下面**，行滑过去时正好把空档盖住，看着就是"缝被填上了"。 -->
                                <Canvas x:Name="HoleLayer" IsHitTestVisible="False" />

                                <!-- 模块那一摞。行的位置**固定不动**，让位靠每行自己的 Margin 偏移补间。
                                     侧边栏自带的那三个键（收起/位置复原/隐藏）这里不画 —— 它们本来就不能拼、不能删，
                                     摆在这儿只会挤位置、也是多余的。 -->
                                <StackPanel x:Name="PreviewPanel" Spacing="3" />
                            </Grid>
                        </Border>

                        <TextBlock FontSize="11.5" Opacity="0.6" Width="240" TextWrapping="Wrap"
                                   Text="右侧三个按钮：上移 / 下移 / 移除。将模块拖出后松手亦可移除。" />
                    </StackPanel>
                </Grid>

                <!-- 侧边栏自带的那排底部按钮（收起 / 常驻 / 位置复原 / 隐藏 / 打开应用）——
                     **五颗各自一个开关**，横排。开关只管显示与否，不改变它们在侧边栏里的先后。
                     ⚠️ IsOn 一律**不在 XAML 里写死**（这版 WinUI 对 XAML 里的布尔字面量不老实），
                        由 Refresh() 从设置同步过来。
                     ⚠️ 五颗的 `Tag` 必须跟 SidebarFooterKeys 里的字面量一致（那是存档格式的一部分）。 -->
                <StackPanel Grid.Row="2" Spacing="4">
                    <TextBlock Text="侧边栏底部按钮" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,-2,0,2"
                               Text="侧边栏展开面板底部自带的一排按钮，逐颗控制显示与隐藏；侧边栏按实际显示的颗数收缩。" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ToggleSwitch x:Name="FoldToggle" Grid.Column="0" Header="收起" Tag="fold"
                                      OnContent="显示" OffContent="隐藏" Toggled="FooterItem_Toggled" />
                        <ToggleSwitch x:Name="PinToggle" Grid.Column="1" Header="常驻" Tag="pin"
                                      OnContent="显示" OffContent="隐藏" Toggled="FooterItem_Toggled" />
                        <ToggleSwitch x:Name="ResetToggle" Grid.Column="2" Header="位置复原" Tag="reset"
                                      OnContent="显示" OffContent="隐藏" Toggled="FooterItem_Toggled" />
                        <ToggleSwitch x:Name="HideToggle" Grid.Column="3" Header="隐藏" Tag="hide"
                                      OnContent="显示" OffContent="隐藏" Toggled="FooterItem_Toggled" />
                        <ToggleSwitch x:Name="OpenAppToggle" Grid.Column="4" Header="打开应用" Tag="openapp"
                                      OnContent="显示" OffContent="隐藏" Toggled="FooterItem_Toggled" />
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="3" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock FontSize="12.5" Opacity="0.7" TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="可不放置任何模块，此时侧边栏仅保留自带的按钮。侧边栏开关位于「设置 → 常用工具」中。" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SidebarButton" Content="隐藏侧边栏" Click="ToggleSidebar_Click" />
                        <Button Content="恢复默认" Click="ResetDefault_Click"
                                ToolTipService.ToolTip="恢复为「抽号 / 计时 / 秒表 / 时钟」四个模块" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- 把预览里的模块拖到空白处时浮出来的提示 -->
        <Border x:Name="RemoveHint" Visibility="Collapsed" Grid.ColumnSpan="3"
                CornerRadius="8" Padding="16,10"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE74D;" FontSize="14"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           Text="松手即从侧边栏移除" />
            </StackPanel>
        </Border>

        <!-- 拖着走的那张卡就放在这层上面（不吃点击） -->
        <Canvas x:Name="DragLayer" Grid.ColumnSpan="3" IsHitTestVisible="False" />
    </Grid>
</Page>
