<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.SidebarLayoutPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <Grid x:Name="WorkspaceRoot">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>

        <!-- 整页可滚：内容长得超过窗口时靠它，别再用小滚动区裁掉东西（拖动时会误会"模块消失"）
             右边留 18 的空：不然页面滚动条会压在预览条上，很难看 -->
        <ScrollViewer x:Name="PageScroll" Grid.Column="1" MaxWidth="960" VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <Grid RowSpacing="14" Margin="0,36,18,44">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="5">
                    <TextBlock Text="侧边布局" FontSize="28" FontWeight="Bold" />
                    <TextBlock FontSize="13" Opacity="0.7" TextWrapping="Wrap"
                               Text="从左侧模块库选择模块，拖入右侧侧边栏预览（亦可单击卡片添加）；在预览区拖动可调整顺序，拖出即移除。右侧即侧边栏的实际效果。触摸屏操作：按住卡片约半秒且手指不移动即可拖动；直接滑动则为滚动整页。" />
                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 左：模块库 -->
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="模块库" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="拖入右侧，或单击卡片" FontSize="12" Opacity="0.6"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel x:Name="LibraryPanel" Grid.Row="1" Spacing="10" Margin="0,2,0,0" />
                    </Grid>

                    <!-- 右：侧边栏预览（宽度照真实侧边栏来，所见即所得） -->
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="侧边栏预览" FontSize="16" FontWeight="Bold" />

                        <Border x:Name="PreviewStrip" Width="240" CornerRadius="10" Padding="4"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                <!-- 让位的"空档"画在这一层：它**不参与布局**，所以空档挪位置时不会有哪一行被布局瞬间顶走
                                     （之前是往下面的 StackPanel 里插/移一个 spacer，跨过一行那一行就跳一格）。
                                     放在行**下面**，行滑过去时正好把空档盖住，看着就是"缝被填上了"。 -->
                                <Canvas x:Name="HoleLayer" IsHitTestVisible="False" />

                                <!-- 模块那一摞。行的位置**固定不动**，让位靠每行自己的 Margin 偏移补间。
                                     侧边栏自带的那三个键（收起/位置复原/隐藏）这里不画 —— 它们本来就不能拼、不能删，
                                     摆在这儿只会挤位置、也是多余的。 -->
                                <StackPanel x:Name="PreviewPanel" Spacing="3" />
                            </Grid>
                        </Border>

                        <TextBlock FontSize="11.5" Opacity="0.6" Width="240" TextWrapping="Wrap"
                                   Text="右侧三个按钮：上移 / 下移 / 移除。将模块拖出后松手亦可移除。" />
                    </StackPanel>
                </Grid>

                <!--
                  ============ 常用工具 / 侧边栏开关 ============
                  2026-10-01：这四项原本在「设置 → 常用工具」，搬到这里 —— 它们本就是侧边栏
                  与常用工具浮窗自己的开关，跟模块库、预览摆在一页才顺。（截图那两项留在设置页。）
                  ⚠️ 版式一律照设置页那套：SettingsCard + HeaderIcon + 4px 组内间距，
                     不许自己叠 Border / 写死颜色。
                -->
                <StackPanel Grid.Row="2">

                    <TextBlock Text="常用工具" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                    <StackPanel Spacing="4">

                        <controls:SettingsCard Header="常用工具窗口始终置顶"
                                               Description="常用工具浮窗不会被其他窗口遮挡。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE718;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="PaletteTopSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                          Toggled="PaletteTopSwitch_Toggled" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="屏幕边缘侧边栏"
                                               Description="在屏幕边缘常驻一条工具栏，可放置常用工具与内置功能。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8A0;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="SidebarSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                          Toggled="SidebarSwitch_Toggled" />
                        </controls:SettingsCard>

                        <!-- 两项都用 ComboBox：与「颜色模式」「窗口背景效果」同一套交互，不做成一排单选按钮 -->
                        <controls:SettingsCard Header="侧边栏放置模式">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7C4;" />
                            </controls:SettingsCard.HeaderIcon>
                            <controls:SettingsCard.Description>
                                <TextBlock x:Name="ModeHint" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </controls:SettingsCard.Description>
                            <ComboBox x:Name="SidebarModeCombo" MinWidth="170"
                                      SelectionChanged="SidebarMode_SelectionChanged">
                                <ComboBoxItem Content="贴靠模式" Tag="dock" />
                                <ComboBoxItem Content="自由模式" Tag="free" />
                            </ComboBox>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="侧边栏贴在哪条边">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8A0;" />
                            </controls:SettingsCard.HeaderIcon>
                            <controls:SettingsCard.Description>
                                <TextBlock x:Name="EdgeHint" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </controls:SettingsCard.Description>
                            <!-- 选项按放置模式动态重建（贴靠 = 左/右/左右两边，自由 = 左/右/上/下） -->
                            <ComboBox x:Name="SidebarEdgeCombo" MinWidth="170"
                                      SelectionChanged="SidebarEdge_SelectionChanged" />
                        </controls:SettingsCard>

                    </StackPanel>

                    <!--
                      ============ 截图 ============
                      2026-10-01：原在「设置 → 截图」，整组搬来这里，紧接「常用工具」下面 ——
                      与浮窗 / 侧边栏同属外部组件那套行为设置，摆在一栏里才顺（设置页那一组已删干净）。
                      ⚠️ 版式照旧：SettingsCard + HeaderIcon + 4px 组内间距。
                    -->
                    <TextBlock Text="截图" Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,24,0,8" />
                    <StackPanel Spacing="4">

                        <controls:SettingsCard Header="截图后自动保存一份原图"
                                               Description="保存至下方目录，文件名格式为 截图_年月日_时分秒.png（重名时自动追加序号）。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE722;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="ShotAutoSaveSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                          Toggled="ShotAutoSave_Toggled" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="截图保存位置">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8F4;" />
                            </controls:SettingsCard.HeaderIcon>
                            <controls:SettingsCard.Description>
                                <StackPanel Spacing="8" Margin="0,4,0,0">
                                    <TextBlock x:Name="ShotDirText" TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="更改目录…" Click="ShotDir_Change_Click" />
                                        <Button Content="打开目录" Click="ShotDir_Open_Click" />
                                        <Button Content="恢复默认（桌面）" Click="ShotDir_Reset_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </controls:SettingsCard.Description>
                        </controls:SettingsCard>

                    </StackPanel>

                    <!--
                      侧边栏自带的那排底部按钮（收起 / 常驻 / 位置复原 / 隐藏 / 打开应用）——
                      **五颗各自一张卡片、一行一个**（2026-10-01：原来横排五个 ToggleSwitch，
                      挤在一起既不好点也不像系统设置）。开关只管显示与否，不改变它们在侧边栏里的先后。
                      ⚠️ IsOn 一律**不在 XAML 里写死**（这版 WinUI 对 XAML 里的布尔字面量不老实），
                         由 Refresh() 从设置同步过来。
                      ⚠️ 五颗的 `Tag` 必须跟 SidebarFooterKeys 里的字面量一致（那是存档格式的一部分）。
                    -->
                    <TextBlock Text="侧边栏底部按钮" Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,24,0,8" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,-4,0,8"
                               Text="侧边栏展开面板底部自带的一排按钮，逐颗控制显示与隐藏；侧边栏按实际显示的颗数收缩。" />
                    <StackPanel Spacing="4">

                        <controls:SettingsCard Header="收起" Description="把侧边栏收成一条窄条，收起来后仍可重新展开。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE76C;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="FoldToggle" Tag="fold" OnContent="显示" OffContent="隐藏"
                                          MinWidth="0" Toggled="FooterItem_Toggled" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="常驻" Description="侧边栏展开后保持展开，不自动收起。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE718;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="PinToggle" Tag="pin" OnContent="显示" OffContent="隐藏"
                                          MinWidth="0" Toggled="FooterItem_Toggled" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="位置复原" Description="把侧边栏移回屏幕边缘的居中位置。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE777;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="ResetToggle" Tag="reset" OnContent="显示" OffContent="隐藏"
                                          MinWidth="0" Toggled="FooterItem_Toggled" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="隐藏" Description="把侧边栏从屏幕上隐藏，可从托盘菜单重新显示。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xED1A;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="HideToggle" Tag="hide" OnContent="显示" OffContent="隐藏"
                                          MinWidth="0" Toggled="FooterItem_Toggled" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="打开应用" Description="唤出软件主界面，主窗口最小化或收进托盘时使用。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE80F;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="OpenAppToggle" Tag="openapp" OnContent="显示" OffContent="隐藏"
                                          MinWidth="0" Toggled="FooterItem_Toggled" />
                        </controls:SettingsCard>

                    </StackPanel>

                    <!--
                      ============ 动画方案 ============
                      2026-10-01 Nick：两种落位收尾都做出来之后觉得都挺好，索性都留给用户自己挑。
                      ⚠️ 版式照旧：组标题 + Caption 说明 + SettingsCard + 4px 组内间距，不许自己叠 Border。
                      ⚠️ 两项都用 ComboBox：与「颜色模式」「侧边栏放置模式」同一套交互，不做成一排单选按钮。
                    -->
                    <TextBlock Text="动画方案" Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,24,0,8" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,-4,0,8"
                               Text="拖放卡片落位时的收尾效果。两种方案均已完成验证，手感取向不同；其实两者观感差异不大，只是开发过程中两种效果均做得不错，删之可惜，一并保留，交由各位自行选择。" />
                    <StackPanel Spacing="4">

                        <controls:SettingsCard Header="落位收尾"
                                               Description="平滑收势：落位后直接收掉提起效果。轻落一下：落位后再轻轻下沉一次，落地感更实。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8CB;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox x:Name="DropAnimCombo" MinWidth="170"
                                      SelectionChanged="DropAnim_SelectionChanged">
                                <ComboBoxItem Content="平滑收势" Tag="plain" />
                                <ComboBoxItem Content="轻落一下" Tag="dip" />
                            </ComboBox>
                        </controls:SettingsCard>

                    </StackPanel>

                </StackPanel>

                <Grid Grid.Row="3" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="可不放置任何模块，此时侧边栏仅保留自带的按钮。" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SidebarButton" Content="隐藏侧边栏" Click="ToggleSidebar_Click" />
                        <Button Content="恢复默认" Click="ResetDefault_Click"
                                ToolTipService.ToolTip="恢复为「抽号 / 计时 / 秒表 / 时钟」四个模块" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- 把预览里的模块拖到空白处时浮出来的提示 -->
        <Border x:Name="RemoveHint" Visibility="Collapsed" Grid.ColumnSpan="3"
                CornerRadius="4" Padding="16,10"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon x:Name="RemoveHintIcon" Glyph="&#xE74D;" FontSize="14"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="RemoveHintText" FontSize="13"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           Text="松手即从侧边栏移除" />
            </StackPanel>
        </Border>

        <!-- 拖着走的那张卡就放在这层上面（不吃点击） -->
        <Canvas x:Name="DragLayer" Grid.ColumnSpan="3" IsHitTestVisible="False" />
    </Grid>
</Page>
