<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.SidebarLayoutPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    



    <Grid x:Name="WorkspaceRoot" Background="Transparent">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>

        

        <ScrollViewer x:Name="PageScroll" Grid.Column="1" MaxWidth="960" VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto">
            <Grid RowSpacing="14" Margin="0,36,18,44">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="5">
                    <TextBlock Text="侧边布局" FontSize="28" FontWeight="Bold" />
                    <TextBlock FontSize="13" Opacity="0.7" TextWrapping="Wrap"
                               Text="从左侧拖入右侧预览区，预览即侧边栏实际效果。" />
                </StackPanel>

                <Grid Grid.Row="1" ColumnSpacing="22">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="模块库" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="拖入右侧，或单击卡片" FontSize="12" Opacity="0.6"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel x:Name="LibraryPanel" Grid.Row="1" Spacing="10" Margin="0,2,0,0" />

                        <StackPanel Grid.Row="2" Spacing="8" Margin="0,14,0,0">
                            <TextBlock Text="快捷应用" FontSize="16" FontWeight="Bold" />
                            <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                       Text="先在上方模块库把「快捷应用」加入侧边栏，再在这里添加应用、快捷方式或文件。" />
                            <StackPanel x:Name="PinnedAppsPanel" Spacing="5" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="添加应用" Click="AddPinnedApp_Click" />
                                <Button Content="添加快捷方式" Click="AddPinnedShortcut_Click" />
                                <Button Content="添加文件" Click="AddPinnedFile_Click" />
                            </StackPanel>
                            <TextBlock x:Name="PinnedStatusText" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />

                            <TextBlock Text="全局快捷键" FontSize="16" FontWeight="Bold" Margin="0,16,0,0" />
                            <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                       Text="为侧边栏里的快捷应用录制独立的全局组合键；应用移除后对应快捷键自动失效。" />
                            <StackPanel x:Name="AppHotkeyPanel" Spacing="5" />
                            <TextBlock x:Name="AppHotkeyStatusText" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>

                    
                    <StackPanel Grid.Column="1" Spacing="8">
                        <TextBlock Text="侧边栏预览" FontSize="16" FontWeight="Bold" />

                        <Border x:Name="PreviewStrip" Width="240" CornerRadius="10" Padding="4"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <Grid>
                                


                                <Canvas x:Name="HoleLayer" IsHitTestVisible="False" />

                                


                                <StackPanel x:Name="PreviewPanel" Spacing="3" />
                            </Grid>
                        </Border>

                        <TextBlock FontSize="11.5" Opacity="0.6" Width="240" TextWrapping="Wrap"
                                   Text="也可把模块拖出预览区移除。" />
                    </StackPanel>
                </Grid>

                






                <StackPanel Grid.Row="2">

                    <TextBlock Text="常用工具" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,0,0,8" />
                    <StackPanel Spacing="4">

                        <controls:SettingsCard Header="常用工具窗口始终置顶"
                                               Description="常用工具浮窗不会被其他窗口遮挡。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE718;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="PaletteTopSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                          Toggled="PaletteTopSwitch_Toggled" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="屏幕边缘侧边栏"
                                               Description="屏幕边缘的常驻工具栏。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8A0;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="SidebarSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                          Toggled="SidebarSwitch_Toggled" />
                        </controls:SettingsCard>

                        

                        <controls:SettingsCard Header="按钮使用长名"
                                               Description="最多四个字，便于辨认。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8D2;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="LongLabelSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                          Toggled="LongLabelSwitch_Toggled" />
                        </controls:SettingsCard>

                        
                        <controls:SettingsCard Header="侧边栏放置模式">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7C4;" />
                            </controls:SettingsCard.HeaderIcon>
                            <controls:SettingsCard.Description>
                                <TextBlock x:Name="ModeHint" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </controls:SettingsCard.Description>
                            <ComboBox x:Name="SidebarModeCombo" MinWidth="170"
                                      SelectionChanged="SidebarMode_SelectionChanged">
                                <ComboBoxItem Content="贴靠模式" Tag="dock" />
                                <ComboBoxItem Content="自由模式" Tag="free" />
                            </ComboBox>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="侧边栏贴在哪条边">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8A0;" />
                            </controls:SettingsCard.HeaderIcon>
                            <controls:SettingsCard.Description>
                                <TextBlock x:Name="EdgeHint" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </controls:SettingsCard.Description>
                            
                            <ComboBox x:Name="SidebarEdgeCombo" MinWidth="170"
                                      SelectionChanged="SidebarEdge_SelectionChanged" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="侧边栏大小样式"
                                               Description="收起成抓手时的粗细。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE747;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox x:Name="SidebarDensityCombo" MinWidth="170"
                                      SelectionChanged="SidebarDensity_SelectionChanged">
                                <ComboBoxItem Content="标准" Tag="standard" />
                                <ComboBoxItem Content="紧凑" Tag="compact" />
                            </ComboBox>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="展开后的大小样式"
                                               Description="默认与收起时一致。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE70E;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox x:Name="SidebarExpandedDensityCombo" MinWidth="170"
                                      SelectionChanged="SidebarExpandedDensity_SelectionChanged">
                                <ComboBoxItem Content="跟随收起时的样式" Tag="same" />
                                <ComboBoxItem Content="标准" Tag="standard" />
                                <ComboBoxItem Content="紧凑" Tag="compact" />
                            </ComboBox>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="工具排列模式"
                                               Description="仅贴靠屏幕左右两边时生效。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8FD;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox x:Name="SidebarColumnsCombo" MinWidth="170"
                                      SelectionChanged="SidebarColumns_SelectionChanged">
                                <ComboBoxItem Content="舒展模式" Tag="3" />
                                <ComboBoxItem Content="紧凑模式" Tag="1" />
                            </ComboBox>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="展开面板高度"
                                               Description="面板高度上限，仅对「紧凑模式」有效。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE740;" />
                            </controls:SettingsCard.HeaderIcon>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                






                                <Slider x:Name="HeightRatioSlider" Width="190"
                                        Minimum="45" Maximum="95" Value="75"
                                        StepFrequency="5" TickFrequency="5"
                                        IsThumbToolTipEnabled="False"
                                        ValueChanged="HeightRatio_ValueChanged" />
                                <TextBlock x:Name="HeightRatioText" MinWidth="40" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="自适应高度"
                                               Description="模块少时面板随之收短。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE9A6;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="HeightAutoSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                          Toggled="HeightAuto_Toggled" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="收起时离屏幕边缘"
                                               Description="仅对收起状态生效。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE71D;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox x:Name="SidebarGapCombo" MinWidth="170"
                                      SelectionChanged="SidebarGap_SelectionChanged">
                                <ComboBoxItem Content="0（紧贴边缘）" Tag="0" />
                                <ComboBoxItem Content="2" Tag="2" />
                                <ComboBoxItem Content="4" Tag="4" />
                                <ComboBoxItem Content="6（默认）" Tag="6" />
                                <ComboBoxItem Content="10" Tag="10" />
                                <ComboBoxItem Content="16" Tag="16" />
                            </ComboBox>
                        </controls:SettingsCard>

                    </StackPanel>

                    





                    <TextBlock Text="截图" Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,24,0,8" />
                    <StackPanel Spacing="4">

                        <controls:SettingsCard Header="截图后自动保存一份原图"
                                               Description="文件名格式：截图_年月日_时分秒.png">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE722;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="ShotAutoSaveSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                          Toggled="ShotAutoSave_Toggled" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="截图保存位置">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8F4;" />
                            </controls:SettingsCard.HeaderIcon>
                            <controls:SettingsCard.Description>
                                <StackPanel Spacing="8" Margin="0,4,0,0">
                                    <TextBlock x:Name="ShotDirText" TextWrapping="Wrap"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="更改目录…" Click="ShotDir_Change_Click" />
                                        <Button Content="打开目录" Click="ShotDir_Open_Click" />
                                        <Button Content="恢复默认（桌面）" Click="ShotDir_Reset_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </controls:SettingsCard.Description>
                        </controls:SettingsCard>

                    </StackPanel>

                    







                    <TextBlock Text="侧边栏底部按钮" Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,24,0,8" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,-4,0,8"
                               Text="按实际显示的颗数收缩。" />
                    <StackPanel Spacing="4">

                        <controls:SettingsCard Header="收起" Description="把侧边栏收成一条窄条，收起来后仍可重新展开。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE76C;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="FoldToggle" Tag="fold" OnContent="显示" OffContent="隐藏"
                                          MinWidth="0" Toggled="FooterItem_Toggled" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="常驻" Description="侧边栏展开后保持展开，不自动收起。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE718;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="PinToggle" Tag="pin" OnContent="显示" OffContent="隐藏"
                                          MinWidth="0" Toggled="FooterItem_Toggled" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="位置复原" Description="把侧边栏移回屏幕边缘的居中位置。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE777;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="ResetToggle" Tag="reset" OnContent="显示" OffContent="隐藏"
                                          MinWidth="0" Toggled="FooterItem_Toggled" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="隐藏" Description="把侧边栏从屏幕上隐藏，可从托盘菜单重新显示。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xED1A;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="HideToggle" Tag="hide" OnContent="显示" OffContent="隐藏"
                                          MinWidth="0" Toggled="FooterItem_Toggled" />
                        </controls:SettingsCard>

                        <controls:SettingsCard Header="打开应用" Description="唤出软件主界面，主窗口最小化或收进托盘时使用。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE80F;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ToggleSwitch x:Name="OpenAppToggle" Tag="openapp" OnContent="显示" OffContent="隐藏"
                                          MinWidth="0" Toggled="FooterItem_Toggled" />
                        </controls:SettingsCard>

                    </StackPanel>

                    




                    <TextBlock Text="关机" Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,24,0,8" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,-4,0,8"
                               Text="按下后会先弹出确认。" />
                    <StackPanel Spacing="4">

                        <controls:SettingsCard Header="关机方式"
                                               Description="手动关机需滑动滑块确认。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE7E8;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox x:Name="ShutdownModeCombo" MinWidth="170"
                                      SelectionChanged="ShutdownMode_SelectionChanged">
                                <ComboBoxItem Content="手动关机（滑动关机）" Tag="slide" />
                                <ComboBoxItem Content="直接关机" Tag="shutdown" />
                            </ComboBox>
                        </controls:SettingsCard>

                    </StackPanel>

                    





                    <TextBlock Text="动画方案" Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,24,0,8" />
                    <StackPanel Spacing="4">

                        <controls:SettingsCard Header="落位收尾"
                                               Description="平滑收势：直接收起。轻落一下：再下沉一次。">
                            <controls:SettingsCard.HeaderIcon>
                                <FontIcon Glyph="&#xE8CB;" />
                            </controls:SettingsCard.HeaderIcon>
                            <ComboBox x:Name="DropAnimCombo" MinWidth="170"
                                      SelectionChanged="DropAnim_SelectionChanged">
                                <ComboBoxItem Content="平滑收势" Tag="plain" />
                                <ComboBoxItem Content="轻落一下" Tag="dip" />
                            </ComboBox>
                        </controls:SettingsCard>

                    </StackPanel>

                </StackPanel>

                <Grid Grid.Row="3" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center"
                               Text="可不放置任何模块，此时侧边栏仅保留自带的按钮。" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="SidebarButton" Content="隐藏侧边栏" Click="ToggleSidebar_Click" />
                        <Button Content="恢复默认" Click="ResetDefault_Click"
                                ToolTipService.ToolTip="恢复为「抽号 / 计时 / 秒表 / 时钟」四个模块" />
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>

        
        <Border x:Name="RemoveHint" Visibility="Collapsed" Grid.ColumnSpan="3"
                CornerRadius="4" Padding="16,10"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon x:Name="RemoveHintIcon" Glyph="&#xE74D;" FontSize="14"
                          Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                <TextBlock x:Name="RemoveHintText" FontSize="13"
                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                           Text="松手即从侧边栏移除" />
            </StackPanel>
        </Border>

        
        <Canvas x:Name="DragLayer" Grid.ColumnSpan="3" IsHitTestVisible="False" />
    </Grid>
</Page>
