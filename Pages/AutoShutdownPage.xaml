<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.AutoShutdownPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <!--
      版式与「程序专杀」「白板专杀」「本机核实」同源：三列 Grid 把内容钉在中间 960 宽。
      ⚠️ 别用 Stretch + MaxWidth：一旦触发上限 WinUI 会把整列右甩。
      卡片语言也照它们：圆角 4、卡片间距 4、手写 Border 一律 CshCardStyle。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,36,24,44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" MaxWidth="960" Spacing="4">

                <!-- 标题 + 实验性标记 -->
                <StackPanel Spacing="6" Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="自动关机" FontSize="28" FontWeight="Bold" />
                        <Border CornerRadius="4" Padding="8,3" Margin="0,0,0,6" VerticalAlignment="Bottom"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SystemFillColorCautionBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xEA80;" FontSize="11"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock Text="实验性功能" FontSize="12"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="按星期设定关机时间点，到达时间后自动关机。可以选「直接关机」（可设延迟）或系统原生的「滑动关机」；延迟期间可在侧边栏用「取消关机」撤回。" />
                </StackPanel>

                <!-- 总开关 -->
                <controls:SettingsCard Header="自动执行">
                    <controls:SettingsCard.Description>
                        <TextBlock x:Name="SwitchHint" FontSize="12" Opacity="0.6" TextWrapping="Wrap" Text="" />
                    </controls:SettingsCard.Description>
                    <ToggleSwitch x:Name="EnableSwitch" OnContent="开" OffContent="关"
                                  MinWidth="0" Toggled="EnableSwitch_Toggled" />
                </controls:SettingsCard>

                <!-- 时间表 -->
                <Border Style="{StaticResource CshCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="关机时间表" FontSize="14" />
                        <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                   Text="每一列是一天。点列下面的 + 添加一个关机点；点已有的关机点可以改时间、方式或删掉它。同一天可以放多个点。" />
                        <Grid x:Name="ScheduleGrid" ColumnSpacing="8" />
                    </StackPanel>
                </Border>

                <!-- 侧边栏的取消关机 -->
                <Border Style="{StaticResource CshCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="取消关机" FontSize="14" />
                        <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                   Text="侧边栏上有一颗「取消关机」，用于延迟期间撤回还没执行的关机（直接关机方式才用得上）。没排到关机时按它只会提示一句。把它加到侧边栏：点右边按钮即追加到末尾，之后可以在「侧边布局」里调整位置。" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="AddToSidebarButton" Content="添加到侧边栏" Click="AddToSidebar_Click" />
                            <Button Content="打开侧边布局" Click="OpenSidebarLayout_Click" />
                        </StackPanel>
                        <TextBlock x:Name="SidebarHint" FontSize="12" TextWrapping="Wrap" Opacity="0.75" Text="" />
                    </StackPanel>
                </Border>

                <!-- 页脚：说明执行依据与限制 -->
                <Border Style="{StaticResource CshCardStyle}">
                    <StackPanel Spacing="7">
                        <TextBlock Text="执行依据与限制" FontSize="12" FontWeight="Bold" Opacity="0.85" />
                        <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="· 生效条件：本程序需处于运行状态。本程序完全退出后，到达时间点也不会执行（执行依赖本程序自身的计时，未向系统注册计划任务）。" />
                        <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="· 直接关机：调用 Windows 自带的关机命令。设了延迟的话，电脑会先进入系统倒计时；这段时间内可用侧边栏的「取消关机」撤回。" />
                        <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="· 滑动关机：调起系统原生的下滑关机界面。它只负责弹出界面，需要手动把滑块拉到底才会关机；不操作就停在原地。" />
                        <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                   Text="· 到点前请自行保存正在编辑的内容。关机是不可逆操作，延迟时间请按实际需要设定。" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
