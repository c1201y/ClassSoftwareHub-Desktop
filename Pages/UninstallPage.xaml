<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.UninstallPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClassSoftwareHub.Desktop.Pages">

    <!--
      版式与「本机核实」「软件下载」同源：三列 Grid 把内容钉在中间 960 宽。
      ⚠️ 别用 Stretch + MaxWidth：一旦触发上限 WinUI 会把整列右甩。
      本页最后一行是页脚说明卡（非自滚元素）→ 中间列底 Margin 写 44；
      列表那一行是 `*`，由 ListView 自己滚（外面不再套 ScrollViewer，否则内外两层滚动条）。
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" MaxWidth="960" RowSpacing="14" Margin="0,36,0,44">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 + 实验性标记：本功能会**真的把软件卸掉**，第一眼就得让人知道它是什么性质 -->
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="应用卸载" FontSize="28" FontWeight="Bold" />
                    <Border CornerRadius="5" Padding="8,3" Margin="0,0,0,6" VerticalAlignment="Bottom"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource SystemFillColorCautionBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <FontIcon Glyph="&#xEA80;" FontSize="11"
                                      Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="实验性功能" FontSize="12"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                           Text="扫描本机已安装的软件，可以直接调起它们自带的卸载程序。卸载动作由厂商自己的卸载程序完成，本程序不删除任何文件。" />
            </StackPanel>

            <!-- 工具条：左边计数，右边搜索（按钮贴在输入框右侧） -->
            <Border Grid.Row="1" CornerRadius="4" Padding="18,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CountText" Text="正在扫描…" FontSize="12" Opacity="0.7"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                    <TextBox Grid.Column="1" x:Name="SearchBox" Width="240" MinHeight="32"
                             PlaceholderText="按名称或发布者筛选" TextChanged="Search_Changed" />
                    <Button Grid.Column="2" x:Name="RescanButton" Content="重新扫描" Click="Rescan_Click" />
                </Grid>
            </Border>

            <!-- 列表：一行一个应用，右侧一颗卸载按钮 -->
            <Grid Grid.Row="2">
                <ListView x:Name="AppList"
                          SelectionMode="None" IsItemClickEnabled="False"
                          ItemContainerStyle="{StaticResource CshResultRowStyle}"
                          Padding="0,2,0,8">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:UninstallRow">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontSize="14"
                                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Sub}" FontSize="12" Opacity="0.6"
                                               MaxLines="1" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Sub}" />
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{x:Bind Version}" FontSize="12" Opacity="0.7"
                                           Margin="12,0,12,0" VerticalAlignment="Center" />

                                <Button Grid.Column="2" Content="卸载"
                                        Click="Uninstall_Click"
                                        IsEnabled="{x:Bind CanUninstall}"
                                        ToolTipService.ToolTip="{x:Bind ActionTip}"
                                        VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 扫描中 -->
                <StackPanel x:Name="LoadingPanel" Spacing="12" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ProgressRing IsActive="True" Width="34" Height="34" HorizontalAlignment="Center" />
                    <TextBlock Text="正在读取本机已安装的软件" FontSize="12" Opacity="0.7"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 空状态 -->
                <StackPanel x:Name="EmptyPanel" Spacing="10" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE74D;" FontSize="28" Opacity="0.45" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText" Text="没有符合条件的应用" FontSize="14" Opacity="0.7"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>

            <!-- 页脚：扫描范围与须知（先说清边界，别让用户自己猜） -->
            <Border Grid.Row="3" Style="{StaticResource CshCardStyle}">
                <StackPanel Spacing="7">
                    <TextBlock Text="扫描范围与须知" FontSize="12" FontWeight="Bold" Opacity="0.85" />
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="· 扫描范围：Windows「程序和功能」的安装记录（64 位、32 位、当前用户三处），以及本账户注册的 Microsoft Store 应用。免安装（绿色版）软件没有任何登记，不会出现在列表里。" />
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="· 卸载方式：调起软件自带的卸载程序（需要管理员权限时会弹出系统授权提示）。本程序只负责发起，不删文件、不动注册表 —— 这比手动删目录安全。" />
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="· 卸载完成后会自动重扫。若某个卸载程序启动后长期不退出（个别软件会卡在重启提示上），可能仍需到系统「设置 → 应用」里收尾。" />
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="· 部分软件（尤其系统组件与其他账户下的商店应用）会拒绝卸载或要求重启，这些限制来自软件本身。卸载前请先退出该软件，并保存好正在编辑的内容。" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
