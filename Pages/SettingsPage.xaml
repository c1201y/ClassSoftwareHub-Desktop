<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.SettingsPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:ClassSoftwareHub.Desktop.Controls"
    Background="{x:Null}">

    












    <Page.Resources>
        


        <DataTemplate x:Key="QuickLinkNormal">
            <Border CornerRadius="4" Padding="12,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Height="24">
                        <FontIcon Glyph="{Binding Glyph}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.95"
                                  Visibility="{Binding IconSvg, Converter={StaticResource NotNullToCollapsed}}" />
                        <Image Source="{Binding IconSource}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IconSource, Converter={StaticResource NullToCollapsed}}" />
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>

    

    

    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto">
        
        <Grid Margin="24,36,24,44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" MaxWidth="960">
                
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <RepositionThemeTransition />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>

                <TextBlock Text="设置" FontSize="28" FontWeight="Bold" />

                
                <StackPanel Spacing="4" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Image x:Name="AboutIcon" Width="44" Height="44" VerticalAlignment="Center" />
                        <TextBlock x:Name="AboutApp" Text="ClassSoftwareHub" FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="AboutVersion" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="AboutSiteVersion" FontSize="12" Opacity="0.75" />
                </StackPanel>

                
                <GridView x:Name="SettingsQuickGrid" Margin="0,6,0,0" Padding="0" SelectionMode="None"
                          IsItemClickEnabled="True" ItemClick="Quick_ItemClick"
                          ItemTemplate="{StaticResource QuickLinkNormal}"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="192" ItemHeight="88" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>

                
                <TextBlock Text="外观" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                <StackPanel Spacing="4">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <controls:SettingsCard x:Name="ThemeCard" Header="颜色模式" Description="跟随系统时，随 Windows 的深浅色设置自动切换。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE790;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ThemeCombo" MinWidth="170" SelectionChanged="ThemeChoice_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="system" />
                            <ComboBoxItem Content="浅色" Tag="light" />
                            <ComboBoxItem Content="深色" Tag="dark" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="桌面悬浮窗单独设置外观"
                                           Description="只影响侧边栏与常用工具浮窗。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE772;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="SplitThemeSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                      Toggled="SplitTheme_Toggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="外部组件外观">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE772;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Description>
                            <TextBlock x:Name="ExtThemeHint" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </controls:SettingsCard.Description>
                        <ComboBox x:Name="ExtThemeCombo" MinWidth="170" SelectionChanged="ExtTheme_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="system" />
                            <ComboBoxItem Content="浅色" Tag="light" />
                            <ComboBoxItem Content="深色" Tag="dark" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="窗口背景效果"
                                           Description="截图框选层与钉图不参与。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE81E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="BackdropCombo" MinWidth="170" SelectionChanged="BackdropChoice_SelectionChanged">
                            <ComboBoxItem Content="亚克力（半透明）" Tag="acrylic" />
                            <ComboBoxItem Content="云母（更接近系统窗口）" Tag="mica" />
                            <ComboBoxItem Content="纯色（最省性能）" Tag="solid" />
                        </ComboBox>
                    </controls:SettingsCard>

                </StackPanel>

                
                





                <TextBlock Text="侧边栏导航" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                <StackPanel Spacing="4">

                    <controls:SettingsCard Header="资源管理器右键菜单"
                                           Description="在 Markdown 文件、图片或任意文件上右键，可直接用本程序打开、取色、生成二维码或校验编码。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE712;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="ShellMenuSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                      Toggled="ShellMenuSwitch_Toggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="设置迁移"
                                           Description="导出外观、侧边栏、快捷应用与 AI 模板；换机导入即可恢复。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </controls:SettingsCard.HeaderIcon>
                        <Button Content="打开向导" Click="Migration_Click" />
                    </controls:SettingsCard>
                    <controls:SettingsCard Header="导航栏项目"
                                           Description="选择哪些页面单独放在导航栏上，其余的收进「课堂工具」或「系统工具」。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8A0;" />
                        </controls:SettingsCard.HeaderIcon>
                        <Button Content="自定义" Click="CustomizeNav_Click" />
                    </controls:SettingsCard>
                </StackPanel>

                
                <TextBlock Text="窗口" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                <StackPanel Spacing="4">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <controls:SettingsCard Header="窗口始终置于最前"
                                           Description="开启后主窗口不会被其他窗口遮挡。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE718;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="TopMostSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                      Toggled="TopMostSwitch_Toggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard x:Name="StartupCard" Header="开机自动启动"
                                           Description="登录 Windows 后自动运行本程序。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7E8;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="AutoStartSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                      Toggled="AutoStartSwitch_Toggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="开机时最小化启动">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE921;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Description>
                            <TextBlock x:Name="MinimizeHint" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="MinimizeSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                      Toggled="MinimizeSwitch_Toggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="点关闭时收进托盘"
                                           Description="关闭主窗口时程序继续在后台运行，从托盘图标可重新打开。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7E7;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="TraySwitch" OnContent="开" OffContent="关" MinWidth="0"
                                      Toggled="TraySwitch_Toggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="显示器适配"
                                           Description="当前显示器的缩放、分辨率与显示模式，跨屏拖动后自动刷新。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7F4;" />
                        </controls:SettingsCard.HeaderIcon>
                        <TextBlock x:Name="DisplayInfoText" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </controls:SettingsCard>
                </StackPanel>

                
                

                <TextBlock Text="课堂快捷键" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                <StackPanel Spacing="4">
                    <controls:SettingsExpander x:Name="HotkeyExpander" Header="全局快捷键"
                                               Description="在任何窗口按下组合键都能用，主界面收进托盘时同样有效。"
                                               IsExpanded="False">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE92E;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>

                            <controls:SettingsCard Header="启用全局快捷键">
                                <controls:SettingsCard.Description>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="关掉之后组合键全部还给其他程序。"
                                                   TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="HotkeyStatusText" TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </controls:SettingsCard.Description>
                                <ToggleSwitch x:Name="HotkeysSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                              Toggled="HotkeysSwitch_Toggled" />
                            </controls:SettingsCard>

                            <controls:SettingsCard Header="显示主界面" Description="把收进托盘的窗口叫回来。">
                                <Button x:Name="HotkeyShowButton" Click="HotkeyShow_Click" KeyDown="HotkeyButton_KeyDown" LostFocus="HotkeyButton_LostFocus"
                                        MinWidth="132" HorizontalContentAlignment="Center" FontFamily="Consolas"
                                        Content="Ctrl+Alt+0"
                                        ToolTipService.ToolTip="点一下，然后直接按新的组合键" />
                            </controls:SettingsCard>

                            <controls:SettingsCard Header="教室喊话" Description="直接跳到喊话页。">
                                <Button x:Name="HotkeyAnnounceButton" Click="HotkeyAnnounce_Click" KeyDown="HotkeyButton_KeyDown" LostFocus="HotkeyButton_LostFocus"
                                        MinWidth="132" HorizontalContentAlignment="Center" FontFamily="Consolas"
                                        Content="Ctrl+Alt+1"
                                        ToolTipService.ToolTip="点一下，然后直接按新的组合键" />
                            </controls:SettingsCard>

                            <controls:SettingsCard Header="课堂计时器" Description="弹出计时器浮窗，压在 PPT 上面；不叫主界面。">
                                <Button x:Name="HotkeyTimerButton" Click="HotkeyTimer_Click" KeyDown="HotkeyButton_KeyDown" LostFocus="HotkeyButton_LostFocus"
                                        MinWidth="132" HorizontalContentAlignment="Center" FontFamily="Consolas"
                                        Content="Ctrl+Alt+2"
                                        ToolTipService.ToolTip="点一下，然后直接按新的组合键" />
                            </controls:SettingsCard>

                            <controls:SettingsCard Header="PPT 触控优化" Description="直接跳到触控优化页。">
                                <Button x:Name="HotkeyPptButton" Click="HotkeyPpt_Click" KeyDown="HotkeyButton_KeyDown" LostFocus="HotkeyButton_LostFocus"
                                        MinWidth="132" HorizontalContentAlignment="Center" FontFamily="Consolas"
                                        Content="Ctrl+Alt+3"
                                        ToolTipService.ToolTip="点一下，然后直接按新的组合键" />
                            </controls:SettingsCard>

                            <controls:SettingsCard Header="恢复默认组合" Description="改乱了可以一键回到 Ctrl+Alt+0 ~ 3。">
                                <Button Content="恢复默认" Click="HotkeyReset_Click" />
                            </controls:SettingsCard>

                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>
                </StackPanel>

                
                

                <TextBlock Text="Hub AI" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                <StackPanel Spacing="4">

                    <controls:SettingsCard x:Name="HubAiCard" Header="Hub AI"
                                           Description="模型服务自备，本软件不托管密钥。"
                                           IsClickEnabled="True" Click="OpenHubAiSettings_Click">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8F2;" />
                        </controls:SettingsCard.HeaderIcon>
                        
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="助手模板" Description="切换课件、解题、代码三类助手预设。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE945;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="AiTemplateCombo" MinWidth="170" SelectionChanged="AiTemplate_Changed">
                            <ComboBoxItem Content="通用助手" Tag="default" />
                            <ComboBoxItem Content="课件助手" Tag="course" />
                            <ComboBoxItem Content="解题助手" Tag="solver" />
                            <ComboBoxItem Content="代码助手" Tag="coder" />
                        </ComboBox>
                    </controls:SettingsCard>

                </StackPanel>

                
                

                <TextBlock Text="查阅单词" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                <StackPanel Spacing="4">

                    <controls:SettingsCard Header="词典源优先级" Description="先查本地，未收录再联网。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8F1;" />
                        </controls:SettingsCard.HeaderIcon>

                        

                        <ComboBox x:Name="DictSourceCombo" MinWidth="128"
                                  SelectionChanged="DictSource_SelectionChanged">
                            <ComboBoxItem Content="离线优先" Tag="offline-first" />
                            <ComboBoxItem Content="在线优先" Tag="online-first" />
                            <ComboBoxItem Content="仅离线" Tag="offline-only" />
                            <ComboBoxItem Content="仅在线" Tag="online-only" />
                        </ComboBox>
                    </controls:SettingsCard>

                </StackPanel>

                
                


                <TextBlock Text="诊断" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                <StackPanel Spacing="4">

                    <controls:SettingsCard Header="日志查看"
                                           Description="可按级别筛选，也可导出交给开发者。"
                                           IsClickEnabled="True" Click="OpenLogViewer_Click">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7C3;" />
                        </controls:SettingsCard.HeaderIcon>
                        




                    </controls:SettingsCard>

                </StackPanel>

                
                




                <TextBlock Text="存储" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                <StackPanel Spacing="4">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <controls:SettingsCard Header="缓存保留数量"
                                           Description="保留最近几个版本，更早的在启动时清理。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE74D;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="CacheKeepCombo" MinWidth="170" SelectionChanged="CacheKeepCombo_SelectionChanged">
                            <ComboBoxItem Content="1 个" Tag="1" />
                            <ComboBoxItem Content="2 个" Tag="2" />
                            <ComboBoxItem Content="3 个" Tag="3" />
                            <ComboBoxItem Content="4 个" Tag="4" />
                            <ComboBoxItem Content="5 个" Tag="5" />
                            <ComboBoxItem Content="6 个" Tag="6" />
                            <ComboBoxItem Content="7 个" Tag="7" />
                            <ComboBoxItem Content="8 个" Tag="8" />
                            <ComboBoxItem Content="9 个" Tag="9" />
                            <ComboBoxItem Content="10 个" Tag="10" />
                        </ComboBox>
                    </controls:SettingsCard>

                    

                    <controls:SettingsCard Header="清除缓存"
                                           Description="删掉旧版本的素材缓存，只保留当前正在用的那一个。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE894;" />
                        </controls:SettingsCard.HeaderIcon>
                        <Button Content="立即清除" Click="ClearCache_Click" />
                    </controls:SettingsCard>

                    
                    <controls:SettingsExpander x:Name="CacheExpander" Header="本地缓存"
                                               Description="可打开目录，也可删除旧版本。"
                                               IsExpanded="False"
                                               Expanded="Cache_Expanded">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Header="缓存目录">
                                <controls:SettingsCard.Description>
                                    <StackPanel Spacing="6" Margin="0,4,0,0">
                                        <TextBlock x:Name="CacheDirText" TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="CacheSummaryText" TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="打开缓存目录" Click="OpenCacheDir_Click" />
                                        </StackPanel>
                                        <StackPanel x:Name="CacheList" Spacing="6" />
                                        


                                        <StackPanel x:Name="CachePager" Orientation="Horizontal" Spacing="8"
                                                    Margin="0,4,0,0" Visibility="Collapsed">
                                            <Button x:Name="CachePrevButton" Content="上一页" Click="CachePrev_Click" />
                                            <TextBlock x:Name="CachePageText" VerticalAlignment="Center"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button x:Name="CacheNextButton" Content="下一页" Click="CacheNext_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </controls:SettingsCard.Description>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <controls:SettingsCard Header="日志保留天数"
                                           Description="超期的在启动时自动清理。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE81C;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="LogKeepCombo" MinWidth="170" SelectionChanged="LogKeepCombo_SelectionChanged">
                            <ComboBoxItem Content="3 天" Tag="3" />
                            <ComboBoxItem Content="7 天" Tag="7" />
                            <ComboBoxItem Content="15 天" Tag="15" />
                            <ComboBoxItem Content="30 天" Tag="30" />
                            <ComboBoxItem Content="永不删除" Tag="0" />
                        </ComboBox>
                    </controls:SettingsCard>

                    
                    <controls:SettingsExpander x:Name="LogExpander" Header="本地日志"
                                               Description="可展开查看，也可删除某一次。"
                                               IsExpanded="False"
                                               Expanded="Log_Expanded">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE7C3;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Header="日志目录">
                                <controls:SettingsCard.Description>
                                    <StackPanel Spacing="6" Margin="0,4,0,0">
                                        <TextBlock x:Name="LogDirText" TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock x:Name="LogSummaryText" TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="打开日志目录" Click="OpenLogDir_Click" />
                                        </StackPanel>
                                        <StackPanel x:Name="LogList" Spacing="6" />
                                        
                                        <StackPanel x:Name="LogPager" Orientation="Horizontal" Spacing="8"
                                                    Margin="0,4,0,0" Visibility="Collapsed">
                                            <Button x:Name="LogPrevButton" Content="上一页" Click="LogPrev_Click" />
                                            <TextBlock x:Name="LogPageText" VerticalAlignment="Center"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button x:Name="LogNextButton" Content="下一页" Click="LogNext_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </controls:SettingsCard.Description>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                </StackPanel>

                
                

                <TextBlock Text="软件内容" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                <StackPanel Spacing="4">

                    <controls:SettingsCard x:Name="ContentCard" Header="软件内容">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Description>
                            <StackPanel Spacing="6" Margin="0,4,0,0">
                                <TextBlock Text="每次启动自动获取最新清单。"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ContentSummary" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="ContentSource" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ContentIssues" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button Content="重新读取内容" Click="ReloadContent_Click" />
                                    <Button Content="从网络获取" Click="SyncContent_Click" />
                                    <Button Content="打开内容目录" Click="OpenContentDir_Click" />
                                </StackPanel>
                            </StackPanel>
                        </controls:SettingsCard.Description>
                    </controls:SettingsCard>

                    




                    <controls:SettingsCard Header="GitHub 下载体验优化">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE945;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Description>
                            <StackPanel Spacing="6" Margin="0,4,0,0">
                                <TextBlock Text="仅影响 GitHub 来源，官网直链不受影响。"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="GithubRouteHint" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                        </controls:SettingsCard.Description>
                        <ComboBox x:Name="GithubRouteCombo" MinWidth="240"
                                  SelectionChanged="GithubRoute_SelectionChanged">
                            <ComboBoxItem Tag="auto">
                                <TextBlock Text="自动" />
                            </ComboBoxItem>
                            <ComboBoxItem Tag="selfhosted">
                                




                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="自建加速服务" />
                                    <TextBlock Text="Exp"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="github">
                                <TextBlock Text="GitHub 源" />
                            </ComboBoxItem>
                        </ComboBox>
                    </controls:SettingsCard>

                    



                    <controls:SettingsCard Header="下载文件夹">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Description>
                            <StackPanel Spacing="8" Margin="0,4,0,0">
                                <TextBlock x:Name="DownloadDirText" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="更改文件夹…" Click="DownloadDir_Change_Click" />
                                    <Button Content="打开文件夹" Click="DownloadDir_Open_Click" />
                                    <Button x:Name="DownloadDirResetBtn" Content="恢复默认"
                                            Click="DownloadDir_Reset_Click" />
                                </StackPanel>
                            </StackPanel>
                        </controls:SettingsCard.Description>
                    </controls:SettingsCard>

                </StackPanel>

                
                <TextBlock x:Name="UpdateSectionHeader" Text="更新" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                <StackPanel Spacing="4">
                    <StackPanel.ChildrenTransitions>
                        <TransitionCollection>
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </StackPanel.ChildrenTransitions>

                    <controls:SettingsCard Header="当前版本">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE896;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Description>
                            <TextBlock x:Name="UpdateCurrent" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </controls:SettingsCard.Description>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="更新通道"
                                           Description="稳定通道更稳；Insider 通道能更早拿到新功能。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE895;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ChannelCombo" MinWidth="170" SelectionChanged="ChannelChoice_SelectionChanged">
                            <ComboBoxItem Content="稳定通道" Tag="stable" />
                            <ComboBoxItem Content="Insider 通道" Tag="insider" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="启动时自动检查更新"
                                           Description="仅检查，不自动安装。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE72C;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="AutoCheckSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                      Toggled="AutoCheckSwitch_Toggled" />
                    </controls:SettingsCard>

                    



                    <controls:SettingsCard Header="检查更新" Description="发现新版本先询问，不会自动安装。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE896;" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Spacing="10" MaxWidth="420" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="CheckButton" Content="检查更新" Click="CheckUpdate_Click"
                                        Style="{ThemeResource AccentButtonStyle}" />
                            </StackPanel>
                            <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" />
                            <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            







                        </StackPanel>
                    </controls:SettingsCard>

                    

                    <controls:SettingsCard Header="安装包保留数量"
                                           Description="保留最近几个安装包，便于装回旧版。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE74D;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="KeepCombo" MinWidth="170" SelectionChanged="KeepCombo_SelectionChanged">
                            <ComboBoxItem Content="1 个" Tag="1" />
                            <ComboBoxItem Content="2 个" Tag="2" />
                            <ComboBoxItem Content="3 个" Tag="3" />
                            <ComboBoxItem Content="4 个" Tag="4" />
                            <ComboBoxItem Content="5 个" Tag="5" />
                            <ComboBoxItem Content="6 个" Tag="6" />
                            <ComboBoxItem Content="7 个" Tag="7" />
                            <ComboBoxItem Content="8 个" Tag="8" />
                            <ComboBoxItem Content="9 个" Tag="9" />
                            <ComboBoxItem Content="10 个" Tag="10" />
                        </ComboBox>
                    </controls:SettingsCard>

                    

                    <controls:SettingsExpander x:Name="InstallerExpander" Header="本地安装包"
                                               Description="可直接覆盖安装当前或更旧版本。"
                                               IsExpanded="False"
                                               Expanded="Installer_Expanded">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Header="已下载的安装包">
                                <controls:SettingsCard.Description>
                                    <StackPanel Spacing="6" Margin="0,4,0,0">
                                        <TextBlock x:Name="InstallerDirText" TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel x:Name="InstallerList" Spacing="6" />
                                        
                                        <StackPanel x:Name="InstallerPager" Orientation="Horizontal" Spacing="8"
                                                    Margin="0,4,0,0" Visibility="Collapsed">
                                            <Button x:Name="InstallerPrevButton" Content="上一页" Click="InstallerPrev_Click" />
                                            <TextBlock x:Name="InstallerPageText" VerticalAlignment="Center"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button x:Name="InstallerNextButton" Content="下一页" Click="InstallerNext_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </controls:SettingsCard.Description>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    

                    <controls:SettingsExpander x:Name="HistoryExpander" Header="版本记录"
                                               Description="本机运行过哪些版本，以及可以从仓库装回的旧版本。"
                                               IsExpanded="False"
                                               Expanded="History_Expanded">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE81C;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>

                            <controls:SettingsCard Header="本机运行过的版本">
                                <controls:SettingsCard.Description>
                                    <StackPanel Spacing="4" Margin="0,4,0,0">
                                        <TextBlock Text="应用每次启动都会记一条（时间为本机时间），按时间倒序。"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel x:Name="LocalHistoryList" Spacing="6" />
                                        
                                        <StackPanel x:Name="LocalHistoryPager" Orientation="Horizontal" Spacing="8"
                                                    Margin="0,4,0,0" Visibility="Collapsed">
                                            <Button x:Name="LocalHistoryPrevButton" Content="上一页" Click="LocalHistoryPrev_Click" />
                                            <TextBlock x:Name="LocalHistoryPageText" VerticalAlignment="Center"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button x:Name="LocalHistoryNextButton" Content="下一页" Click="LocalHistoryNext_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </controls:SettingsCard.Description>
                            </controls:SettingsCard>

                            <controls:SettingsCard Header="从仓库装回旧版本">
                                <controls:SettingsCard.Description>
                                    <StackPanel Spacing="8" Margin="0,4,0,0">
                                        <TextBlock Text="装回旧版会覆盖程序文件，设置不受影响。"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="LoadHistoryButton" Content="从仓库加载可回滚的版本"
                                                    Click="LoadHistory_Click" />
                                            <ProgressRing x:Name="HistoryRing" Width="20" Height="20"
                                                          IsActive="False" Visibility="Collapsed" />
                                        </StackPanel>
                                        <StackPanel x:Name="HistoryList" Spacing="6" />
                                        

                                        <StackPanel x:Name="HistoryPager" Orientation="Horizontal" Spacing="8"
                                                    Margin="0,4,0,0" Visibility="Collapsed">
                                            <Button x:Name="HistoryPrevButton" Content="上一页" Click="HistoryPrev_Click" />
                                            <TextBlock x:Name="HistoryPageText" VerticalAlignment="Center"
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <Button x:Name="HistoryNextButton" Content="下一页" Click="HistoryNext_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </controls:SettingsCard.Description>
                            </controls:SettingsCard>

                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
