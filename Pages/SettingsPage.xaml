<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.SettingsPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:ClassSoftwareHub.Desktop.Core"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    Background="{x:Null}">

    <!--
      设置页版式遵循 WinUI 3 / WinUI Gallery 的设置页规范（2026-09-28 重构）：
        · 整页背景透明 —— 窗口的 Mica / 亚克力从 MainWindow 的 SystemBackdrop 透上来，
          不允许再出现纯黑、纯灰的实心底色（旧版是一整块自绘 Border，把材质全盖死了）。
        · 每一项 = 一张 SettingsCard：左侧 HeaderIcon + Header（BodyStrong）+ Description（Caption
          + TextFillColorSecondary，由卡片模板自动套），右侧放开关 / 下拉 / 按钮。
          卡片自带 16px 内边距，右侧控件与卡片右边缘的间距天然统一，不要自己再加外边距。
        · 同一组内的卡片间距 4px（StackPanel Spacing），组标题距上一组 24px。
        · 折叠区用 SettingsExpander，外观与 SettingsCard 一致，不再混用原生 Expander（圆角/描边不一样）。
      ⚠️ 卡片模板对 Header / Description 的字体样式是写死在控件模板里的，别再手工指定，
         否则会和工具栏那套 TextBlock 样式打架。
    -->

    <Page.Resources>
        <!-- 快捷入口两套模板（同首页）：颜色全走 {ThemeResource}，浅色/深色自己会变 -->
        <DataTemplate x:Key="QuickLinkNormal">
            <Border CornerRadius="8" Padding="12,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="{Binding Glyph}" FontSize="24" HorizontalAlignment="Center"
                              Foreground="{ThemeResource TextFillColorPrimaryBrush}" Opacity="0.95" />
                    <TextBlock Text="{Binding Name}" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="QuickLinkAccent">
            <Border CornerRadius="8" Padding="12,10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="{ThemeResource AccentFillColorDefaultBrush}">
                <StackPanel Spacing="7" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="{Binding Glyph}" FontSize="24" HorizontalAlignment="Center"
                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Opacity="0.95" />
                    <TextBlock Text="{Binding Name}" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <core:QuickLinkSelector x:Key="QuickLinkSelector"
                                Normal="{StaticResource QuickLinkNormal}"
                                Accent="{StaticResource QuickLinkAccent}" />
    </Page.Resources>

    <!-- ⛔ 不写 Background：App.xaml 给全站 ScrollViewer 设了 Transparent（见那里的注释）——
         写 `{x:Null}` 会盖掉它，标题上方的缝隙又会滚不动。 -->
    <!-- ⛔ 间距写在内部 Grid 的 Margin 上（同首页）：ScrollViewer.Padding 的底部不参与
         滚动范围计算，滚到底最后一条内容仍被裁（WinUI 3 已知坑，2026-10-01 实测）。 -->
    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto">
        <!-- 和首页同一套版式：三列 Grid 把内容钉在中间 960 宽，导航展开/收起都不动 -->
        <Grid Margin="24,36,24,44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="998*" MaxWidth="960" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1">

                <TextBlock Text="设置" FontSize="28" FontWeight="Bold" />

                <!-- ===== 关于（最上，不要卡片底，自成一块区域） ===== -->
                <StackPanel Spacing="4" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Image x:Name="AboutIcon" Width="44" Height="44" VerticalAlignment="Center" />
                        <TextBlock x:Name="AboutApp" Text="ClassSoftwareHub" FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock x:Name="AboutVersion" FontSize="28" FontWeight="Bold" Margin="0,6,0,0"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="AboutSiteVersion" FontSize="12" Opacity="0.75" />
                </StackPanel>

                <!-- 相关链接（在版本号下面，跟首页那行同款） -->
                <GridView x:Name="SettingsQuickGrid" Margin="0,6,0,0" Padding="0" SelectionMode="None"
                          IsItemClickEnabled="True" ItemClick="Quick_ItemClick"
                          ItemTemplateSelector="{StaticResource QuickLinkSelector}"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="192" ItemHeight="88" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                </GridView>

                <!-- ================= 外观 ================= -->
                <TextBlock Text="外观" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                <StackPanel Spacing="4">

                    <controls:SettingsCard Header="颜色模式" Description="跟随系统时，随 Windows 的深浅色设置自动切换。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE790;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ThemeCombo" MinWidth="170" SelectionChanged="ThemeChoice_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="system" />
                            <ComboBoxItem Content="浅色" Tag="light" />
                            <ComboBoxItem Content="深色" Tag="dark" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="外部组件单独设置外观"
                                           Description="外部组件指屏幕侧边栏、常用工具浮窗与截图编辑窗；主界面不受影响。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE772;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="SplitThemeSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                      Toggled="SplitTheme_Toggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="外部组件外观">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE772;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Description>
                            <TextBlock x:Name="ExtThemeHint" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </controls:SettingsCard.Description>
                        <ComboBox x:Name="ExtThemeCombo" MinWidth="170" SelectionChanged="ExtTheme_SelectionChanged">
                            <ComboBoxItem Content="跟随系统" Tag="system" />
                            <ComboBoxItem Content="浅色" Tag="light" />
                            <ComboBoxItem Content="深色" Tag="dark" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="窗口背景效果"
                                           Description="主界面、常用工具浮窗与截图编辑窗都随此项；截图框选层与钉图不参与。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE81E;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="BackdropCombo" MinWidth="170" SelectionChanged="BackdropChoice_SelectionChanged">
                            <ComboBoxItem Content="亚克力（半透明）" Tag="acrylic" />
                            <ComboBoxItem Content="云母（更接近系统窗口）" Tag="mica" />
                            <ComboBoxItem Content="纯色（最省性能）" Tag="solid" />
                        </ComboBox>
                    </controls:SettingsCard>

                </StackPanel>

                <!-- ================= 窗口 ================= -->
                <TextBlock Text="窗口" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                <StackPanel Spacing="4">

                    <controls:SettingsCard Header="窗口始终置于最前"
                                           Description="开启后主窗口不会被其他窗口遮挡。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE718;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="TopMostSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                      Toggled="TopMostSwitch_Toggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="开机自动启动"
                                           Description="登录 Windows 后自动运行本程序。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7E8;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="AutoStartSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                      Toggled="AutoStartSwitch_Toggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="开机时最小化启动">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE921;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Description>
                            <TextBlock x:Name="MinimizeHint" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </controls:SettingsCard.Description>
                        <ToggleSwitch x:Name="MinimizeSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                      Toggled="MinimizeSwitch_Toggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="点关闭时收进托盘"
                                           Description="关闭主窗口时程序继续在后台运行，从托盘图标可重新打开。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7E7;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="TraySwitch" OnContent="开" OffContent="关" MinWidth="0"
                                      Toggled="TraySwitch_Toggled" />
                    </controls:SettingsCard>

                </StackPanel>

                <!-- ================= 软件内容 ================= -->
                <!-- 2026-10-01：原「常用工具」整组（浮窗置顶 / 屏幕边缘侧边栏 / 放置模式 / 贴哪条边）
                     与「截图」两项，都搬去了「侧边布局」页 —— 那页本就是侧边栏与常用工具的布置中心。 -->
                <TextBlock Text="软件内容" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                <StackPanel Spacing="4">

                    <controls:SettingsCard Header="本地内容包">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Description>
                            <StackPanel Spacing="6" Margin="0,4,0,0">
                                <TextBlock Text="软件清单与分类来自内容包；重新读取会用当前本地数据再解析一遍。"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ContentSummary" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="ContentSource" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock x:Name="ContentIssues" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                                    <Button Content="重新读取内容" Click="ReloadContent_Click" />
                                    <Button Content="同步内容包" Click="SyncContent_Click" />
                                    <Button Content="打开内容目录" Click="OpenContentDir_Click" />
                                </StackPanel>
                            </StackPanel>
                        </controls:SettingsCard.Description>
                    </controls:SettingsCard>

                </StackPanel>

                <!-- ================= 更新 ================= -->
                <TextBlock Text="更新" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                <StackPanel Spacing="4">

                    <controls:SettingsCard Header="当前版本">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE896;" />
                        </controls:SettingsCard.HeaderIcon>
                        <controls:SettingsCard.Description>
                            <TextBlock x:Name="UpdateCurrent" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </controls:SettingsCard.Description>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="更新通道"
                                           Description="稳定通道更稳；Insider 通道能更早拿到新功能。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE895;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ChannelCombo" MinWidth="170" SelectionChanged="ChannelChoice_SelectionChanged">
                            <ComboBoxItem Content="稳定通道" Tag="stable" />
                            <ComboBoxItem Content="Insider 通道" Tag="insider" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="启动时自动检查更新"
                                           Description="仅检查，不自动安装。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE72C;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="AutoCheckSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                      Toggled="AutoCheckSwitch_Toggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="检查更新"
                                           Description="发现新版本会先询问是否安装，不会自动更新；最小化启动时会通过系统通知提醒。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE896;" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="CheckButton" Content="检查更新" Click="CheckUpdate_Click"
                                        Style="{ThemeResource AccentButtonStyle}" />
                            </StackPanel>
                            <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" />
                            <TextBlock x:Name="UpdateStatus" TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock x:Name="UpdateNotes" TextWrapping="Wrap" MaxLines="8" Visibility="Collapsed"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <!-- 安装包自动清理：updates 目录只留最近 N 个，更早的启动时删除（InstallerCleanup）。
                         留下的包给「版本记录 → 装回旧版本」用：本地有同名包且校验通过就不再下载。 -->
                    <controls:SettingsCard Header="安装包保留数量"
                                           Description="自动清理更新时下载的安装包：本地保留最近几个，更早的自动删除。保留的安装包可用于装回旧版本，无需重新下载。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE74D;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="KeepCombo" MinWidth="170" SelectionChanged="KeepCombo_SelectionChanged">
                            <ComboBoxItem Content="1 个" Tag="1" />
                            <ComboBoxItem Content="2 个" Tag="2" />
                            <ComboBoxItem Content="3 个" Tag="3" />
                            <ComboBoxItem Content="4 个" Tag="4" />
                            <ComboBoxItem Content="5 个" Tag="5" />
                            <ComboBoxItem Content="6 个" Tag="6" />
                            <ComboBoxItem Content="7 个" Tag="7" />
                            <ComboBoxItem Content="8 个" Tag="8" />
                            <ComboBoxItem Content="9 个" Tag="9" />
                            <ComboBoxItem Content="10 个" Tag="10" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <!-- 本地安装包：列表在展开时现读（平时折叠，不占加载时间）。
                         ⚠️ 内容走 Items / Description —— ContentAlignment="Vertical" 实测无效（§K.6） -->
                    <controls:SettingsExpander x:Name="InstallerExpander" Header="本地安装包"
                                               Description="更新时下载的安装包存放在此，可单独删除；删除后装回该版本需重新下载。"
                                               IsExpanded="False"
                                               Expanded="Installer_Expanded">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE8B7;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>
                            <controls:SettingsCard Header="已下载的安装包">
                                <controls:SettingsCard.Description>
                                    <StackPanel Spacing="6" Margin="0,4,0,0">
                                        <TextBlock x:Name="InstallerDirText" TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel x:Name="InstallerList" Spacing="6" />
                                    </StackPanel>
                                </controls:SettingsCard.Description>
                            </controls:SettingsCard>
                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                    <!-- 版本记录：内容走 Items（渲染在标题下方的整行区域），
                         不能塞进默认的 Content 位 —— 那样会挤在标题右侧，展开后成为一条窄长的右栏列表 -->
                    <controls:SettingsExpander x:Name="HistoryExpander" Header="版本记录"
                                               Description="本机运行过哪些版本，以及可以从仓库装回的旧版本。"
                                               IsExpanded="False"
                                               Expanded="History_Expanded">
                        <controls:SettingsExpander.HeaderIcon>
                            <FontIcon Glyph="&#xE81C;" />
                        </controls:SettingsExpander.HeaderIcon>
                        <controls:SettingsExpander.Items>

                            <controls:SettingsCard Header="本机运行过的版本">
                                <controls:SettingsCard.Description>
                                    <StackPanel Spacing="4" Margin="0,4,0,0">
                                        <TextBlock Text="应用每次启动都会记一条（时间为本机时间），按时间倒序。"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel x:Name="LocalHistoryList" Spacing="6" />
                                    </StackPanel>
                                </controls:SettingsCard.Description>
                            </controls:SettingsCard>

                            <controls:SettingsCard Header="从仓库装回旧版本">
                                <controls:SettingsCard.Description>
                                    <StackPanel Spacing="8" Margin="0,4,0,0">
                                        <TextBlock Text="从更新仓库加载可回滚的版本（正式版与 Insider 版）。装回旧版会覆盖当前程序文件，设置与软件内容不受影响。"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button x:Name="LoadHistoryButton" Content="从仓库加载可回滚的版本"
                                                    Click="LoadHistory_Click" />
                                            <ProgressRing x:Name="HistoryRing" Width="20" Height="20"
                                                          IsActive="False" Visibility="Collapsed" />
                                        </StackPanel>
                                        <StackPanel x:Name="HistoryList" Spacing="6" />
                                    </StackPanel>
                                </controls:SettingsCard.Description>
                            </controls:SettingsCard>

                        </controls:SettingsExpander.Items>
                    </controls:SettingsExpander>

                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
