<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.VirtualKeyboardPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <!--
      版式与「程序专杀」「白板专杀」同源：三列 Grid 把内容钉在中间 960 宽。
      ⚠️ 别用 Stretch + MaxWidth：一旦触发上限 WinUI 会把整列右甩。

      ⛔ 每一项都用 **系统 SettingsCard**（Nick 2026-09-30 明确：「不是要模仿 windows 原生，
         我就是要 windows 原生」「颜色就用主题色就行了」）。别退回自绘 Border 行 ——
         他自己举的正面例子就是设置页从自绘 Border 换成 SettingsCard 那次。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,36,24,44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" MaxWidth="960">

                <!-- 标题 + 实验性标记 -->
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="虚拟键盘" FontSize="28" FontWeight="Bold" />
                        <Border CornerRadius="4" Padding="8,3" Margin="0,0,0,6" VerticalAlignment="Bottom"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SystemFillColorCautionBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xEA80;" FontSize="11"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock Text="实验性功能" FontSize="11.5"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock FontSize="12.5" Opacity="0.65" TextWrapping="Wrap"
                               Text="自绘的触屏键盘。开启后，用手指点在可输入的输入框上即自动弹出；鼠标点击不会弹出。键盘的外观与键帽全部使用系统控件与主题色。" />
                </StackPanel>

                <!--
                  两条横幅，一红一黄，都在标题下方、所有设置之前。

                  【红】Nick 2026-09-30 要求置顶明示"极其不稳定"，用红色。
                       ⛔⛔ 别再改它的配色：中间试过"实心红底 #C42B1C + 白字"，被 Nick 当场否掉 ——
                          「为什么会这么红呢？刚才做的那一版红不是挺好的吗？」
                          就用 InfoBar 自己的 Severity="Error" 原生配色（浅色 #FDE7E9 底 / 深色 #442726 底，
                          红只落在图标与标题上）。**不要再加 Background / Foreground / IsIconVisible**。

                  【黄】说明这个功能为什么存在（Nick 2026-09-30 口述）：主要针对 Windows 10，
                      大屏 + 高 DPI 下系统屏幕键盘体验差、自定义尺寸调节余地小。
                      用 Severity="Warning" 的原生观感，同样不动配色。
                -->
                <InfoBar IsOpen="True" Severity="Error" IsClosable="False" Margin="0,20,0,0"
                         Title="此功能极不稳定"
                         Message="虚拟键盘仍在早期阶段，键位、弹出时机与外观都会随版本继续调整；个别机型上可能出现触摸不弹出、与系统输入法冲突、键位错位等情况。请先在非关键场合试用，并保留可用的备选输入方式。遇问题请通过「反馈中心」上报。" />

                <InfoBar IsOpen="True" Severity="Warning" IsClosable="False"
                         Margin="0,10,0,0"
                         Title="功能定位：主要针对 Windows 10"
                         Message="本功能主要针对 Windows 10 开发。部分 Windows 10 设备在屏幕较大、缩放比例较高时，系统屏幕键盘的可用体验较差 —— 键位偏小、占据屏幕过多，自定义尺寸的调节范围也有限，此功能即为改善这一情况而设。Windows 11 的系统屏幕键盘已能覆盖多数使用场景，可按需选用。" />

                <!-- ================= 总开关 ================= -->
                <TextBlock Text="启用" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                <StackPanel Spacing="4">

                    <controls:SettingsCard Header="启用虚拟键盘"
                                           Description="开启后会启动触摸监听与输入框判定。关闭时不会加载任何系统组件，也不改动系统设置。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE765;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="EnableSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                      Toggled="Enable_Toggled" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="打开键盘"
                                           Description="立即在屏幕底边摆出键盘，用来先看看效果。也可以从屏幕侧边栏的「键盘」按钮随时呼出。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8A7;" />
                        </controls:SettingsCard.HeaderIcon>
                        <Button x:Name="ShowButton" Content="打开键盘" Click="Show_Click" MinWidth="120" />
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="接管系统触摸键盘"
                                           Description="关闭系统触摸键盘在桌面模式下的自动弹出，避免与自绘键盘同时出现。此项是唯一会写入注册表的地方，开启前会自动备份原值，关闭功能或取消勾选时原样还原；手动叫出系统键盘（Win+Ctrl+O、任务栏图标）不受影响。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8AB;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ToggleSwitch x:Name="CaptureSwitch" OnContent="开" OffContent="关" MinWidth="0"
                                      Toggled="Capture_Toggled" />
                    </controls:SettingsCard>
                </StackPanel>

                <!-- ================= 布局与尺寸 ================= -->
                <TextBlock Text="布局与尺寸" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                <StackPanel Spacing="4">

                    <controls:SettingsCard Header="键盘布局"
                                           Description="完整：功能键齐全，与系统键盘一致。精简：数字并到字母键上，占地更小。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE80A;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ModeCombo" MinWidth="140" SelectionChanged="Mode_Changed">
                            <ComboBoxItem Content="完整" Tag="full" />
                            <ComboBoxItem Content="精简" Tag="compact" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="键盘大小"
                                           Description="整体缩放键帽与行高，0.7 至 1.6 倍连续可调。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE740;" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Slider x:Name="ScaleSlider" MinWidth="180" Minimum="0.7" Maximum="1.6"
                                    StepFrequency="0.05" ValueChanged="Scale_Changed" />
                            <TextBlock x:Name="ScaleText" MinWidth="46" VerticalAlignment="Center"
                                       FontSize="12.5" Opacity="0.75" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="键盘宽度"
                                           Description="占屏幕工作区宽度的比例，0.35 至 1.0 连续可调。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE9E9;" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Slider x:Name="WidthSlider" MinWidth="180" Minimum="0.35" Maximum="1.0"
                                    StepFrequency="0.05" ValueChanged="Width_Changed" />
                            <TextBlock x:Name="WidthText" MinWidth="46" VerticalAlignment="Center"
                                       FontSize="12.5" Opacity="0.75" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="键帽文字大小"
                                           Description="只影响键帽上的字，不改变键盘整体尺寸。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE8D2;" />
                        </controls:SettingsCard.HeaderIcon>
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Slider x:Name="FontSlider" MinWidth="180" Minimum="0.8" Maximum="1.3"
                                    StepFrequency="0.05" ValueChanged="Font_Changed" />
                            <TextBlock x:Name="FontText" MinWidth="46" VerticalAlignment="Center"
                                       FontSize="12.5" Opacity="0.75" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="排列方式"
                                           Description="贴靠屏幕底边，或自由摆位。自由摆位时按住键盘顶栏拖动即可移动。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE7C2;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="PlacementCombo" MinWidth="140" SelectionChanged="Placement_Changed">
                            <ComboBoxItem Content="贴靠底边" Tag="dock" />
                            <ComboBoxItem Content="自由悬浮" Tag="float" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="键盘底色" Description="默认跟随系统深浅色；键盘颜色本身取自主题。">
                        <controls:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE790;" />
                        </controls:SettingsCard.HeaderIcon>
                        <ComboBox x:Name="ThemeCombo" MinWidth="140" SelectionChanged="Theme_Changed">
                            <ComboBoxItem Content="跟随系统" Tag="system" />
                            <ComboBoxItem Content="浅色" Tag="light" />
                            <ComboBoxItem Content="深色" Tag="dark" />
                        </ComboBox>
                    </controls:SettingsCard>
                </StackPanel>

                <!-- ================= 说明 ================= -->
                <TextBlock Text="行为说明" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,24,0,8" />
                <StackPanel Spacing="6" Margin="4,0,0,0">
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="· 弹出时机：仅响应手指触摸。用手指点在能输入文字的位置即弹出；点在其他位置自动收起。鼠标点击不触发弹出。" />
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="· 手动打开：从侧边栏「键盘」按钮，或本页的「打开键盘」按钮呼出的键盘不会自动收起，需要手动点顶栏的收起按钮。" />
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="· 文字输入：键帽送出的是标准虚拟键码，因此当前输入法的中文、标点全角半角都能正常工作。" />
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="· 布局：完整为 5 行（含 Esc、Tab、大写锁定、Ctrl、Win、Alt、方向键）；精简为 4 行。键盘上的「&amp;123」可切换到符号，再切到数字键区。" />
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="· 生效条件：本程序需处于运行状态。本程序完全退出后，触摸弹出与系统键盘接管均停止。" />
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="· 已知限制：部分以管理员权限运行的程序会拒绝接收键盘输入，这属于系统的权限隔离机制。" />
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
