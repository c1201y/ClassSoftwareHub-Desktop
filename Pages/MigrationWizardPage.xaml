<Page x:Class="ClassSoftwareHub.Desktop.Pages.MigrationWizardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
        <StackPanel Padding="28,24,28,28" MaxWidth="720" Spacing="16">
            <TextBlock Text="设置迁移向导" FontSize="26" FontWeight="Bold" />
            <TextBlock Text="把这台电脑上的外观、侧边栏、Hub AI 模板和快捷应用导出成 JSON；换机后导入即可恢复。激活码、设备指纹和本地缓存不会被导出。"
                       TextWrapping="Wrap" Opacity="0.7" />
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="1. 导出当前设置" FontWeight="SemiBold" />
                    <TextBlock Text="选择保存位置，生成一份带当前版本号的迁移包。" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                    <Button Content="导出设置包…" Click="Export_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <TextBlock Text="2. 导入到这台电脑" FontWeight="SemiBold" />
                    <TextBlock Text="导入前会先在内存中校验结构；确认无误后覆盖当前偏好，建议先导出一份本机备份。" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                    <Button Content="选择并导入设置包…" Click="Import_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <InfoBar x:Name="ResultBar" IsOpen="False" Severity="Informational" />
        </StackPanel>
    </ScrollViewer>
</Page>
