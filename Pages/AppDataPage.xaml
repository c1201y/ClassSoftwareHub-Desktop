<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.AppDataPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClassSoftwareHub.Desktop.Pages">

    <!--
      AppData 管理（2026-10-13 新功能，Nick：「实验性功能就是 AppData 文件夹管理」）。

      ⛔⛔ 三层边界（界面上就是这么分的，改版式时别把它们揉回去）：
        第 1 层 **只读体检**（概览 · 本地 / 概览 · 漫游）—— 一级目录体积排行，**没有清理入口**
        第 2 层 **白名单清理**（可清理 · 系统临时 / 浏览器 / 商店应用 / 开发工具 / 图形）—— 永久删除
        第 3 层 **禁碰区** —— 一级目录整目录删除这条路上的按钮**压根不存在**（见 Services/AppDataScan 类注释）

      2026-10-14 与「应用卸载」页一起做过一次去网页感的改版（Nick 的第三轮反馈，两页同罪）：
        · **砍掉表格视图**（⛔ 不是改成下拉）—— 与列表内容一模一样，纯粹是凑出来的选择；
        · 标题下的解释长句删掉、包着工具条的卡片删掉，标题下方改成**动态计数**；
        · 分类下拉 / 重新扫描 / 说明 并到标题行右侧（原先孤零零占一整行，还套了个卡片）；
        · **行尾不再摆按钮**：改成一朵透明的「⋯」（`E712`），点开是**手建**的 `MenuFlyout`
          —— 里面是「打开文件夹」，可清理的行多一项「清理」。原先行尾并排两个按钮
          （`打开` + `清理`），几十行下来也是一面按钮墙。

      2026-10-15 加（Nick：「可清理项可以加一个复选框，可以统一管理。还有一件事，可以再增加一个按钮
      一个是复制文件路径。第二个功能是搜索……现在用户看到这么多文件夹，不知道是干啥的」）：
        · 可清理行加**系统多选**（`ListView.SelectionMode=Multiple`，靠系统那个 SelectionCheckBox，
          ⛔ 不是自己在 DataTemplate 里画一个 CheckBox —— 行模板里少一个控件就少一处 WMC9999 风险，
          而且这本来就是系统控件该干的事）；底部随之多出一条**批量动作条**。
        · 行尾「⋯」菜单扩到四项：复制完整路径 / 打开文件夹 / 在网上搜索完整路径 / 清理。
          ⛔ 搜索走**系统默认浏览器**（`UseShellExecute=true` 调 Bing），不内置 WebView2 ——
             本机唯一那个 WebView2 是只读 WebSheet，再起一个实例要摊用户数据目录与生命周期，
             而这个动作本来就是"去互联网查资料"，交给真浏览器能开标签、能继续点进去看。
          ⛔⛔ 检索词就是**完整路径原样**，不附加「AppData」「文件夹」之类的后缀
             （Nick 2026-10-15 定案：擅自概括会失真，同一个目录名挂在不同根下含义完全不同）。
        · 顶部加**常驻红条**（与「应用卸载」页同一条规则：永久删除类功能一律常驻风险提示，不可关闭）。

      ⚠️ 三个已踩过的编译坑，别在这里复现（都是同一个壳错误 `WMC9999`，没有行号）：
        · `ComboBox.ItemTemplate` + `x:Bind` 会让 XamlCompiler 崩在 PageCodeGen ⇒ 选项在代码里手建。
        · `Page.Resources` 里跨文件 `BasedOn` 同样会崩 ⇒ 八行 Setter 照抄。
        · ⛔⛔ 控件 `x:Name` **撞上行类型的属性名**（本页 `x:Name="CountText"` 曾撞 `AppDataRow.CountText`，
          行模板里又有 `{x:Bind CountText}`）⇒ 崩在 PageCodeGen。改名 `CountLine` 后立刻 0 错误。
          排查法：读 `obj\…\output.json` 的 `MSBuildLogEntries` 找到崩在哪一页，再**掏空法二分**。
    -->
    <Page.Resources>
        <!-- 行尾的图标按钮（⋯ / 说明）。⚠️ 八行 Setter **照抄**而不是跨文件 `BasedOn`：
             跨文件 BasedOn 会让 XAML 编译器在 Pass2 的代码生成阶段崩掉（见文件头注释）。 -->
        <Style x:Key="RowMoreButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    <!-- ⚠️ Background="Transparent" 是给滚轮接力用的（Core/WheelRelay.cs）：两侧留白也要参与命中测试 -->
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" MaxWidth="960" RowSpacing="10" Margin="0,36,0,44">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ── 标题行：左＝标题+实验性标记+计数，右＝分类 / 重新扫描 / 说明（全部并排） ── -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="AppData 管理" FontSize="28" FontWeight="Bold" />
                        <Border CornerRadius="5" Padding="8,3" Margin="0,0,0,6" VerticalAlignment="Bottom"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SystemFillColorCautionBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xEA80;" FontSize="11"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock Text="实验性功能" FontSize="12"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 标题下面这一行原本是一段解释话（已移进「说明」弹窗），现在放**计数**。
                         ⚠️ 名字必须叫 CountLine —— 「CountText」会撞行类型的 AppDataRow.CountText（见文件头） -->
                    <TextBlock x:Name="CountLine" Text="" FontSize="12" Opacity="0.65"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- 分类：**下拉单选**，一次只显示一个分类。
                     ⚠️ 选项内容在代码里建（FillCategories）—— `ItemTemplate` + `x:Bind` 会让编译器崩 -->
                <ComboBox x:Name="CategoryBox" Grid.Column="1" MinWidth="200"
                          VerticalAlignment="Top" Margin="0,4,0,0"
                          SelectionChanged="Category_Changed" />

                <Button x:Name="RescanButton" Grid.Column="2" Content="重新扫描" Click="Rescan_Click"
                        VerticalAlignment="Top" Margin="0,4,0,0" />

                <!-- ⚠️ Content 是 FontIcon ⇒ UIA 拿不到按钮名，显式给一个 -->
                <Button x:Name="AboutButton" Grid.Column="3" Click="About_Click"
                        Style="{StaticResource RowMoreButtonStyle}"
                        VerticalAlignment="Top" Margin="0,4,0,0"
                        AutomationProperties.Name="说明"
                        ToolTipService.ToolTip="这三层是怎么分的">
                    <FontIcon Glyph="&#xE946;" FontSize="15" />
                </Button>
            </Grid>

            <!-- ── 常驻风险提示 ──
                 ⛔ 与「应用卸载」页同一条规约：**永久删除类功能一律常驻红色提示、不给关**
                    （Nick 2026-10-15 定：「页面警告，常驻红色警告」）。
                 ⚠️ Severity 用 Error 而不是 Warning：这一层是**不入回收站**的直接删除，
                    比"改动系统"更重，配色上也要区分得开。 -->
            <InfoBar x:Name="RiskBar" Grid.Row="1"
                     Severity="Error" IsOpen="True" IsClosable="False"
                     Title="此操作将永久删除文件"
                     Message="清理不会进入回收站，删除后无法恢复。仅清空缓存目录的内容，目录本身保留。" />

            <!-- ── 内容区 ── -->
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListView x:Name="EntryList"
                          SelectionMode="None" IsItemClickEnabled="False"
                          SelectionChanged="Selection_Changed"
                          ItemContainerStyle="{StaticResource CshResultRowStyle}"
                          Padding="0,2,0,8">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:AppDataRow">
                            <Grid ColumnSpacing="12" MinHeight="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}" FontSize="15" Opacity="0.55"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontSize="14"
                                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Sub}" FontSize="12" Opacity="0.6"
                                               MaxLines="1" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Sub}" />
                                </StackPanel>

                                <!-- 体积 + 文件数：等宽数字（Typography.NumeralAlignment），否则统计过程中数字一跳整行抖 -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" FontSize="13"
                                               HorizontalAlignment="Right"
                                               Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Text="{x:Bind CountText, Mode=OneWay}" FontSize="12" Opacity="0.6"
                                               HorizontalAlignment="Right"
                                               Typography.NumeralAlignment="Tabular" />
                                </StackPanel>

                                <!-- 行尾：一朵透明的「⋯」。菜单里有「打开文件夹」，可清理的行多一项「清理」
                                     （⛔ 只读体检行永远不出「清理」）。 -->
                                <Button Grid.Column="3" Style="{StaticResource RowMoreButtonStyle}"
                                        Click="More_Click"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="更多操作"
                                        ToolTipService.ToolTip="更多操作">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 扫描中 -->
                <StackPanel x:Name="LoadingPanel" Grid.Row="0" Spacing="12" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ProgressRing IsActive="True" Width="34" Height="34" HorizontalAlignment="Center" />
                    <TextBlock Text="正在读取 AppData 目录结构" FontSize="12" Opacity="0.7"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 空状态 -->
                <StackPanel x:Name="EmptyPanel" Grid.Row="0" Spacing="10" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontSize="28" Opacity="0.45" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText" Text="这个分类下没有东西" FontSize="14" Opacity="0.7"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>

                <!-- ── 批量动作条 ──
                     只在「可清理 · ×××」分类下出现（⛔ 只读体检没有删除入口，别让它露出来）。
                     ⚠️ 全选 / 清空选择 都在代码里操作 `EntryList.SelectedItems`，不额外维护一份勾选状态 ——
                        勾选状态只有列表自己那一份，才不会出现"界面上没勾、其实记着"。
                     ⛔ 这里**没有**反选：这一页的动作全是删除，少一个花样少一次误删。 -->
                <Grid x:Name="CleanBar" Grid.Row="1" Visibility="Collapsed" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CleanBarSummary" FontSize="12" Opacity="0.7"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <Button x:Name="SelectAllButton" Grid.Column="1" Content="全选"
                            Click="SelectAll_Click" />

                    <Button x:Name="ClearSelButton" Grid.Column="2" Content="清空选择"
                            Click="ClearSel_Click" />

                    <Button x:Name="CleanSelectedButton" Grid.Column="3" Content="清理选中"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="CleanSelected_Click" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
