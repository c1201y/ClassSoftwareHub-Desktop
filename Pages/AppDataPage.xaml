<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.AppDataPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ClassSoftwareHub.Desktop.Pages">

    <!--
      AppData 管理（2026-10-13 新功能，Nick：「实验性功能就是 AppData 文件夹管理」）。

      ⛔⛔ 三层边界（界面上就是这么分的，改版式时别把它们揉回去）：
        第 1 层 **只读体检**（概览 · 本地 / 概览 · 漫游）—— 一级目录体积排行，**没有清理入口**
        第 2 层 **白名单清理**（可清理 · 系统临时 / 浏览器 / 商店应用 / 开发工具 / 图形）—— 永久删除
        第 3 层 **禁碰区** —— 一级目录整目录删除这条路上的按钮**压根不存在**（见 Services/AppDataScan 类注释）

      版式与「应用卸载」二版一致（Nick 2026-10-13 对那一版的要求同样适用）：
        页宽 960 写在**中列内容自身**（⛔ 不是给根元素定宽 + 居中）；
        分类＝**下拉单选**（⛔ 不是可独立开关的芯片）；列表 / 表格两种形式；说明按钮带图标。

      ⚠️ 三个已踩过的编译坑，别在这里复现（都是同一个壳错误 `WMC9999`，没有行号）：
        · `ComboBox.ItemTemplate` + `x:Bind` 会让 XamlCompiler 崩在 PageCodeGen ⇒ 选项在代码里手建。
        · `Page.Resources` 里跨文件 `BasedOn` 同样会崩 ⇒ 三行 Setter 照抄。
        · ⛔⛔ 控件 `x:Name` **撞上行类型的属性名**（本页 `x:Name="CountText"` 撞 `AppDataRow.CountText`，
          行模板里又有 `{x:Bind CountText}`）⇒ 崩在 PageCodeGen。改名 `CountLine` 后立刻 0 错误。
          排查法：读 `obj\…\output.json` 的 `MSBuildLogEntries` 找到崩在哪一页，再**掏空法二分**。
    -->
    <Page.Resources>
        <Style x:Key="CshTableRowStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="14,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <!-- ⚠️ Background="Transparent" 是给滚轮接力用的（Core/WheelRelay.cs）：两侧留白也要参与命中测试 -->
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" MaxWidth="960" RowSpacing="14" Margin="0,36,0,44">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ── 标题行 ── -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="AppData 管理" FontSize="28" FontWeight="Bold" />
                        <Border CornerRadius="5" Padding="8,3" Margin="0,0,0,6" VerticalAlignment="Bottom"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource SystemFillColorCautionBrush}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <FontIcon Glyph="&#xEA80;" FontSize="11"
                                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                <TextBlock Text="实验性功能" FontSize="12"
                                           Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="先看清是哪些文件夹在占地方，再决定要不要清。能清的一律只清缓存，删掉程序会自己重建。" />
                </StackPanel>

                <!-- 视图切换：⛔ 别换成 SelectorBar / Pivot（Nick 2026-10-11 否过） -->
                <RadioButtons x:Name="ViewChoice" Grid.Column="1" MaxColumns="2"
                              VerticalAlignment="Top" Margin="0,4,0,0"
                              SelectionChanged="ViewChoice_SelectionChanged">
                    <RadioButton Content="列表" Tag="list" />
                    <RadioButton Content="表格" Tag="table" />
                </RadioButtons>

                <!-- ⚠️ Content 是 StackPanel ⇒ UIA 拿不到按钮名，显式给一个 -->
                <Button x:Name="AboutButton" Grid.Column="2" Click="About_Click"
                        AutomationProperties.Name="说明"
                        VerticalAlignment="Top" Margin="0,4,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <FontIcon Glyph="&#xE946;" FontSize="14" />
                        <TextBlock Text="说明" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- ── 工具条：分类下拉 + 计数 | 重新扫描 ── -->
            <Border Grid.Row="1" CornerRadius="4" Padding="18,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- 分类：**下拉单选**，一次只显示一个分类。
                         ⚠️ 选项内容在代码里建（FillCategories）—— `ItemTemplate` + `x:Bind` 会让编译器崩 -->
                    <ComboBox x:Name="CategoryBox" MinWidth="200" VerticalAlignment="Center"
                              SelectionChanged="Category_Changed" />

                    <TextBlock x:Name="CountLine" Grid.Column="1" Text="" FontSize="12" Opacity="0.7"
                               Margin="8,0,0,0" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                    <Button Grid.Column="2" x:Name="RescanButton" Content="重新扫描" Click="Rescan_Click" />
                </Grid>
            </Border>

            <!-- ── 表头（只有表格视图显示）。⚠️ 列宽必须与表格行模板逐列一致，否则错位 ── -->
            <Grid x:Name="TableHeader" Grid.Row="2" Visibility="Collapsed"
                  ColumnSpacing="12" Margin="14,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="104" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="名称" FontSize="12" Opacity="0.6" Margin="0,0,0,7" />
                <TextBlock Grid.Column="2" Text="体积" FontSize="12" Opacity="0.6"
                           HorizontalAlignment="Right" Margin="0,0,0,7" />
                <TextBlock Grid.Column="3" Text="操作" FontSize="12" Opacity="0.6" Margin="0,0,0,7" />
                <!-- 这一条线就是"表格"与"列表"的观感分界。
                     ⚠️ 用文字的下边距把线顶到底，别写负 Margin（负 Margin 出过 LayoutCycle） -->
                <Border Grid.ColumnSpan="4" Height="1" VerticalAlignment="Bottom"
                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </Grid>

            <!-- ── 内容区：两个 ListView 叠放，按视图切换显隐（共用同一次扫描的结果） ── -->
            <Grid Grid.Row="3">
                <ListView x:Name="EntryList"
                          SelectionMode="None" IsItemClickEnabled="False"
                          ItemContainerStyle="{StaticResource CshResultRowStyle}"
                          Padding="0,2,0,8">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:AppDataRow">
                            <Grid ColumnSpacing="12" MinHeight="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="104" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}" FontSize="15" Opacity="0.55"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontSize="14"
                                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Sub}" FontSize="12" Opacity="0.6"
                                               MaxLines="1" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Sub}" />
                                </StackPanel>

                                <!-- 体积 + 文件数：等宽数字（Typography.NumeralAlignment），否则统计过程中数字一跳整行抖 -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" FontSize="13"
                                               HorizontalAlignment="Right"
                                               Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Text="{x:Bind CountText, Mode=OneWay}" FontSize="12" Opacity="0.6"
                                               HorizontalAlignment="Right"
                                               Typography.NumeralAlignment="Tabular" />
                                </StackPanel>

                                <!-- 操作列：「打开」**每一行都有**（只读体检也想进去看一眼）；
                                     「清理」只有白名单命中项才出现（⛔ 只读项永远不出清理按钮）。
                                     ⚠️ 原来那行「只读」灰字已去掉 —— 行副标题里已经写了
                                     「一级目录（只读体检，不提供清理）」，再跟按钮并排反而自相矛盾。 -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Button Width="32" MinHeight="28" Padding="0" MinWidth="0"
                                            Click="OpenFolder_Click"
                                            AutomationProperties.Name="打开文件夹"
                                            ToolTipService.ToolTip="在资源管理器里打开这个目录">
                                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                                    </Button>
                                    <Button Content="清理" Width="64" MinHeight="28"
                                            Padding="10,0" FontSize="12"
                                            Click="Clean_Click"
                                            IsEnabled="{x:Bind CanClean, Mode=OneWay}"
                                            Visibility="{x:Bind CleanVisibility}"
                                            ToolTipService.ToolTip="{x:Bind ActionTip, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ListView x:Name="EntryTable" Visibility="Collapsed"
                          SelectionMode="None" IsItemClickEnabled="False"
                          ItemContainerStyle="{StaticResource CshTableRowStyle}"
                          Padding="0,0,0,8">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:AppDataRow">
                            <Grid ColumnSpacing="12" MinHeight="26">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="104" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0" Glyph="{x:Bind Glyph}" FontSize="13" Opacity="0.55"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="13"
                                           MaxLines="1" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           ToolTipService.ToolTip="{x:Bind Sub}" />

                                <TextBlock Grid.Column="2" Text="{x:Bind SizeText, Mode=OneWay}" FontSize="13"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular" />

                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <Button Width="32" MinHeight="28" Padding="0" MinWidth="0"
                                            Click="OpenFolder_Click"
                                            AutomationProperties.Name="打开文件夹"
                                            ToolTipService.ToolTip="在资源管理器里打开这个目录">
                                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                                    </Button>
                                    <Button Content="清理" Width="64" MinHeight="28"
                                            Padding="10,0" FontSize="12"
                                            Click="Clean_Click"
                                            IsEnabled="{x:Bind CanClean, Mode=OneWay}"
                                            Visibility="{x:Bind CleanVisibility}"
                                            ToolTipService.ToolTip="{x:Bind ActionTip, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 扫描中 -->
                <StackPanel x:Name="LoadingPanel" Spacing="12" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ProgressRing IsActive="True" Width="34" Height="34" HorizontalAlignment="Center" />
                    <TextBlock Text="正在读取 AppData 目录结构" FontSize="12" Opacity="0.7"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- 空状态 -->
                <StackPanel x:Name="EmptyPanel" Spacing="10" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontSize="28" Opacity="0.45" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText" Text="这个分类下没有东西" FontSize="14" Opacity="0.7"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
