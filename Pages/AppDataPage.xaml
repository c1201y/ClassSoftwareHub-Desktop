<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.AppDataPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:ClassSoftwareHub.Desktop.Controls"
    xmlns:local="using:ClassSoftwareHub.Desktop.Pages">

    








































    <Page.Resources>
        

        <Style x:Key="RowMoreButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Page.Resources>

    
    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" MaxWidth="960" RowSpacing="10" Margin="0,36,0,44">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="AppData 管理" FontSize="28" FontWeight="Bold" />
                    </StackPanel>

                    

                    <TextBlock x:Name="CountLine" Text="" FontSize="12" Opacity="0.65"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                

                <ComboBox x:Name="CategoryBox" Grid.Column="1" MinWidth="200"
                          VerticalAlignment="Top" Margin="0,4,0,0"
                          SelectionChanged="Category_Changed" />

                <Button x:Name="RescanButton" Grid.Column="2" Content="重新扫描" Click="Rescan_Click"
                        VerticalAlignment="Top" Margin="0,4,0,0" />

                
                <Button x:Name="AboutButton" Grid.Column="3" Click="About_Click"
                        Style="{StaticResource RowMoreButtonStyle}"
                        VerticalAlignment="Top" Margin="0,4,0,0"
                        AutomationProperties.Name="说明"
                        ToolTipService.ToolTip="这三层是怎么分的">
                    <FontIcon Glyph="&#xE946;" FontSize="15" />
                </Button>

                

                <Button x:Name="HubAiEntry" Grid.Column="4" Padding="12,6" Click="HubAiEntry_Click"
                        VerticalAlignment="Top" Margin="0,4,0,0"
                        ToolTipService.ToolTip="打开 Hub AI 顾问">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8F2;" FontSize="13" />
                        <TextBlock Text="AI" FontSize="12.5" />
                    </StackPanel>
                </Button>
            </Grid>

            




            <InfoBar x:Name="RiskBar" Grid.Row="1"
                     Severity="Error" IsOpen="True" IsClosable="False"
                     Title="此操作将永久删除文件"
                     Message="清理不会进入回收站，删除后无法恢复。仅清空缓存目录的内容，目录本身保留。" />

            
            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListView x:Name="EntryList"
                          SelectionMode="None" IsItemClickEnabled="False"
                          ItemContainerStyle="{StaticResource CshResultRowStyle}"
                          Padding="0,2,0,8">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:AppDataRow">
                            <Grid ColumnSpacing="12" MinHeight="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                






                                <CheckBox Grid.Column="0" MinWidth="0" Padding="0" Margin="0,0,4,0"
                                          VerticalAlignment="Center"
                                          IsChecked="{x:Bind IsChecked, Mode=TwoWay}"
                                          Click="RowCheck_Click"
                                          Visibility="{x:Bind CheckVisibility}"
                                          AutomationProperties.Name="勾选这一项" />

                                <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="15" Opacity="0.55"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontSize="14"
                                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Sub}" FontSize="12" Opacity="0.6"
                                               MaxLines="1" TextTrimming="CharacterEllipsis"
                                               ToolTipService.ToolTip="{x:Bind Sub}" />
                                </StackPanel>

                                
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="2"
                                            HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind SizeText, Mode=OneWay}" FontSize="13"
                                               HorizontalAlignment="Right"
                                               Typography.NumeralAlignment="Tabular" />
                                    <TextBlock Text="{x:Bind CountText, Mode=OneWay}" FontSize="12" Opacity="0.6"
                                               HorizontalAlignment="Right"
                                               Typography.NumeralAlignment="Tabular" />
                                </StackPanel>

                                

                                <Button Grid.Column="4" Style="{StaticResource RowMoreButtonStyle}"
                                        Click="More_Click"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="更多操作"
                                        ToolTipService.ToolTip="更多操作">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                
                <StackPanel x:Name="LoadingPanel" Grid.Row="0" Spacing="12" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ProgressRing IsActive="True" Width="34" Height="34" HorizontalAlignment="Center" />
                    <TextBlock Text="正在读取 AppData 目录结构" FontSize="12" Opacity="0.7"
                               HorizontalAlignment="Center" />
                </StackPanel>

                
                <StackPanel x:Name="EmptyPanel" Grid.Row="0" Spacing="10" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE8B7;" FontSize="28" Opacity="0.45" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyText" Text="这个分类下没有东西" FontSize="14" Opacity="0.7"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>

                




                <Grid x:Name="CleanBar" Grid.Row="1" Visibility="Collapsed" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="CleanBarSummary" FontSize="12" Opacity="0.7"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <Button x:Name="SelectAllButton" Grid.Column="1" Content="全选"
                            Click="SelectAll_Click" />

                    <Button x:Name="ClearSelButton" Grid.Column="2" Content="清空选择"
                            Click="ClearSel_Click" />

                    <Button x:Name="CleanSelectedButton" Grid.Column="3" Content="清理选中"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="CleanSelected_Click" />
                </Grid>
            </Grid>
        </Grid>
        

        <ui:HubAiFlyout x:Name="AiFlyout" Grid.Column="1" />
    </Grid>
</Page>
