<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.ExperimentalPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:ClassSoftwareHub.Desktop.Data">

    <!-- 和内置工具页同一套版式：内容钉在中间 960 宽（Nick 2026-09-26 要求"页面布局类似于内置工具页面"） -->
    <!-- 根 Grid 不带 Margin：间距放进中间列，让 GridView 拿到整页高度约束。
         ⛔ 中间列底部间距分两种写法（2026-10-03 定）：最后一行是自滚容器（`*` + 自带
            Padding 底部 44）→ 写 0；最后一行是页脚 / 卡片等非自滚元素 → 写 44。
         本页最后一行是「实验性的含义」页脚卡片 → 写 44，否则页脚直接怼到窗口下边框。 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" MaxWidth="960" RowSpacing="14" Margin="0,36,0,44">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock Text="实验性功能" FontSize="30" FontWeight="Bold" />
                <TextBlock FontSize="12.5" Opacity="0.65" TextWrapping="Wrap"
                           Text="暂未达到主界面功能可靠程度的试验性功能集中于此。功能可用，但结果不保证准确，界面后续仍可能调整。" />
            </StackPanel>

            <!-- 卡片 462 + 间距 16 = 478，960 里正好两列（跟内置工具页同一个尺寸口径） -->
            <GridView x:Name="FeatureGrid" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="FeatureGrid_ItemClick" Padding="0,2,0,44"
                      ItemContainerStyle="{StaticResource CshCardItemStyle}">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="data:ExperimentalFeature">
                        <Border Style="{StaticResource CshCardStyle}" Width="462" Height="76" Padding="20,0" Margin="0,0,16,14"
                                PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" VerticalAlignment="Center" />
                                <!-- 名字 + 一句话说明：说明只占一行，长了就省略号，卡片高度才稳 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}" FontSize="15" FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Desc}" FontSize="12" Opacity="0.65"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="13" Opacity="0.5"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- 页脚：把「实验性」这个标签的含义和检测范围讲清楚（先说清边界，别让用户自己猜） -->
            <Border Grid.Row="2" CornerRadius="4" Padding="20,16" Margin="0,4,0,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnSpacing="16" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <FontIcon Glyph="&#xEA80;" FontSize="20" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="「实验性」的含义" FontSize="15" FontWeight="Bold" />

                    <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12.5" Opacity="0.7"
                               TextWrapping="Wrap"
                               Text="以下功能处于成型阶段，因此入口保留在此处而非主界面：功能成熟后逐步移入主界面。列于此处表示功能已可试用，不代表其可靠程度已达到正式功能水平。" />
                    <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Opacity="0.6"
                               TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="使用中如确认功能可用，或发现判断有误，均可在「反馈中心」提交反馈。此类功能的去留取决于实际使用反馈。" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
