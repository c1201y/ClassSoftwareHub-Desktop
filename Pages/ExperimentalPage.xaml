<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.ExperimentalPage"
    NavigationCacheMode="Enabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:ClassSoftwareHub.Desktop.Data">

    <!-- 和首页 / 设置页 / 内置工具页同一套版式：ScrollViewer 在最外层（滚动条贴窗口最右），
         内容钉在中间 960 宽。
         ✅ 2026-10-13 由「根 Grid 骨架」迁到本骨架：两侧留白天然可滚，不再需要 Core/WheelRelay.cs 接力。

         ✅ 2026-10-13 卡片整段改成**照搬首页「快速开始」那套**（Nick：「直接复用首页卡片」）：
            · 外观 = CshNavCardStyle（圆角 8 / Padding 14,18），标题 14 不加粗、
              说明 12 / Opacity 0.78、右端 E8A7 指示符 —— 与首页逐项一致；
            · 板式 = 左右两个 ItemsControl 各占一列（首页也是手写两列），
              卡片宽度天然跟着列宽走 ⇒ 窗口再窄也是两列，不会掉成单列、右边留一大片空。
            ⛔ 前一版试过「GridView + 运行时算 ItemWidth」，窄窗口下不可靠（掉成单列），已弃用。

         ⛔ 间距必须写在内部 Grid 的 Margin 上，不能写成 ScrollViewer 的 Padding：
            WinUI 3 的 ScrollViewer.Padding 底部不参与滚动范围计算，滚到底最后一条内容仍被裁。
         ⛔ 中间列底部间距：最后一行是「实验性的含义」页脚卡片（非自滚元素）→ 写 44，
            否则页脚直接怼到窗口下边框。 -->
    <Page.Resources>
        <!-- 首页「快速开始」那张卡：左右两列共用同一个模板 -->
        <DataTemplate x:Key="NavCardTemplate" x:DataType="data:ExperimentalFeature">
            <Border Style="{StaticResource CshNavCardStyle}"
                    PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited"
                    Tapped="Card_Tapped">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="{x:Bind Name}" FontSize="14" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Desc}" FontSize="12" Opacity="0.78"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,36,24,44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <!-- 行高全 Auto：整页交给外层 ScrollViewer 滚，不再需要 `*` 行吸收高度 -->
            <Grid Grid.Column="1" MaxWidth="960" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="4">
                    <TextBlock Text="实验性功能" FontSize="30" FontWeight="Bold" />
                    <TextBlock FontSize="12.5" Opacity="0.65" TextWrapping="Wrap"
                               Text="暂未达到主界面功能可靠程度的试验性功能集中于此。功能可用，但结果不保证准确，界面后续仍可能调整。" />
                </StackPanel>

                <!-- 两列（首页「快速开始」同款：列间距 8、行间距 8）：
                     序号偶数的进左列、奇数的进右列，见 code-behind。 -->
                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <ItemsControl x:Name="CardColumnLeft" Grid.Column="0"
                                  ItemTemplate="{StaticResource NavCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl x:Name="CardColumnRight" Grid.Column="1"
                                  ItemTemplate="{StaticResource NavCardTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>

                <!-- 页脚：把「实验性」这个标签的含义和检测范围讲清楚（先说清边界，别让用户自己猜） -->
                <Border Grid.Row="2" CornerRadius="4" Padding="20,16" Margin="0,20,0,0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid ColumnSpacing="16" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <FontIcon Glyph="&#xEA80;" FontSize="20" VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1" Text="「实验性」的含义" FontSize="15" FontWeight="Bold" />

                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12.5" Opacity="0.7"
                                   TextWrapping="Wrap"
                                   Text="以下功能处于成型阶段，因此入口保留在此处而非主界面：功能成熟后逐步移入主界面。列于此处表示功能已可试用，不代表其可靠程度已达到正式功能水平。" />
                        <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12" Opacity="0.6"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="使用中如确认功能可用，或发现判断有误，均可在「反馈中心」提交反馈。此类功能的去留取决于实际使用反馈。" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
