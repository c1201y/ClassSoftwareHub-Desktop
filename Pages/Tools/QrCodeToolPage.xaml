<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.Tools.QrCodeToolPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1120*" MaxWidth="1128" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,14,24,20" Spacing="14">
                <StackPanel Spacing="2">
                    <TextBlock Text="QR 生成器" FontSize="28" FontWeight="Bold" />
                    <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                               Text="三种模式都通过本机临时地址生成二维码，可统一设置有效期；到期后地址返回 410。" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="内容" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,2,0" />
                    <RadioButton x:Name="TextTab" GroupName="QrMode" Content="文本" MinWidth="0"
                                 AutomationProperties.Name="文本" Checked="Mode_Changed" />
                    <RadioButton x:Name="LinkTab" GroupName="QrMode" Content="链接" MinWidth="0"
                                 AutomationProperties.Name="链接" Checked="Mode_Changed" />
                    <RadioButton x:Name="FileTab" GroupName="QrMode" Content="文件" MinWidth="0"
                                 AutomationProperties.Name="文件" Checked="Mode_Changed" />
                </StackPanel>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>

                    <Border CornerRadius="4" Padding="16" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="12">
                            <StackPanel x:Name="TextPanel" Spacing="8">
                                <TextBlock Text="文本内容" FontSize="14" FontWeight="Bold" />
                                <TextBox x:Name="TextInput" AcceptsReturn="True" TextWrapping="Wrap" Height="180"
                                         PlaceholderText="输入要放进二维码的文本，支持中文" TextChanged="Input_TextChanged" />
                                <TextBlock x:Name="TextCount" FontSize="12" Opacity="0.6" />
                            </StackPanel>

                            <StackPanel x:Name="LinkPanel" Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="链接地址" FontSize="14" FontWeight="Bold" />
                                <TextBox x:Name="LinkInput" PlaceholderText="https://example.com"
                                         TextChanged="Input_TextChanged" />
                                <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                           Text="支持 http / https 链接；未写协议时自动补 https://。" />
                            </StackPanel>

                            <StackPanel x:Name="FilePanel" Spacing="10" Visibility="Collapsed">
                                <TextBlock Text="选择文件" FontSize="14" FontWeight="Bold" />
                                <Border x:Name="DropZone" Padding="12" CornerRadius="4" BorderThickness="0"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        AllowDrop="True" Tapped="DropZone_Tapped"
                                        DragOver="File_DragOver" DragLeave="File_DragLeave" Drop="File_Drop">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="把文件拖到这里，或单击选择" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock x:Name="FileInfoText" FontSize="12" Opacity="0.6"
                                                   TextTrimming="CharacterEllipsis" Text="未选择文件" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="PickFileButton" Content="选择文件" Click="PickFile_Click" />
                                    <Button x:Name="ClearFileButton" Content="清除" Click="ClearFile_Click"
                                            IsEnabled="False" />
                                </StackPanel>

                                <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                           Text="文本、链接和文件都通过本机临时地址分享，手机需与电脑在同一局域网。首次使用若手机打不开，请允许 Windows 防火墙访问专用网络。到期后地址立即失效。" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="有效期" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                                <ComboBox x:Name="ExpiryBox" MinWidth="150">
                                    <ComboBoxItem Content="5 分钟" />
                                    <ComboBoxItem Content="15 分钟" />
                                    <ComboBoxItem Content="30 分钟" />
                                    <ComboBoxItem Content="60 分钟" />
                                    <ComboBoxItem Content="不过期" />
                                </ComboBox>
                            </StackPanel>

                            <Button x:Name="GenerateButton" Content="生成二维码" Click="Generate_Click"
                                    Style="{StaticResource AccentButtonStyle}" />
                            <TextBlock x:Name="StatusText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" CornerRadius="4" Padding="16" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <Grid Width="300" Height="300">
                                <Border x:Name="EmptyBox" Background="{ThemeResource ControlFillColorDefaultBrush}"
                                        CornerRadius="4">
                                    <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="32" Opacity="0.5" />
                                        <TextBlock Text="生成后显示二维码" FontSize="12" Opacity="0.6" />
                                    </StackPanel>
                                </Border>
                                <Image x:Name="QrImage" Width="300" Height="300" Stretch="Uniform"
                                       Visibility="Collapsed" />
                            </Grid>

                            <TextBlock x:Name="CountdownText" FontSize="12" Opacity="0.7"
                                       HorizontalAlignment="Center" />

                            <TextBox x:Name="PayloadText" Header="二维码内容" IsReadOnly="True"
                                     TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                                     MaxHeight="110" />

                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <Button x:Name="SaveButton" Content="保存 PNG" Click="Save_Click"
                                        IsEnabled="False" />
                                <Button x:Name="CopyButton" Content="复制链接" Click="Copy_Click"
                                        IsEnabled="False" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
