<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.Tools.QrCodeToolPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 2026-11-21 重做（教室大屏、触屏、无鼠标）：
         内容来源改成两个等高的区域 —— 左边粘贴链接，右边整块是文件区，点一下就选文件，也能拖进来。
         不再有「小按钮贴在输入框旁边」。所有操作按钮 38 高、间距 10，手指点得中。 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,28,24,36">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" MaxWidth="960" Spacing="20">
                <StackPanel Spacing="6">
                    <TextBlock Text="二维码生成器" FontSize="28" FontWeight="Bold" />
                    <TextBlock FontSize="12.5" Opacity="0.65" TextWrapping="Wrap"
                               Text="粘贴链接或选择文件，生成后手机扫描即可打开或下载。" />
                </StackPanel>

                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="16" VerticalAlignment="Top">

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="196" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="InputBox" Grid.Column="0"
                                     Height="132" TextWrapping="Wrap"
                                     FontSize="14"
                                     Padding="14,12,14,12"
                                     PlaceholderText="粘贴链接"
                                     TextChanged="Input_TextChanged" />

                            <!-- 文件区与输入框同高：整块可点、可拖，触屏不用瞄准小按钮。 -->
                            <Border x:Name="FileDrop" Grid.Column="1"
                                    Height="132" CornerRadius="4"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    AllowDrop="True" Tapped="PickFile_Tapped"
                                    DragOver="File_DragOver" Drop="File_Drop">

                                <Grid>
                                    <StackPanel x:Name="DropEmpty" Spacing="6"
                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8E5;" FontSize="22" Opacity="0.75" />
                                        <TextBlock Text="选择文件" FontSize="13.5" HorizontalAlignment="Center" />
                                        <TextBlock Text="或拖到这里" FontSize="11.5" Opacity="0.55"
                                                   HorizontalAlignment="Center" />
                                    </StackPanel>

                                    <StackPanel x:Name="DropPicked" Spacing="4" Visibility="Collapsed"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Margin="12,0,12,0">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="22" Opacity="0.75" />
                                        <TextBlock x:Name="PickedName" FontSize="12.5" MaxWidth="168"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" MaxLines="2"
                                                   TextWrapping="Wrap" />
                                        <HyperlinkButton Content="移除" Padding="0"
                                                         HorizontalAlignment="Center"
                                                         Click="ClearFile_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <TextBlock x:Name="DetectText" FontSize="12.5" Opacity="0.6"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="有效期" FontSize="13.5" VerticalAlignment="Center" />
                            <ComboBox x:Name="ExpiryBox" MinWidth="124" Height="38">
                                <ComboBoxItem Content="1 分钟" />
                                <ComboBoxItem Content="2 分钟" />
                                <ComboBoxItem Content="5 分钟" />
                                <ComboBoxItem Content="10 分钟" />
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="GenerateButton" Content="生成二维码"
                                    Height="38" Padding="22,0" FontSize="13.5"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="Generate_Click" />

                            <Button x:Name="SaveButton" Height="38" Padding="16,0" FontSize="13.5"
                                    IsEnabled="False" Click="Save_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE896;" FontSize="14" />
                                    <TextBlock Text="下载图片" FontSize="13.5" />
                                </StackPanel>
                            </Button>

                            <Button x:Name="CopyButton" Height="38" Padding="16,0" FontSize="13.5"
                                    IsEnabled="False" Click="Copy_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                    <TextBlock Text="复制链接" FontSize="13.5" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <TextBlock x:Name="StatusText" FontSize="12.5" Opacity="0.6" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="10" VerticalAlignment="Top">
                        <Grid Width="300" Height="300">
                            <!-- 空态跟主题走，不铺白，避免深色下刺眼。 -->
                            <Border x:Name="EmptyBox" CornerRadius="8"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                                <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="30"
                                              Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    <TextBlock Text="生成后显示二维码" FontSize="12.5"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Border>

                            <!-- 二维码要纯白底才扫得出，只在生成后铺。 -->
                            <Border x:Name="QrPaper" CornerRadius="8" Background="White"
                                    BorderThickness="1"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    Visibility="Collapsed">
                                <Image x:Name="QrImage" Width="268" Height="268" Stretch="Uniform" />
                            </Border>
                        </Grid>

                        <TextBlock x:Name="CountdownText" FontSize="12.5" Opacity="0.65"
                                   HorizontalAlignment="Center" />

                        <TextBlock x:Name="PayloadText" FontSize="11.5" Opacity="0.55" TextWrapping="Wrap"
                                   IsTextSelectionEnabled="True"
                                   TextTrimming="CharacterEllipsis" MaxLines="2"
                                   TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
