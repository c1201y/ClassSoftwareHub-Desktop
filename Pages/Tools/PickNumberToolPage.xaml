<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.Tools.PickNumberToolPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ 2026-10-02 第四次重排（Nick：「典型的左右分栏仪表盘割裂，左挤右空」）═══
         前三版一直在解决"入口看不看得见"，版式却始终是**左设置 / 右结果**两栏：
         左边 286 宽塞满输入框和按钮，右边一大片空地上孤零零一个数字。
         这是网页仪表盘的思路 —— 桌面小工具不该让"设置"和"主角"平起平坐。

         这一版回到**单列、竖着排**，按"主角—配角"重新分配视觉重心：

           ┌ 标题
           ├ 一行紧凑的选择项（功能 · 抽取对象）—— 都是原生 RadioButton，两个选项都看得见
           ├ 一条参数带（范围 / 数量 / 不重复），右边挂池子状态
           ├ ★ 结果舞台：占据剩下的全部高度，抽出来的号大字居中，这是这一页的主角
           ├ 「开始抽号」强调色主按钮（全页唯一的 Accent）
           └ 已抽记录 / 设置摘要 / 公平性自检 —— 全是小字，退到页脚

         ⛔ 别退回左右分栏；⛔ 别给结果舞台加强调色描边（Accent 只能有一个，就是那颗按钮）。 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="998*" MaxWidth="1008" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" Margin="24,14,24,20" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ═══ 标题 ═══ -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="随机抽号" FontSize="28" FontWeight="Bold" />
                    <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                               Text="随机抽取学号或学生姓名，也可一键随机分组。号码取自系统加密随机数，结果公平可靠。" />
                </StackPanel>
                <Button Grid.Column="1" Content="在工具窗口打开" VerticalAlignment="Center"
                        Click="OpenPalette_Click" ToolTipService.ToolTip="打开置顶小窗口，便于随时抽号" />
            </Grid>

            <!-- ═══ 选择项：功能 / 抽取对象 ═══
                 ⚠️ 用原生 RadioButton，不套卡片：一条横行放得下，两个选项同时可见（不会藏功能），
                    占地却只有原来那四张大卡的零头 —— 省下来的高度全给下面的结果舞台。
                 ⚠️ MinWidth 必须清零：RadioButton 默认 MinWidth=120，不清零会拉开一片空当。
                 ⚠️ IsChecked 一律在代码里赋初值，不写在这里（见 App.xaml 的 CshModeCardStyle 注释）。 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="28" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="功能" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,2,0" />
                    <RadioButton x:Name="TaskDrawRadio" GroupName="TaskMode" Content="抽号" MinWidth="0"
                                 Checked="TaskMode_Changed" />
                    <RadioButton x:Name="TaskGroupRadio" GroupName="TaskMode" Content="随机分组" MinWidth="0"
                                 Checked="TaskMode_Changed" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="抽取对象" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,2,0" />
                    <!-- 2026-10-03（Nick）：旧文案「按号码/按名单」太随意，改成说动作本身，
                         与浮窗版 MiniPickNumber 保持一致。 -->
                    <RadioButton x:Name="ModeRangeRadio" GroupName="PoolMode" Content="抽取座号" MinWidth="0"
                                 AutomationProperties.Name="抽取座号" Checked="PoolMode_Changed" />
                    <RadioButton x:Name="ModeRosterRadio" GroupName="PoolMode" Content="使用名单" MinWidth="0"
                                 AutomationProperties.Name="使用名单" Checked="PoolMode_Changed" />
                </StackPanel>
            </StackPanel>

            <!-- ═══ 内容：抽号 / 随机分组 ═══ -->
            <Grid Grid.Row="2">
                <!-- ══════════ 抽号 ══════════ -->
                <!-- VerticalContentAlignment=Stretch：让内容在窗口够高时铺满可视高度，
                     结果舞台才能真的"占住剩下的全部地方"，而不是缩成一条。 -->
                <ScrollViewer x:Name="DrawView" VerticalScrollBarVisibility="Auto"
                              VerticalContentAlignment="Stretch">
                    <!-- ⛔ 底部 Margin 是保险栓：外层 Grid 的 Padding 底部在滚动区**之外**，
                         实测滚到底仍会贴住窗口底边 —— 留白必须写在滚动区**里**。 -->
                    <Grid Margin="0,0,0,20" RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="240" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- ── 参数带：范围 / 数量 / 不重复，全挤在一行 ──
                             右边那句状态（池子多大 / 抽掉多少 / 还剩多少）属于"池子"，
                             就该待在定义池子的这一行里。 -->
                        <Border CornerRadius="4" Padding="16,8,16,8" BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid>
                                    <!-- 号码：范围 + 抽取数量 + 不重复 -->
                                    <StackPanel x:Name="RangePanel" Orientation="Horizontal" Spacing="10"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="号码范围" FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <!-- ⚠️ NumberBox 的 Maximum 必须填：不填的话在框里粘一个大数字（比如一亿），
                                             后面 Enumerable.Range(Lo, size) 会瞬间申请几 GB → 界面冻死或直接 OOM。
                                             上限与浮窗版保持一致；代码里另有一道夹取兜底。 -->
                                        <NumberBox x:Name="FromBox" Value="1" Minimum="0" Maximum="9999"
                                                   SmallChange="1" SpinButtonPlacementMode="Compact" Width="104" />
                                        <TextBlock Text="~" VerticalAlignment="Center" Opacity="0.6" />
                                        <NumberBox x:Name="ToBox" Value="50" Minimum="0" Maximum="9999"
                                                   SmallChange="1" SpinButtonPlacementMode="Compact" Width="104" />
                                        <TextBlock Text="抽取数量" FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="12,0,4,0" />
                                        <NumberBox x:Name="CountBox" Value="1" Minimum="1" Maximum="50"
                                                   SmallChange="1" SpinButtonPlacementMode="Compact" Width="104" />
                                        <CheckBox x:Name="NoRepeatBox" Content="不重复" MinWidth="0"
                                                  Padding="6,0,0,0" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </StackPanel>

                                    <!-- 名单：导入 / 示例 / 查看修改 / 清空
                                         ⚠️「查看 / 编辑名单」为什么是弹窗而不是就地把列表摆在这儿：
                                            本机窗口可用高度有限，就地摆一个 ListView 实测被压成十几像素（等于看不见）。
                                            弹窗能给它 400+ 的高度，一屏能核对十几个人，也不占主流程的地方。 -->
                                    <StackPanel x:Name="RosterPanel" Orientation="Horizontal" Spacing="10"
                                                VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="名单文件" FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <Button Content="导入名单" Click="ImportRoster_Click" />
                                        <!-- 导入之前先让人看见"名单文件该长什么样"（图 + 可下载的示例） -->
                                        <Button Content="示例名单" Click="SampleRoster_Click"
                                                ToolTipService.ToolTip="看看名单文件该怎么做，也可直接下载一份示例照着填" />
                                        <Button x:Name="OpenRosterButton" Content="查看 / 编辑名单"
                                                Click="OpenRoster_Click"
                                                ToolTipService.ToolTip="列出名单里的每个人，可逐个改名、删除，也可导出成 Excel 或 txt" />
                                        <Button x:Name="ClearRosterButton" Content="清空名单"
                                                Click="ClearRoster_Click" IsEnabled="False" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="PoolStatusText" Grid.Column="1" FontSize="12" FontWeight="SemiBold"
                                           Opacity="0.8" VerticalAlignment="Center" TextWrapping="Wrap"
                                           MaxWidth="360" TextAlignment="Right" />
                            </Grid>
                        </Border>

                        <!-- ── 结果舞台：这一页的主角，占掉剩下的全部高度 ──
                             不再用强调色描边（Accent 全页只留给主按钮），改成一块素净的浅底，
                             让大字自己立住。 -->
                        <Border x:Name="ResultCard" Grid.Row="1" CornerRadius="4" Padding="20"
                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <Grid>
                                <TextBlock x:Name="ResultHint" Text="单击下方「开始抽号」" FontSize="12" Opacity="0.55"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <VariableSizedWrapGrid x:Name="ResultHost" Orientation="Horizontal"
                                                       ItemWidth="180" ItemHeight="112"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <!-- ── 主操作：全页唯一的强调色按钮，居中 ── -->
                        <StackPanel Grid.Row="2" Spacing="8" HorizontalAlignment="Center">
                            <Button x:Name="DrawButton" Content="开始抽号"
                                    Style="{StaticResource AccentButtonStyle}" Click="Draw_Click"
                                    MinWidth="280" Height="44" FontSize="15" />
                            <!-- 出错提示紧贴按钮：原来甩在结果区下面，用户点完不知道哪儿不对 -->
                            <TextBlock x:Name="ErrorText" FontSize="12" TextAlignment="Center"
                                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                       TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>

                        <!-- ── 抽号记录：抽完立刻能回看 ── -->
                        <Grid x:Name="UsedRow" Grid.Row="3" ColumnSpacing="10" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="UsedText" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="重置记录" Click="ResetUsed_Click" />
                        </Grid>

                        <!-- ── 页脚：设置摘要 + 公平性自检，都是小字 ── -->
                        <Grid Grid.Row="4" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SummaryText" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <!-- 公平性自检：低频的排查工具（实抽 2 万次看分布）。
                                 做成"一行链接 + 浮出面板"，贴着链接弹出，不占主流程的地方。 -->
                            <HyperlinkButton x:Name="FairLink" Grid.Column="1" Content="公平性自检" Padding="0"
                                             VerticalAlignment="Center" Click="FairCheck_Click"
                                             ToolTipService.ToolTip="在本机实抽 2 万次，检验号码分布是否均匀" />
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <!-- ══════════ 随机分组：同样单列，设置在上、结果在下 ══════════ -->
                <ScrollViewer x:Name="GroupView" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel Margin="0,0,0,20" Spacing="10">
                        <!-- 分组设置压成一条横带：方式 / 组数 / 开始 / 复制，全都紧挨着 -->
                        <Border CornerRadius="4" Padding="16,12,16,12" BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <StackPanel Spacing="8">
                                <!-- ⚠️ 两个控件都自带 Header（"分组方式""组数/每组人数"），
                                     按钮用 Bottom 对齐，才能跟输入框的**本体**齐平，而不是跟标题齐平。 -->
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <ComboBox x:Name="GroupModeBox" Header="分组方式" MinWidth="150"
                                              VerticalAlignment="Bottom" />
                                    <NumberBox x:Name="GroupValueBox" Value="4" Minimum="1"
                                               Maximum="9999" SmallChange="1" SpinButtonPlacementMode="Compact"
                                               Width="150" VerticalAlignment="Bottom" />
                                    <Button x:Name="GroupButton" Content="开始分组"
                                            Style="{StaticResource AccentButtonStyle}" Click="Group_Click"
                                            VerticalAlignment="Bottom" />
                                    <Button x:Name="CopyGroupsButton" Content="复制分组结果" Click="CopyGroups_Click"
                                            IsEnabled="False" VerticalAlignment="Bottom"
                                            ToolTipService.ToolTip="按「第 N 组：姓名、姓名…」的格式复制到剪贴板" />
                                </StackPanel>

                                <TextBlock x:Name="GroupRangeHint" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
                                <!-- 用户最常问的就是"能分几次" —— 直接写在设置区里 -->
                                <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                           Text="每次单击「开始分组」都会重新打散一次，可反复使用、没有次数限制，也不影响抽号那边的「不重复」记录。" />
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="GroupHint" Text="单击上方「开始分组」后，各组名单按行列出。"
                                   FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                        <StackPanel x:Name="GroupsHost" Spacing="8" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <TextBlock x:Name="Toast" Grid.Row="3" FontSize="12" Opacity="0.75" />
        </Grid>
    </Grid>
</Page>
