<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.Tools.PickNumberToolPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,14,24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Click="Back_Click" Padding="8,4" VerticalAlignment="Top" ToolTipService.ToolTip="返回">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="随机抽号" FontSize="24" FontWeight="Bold" />
                <TextBlock FontSize="12.5" Opacity="0.6" TextWrapping="Wrap"
                           Text="输入号码范围，一键抽号（比如学号 1~50）。号码用系统加密随机数抽取，绝对公平；也可用来随机分组。" />
            </StackPanel>
            <Button Grid.Column="2" Content="在工具窗口打开" VerticalAlignment="Center"
                    Click="OpenPalette_Click" ToolTipService.ToolTip="开一个小置顶窗，随手抽号" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ═══ 抽号 ═══ -->
                <Border CornerRadius="10" Padding="16" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="抽号设置" FontSize="13" FontWeight="Bold" />

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <NumberBox x:Name="FromBox" Value="1" Minimum="0" SmallChange="1"
                                       SpinButtonPlacementMode="Compact" Width="130" HorizontalAlignment="Stretch" />
                            <TextBlock Text="~" VerticalAlignment="Center" Opacity="0.6" />
                            <NumberBox x:Name="ToBox" Value="50" Minimum="0" SmallChange="1"
                                       SpinButtonPlacementMode="Compact" Width="130" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <NumberBox x:Name="CountBox" Header="抽几个" Value="1" Minimum="1" SmallChange="1"
                                       SpinButtonPlacementMode="Compact" Width="130" />
                            <CheckBox x:Name="NoRepeatBox" Content="不重复（抽过的不再出现）"
                                      IsChecked="True" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        </StackPanel>

                        <Button x:Name="DrawButton" Content="开始抽号" Style="{StaticResource AccentButtonStyle}"
                                Click="Draw_Click" HorizontalAlignment="Stretch" />

                        <TextBlock x:Name="SummaryText" FontSize="12.5" Opacity="0.65" TextWrapping="Wrap" />
                        <TextBlock x:Name="RemainText" FontSize="12.5" Opacity="0.65" TextWrapping="Wrap"
                                   Visibility="Collapsed" />

                        <Border CornerRadius="8" Padding="14" MinHeight="118"
                                Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <Grid>
                                <TextBlock x:Name="ResultHint" Text="结果会显示在这里" FontSize="12.5" Opacity="0.6"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <VariableSizedWrapGrid x:Name="ResultHost" Orientation="Horizontal"
                                                       ItemWidth="124" ItemHeight="72"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <TextBlock x:Name="ErrorText" FontSize="12.5" Foreground="{ThemeResource SystemFillColorCriticalBrush}" TextWrapping="Wrap"
                                   Visibility="Collapsed" />

                        <Grid x:Name="UsedRow" ColumnSpacing="10" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="UsedText" FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="重置记录" Click="ResetUsed_Click" />
                        </Grid>

                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="公平性自检" Click="FairCheck_Click" />
                                <TextBlock Text="在本机实抽 2 万次，看分布平不平" FontSize="12" Opacity="0.6"
                                           VerticalAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel x:Name="FairPanel" Spacing="8" Visibility="Collapsed">
                                <Border CornerRadius="8" Padding="10,8,10,4" Height="124"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}">
                                    <Grid x:Name="FairChart" VerticalAlignment="Bottom" />
                                </Border>
                                <TextBlock x:Name="FairNote" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══ 分组 ═══ -->
                <Border Grid.Column="1" CornerRadius="10" Padding="16" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="随机分组" FontSize="13" FontWeight="Bold" />

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <ComboBox x:Name="GroupModeBox" Width="220" />
                            <NumberBox x:Name="GroupValueBox" Value="4" Minimum="1" SmallChange="1"
                                       SpinButtonPlacementMode="Compact" Width="120" />
                        </StackPanel>
                        <TextBlock x:Name="GroupRangeHint" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />

                        <Button Content="开始分组" Click="Group_Click" HorizontalAlignment="Stretch" />

                        <TextBlock x:Name="GroupHint" Text="分组结果会显示在这里" FontSize="12.5" Opacity="0.6"
                                   TextWrapping="Wrap" />
                        <StackPanel x:Name="GroupsHost" Spacing="10" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <TextBlock x:Name="Toast" Grid.Row="2" FontSize="12" Opacity="0.75" />
    </Grid>
</Page>
