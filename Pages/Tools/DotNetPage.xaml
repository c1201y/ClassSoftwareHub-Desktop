<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.Tools.DotNetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Disabled">

    <Grid Background="Transparent">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      HorizontalScrollMode="Disabled">
            <Grid Margin="24,36,24,44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" MaxWidth="960">
                    <TextBlock Text=".NET 环境" FontSize="28" FontWeight="Bold" />
                    <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,4,0,0"
                               Text="列出本机各路 .NET 运行时与 SDK 的安装情况，缺的、旧的从微软官方源补装。" />

                    <AutoSuggestBox x:Name="SearchBox" Width="320" Margin="0,16,0,0"
                                    HorizontalAlignment="Left"
                                    PlaceholderText="搜索通道或组件"
                                    QueryIcon="Find"
                                    TextChanged="SearchBox_TextChanged" />

                    <InfoBar x:Name="NoticeBar" Margin="0,12,0,0" IsOpen="False" IsClosable="True" />

                    <TextBlock Text="本机" Style="{StaticResource BodyStrongTextBlockStyle}"
                               Margin="0,24,0,8" />

                    <controls:SettingsCard x:Name="OverviewCard">
                        <controls:SettingsCard.Header>
                            <TextBlock Text="已安装的 .NET" />
                        </controls:SettingsCard.Header>
                        <controls:SettingsCard.Description>
                            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" />
                        </controls:SettingsCard.Description>
                        <Button x:Name="RefreshButton" Content="刷新" Click="Refresh_Click" />
                    </controls:SettingsCard>

                    <StackPanel x:Name="ChannelPanel" />

                    <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap" Margin="0,20,0,0"
                               Text="安装由微软安装程序完成，需要管理员权限，系统会弹一次确认；装完按提示重启即可。" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <StackPanel x:Name="LoadingPanel" Spacing="10" Visibility="Collapsed"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressRing Width="28" Height="28" IsActive="True" HorizontalAlignment="Center" />
            <TextBlock Text="正在读取版本清单…" FontSize="12" Opacity="0.7"
                       HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
