<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.Tools.ImageColorToolPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 版式：标题行 / 内容（滚动，Grid 铺满 → 不会被 ScrollViewer 算歪）/ 状态行 -->
    <Grid Padding="24,14,24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══ 标题 ═══ -->
        <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Click="Back_Click" Padding="8,4" VerticalAlignment="Top" ToolTipService.ToolTip="返回">
                <FontIcon Glyph="&#xE72B;" FontSize="14" />
            </Button>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="图片取色" FontSize="24" FontWeight="Bold" />
                <TextBlock FontSize="12.5" Opacity="0.6" TextWrapping="Wrap"
                           Text="上传一张图片，自动提取一组柔和的配色（类似 Win11 壁纸主题色的取法）。点击色块复制 hex。图片只在本机处理，不会上传。" />
            </StackPanel>
        </StackPanel>

        <!-- ═══ 内容 ═══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 上传区：点一下或拖进来 -->
                <Grid x:Name="DropZone" Grid.Row="0" MinHeight="220" Background="Transparent"
                      Tapped="DropZone_Tapped" AllowDrop="True"
                      DragOver="DropZone_DragOver" DragLeave="DropZone_DragLeave" Drop="DropZone_Drop">
                    <Rectangle x:Name="DropFrame" RadiusX="8" RadiusY="8" StrokeThickness="1" StrokeDashArray="4,3"
                               Stroke="{ThemeResource CardStrokeColorDefaultBrush}"
                               Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                    <Rectangle x:Name="DropFrameAccent" RadiusX="8" RadiusY="8" StrokeThickness="1" StrokeDashArray="4,3"
                               Visibility="Collapsed"
                               Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                               Fill="{ThemeResource CardBackgroundFillColorDefaultBrush}" />

                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Spacing="10" Padding="24">
                        <FontIcon Glyph="&#xEB9F;" FontSize="30" HorizontalAlignment="Center"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <TextBlock Text="点击选择图片" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="或把图片拖进来 · 支持 PNG / JPG / WebP / GIF" FontSize="12" Opacity="0.6"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="LoadedState" Orientation="Horizontal" Spacing="20" Padding="18"
                                VerticalAlignment="Center" Visibility="Collapsed">
                        <Border CornerRadius="6" BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                            <Image x:Name="Preview" Stretch="Uniform" MaxWidth="220" MaxHeight="140" />
                        </Border>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="换一张图片" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="点击这里，或把新图片拖进来" FontSize="12" Opacity="0.6" />
                            <TextBlock x:Name="ImageInfo" FontSize="12" Opacity="0.6" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 错误 -->
                <TextBlock x:Name="ErrorText" Grid.Row="1" Visibility="Collapsed" TextWrapping="Wrap"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />

                <!-- 种子色 -->
                <Border x:Name="SeedCard" Grid.Row="2" Visibility="Collapsed" CornerRadius="8" Padding="14,12"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <Border x:Name="SeedChip" Width="36" Height="36" CornerRadius="6" BorderThickness="1"
                                BorderBrush="#26000000" />
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="提取到的种子色" FontSize="12" Opacity="0.6" />
                            <TextBlock x:Name="SeedText" FontSize="14" FontFamily="Consolas" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 配色方案 -->
                <StackPanel x:Name="PaletteSection" Grid.Row="3" Spacing="10" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="配色方案" FontSize="14.5" FontWeight="Bold" />
                        <TextBlock Text="点击色块复制 hex" FontSize="12" Opacity="0.6" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <VariableSizedWrapGrid x:Name="SwatchHost" Orientation="Horizontal"
                                           ItemWidth="148" ItemHeight="126" />
                </StackPanel>

                <!-- HSL 快捷复制 -->
                <StackPanel x:Name="HslSection" Grid.Row="4" Spacing="10" Visibility="Collapsed">
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <TextBlock Text="HSL（点击复制）" FontSize="13" FontWeight="SemiBold" />
                    <VariableSizedWrapGrid x:Name="HslHost" Orientation="Horizontal"
                                           ItemWidth="148" ItemHeight="30" />
                </StackPanel>

                <!-- 操作 -->
                <StackPanel x:Name="ActionRow" Grid.Row="5" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <Button Content="换一张" Click="Replace_Click" />
                    <Button Content="清空" Click="Clear_Click" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ═══ 状态 ═══ -->
        <TextBlock x:Name="Toast" Grid.Row="2" FontSize="12" Opacity="0.75" />
    </Grid>
</Page>
