<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.Tools.TimerToolPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ 2026-09-29 三次调整 ═══
         · 倒计时 / 秒表原来是一对普通按钮，靠"当前那个是强调色 + 名字前加个 ●"来提示选中状态，
           未选中的那个看着跟"重置"没区别。现在换成两张并列的模式卡（App.xaml 的 CshModeCardStyle），
           每张都写着自己干什么，选中的那张有强调色描边 + 淡底 + 对勾，三处同时变。
         · 秒表模式下原来把「设定时长」整块收起来，页面底部留一大块空白，像加载失败。
           现在改成在该位置显示一句说明，位置不跳、内容有解释。 -->
    <Grid Padding="24,14,24,20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="课堂计时器" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="倒计时 / 秒表，大字号便于投影，到达设定时间响铃。" FontSize="12.5" Opacity="0.6" />
            </StackPanel>
            <Button Grid.Column="1" Content="在工具窗口打开" VerticalAlignment="Center"
                    Click="OpenPalette_Click" ToolTipService.ToolTip="打开置顶小窗口，便于随时计时" />
        </Grid>

        <Border Grid.Row="1" CornerRadius="10" Padding="24" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- ⚠️ IsChecked 一律在代码里赋初值（见 App.xaml 的 CshModeCardStyle 注释） -->
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <RadioButton x:Name="BtnCountdown" GroupName="TimerMode" Width="252"
                                 Style="{StaticResource CshModeCardStyle}" Checked="Mode_Changed">
                        <StackPanel Spacing="2">
                            <TextBlock Text="倒计时" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="设定时长后倒数，到点响铃。" FontSize="12" Opacity="0.65" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="BtnStopwatch" GroupName="TimerMode" Width="252"
                                 Style="{StaticResource CshModeCardStyle}" Checked="Mode_Changed">
                        <StackPanel Spacing="2">
                            <TextBlock Text="秒表" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="从 0 开始正向计时，适合掐时间。" FontSize="12" Opacity="0.65" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <TextBlock x:Name="Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="05:00" FontSize="96" FontWeight="Bold"
                           FontFamily="Consolas" HorizontalAlignment="Center" />

                <Border Width="520" Height="6" CornerRadius="3"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <Border x:Name="ProgressFill" Width="520" Height="6" CornerRadius="3"
                            HorizontalAlignment="Left"
                            Background="{ThemeResource AccentFillColorDefaultBrush}" />
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Button x:Name="StartButton" Content="开始" Click="StartPause_Click" MinWidth="120" Height="40"
                            FontSize="15" Style="{StaticResource AccentButtonStyle}" />
                    <Button Content="重置" Click="Reset_Click" MinWidth="120" Height="40" FontSize="15" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 倒计时设定 / 秒表说明：同一个位置，两种模式各显示一半，尺寸不跳 -->
        <Border x:Name="SetupPanel" Grid.Row="2" CornerRadius="10" Padding="16" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="10" MaxWidth="900" HorizontalAlignment="Left">
                <TextBlock x:Name="SetupTitle" Text="设定时长" FontWeight="Bold" />
                <StackPanel x:Name="SetRow" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <NumberBox x:Name="MinBox" Value="5" Minimum="0" Maximum="999" SpinButtonPlacementMode="Compact"
                               Width="120" IsEnabled="True" />
                    <TextBlock Text="分" VerticalAlignment="Center" />
                    <NumberBox x:Name="SecBox" Value="0" Minimum="0" Maximum="59" SpinButtonPlacementMode="Compact"
                               Width="120" />
                    <TextBlock Text="秒" VerticalAlignment="Center" />
                    <Button Content="1 分钟" Click="Preset_Click" Tag="1" Margin="16,0,0,0" />
                    <Button Content="3 分钟" Click="Preset_Click" Tag="3" />
                    <Button Content="5 分钟" Click="Preset_Click" Tag="5" />
                    <Button Content="10 分钟" Click="Preset_Click" Tag="10" />
                    <Button Content="15 分钟" Click="Preset_Click" Tag="15" />
                </StackPanel>
                <TextBlock x:Name="StopwatchHint" Visibility="Collapsed" FontSize="12.5" Opacity="0.65"
                           TextWrapping="Wrap"
                           Text="秒表模式不需要设定时长：单击「开始」即开始计时，再次单击暂停，单击「重置」归零。" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
