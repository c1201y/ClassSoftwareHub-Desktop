<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.Tools.TimerToolPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ 2026-10-02 四次调整 ═══
         · 倒计时 / 秒表原来是一对普通按钮，靠"当前那个是强调色 + 名字前加个 ●"提示选中状态；
           后来升级成两张并列的大卡片 —— 但两张卡塞在计时盘内部，把主角位置挤扁了。
           现在改成页顶一行**原生 RadioButton**：两个模式同时看得见，占地只有一行。
         · 「设定时长」原来是一整张横贯全宽的卡片，内容却靠在左边，右边留出大片空白。
           现在去掉卡片外壳，输入框与预设按钮**紧挨着排、整行居中**，落在大字正下方。
         ⛔ 计时盘的大字是这一页唯一的主角，别往它左右两边再塞东西。 -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="998*" MaxWidth="1008" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" Margin="24,14,24,20" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="课堂计时器" FontSize="28" FontWeight="Bold" />
                    <TextBlock Text="倒计时 / 秒表，大字号便于投影，到达设定时间响铃。" FontSize="12" Opacity="0.6" />
                </StackPanel>
                <Button Grid.Column="1" Content="在工具窗口打开" VerticalAlignment="Center"
                        Click="OpenPalette_Click" ToolTipService.ToolTip="打开置顶小窗口，便于随时计时" />
            </Grid>

            <!-- 模式选择：⚠️ MinWidth 必须清零（RadioButton 默认 120），IsChecked 一律在代码里赋初值。
                 2026-10-04（Nick）：这一行右边再加「自定义铃声」按钮 + 「使用全屏时钟背景设置」开关。
                 改成三列 —— 说明文字落中间那一列（* 宽），窗口窄的时候由它自己省略，
                 不会把右边两个控件挤出去。 -->
            <Grid Grid.Row="1" ColumnSpacing="12" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="模式" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,2,0" />
                    <RadioButton x:Name="BtnCountdown" GroupName="TimerMode" Content="倒计时" MinWidth="0"
                                 Checked="Mode_Changed" />
                    <RadioButton x:Name="BtnStopwatch" GroupName="TimerMode" Content="秒表" MinWidth="0"
                                 Checked="Mode_Changed" />
                </StackPanel>

                <TextBlock Grid.Column="1" FontSize="12" Opacity="0.55" VerticalAlignment="Center" Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis"
                           Text="倒计时设定时长后倒数，到点响铃；秒表从 0 开始正向计时。" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button x:Name="AlarmButton" Content="自定义铃声" Click="Alarm_Click" MinWidth="0" />
                    <TextBlock Text="使用全屏时钟背景设置" FontSize="12" Opacity="0.6" VerticalAlignment="Center" />
                    <!-- ⚠️ MinWidth 必须清零；On/Off 文案留空 —— 标签已经在左边了，再来个「开/关」就重复 -->
                    <ToggleSwitch x:Name="ClockBgSwitch" MinWidth="0" OffContent="" OnContent=""
                                  Toggled="ClockBg_Toggled" />
                </StackPanel>
            </Grid>

            <!-- ═══ 计时盘：这一页的主角 ═══
                 只保留一块素净底，不给描边 —— 省掉"方块包方块"的厚重感，视线直接落在大字上。 -->
            <Border Grid.Row="2" CornerRadius="4" BorderThickness="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="Display" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Text="05:00" FontSize="96" FontWeight="Bold"
                               FontFamily="Consolas" HorizontalAlignment="Center" />

                    <Border Width="520" Height="6" CornerRadius="3"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <Border x:Name="ProgressFill" Width="520" Height="6" CornerRadius="3"
                                HorizontalAlignment="Left"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Button x:Name="StartButton" Content="开始" Click="StartPause_Click" MinWidth="120" Height="40"
                                FontSize="15" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="重置" Click="Reset_Click" MinWidth="120" Height="40" FontSize="15" />
                        <!-- 全屏投影：倒计时开全屏倒计时、秒表开全屏秒表（2026-10-03 Nick：两端都要有） -->
                        <Button x:Name="FullscreenButton" Content="全屏倒计时" Click="Fullscreen_Click" MinWidth="120" Height="40"
                                FontSize="15"
                                ToolTipService.ToolTip="把计时铺满整块屏幕，适合投影" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 倒计时设定 / 秒表说明：同一个位置，两种模式各显示一半，尺寸不跳。
                 ⛔ 不要再给它套卡片 —— 这一行的内容本来就窄，套上外壳就只剩右边一大片空白。 -->
            <StackPanel x:Name="SetupPanel" Grid.Row="3" Spacing="8" HorizontalAlignment="Center">
                <TextBlock x:Name="SetupTitle" Text="设定时长" FontSize="12" Opacity="0.6"
                           HorizontalAlignment="Center" />
                <!-- 2026-10-04（Nick）：这一整块与**网页版** `TimerTool.vue` 对齐 ——
                     网页版就是「分/秒输入框一行、预设另起一行」，桌面端原来挤成一行，
                     窗口一窄（≥700 的紧凑导航就是这个区间）左右两头都会被裁掉。
                     SetRow 现在是**竖排**容器（里面两行），所以 SetMode 里 SetRow.Visibility 照旧管用。 -->
                <StackPanel x:Name="SetRow" Spacing="12" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <!-- ═══ TimePicker 已撤 ═══
                             TimePicker 的弹出列表只有「时 / 分」、**没有秒**（10 秒倒计时都设不了），
                             而且它的列表默认朝上展开，会把上面那行「05:00」大字整块盖住（就是"起飞"）。
                             换回分/秒两个 NumberBox（Compact 步进，只弹一个小加减面板，不糊大字）。
                             ⚠️ 分上限 999 —— 90 分钟的公开课直接填 90，不用换算成小时（同网页版）。 -->
                        <NumberBox x:Name="MinBox" Width="92" MinWidth="0" Value="5"
                                   Minimum="0" Maximum="999" SmallChange="1" SpinButtonPlacementMode="Compact"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="分" FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
                        <NumberBox x:Name="SecBox" Width="92" MinWidth="0" Value="0"
                                   Minimum="0" Maximum="59" SmallChange="1" SpinButtonPlacementMode="Compact"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="秒" FontSize="12" Opacity="0.8" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel x:Name="PresetRow" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Content="1 分钟" Click="Preset_Click" Tag="1" />
                        <Button Content="3 分钟" Click="Preset_Click" Tag="3" />
                        <Button Content="5 分钟" Click="Preset_Click" Tag="5" />
                        <Button Content="10 分钟" Click="Preset_Click" Tag="10" />
                        <Button Content="15 分钟" Click="Preset_Click" Tag="15" />
                        <Button Content="1 小时" Click="Preset_Click" Tag="60" />
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="StopwatchHint" Visibility="Collapsed" FontSize="12" Opacity="0.65"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           Text="秒表模式不需要设定时长：单击「开始」即开始计时，再次单击暂停，单击「重置」归零。" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
