<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClassSoftwareHub.Desktop.Pages.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 原生标题栏：拖动区由 MainWindow 的 SetTitleBar 指定；系统按钮（三大金刚）在右上角。
             三列（* / Auto / *）：左＝图标与名称，中＝全局搜索（靠这套列定义真正居中于窗口），右＝外观按钮。 -->
        <Grid x:Name="TitleBarArea" Grid.Row="0" Background="{x:Null}"
              SizeChanged="TitleBarArea_SizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image x:Name="TitleIcon" Width="18" Height="18" />
                <TextBlock x:Name="TitleText" Text="ClassSoftwareHub" FontSize="12" FontWeight="Bold"
                           VerticalAlignment="Center" />
            </StackPanel>

            <!--
              全局搜索（Ctrl + K）。
              整套都用 AutoSuggestBox 的原生能力：搜索框外观、前置放大镜、清除按钮、以及**结果下拉**
              （定位、滚动、键盘上下选择、点外面自动收起，全归系统管），⛔ 不再自己叠一层浮层。
              2026-10-16 Nick 看过自绘那版，明确要求「用 WinUI 原生的就行，你不需要照抄网页的」。
              搜索范围与匹配规则在 Data/SearchIndex.cs。
            -->
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="1" Width="360" VerticalAlignment="Center"
                            QueryIcon="Find"
                            PlaceholderText="搜索软件、内置工具、页面…"
                            TextChanged="SearchBox_TextChanged"
                            SuggestionChosen="SearchBox_SuggestionChosen"
                            QuerySubmitted="SearchBox_QuerySubmitted">
                <!--
                  ⚠️ 模板里用 {Binding} 而不是 x:Bind：绑定源是普通对象列表，运行时绑定最省事，
                     也避开嵌套模板 + x:Bind 在这套 XamlCompiler 上的坑（§D ㉗）。
                  ⚠️ 那个"首字 / 字形"是两套并存、按可见性切换 —— 软件没有图标字体字形
                     （它的 icon 是远程图片，搜索结果不等它加载）。
                -->
                <AutoSuggestBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="10" Padding="0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <TextBlock Text="{Binding IconLetter}" FontSize="13" FontWeight="SemiBold"
                                               Visibility="{Binding LetterVisibility}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <FontIcon Glyph="{Binding IconGlyph}" FontSize="14"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              Visibility="{Binding GlyphVisibility}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="14"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Opacity="0.7"
                                           Visibility="{Binding SubtitleVisibility}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" Text="{Binding Badge}" FontSize="11" Opacity="0.6"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </AutoSuggestBox.ItemTemplate>
            </AutoSuggestBox>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,170,0" Spacing="10">
                <!-- 深色 / 浅色 一键切换（图标显示"点了会切到的那一边"） -->
                <Button x:Name="ThemeButton" Click="ThemeButton_Click"
                        Background="Transparent" BorderThickness="0" Padding="7,4" CornerRadius="4">
                    <FontIcon x:Name="ThemeIcon" Glyph="&#xE708;" FontSize="14" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2026-10-01 Nick 反馈「页面还够宽导航栏就自动收进去了，阈值太大」：
             CompactModeThresholdWidth 820→700、ExpandedModeThresholdWidth 1180→1008
             （1008 = WinUI 系统默认，与 Gallery 同款）：≥1008 展开、700~1008 图标条、<700 全隐 -->
        <NavigationView x:Name="Nav" Grid.Row="1" Background="{x:Null}"
                        IsBackButtonVisible="Visible" IsSettingsVisible="False"
                        PaneDisplayMode="Auto" OpenPaneLength="252"
                        CompactModeThresholdWidth="700" ExpandedModeThresholdWidth="1008"
                        BackRequested="Nav_BackRequested"
                        ItemInvoked="Nav_ItemInvoked">

            <!--
              材质底座（2026-09-28 起；2026-09-29 修正过一次 —— 之前刷得太狠了）。
              ⚠️ 本窗口的外观是 Mica / 亚克力（MainWindow.ApplyBackdrop 挂 SystemBackdrop）。
                 NavigationView 的默认模板会给**内容区**糊一层不透明底色
                 （SolidBackgroundFillColorBaseBrush），把窗口材质整个盖住 ——
                 表现就是设置页一片死灰/死黑。所以**只需要把这一层改透明**，材质才透得上来。
              ⚠️ 必须写成同 key 的 SolidColorBrush 定义：模板用的是 {ThemeResource} 查表，
                 换成 StaticResource 重指向同一 key 是无效的（会自引用）。

              ⛔⛔ 其余键**一律不要覆盖** —— 2026-09-29 Nick 连着报的两个 bug 全出在这里：

              ① 面板背景（`NavigationViewExpandedPaneBackground` /
                 `NavigationViewDefaultPaneBackground`）刷成透明会连出两个毛病：
                   · 窄窗口点汉堡，弹出的浮层面板透明 → 后面的页面内容整个漏出来；
                   · 并排展开时面板和内容区成了同一张底 → 左边分不出"导航栏"这一块。
                 官方对照表（NavigationView → Pane Backgrounds）：
                   Left                       → NavigationViewExpandedPaneBackground
                   LeftCompact / LeftMinimal  → NavigationViewDefaultPaneBackground
                   Top                        → NavigationViewTopPaneBackground
                 系统给它们的是**亚克力**（Expanded 是 background acrylic、跟着窗口材质；
                 Compact/Minimal 是 in-app acrylic，专为"浮在内容之上"设计）——
                 本身就是半透明的，不会把材质盖住，⛔ 别再改回 Transparent。

              ② `NavigationViewPaneBorderBrush` / `NavigationViewPaneBorderThickness`
                 —— 这就是**导航面板与内容区之间那条分隔线**。
                 2026-09-28 顺手刷成透明 + 粗细 0，线就没了。Nick 原话：
                 「原先导航栏还有标题栏，他们俩的是连接在一起的，并且与右边的内容区域是有分隔开的，
                   有一条线的，现在却是没有的」。
                 同类的还有 `NavigationViewContentGridBorderBrush` / `...GridBorderThickness`
                 （内容区那一圈边框），一并交回系统。

              → 结论（2026-10-01 修订，Nick 对标 WinUI Gallery）：
                 **一个键都不刷，NavigationView.Resources 整段删掉**。
                 Gallery 的分层 = 系统默认模板：标题栏 + 导航栏露窗口 Mica 材质，
                 内容区默认取 LayerFillColorDefaultBrush（设计规范「内容层色」，
                 "Used on background colors of any material to create layering"）+ 顶部 1px 分隔线。
                 09-28 刷透明治的「死灰盖材质」根因是当时的背板组合；现在默认背板已是 Mica，
                 与 Gallery 同构，恢复系统默认即 Gallery 观感，不会复发。
                 ⚠️ 若再遇内容区盖材质，先查背板设置，⛔ 别再刷 Transparent 抹掉分层。
            -->
            <!-- 上半区：首页 / 软件下载 / 内置工具 / 侧边布局 / 实验性功能（实验性功能永远排最后）
                 ⚠️ 图标别撞脸：E719（购物袋）＝软件商店，E896（下载箭头）留给「任务进行」，
                    E7F4（显示器）＝本机核实，EA80（灯泡）＝实验性功能。
                    改图标前先把码位渲染成图看一眼有没有字形（曾经差点用到不存在的码位）。 -->
            <NavigationView.MenuItems>
                <NavigationViewItem Content="首页" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="软件下载" Tag="apps">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE719;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--
                  内置工具：和「实验性功能」一样是分组父项 —— 点它 = 进工具索引页 + 展开/收起分组，
                  子项（图片取色 / 随机抽号 / 课堂计时器 / 全屏时钟 / 编码哈希）直达各自页面。
                  子项由 ShellPage 构造时按 ToolCatalog.All 动态生成（tag = ToolDef.Id），
                  ⛔ 别在 XAML 里手写 —— 工具清单只有 ToolCatalog 一份，手写会变成两处维护。
                  父项自己也是入口（进 ToolsPage），不进 NavigationView 的选中体系（原因同实验性功能）。
                -->
                <NavigationViewItem x:Name="ToolsNav" Content="内置工具" Tag="tools">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="侧边布局" Tag="sidebar">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8A0;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--
                  实验性功能：稳定性和准确度都还没到能上主界面的小玩意挂这儿。
                  ⚠️ **永远排在导航上半区最后一位** —— 这是「还没成熟」的位置含义，
                     以后往里加新功能也照此放，别插到前面去。
                  ⚠️ 父项**自己就是总览入口**：点它 = 打开总览页 + 展开/收起分组。
                     走的就是普通 ItemInvoked（实测：有子项的项被点击时 ItemInvoked 照样触发，
                     只是 InvokedItemContainer 的 Tag 为空 —— 所以给它设上 Tag 即可）。
                  ⚠️ 父项**不要进 NavigationView 的选中体系**：把 SelectedItem 指到 group header 上，
                     它偶尔会顺着分组去 Invoke 第一个子项（实测：点实验性功能却跳到本机核实）。
                     所以 SelectTag 对 experimental 是特判——手动点亮父项，不碰 SelectedItem（见 ShellPage.xaml.cs）。
                  ⚠️ 因此**不要**为了"能高亮"再往里加一个「总览」子项：总览没有独立内容，
                     它就是这一组本身，导航里凭空多一项反而像是个单独的功能。
                -->
                <NavigationViewItem x:Name="ExperimentalNav" Content="实验性功能" Tag="experimental">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA80;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.MenuItems>
                        <!--
                          本机核实：拿本机已装软件跟清单对一遍。
                          ⚠️ 为啥塞进实验性：结果**明显不准**（只读「程序和功能」注册表，
                             匹配靠名称模糊比对，Store 版/免安装版/改了名的全认不出来）。
                             放一级导航容易被当成装机验收依据，所以降级成"供你自己玩"。
                        -->
                        <NavigationViewItem Content="本机核实" Tag="machinecheck">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE7F4;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <!--
                          白板专杀：到点结束希沃白板5 后台滞留的残留进程。
                          ⚠️ 与「程序专杀」是**两个独立功能**，Nick 2026-09-28 明确要求不合并 ——
                             本项写死只认白板5 家族（EasiNote*），不碰集控端与更新组件，所以不能拿通用专杀替代。
                          ⚠️ 为啥塞进实验性：要真机上装了白板5 才能验，而且"有窗口就不动"这套判定
                             在真实课堂里的误判率还没底（比如白板5 挂了个不可见的辅助窗口）。
                        -->
                        <NavigationViewItem Content="白板专杀" Tag="easiguard">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xEA99;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <!--
                          程序专杀：用户自己指定进程名，每个程序单独配结束时间点。
                          ⚠️ 与白板专杀各存各的配置、各跑各的定时器（Nick 明确要求白板独立出来）。
                        -->
                        <NavigationViewItem Content="程序专杀" Tag="procguard">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE7E8;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <!--
                          应用卸载：2026-10-12 加（Nick：「既然是以软件下载起步的，为什么不也管卸载」）。
                          ⚠️ 为啥塞实验性：卸载是**不可逆操作**，而扫描口径有已知盲区（免安装版没有任何登记、
                             别的账户注册的商店应用读不到），结果不像"能装机验收"那么权威 ——
                             先放这儿用一阵，反馈好了再议要不要上主界面。
                          ⚠️ 图标 E74D（垃圾桶）：MDL2 里没有专门的"卸载"字形，垃圾桶是最通用的隐喻；
                             改之前先过 glyphs.ps1 渲图看有没有字形（ED 那段的坑见 MEMORY §6）。
                        -->
                        <NavigationViewItem Content="应用卸载" Tag="uninstaller">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE74D;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <!--
                          AppData 管理：2026-10-13 加（Nick：「实验性功能就是 AppData 文件夹管理」）。
                          ⚠️ 为啥塞实验性：删的是**别的软件的数据**，没有厂商卸载程序兜底，
                             判"哪些目录是纯缓存"这件事永远可能判错 —— 所以只放实验性里，且清单一律限于缓存目录（永久删除）。
                             三层边界（只读体检 / 白名单清理 / 禁碰区）写在 Services/AppDataScan.cs 的类注释里。
                          ⚠️ 图标 E8B7（文件夹）：语义最直白；改之前先过 glyphs 脚本渲图看有没有字形
                             （ED 那段的坑见 MEMORY §6）。
                        -->
                        <NavigationViewItem Content="AppData 管理" Tag="appdata">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE8B7;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <!--
                          开机启动项：2026-10-16 加（1.2.0 第二批第一条，Nick：「可以试试」）。
                          ⚠️ 为啥塞实验性：它改动的是**系统启动配置**，而且扫描口径有已知盲区 ——
                             只覆盖注册表 Run 与启动文件夹这两大类，服务、计划任务、Group Policy 启动脚本
                             都不在范围内。用户若把它当成"这台机器上所有自启项"就会漏判。
                          ⚠️ 关掉一项写的是 Windows 自己的 StartupApproved 状态位（与任务管理器同一套），
                             ⛔ 不删注册表值、不移动文件 —— 不可逆操作一律不做，见 Services/StartupItems.cs。
                          ⚠️ 图标 E945（闪电）：E7E8（电源）被「程序专杀」用了，重复会分不清；
                             改之前先过 glyphs 脚本渲图看有没有字形（ED 那段的坑见 MEMORY §6）。
                        -->
                        <NavigationViewItem Content="开机启动项" Tag="startup">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE945;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <!--
                          系统修复：2026-10-16 加（1.2.0 第二批第二条）。
                          ⚠️ 为啥塞实验性：7 张卡全是**改系统**的命令（系统文件 / 组件存储 / 网络栈 / 系统服务），
                             而且"哪张卡该在什么情况下用"需要使用者自己判断 —— 它不是一键体检。
                             条目本身是 Windows 自带命令，技术上没有不确定性，风险全在"用错场合"。
                          ⛔ 刻意**不做命令输入框**，只有预设卡；确认框（唯一安全闸）里原样列出将要执行的命令。
                          ⚠️ 图标 E7EF（盾牌）：语义＝修复/防护；改之前先过 glyphs 脚本渲图看有没有字形
                             （ED 那段的坑见 MEMORY §6）。卡内 7 个图标也各验过、彼此不撞脸。
                        -->
                        <NavigationViewItem Content="系统修复" Tag="repair">
                            <NavigationViewItem.Icon>
                                <FontIcon Glyph="&#xE7EF;" />
                            </NavigationViewItem.Icon>
                        </NavigationViewItem>
                        <!--
                          自动关机：2026-10-12 转正搬去「内置工具」分组 —— 子项由 ToolCatalog 自动生成，
                          这里不能再手写一条（否则导航里会出现两个同名项）。见 Data/ToolDef.cs。
                        -->
                        <!--
                          日志查看：Nick 2026-10-02 拍板「不要实验性」，入口挪到 设置 → 诊断
                          （Pages/SettingsPage.xaml）。NavigateTagCore 的 "logs" case 保留，
                          供设置页跳转（含 page=logs 启动参数）用。
                        -->
                    </NavigationViewItem.MenuItems>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <!-- 下半区：任务进行 / 提交软件 / 反馈中心 / 更新日志 / 设置 -->
            <NavigationView.FooterMenuItems>
                <!-- 下载不再占着界面：进度在这里看得到；徽标上是「正在下载几个」（0 个就把徽标摘掉） -->
                <NavigationViewItem x:Name="DownloadsNav" Content="任务进行" Tag="downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="提交软件" Tag="submit">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE898;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!--
                  反馈中心：和「提交软件」是一对（都是"往维护者那边送东西"），所以紧挨着放。
                  E939 是「人 + 对话泡」，微软反馈中心用的就是这个字形（已用字形渲染法确认存在）。
                -->
                <NavigationViewItem Content="反馈中心" Tag="feedback">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE939;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- 更新日志：E81C 是时钟/历史，跟「设置」的齿轮分得开 -->
                <NavigationViewItem Content="更新日志" Tag="changelog">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <!--
                CacheSize（2026-10-04 由 12 收紧到 2）：
                原本是 0（页面一切走就丢，每次回来都要重新解析 XAML + 重建整棵树，切页能明显顿一下）；
                10-01 为了消掉那个顿，一口气放到 12。Nick 现在要"回到最开始那种激进省内存的思路"，
                所以**不再攒一堆页面** —— 只留最近 2 页（够"来回切"不重解析，又不会把十来个页面的
                可视化树长期钉在内存里）。
                ⛔ 没取 0：那正是 10-01 实测"切页明显顿一下"的配置，代价已经被否过一次。
                ⛔ 没取 12：Nick 明确说"缓存各种页面…还是不够好"。
                页面用 NavigationCacheMode="Enabled" 的才真进缓存，其余仍旧走完就丢；
                "内存立刻降下来"主要还是靠 MemoryTrimmer 的回收时机（现在切一页就收一次，
                见 Services/MemoryTrimmer.cs）。

                ContentTransitions：WinUI 原生的切页过渡（淡入 + 轻微上移），不是自绘动画。
            -->
            <Frame x:Name="ContentFrame" CacheSize="2">
                <Frame.ContentTransitions>
                    <TransitionCollection>
                        <NavigationThemeTransition>
                            <NavigationThemeTransition.DefaultNavigationTransitionInfo>
                                <EntranceNavigationTransitionInfo />
                            </NavigationThemeTransition.DefaultNavigationTransitionInfo>
                        </NavigationThemeTransition>
                    </TransitionCollection>
                </Frame.ContentTransitions>
