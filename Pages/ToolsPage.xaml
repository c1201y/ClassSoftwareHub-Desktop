<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.ToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:ClassSoftwareHub.Desktop.Data">

    <!-- 和首页 / 设置页 / 软件下载页同一套版式：内容钉在中间 960 宽 -->
    <Grid Padding="24,36,24,44">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="998*" MaxWidth="960" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Text="内置工具" FontSize="30" FontWeight="Bold" />

            <!-- 6 个工具：卡片 462 + 间距 16 = 478，960 里正好两列；单行卡片（图标 + 名称 + 箭头） -->
            <GridView x:Name="ToolGrid" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="ToolGrid_ItemClick" Padding="0,2,0,0"
                      ItemContainerStyle="{StaticResource CshCardItemStyle}">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="data:ToolDef">
                        <Border Width="462" Height="64" CornerRadius="8" Padding="20,0" Margin="0,0,16,14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="15" FontWeight="Bold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="13" Opacity="0.5"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </Grid>
    </Grid>
</Page>
