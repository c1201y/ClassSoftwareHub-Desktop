<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.ToolsPage"
    NavigationCacheMode="Disabled"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:data="using:ClassSoftwareHub.Desktop.Data">

    <!-- 和首页 / 设置页 / 软件下载页同一套版式：内容钉在中间 960 宽 -->
    <Grid Padding="24,36,24,44">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="998*" MaxWidth="960" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="1" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="内置工具" FontSize="30" FontWeight="Bold" />

            <!-- 6 个工具：卡片 462 + 间距 16 = 478，960 里正好两列；单行卡片（图标 + 名称 + 箭头） -->
            <GridView x:Name="ToolGrid" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True"
                      ItemClick="ToolGrid_ItemClick" Padding="0,2,0,0"
                      ItemContainerStyle="{StaticResource CshCardItemStyle}">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="data:ToolDef">
                        <Border Width="462" Height="64" CornerRadius="8" Padding="20,0" Margin="0,0,16,14"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                PointerEntered="Card_PointerEntered" PointerExited="Card_PointerExited">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="20" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="15" FontWeight="Bold"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="13" Opacity="0.5"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <!-- ===== 常用工具窗口：开关就放这儿，跟首页「体验网页版」那张卡一个意思 ===== -->
            <Border Grid.Row="2" CornerRadius="8" Padding="20,16" Margin="0,4,0,0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid ColumnSpacing="16" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE71D;" FontSize="20" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Text="常用工具窗口" FontSize="15" FontWeight="Bold" />
                        <TextBlock FontSize="12.5" Opacity="0.7" TextWrapping="Wrap"
                                   Text="一个置顶小窗口，只放四个常用的：随机抽号、课堂计时、秒表计时、全屏时钟。不用打开主界面 —— 系统托盘里有它自己的图标，点一下就出来（窗口能拖，Esc 收起来）。屏幕边上还有一条更省事的「侧边栏」，全屏放 PPT 时也点得到。" />
                        <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                                   Text="侧边栏、窗口置顶这些开关在「设置 → 常用工具」里。" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="打开窗口" Style="{StaticResource AccentButtonStyle}"
                            VerticalAlignment="Top" Click="OpenPalette_Click" />

                    <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="28">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="点关闭时收进托盘" FontSize="13" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="TraySwitch" OnContent="开" OffContent="关" MinWidth="0"
                                          Toggled="TraySwitch_Toggled" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
