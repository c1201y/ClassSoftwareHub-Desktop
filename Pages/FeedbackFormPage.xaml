<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Pages.FeedbackFormPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    












    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
            

            <StackPanel MaxWidth="1008" Padding="24,32,24,44">

                
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image x:Name="FormKindImage" Width="30" Height="30" Stretch="Uniform"
                           VerticalAlignment="Center" />
                    <TextBlock x:Name="FormKindText" FontSize="28" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                
                <InfoBar IsOpen="True" Severity="Informational" IsClosable="False" Margin="0,18,0,0"
                         Title="内容将公开可见"
                         Message="提交后，所填内容将公开显示于本站仓库的议题列表中，任何人均可查看。请勿填写密码、手机号等敏感信息。" />

                
                <Border Margin="0,24,0,0" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Padding="22,20,22,24">
                    <StackPanel Spacing="0">
                        <TextBlock Text="基本信息" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16" />

                        <StackPanel Spacing="18">
                            





                            <ComboBox x:Name="SubKindCombo" Header="问题类型" PlaceholderText="请选择"
                                      DisplayMemberPath="Title"
                                      HorizontalAlignment="Stretch" SelectionChanged="SubKind_Changed" />

                            
                            <ComboBox x:Name="AppCombo" Header="涉及的软件" PlaceholderText="选择软件（选填）"
                                      DisplayMemberPath="Name"
                                      HorizontalAlignment="Stretch" SelectionChanged="App_Changed" />

                            
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="标题" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="*" FontSize="13"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <TextBox x:Name="TitleBox" PlaceholderText="一句话概括问题或建议"
                                         TextWrapping="Wrap" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="详细描述" FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="*" FontSize="13"
                                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                </StackPanel>
                                <TextBox x:Name="DetailBox" PlaceholderText="说明问题出现的页面、操作步骤、预期结果与实际结果"
                                         TextWrapping="Wrap" AcceptsReturn="True" MinHeight="112"
                                         HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </StackPanel>

                        
                        <Border Height="1" Margin="0,28,0,24"
                                Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <TextBlock Text="联系方式" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <StackPanel Spacing="6">
                            <TextBox x:Name="ContactBox" Header="联系方式" PlaceholderText="QQ / 微信 / 邮箱"
                                     HorizontalAlignment="Stretch" />
                            <TextBlock Text="选填。您的联系方式将在本地加密后提交，仅维护者可解密查看。"
                                       FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                
                <Border Margin="0,24,0,0" CornerRadius="4" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        Padding="22,20,22,24">
                    <StackPanel Spacing="0">
                        <TextBlock Text="本机信息" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <CheckBox x:Name="IncludeEnvCheck" Content="随反馈附上本机信息"
                                  Checked="IncludeEnv_Changed" Unchecked="IncludeEnv_Changed" />
                        <TextBlock x:Name="EnvPreview" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Border>

                
                <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" Title="无法提交"
                         Margin="0,16,0,0" IsClosable="True" />

                <InfoBar x:Name="SuccessBar" IsOpen="False" Severity="Success" Title="已提交"
                         Margin="0,16,0,0" IsClosable="True">
                    <InfoBar.ActionButton>
                        <Button x:Name="ViewIssueButton" Content="查看议题" Click="ViewIssue_Click"
                                Visibility="Collapsed" />
                    </InfoBar.ActionButton>
                </InfoBar>

                <InfoBar x:Name="TruncateBar" IsOpen="False" Severity="Warning" Title="内容已自动截断"
                         Message="描述长度超出链接可承载的上限，已自动截断。单击「在 Q 群中反馈」可取得完整内容，粘贴到群相册的说明栏即可。"
                         Margin="0,16,0,0" IsClosable="True" />

                
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,24,0,0">
                    



                    <Button x:Name="SubmitButton" Click="Submit_Click" Style="{StaticResource AccentButtonStyle}"
                            Padding="18,8,18,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE724;" FontSize="14" />
                            <TextBlock x:Name="SubmitLabel" Text="提交反馈" />
                        </StackPanel>
                    </Button>

                    
                    <Button x:Name="OpenIssueButton" Click="OpenIssue_Click" Padding="18,8,18,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                            <TextBlock Text="在 GitHub 上提交" />
                        </StackPanel>
                    </Button>

                    




                    <Button x:Name="QqGroupButton" Click="QqGroup_Click" Padding="18,8,18,8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8BD;" FontSize="14" />
                            <TextBlock Text="在 Q 群中反馈" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                




                <StackPanel Margin="0,16,0,0" Spacing="6">
                    <TextBlock FontSize="12" TextWrapping="Wrap" LineHeight="18"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="「提交反馈」" FontWeight="SemiBold" />
                        <Run Text="：无需 GitHub 账户；开发者回复不会通知到您。" />
                    </TextBlock>

                    <TextBlock FontSize="12" TextWrapping="Wrap" LineHeight="18"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="「在 GitHub 上提交」" FontWeight="SemiBold" />
                        <Run Text="：需 GitHub 账户；可收到回复通知。" />
                    </TextBlock>

                    <TextBlock FontSize="12" TextWrapping="Wrap" LineHeight="18"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="「在 Q 群中反馈」" FontWeight="SemiBold" />
                        <Run Text="：以上两者不便使用时改用此通道。" />
                    </TextBlock>

                    <TextBlock Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" LineHeight="18"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="填写内容在本地自动保存为草稿，中途离开亦不会丢失。" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
