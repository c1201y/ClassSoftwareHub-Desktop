<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClassSoftwareHub.Desktop.Views.Markdown.MarkdownStageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 沉浸模式：全屏、无控件、只有内容，适合投影与教室大屏。 -->
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <ScrollViewer x:Name="Scroller"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="Stage" MaxWidth="1080" Margin="48,56,48,120"
                        HorizontalAlignment="Center" />
        </ScrollViewer>

        <Border x:Name="Hint" VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,18,0,0" Padding="14,8" CornerRadius="8"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <TextBlock x:Name="HintText" FontSize="12" Opacity="0.75" />
        </Border>

        <!-- 触屏没有键盘，退出必须有一个能点的入口，不能只靠 Esc。 -->
        <Button x:Name="ExitButton" VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="0,18,24,0" Height="38" Padding="16,0"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Click="Exit_Click" ToolTipService.ToolTip="退出沉浸模式">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
                <TextBlock Text="退出" FontSize="13.5" />
            </StackPanel>
        </Button>
    </Grid>
</Window>
