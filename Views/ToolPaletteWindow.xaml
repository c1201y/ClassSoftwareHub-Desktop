<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClassSoftwareHub.Desktop.Views.ToolPaletteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:palette="using:ClassSoftwareHub.Desktop.Views.Palette">

    <!--
      常用工具窗口：**标准窗口 + 自绘标题栏**（ExtendsContentIntoTitleBar）——
      外观是自己的（不是系统那根丑标题栏），但窗口框架还是系统的：
      拖动/触屏拖动/阴影/圆角都交给 Windows，我们不用再自己算位移。
      **不进任务栏**（入口是系统托盘里它自己那个图标，跟主界面那个图标分开）；
      不能最大化/全屏、不能最小化；× / Esc = 收起来，托盘那个图标点一下就回来。
    -->
    <Grid x:Name="Root" IsTabStop="True" KeyDown="Root_KeyDown"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏（SetTitleBar 就是这一块，整条都能拖，触屏也能拖） -->
        <Grid x:Name="AppTitleBar" Height="32" Padding="12,0,0,0" ColumnSpacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE71D;" FontSize="13" Opacity="0.85" />
                <TextBlock Text="常用工具" FontSize="12.5" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 四个工具切换（等宽，标题统一四个字） -->
        <Grid Grid.Row="1" ColumnSpacing="6" Padding="14,6,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ChipPick" Content="随机抽号" Tag="pick-number" HorizontalAlignment="Stretch"
                    Padding="0,6" MinWidth="0" Click="Chip_Click" />
            <Button x:Name="ChipTimer" Grid.Column="1" Content="课堂计时" Tag="timer" MinWidth="0"
                    HorizontalAlignment="Stretch" Padding="0,6" Click="Chip_Click" />
            <Button x:Name="ChipStopwatch" Grid.Column="2" Content="秒表计时" Tag="stopwatch" MinWidth="0"
                    HorizontalAlignment="Stretch" Padding="0,6" Click="Chip_Click" />
            <Button x:Name="ChipClock" Grid.Column="3" Content="全屏时钟" Tag="clock" MinWidth="0"
                    HorizontalAlignment="Stretch" Padding="0,6" Click="Chip_Click" />
        </Grid>

        <!-- 当前工具 -->
        <Grid Grid.Row="2" Padding="14,0,14,14">
            <Grid x:Name="PanePick">
                <palette:MiniPickNumber x:Name="PickView" />
            </Grid>
            <Grid x:Name="PaneTimer" Visibility="Collapsed">
                <palette:MiniTimer x:Name="TimerView" />
            </Grid>
            <Grid x:Name="PaneStopwatch" Visibility="Collapsed">
                <palette:MiniStopwatch x:Name="StopwatchView" />
            </Grid>
            <Grid x:Name="PaneClock" Visibility="Collapsed">
                <palette:MiniClock x:Name="ClockView" />
            </Grid>
        </Grid>
    </Grid>
</Window>
