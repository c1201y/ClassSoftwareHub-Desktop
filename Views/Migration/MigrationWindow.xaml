<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClassSoftwareHub.Desktop.Views.Migration.MigrationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarHost" Grid.Row="0" Padding="20,0,150,0" Background="Transparent">
            <TextBlock Text="设置迁移" FontSize="12" Opacity="0.65" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="40,4,40,0" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="12" Padding="0,0,0,8">
                <StackPanel Spacing="6">
                    <TextBlock Text="设置迁移" FontSize="28" FontWeight="Bold" />
                    <TextBlock FontSize="12" Opacity="0.65" TextWrapping="Wrap"
                               Text="导出一份配置文件带到别的电脑，或从配置文件恢复这台电脑的设置。" />
                </StackPanel>

                <TextBlock Text="导出" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,0" />
                <controls:SettingsCard Header="保存当前设置"
                                       Description="包含外观、侧边栏、快捷应用与 AI 模板；激活状态与本地缓存不在其中。">
                    <Button Content="选择保存位置…" Click="Export_Click" />
                </controls:SettingsCard>

                <TextBlock Text="导入" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                <controls:SettingsCard Header="从配置文件恢复"
                                       Description="先核对差异再覆盖，应用前会自动备份当前设置。">
                    <Button Content="选择文件…" Click="Import_Click" />
                </controls:SettingsCard>

                <controls:SettingsCard x:Name="DiffCard" Header="待应用的变更" Visibility="Collapsed">
                    <controls:SettingsCard.Description>
                        <TextBlock x:Name="DiffText" TextWrapping="Wrap"
                                   Style="{StaticResource CaptionTextBlockStyle}" />
                    </controls:SettingsCard.Description>
                </controls:SettingsCard>

                <InfoBar x:Name="ResultBar" IsOpen="False" Severity="Informational" />
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Margin="40,12,40,20" FontSize="12" Opacity="0.55" TextWrapping="Wrap"
                   Text="窗口位置、下载目录等本机字段不会迁移。" />
    </Grid>
</Window>
