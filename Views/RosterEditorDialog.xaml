<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ClassSoftwareHub.Desktop.Views.RosterEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="名单"
    CloseButtonText="关闭"
    DefaultButton="Close"
    CornerRadius="8">

    








    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
    </ContentDialog.Resources>

    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2" VerticalAlignment="Center">
                <TextBlock x:Name="CountText" FontSize="13" FontWeight="Bold" Text="共 0 人" />
                <TextBlock FontSize="11.5" Opacity="0.6" TextWrapping="Wrap"
                           Text="单击名字即可编辑，右侧按键移除该行。" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                



                <Button x:Name="AddNameButton" Click="Add_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        AutomationProperties.Name="添加一行姓名"
                        ToolTipService.ToolTip="在名单末尾加一行，填好姓名后按回车即可">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                        <TextBlock Text="添加姓名" />
                    </StackPanel>
                </Button>
                <Button x:Name="ExportExcelButton" Content="导出 Excel" Click="ExportExcel_Click"
                        ToolTipService.ToolTip="另存为 .xlsx 表格（序号 + 姓名两列）" />
                <Button x:Name="ExportTxtButton" Content="导出 txt" Click="ExportTxt_Click"
                        ToolTipService.ToolTip="另存为 .txt 文本，一行一个名字" />
            </StackPanel>
        </Grid>

        
        <ListView x:Name="RosterList" Grid.Row="1" Height="380" SelectionMode="None" Padding="0">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnSpacing="10" Padding="0,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding NoText}" FontSize="12" Opacity="0.55"
                                   VerticalAlignment="Center" />
                        


                        <TextBox Grid.Column="1" Text="{Binding Name}" FontSize="13" Padding="8,4"
                                 VerticalAlignment="Center"
                                 AutomationProperties.Name="{Binding RowLabel}"
                                 LostFocus="Name_LostFocus" KeyDown="Name_KeyDown" />
                        <Button Grid.Column="2" Click="Delete_Click" Padding="9,6"
                                VerticalAlignment="Center" AutomationProperties.Name="{Binding DeleteLabel}"
                                ToolTipService.ToolTip="从名单中移除这一行">
                            <FontIcon Glyph="&#xE74D;" FontSize="13" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        




        <StackPanel Grid.Row="2" Spacing="6">
            <TextBlock x:Name="EmptyHint" FontSize="12.5" Opacity="0.6" TextWrapping="Wrap"
                       Visibility="Collapsed"
                       Text="名单为空，可逐个添加或导入 Excel / txt / csv。" />
            <TextBlock x:Name="ToastText" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</ContentDialog>
