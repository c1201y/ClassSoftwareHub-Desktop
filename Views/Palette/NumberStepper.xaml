<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClassSoftwareHub.Desktop.Views.Palette.NumberStepper"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <!--
      触屏友好的数字步进器：[-] 数值 [+]
      ⚠️ 数值故意**不放在 TextBox 里**：触屏点一下 TextBox 会选中全部文字并弹出"复制/粘贴"小菜单，
        教室里用触屏特别难受。这里用 TextBlock，只靠两边的大按钮加减。
      RepeatButton 自带长按连发（Delay 后按 Interval 重复），所以 1 加到 50 按住不放就行。
    -->
    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
        <TextBlock x:Name="LabelText" FontSize="12.5" Opacity="0.7" VerticalAlignment="Center" />

        <primitives:RepeatButton x:Name="MinusButton" Content="&#x2212;" FontSize="16" FontWeight="SemiBold"
                                 MinWidth="38" MinHeight="34" Padding="0"
                                 Delay="450" Interval="110" Click="Minus_Click" />

        <Border MinWidth="46" Height="34" CornerRadius="4" BorderThickness="1"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
            <TextBlock x:Name="ValueText" Text="0" FontSize="15"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <primitives:RepeatButton x:Name="PlusButton" Content="+" FontSize="16" FontWeight="SemiBold"
                                 MinWidth="38" MinHeight="34" Padding="0"
                                 Delay="450" Interval="110" Click="Plus_Click" />
    </StackPanel>
</UserControl>
