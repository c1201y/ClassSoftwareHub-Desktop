<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClassSoftwareHub.Desktop.Views.Palette.MiniPickNumber"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      浮窗版随机抽号：抽什么（座号 / 名单）+ 基本设置 + 大号结果 + 重置/抽取/不重复。

      2026-10-03（Nick 三轮定版）：
        · 「抽取座号」= 抽数字，「使用名单」= 抽名字。
        · **起始座号砍掉**：座号固定从 1 号开始，只留一个「终止范围」（＝原来那个"结束座号"）。
        · 「终止范围」和「抽取个数」改用 **NumberBox（Inline 自增钮）**——原来的小号上下箭头
          鼠标能点到、触屏点不到，Inline 版的上/下按钮整高、够大。
        · **不重复**挪到「重置 / 抽取」那一行的右边。
    -->
    <Grid RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 抽什么：座号（数字）/ 名单（名字） -->
        <SelectorBar x:Name="PoolSelector" Grid.Row="0" HorizontalAlignment="Center"
                     SelectionChanged="PoolSelector_SelectionChanged">
            <SelectorBarItem x:Name="ModeRangeItem" Tag="range" Text="抽取座号" />
            <SelectorBarItem x:Name="ModeRosterItem" Tag="roster" Text="使用名单" />
        </SelectorBar>

        <!-- 基本设置一行：(终止范围 | 名单信息) + 抽取个数 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="16"
                    HorizontalAlignment="Center" VerticalAlignment="Top">
            <!-- 座号模式：终止范围（从 1 号抽到 N 号） -->
            <NumberBox x:Name="ToNumberBox" Header="终止范围" Value="50" Minimum="1" Maximum="9999"
                       SmallChange="1" SpinButtonPlacementMode="Inline" Width="150"
                       AutomationProperties.Name="终止范围" />

            <!-- 名单模式：池子信息（跟 NumberBox 的输入框本体育对齐） -->
            <TextBlock x:Name="RosterInfoText" FontSize="12.5" Opacity="0.7"
                       VerticalAlignment="Center" Margin="0,16,0,0"
                       Text="名单：—" TextWrapping="NoWrap" MaxWidth="150" />

            <!-- 抽取个数：两种模式共用（上限在代码里按模式夹） -->
            <NumberBox x:Name="CountNumberBox" Header="抽取个数" Value="1" Minimum="1" Maximum="9999"
                       SmallChange="1" SpinButtonPlacementMode="Inline" Width="150"
                       AutomationProperties.Name="抽取个数" />
        </StackPanel>

        <!-- 结果区：这一页的主角，吃掉中间剩下的全部高度。
             ⚠️ 外面这层 Viewbox 是必须的（2026-10-05 群反馈）：文本改为**单行**显示，
                放不下时整体等比缩小；`StretchDirection="DownOnly"` 保证"放得下就保持原字号"，
                不会被放大。旧版是 TextBlock 自己 `TextWrapping="Wrap"`，
                名字一长就折成两三行、挤在小小的浮窗里，跟主页面那个"名字折行"是同一处毛病。 -->
        <Grid Grid.Row="2" MinHeight="96">
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="8,0"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="ResultText" Text="—" FontSize="64" FontWeight="SemiBold"
                           FontFamily="Bahnschrift" TextAlignment="Center" TextWrapping="NoWrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Viewbox>
            <!-- 提示与池子状态：贴在大字底下，小字退成配角 -->
            <TextBlock x:Name="HintText" FontSize="11.5" Opacity="0.6"
                       VerticalAlignment="Bottom" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" IsHitTestVisible="False" Margin="0,6,0,0" />
        </Grid>

        <!-- 重置 + 抽取 + 不重复：同一行、居中 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <Button x:Name="ResetButton" Content="重置" Padding="26,7"
                    Click="Reset_Click"
                    ToolTipService.ToolTip="清空已抽取的记录，重新开始" />
            <Button x:Name="DrawButton" Content="抽取" Style="{StaticResource AccentButtonStyle}"
                    Padding="44,7" FontSize="15"
                    Click="Draw_Click" />
            <ToggleSwitch x:Name="NoRepeatBox" OnContent="不重复" OffContent="允许重复"
                          MinWidth="0" Toggled="NoRepeat_Toggled" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
