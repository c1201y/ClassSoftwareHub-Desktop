<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClassSoftwareHub.Desktop.Views.Palette.MiniClock"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      浮窗版时钟：大号时间 + 日期 + 一键进全屏时钟。
      ⚠️ 2026-09-28（Nick）：浮窗里也要能看出"这套预设长什么样"、要能切预设、还要能恢复默认。
      所以时间那块自己成了一张"舞台"（Stage），按当前外观画底色/背景图/蒙版/字色/字体 ——
      它既是预览，也是切完立刻能看到反馈的地方。
    -->
    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="Stage" CornerRadius="8" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Border x:Name="VeilHost" CornerRadius="8" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Center">
                        <TextBlock x:Name="TimeText" Text="00:00" FontSize="46" FontWeight="SemiBold"
                                   FontFamily="Bahnschrift" />
                        <TextBlock x:Name="SecText" Text=":00" FontSize="18" FontWeight="SemiBold" Opacity="0.8"
                                   FontFamily="Bahnschrift" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                    </StackPanel>
                    <TextBlock x:Name="DateText" Text="" FontSize="11" Opacity="0.7"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 预设切换：点一下就换一套；「恢复默认」固定在右边不跟着滚 -->
        <Grid Grid.Row="1" ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="PresetHost" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
            </ScrollViewer>
            <Button x:Name="ResetAppearanceButton" Grid.Column="1" Content="恢复默认外观" MinWidth="0" Padding="10,5"
                    FontSize="12.5" Click="ResetAppearance_Click"
                    ToolTipService.ToolTip="恢复出厂外观设置，不套用任何预设" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Content="全屏时钟" Style="{StaticResource AccentButtonStyle}" Click="Fullscreen_Click" />
            <Button Content="详细设置" Click="Details_Click"
                    ToolTipService.ToolTip="显示应用内的「时钟」工具页，可修改字体、底色、遮罩并保存预设" />
        </StackPanel>
    </Grid>
</UserControl>
