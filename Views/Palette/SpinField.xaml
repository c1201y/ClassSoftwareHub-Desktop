<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClassSoftwareHub.Desktop.Views.Palette.SpinField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    <!--
      紧凑数字输入：**标签在上、窄框、右侧上下箭头**（Nick 2026-10-03 定的形态，照 AdaptiveTrigger 面板那种样式）。

      为什么不用原生 NumberBox：它数值放在 TextBox 里，触屏点一下会全选 + 弹"复制/粘贴"菜单，教室里很难受
      —— 这是 NumberStepper 当初自己写的原因（见 NumberStepper.xaml 注释）。所以这里沿用同一套做法：
      值用 TextBlock 显示，上下箭头是 RepeatButton（自带长按连发，按住不放就一直加）。

      宽度刻意做窄（默认 88），这样「范围 / 个数」两三个能并排放进一行。
    -->
    <StackPanel Spacing="4" VerticalAlignment="Top">

        <TextBlock x:Name="LabelText" FontSize="11.5" Opacity="0.65"
                   HorizontalAlignment="Center" TextWrapping="NoWrap" />

        <Border CornerRadius="4" BorderThickness="1"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                Height="30" MinWidth="72">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ValueText" Text="0" FontSize="14" Margin="10,0,2,0"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <!-- 上下箭头：叠在一个窄条里，上半下半分；右边留 3px，别把箭头怼在边框线上看着像截断 -->
                <Grid Grid.Column="1" Width="22" Height="26" Margin="0,1,3,1" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <primitives:RepeatButton x:Name="UpButton" Grid.Row="0" Content="&#xE70E;"
                                             FontFamily="Segoe Fluent Icons" FontSize="9"
                                             MinWidth="0" MinHeight="0" Padding="0"
                                             Delay="450" Interval="110"
                                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                             Background="Transparent" BorderThickness="0"
                                             AutomationProperties.Name="增加"
                                             Click="Up_Click" />
                    <primitives:RepeatButton x:Name="DownButton" Grid.Row="1" Content="&#xE70D;"
                                             FontFamily="Segoe Fluent Icons" FontSize="9"
                                             MinWidth="0" MinHeight="0" Padding="0"
                                             Delay="450" Interval="110"
                                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                             Background="Transparent" BorderThickness="0"
                                             AutomationProperties.Name="减少"
                                             Click="Down_Click" />
                </Grid>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
