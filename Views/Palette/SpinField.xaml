<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ClassSoftwareHub.Desktop.Views.Palette.SpinField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:primitives="using:Microsoft.UI.Xaml.Controls.Primitives">

    








    <StackPanel Spacing="4" VerticalAlignment="Top">

        <TextBlock x:Name="LabelText" FontSize="11.5" Opacity="0.65"
                   HorizontalAlignment="Center" TextWrapping="NoWrap" />

        <Border CornerRadius="4" BorderThickness="1"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                Height="30" MinWidth="72">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="ValueText" Text="0" FontSize="14" Margin="10,0,2,0"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                
                <Grid Grid.Column="1" Width="22" Height="26" Margin="0,1,3,1" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <primitives:RepeatButton x:Name="UpButton" Grid.Row="0" Content="&#xE70E;"
                                             FontFamily="Segoe Fluent Icons" FontSize="9"
                                             MinWidth="0" MinHeight="0" Padding="0"
                                             Delay="450" Interval="110"
                                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                             Background="Transparent" BorderThickness="0"
                                             AutomationProperties.Name="增加"
                                             Click="Up_Click" />
                    <primitives:RepeatButton x:Name="DownButton" Grid.Row="1" Content="&#xE70D;"
                                             FontFamily="Segoe Fluent Icons" FontSize="9"
                                             MinWidth="0" MinHeight="0" Padding="0"
                                             Delay="450" Interval="110"
                                             VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                             Background="Transparent" BorderThickness="0"
                                             AutomationProperties.Name="减少"
                                             Click="Down_Click" />
                </Grid>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
