<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClassSoftwareHub.Desktop.Views.ToolPageWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      通用「工具页」窗口（2026-10-30）。

      来由：侧边栏的「编码 / 哈希转换」原来点一下会把整个主界面拉出来再翻到那一页 ——
      为了转个 Base64 或核一个哈希值，代价太大（学科工具窗 2026-10-18 已经为同一个理由改过）。
      这扇窗把那一页单独装进来，侧边栏点一下就用，主窗口可以一直收在托盘里。

      · 只承载一个 Page，没有左侧导航栏：这些页面自己都有 28px 大标题，不需要再排一层。
      · 系统标题栏 + 自绘 32px 条，与学科工具窗、哈希校验窗同一套。
      · 窗口尺寸按承载页的需要给（编码页是三栏 998 宽的版式，给窄了会把它压变形）。
    -->

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarHost" Grid.Row="0" Padding="16,0,140,0" Background="Transparent">
            <TextBlock x:Name="TitleText" FontSize="12" Opacity="0.7" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <Frame x:Name="ContentFrame" Grid.Row="1" />
    </Grid>
</Window>
