<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Views.Submit.Steps.SubmitReviewPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      第 5 步：核对并提交。
      提交按钮在窗口底部（导航条那颗），本页只负责摘要、缺失项定位与结果展示。
      ⛔ 提交成功后停在这里，不自动关窗：投稿人常要立刻再传第二个。
    -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="24,28,24,24">
            <StackPanel Width="600" HorizontalAlignment="Center" Spacing="14">

                <StackPanel Spacing="4" Margin="0,0,0,2">
                    <TextBlock Text="核对并提交" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock FontSize="13" Opacity="0.65" TextWrapping="Wrap"
                               Text="确认内容无误后点右下角的「提交」。提交后由审核处理，通过即上架。" />
                </StackPanel>

                <Border Padding="16" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Width="48" Height="48" CornerRadius="8"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                <Grid>
                                    <FontIcon Glyph="&#xE7C3;" FontSize="18" Opacity="0.35"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image x:Name="SummaryIcon" Stretch="UniformToFill" Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock x:Name="SummaryName" FontSize="16" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="SummaryId" FontSize="12" Opacity="0.6"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="SummaryRows" Spacing="6" />
                    </StackPanel>
                </Border>

                <Border x:Name="MissingPanel" Padding="16" CornerRadius="8" BorderThickness="1"
                        Visibility="Collapsed"
                        BorderBrush="{ThemeResource SystemFillColorCautionBrush}"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="还需要补充" FontWeight="SemiBold" />
                        <StackPanel x:Name="MissingHost" Spacing="6" />
                    </StackPanel>
                </Border>

                <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="False" />

                <StackPanel x:Name="SuccessPanel" Spacing="10" Visibility="Collapsed">
                    <Button Content="再提交一个" Click="Restart_Click" />
                </StackPanel>

                <!-- 连不上提交服务时的兜底：内容已在本机，四条路都能走 -->
                <StackPanel x:Name="FallbackPanel" Spacing="10" Visibility="Collapsed">
                    <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="无法连接提交服务"
                             Message="内容已保存于本机，不会丢失。可稍后重试，或将提交文件下载后手动放入仓库，亦可直接前往 GitHub 提交。" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="重试" Click="Retry_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="下载提交文件" Click="DownloadSubmission_Click" />
                        <Button Content="复制 JSON" Click="CopySubmission_Click" />
                        <Button Content="在 GitHub 提交" Click="OpenGithubSubmit_Click" />
                    </StackPanel>
                    <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                               Text="在 GitHub 新建文件并提交，合并后生成工单。" />
                </StackPanel>

                <TextBlock x:Name="Toast" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
