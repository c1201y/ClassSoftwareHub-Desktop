<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClassSoftwareHub.Desktop.Views.QqFeedbackGuideWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      「在 Q 群中反馈」第二步的图文流程窗：提醒浮窗里点完「复制」就摊开这一扇。

      五步 = 加入群聊 → 打开群相册面板 → 新建相册并填入相关信息 → 进入相册点上传 → 选照片/视频并上传，
      后四步各配一张 QQ 里实拍的操作截图（Assets\feedback\qq-step-*.png，2026-09-30 Nick 提供）。

      = **标准窗口 + 自绘标题栏**（跟「常用工具」窗一个套路）：外观是自己的，拖动/阴影/圆角交给 Windows。
      ⚠️ 这扇窗**故意留在任务栏和 Alt+Tab 里**（不像其它辅助窗）—— 用户要一边看它一边切到 QQ 操作，
         切走了还能 Alt+Tab 摸回来。

      面板里的横向排列一律用 Grid，不用横向 StackPanel（横向 StackPanel 拿无限宽度量孩子，
      里面的 TextWrapping 会失效、文字被裁 —— 反馈页那三张流程卡就是这么断的，2026-09-30 修）。
    -->
    <Grid x:Name="Root" IsTabStop="True" KeyDown="Root_KeyDown"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 自绘标题栏（SetTitleBar 就是这一块） -->
        <Grid x:Name="AppTitleBar" Height="32" Padding="12,0,0,0" Grid.Row="0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE8BD;" FontSize="13" Opacity="0.85" />
                <TextBlock Text="在 Q 群中反馈" FontSize="12.5" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0">
            <StackPanel Padding="26,10,26,28" Spacing="0">

                <TextBlock Text="提交反馈至 QQ 群" FontSize="22" FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0" FontSize="13.5" LineHeight="21" TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="以下为在 QQ 群相册中提交反馈的完整流程。反馈信息已复制到剪贴板，第 3 步可直接粘贴。" />

                <!-- 第 1 步：加入群聊（没有截图，本身就是一次点击） -->
                <StackPanel Margin="0,22,0,0" Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="24" Height="24" VerticalAlignment="Top">
                            <Border CornerRadius="12"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="0.15" />
                            <TextBlock Text="1" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="加入群聊" FontSize="14.5" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="群卡片已在浏览器中打开，按提示申请加入。通过后群名为 ClassSoftwareHub，与 QQ 群号一致。"
                                       FontSize="13" LineHeight="19" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- 第 2 步 -->
                <StackPanel Margin="0,22,0,0" Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="24" Height="24" VerticalAlignment="Top">
                            <Border CornerRadius="12"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="0.15" />
                            <TextBlock Text="2" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="打开群相册面板" FontSize="14.5" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="在群聊天窗口右上角单击群应用按钮，在展开的菜单中选「群相册」。"
                                       FontSize="13" LineHeight="19" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Border CornerRadius="8" BorderThickness="1" HorizontalAlignment="Left"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Image x:Name="StepImage1" Stretch="Uniform" MaxHeight="360" />
                    </Border>
                </StackPanel>

                <!-- 第 3 步 -->
                <StackPanel Margin="0,22,0,0" Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="24" Height="24" VerticalAlignment="Top">
                            <Border CornerRadius="12"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="0.15" />
                            <TextBlock Text="3" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="新建相册并填入相关信息" FontSize="14.5" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="点右上角「创建相册」；第一栏填写问题概括，第二栏粘贴上一步复制的反馈信息，点「确定」。"
                                       FontSize="13" LineHeight="19" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Border CornerRadius="8" BorderThickness="1" HorizontalAlignment="Left"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Image x:Name="StepImage2" Stretch="Uniform" MaxHeight="360" />
                    </Border>
                </StackPanel>

                <!-- 第 4 步 -->
                <StackPanel Margin="0,22,0,0" Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="24" Height="24" VerticalAlignment="Top">
                            <Border CornerRadius="12"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="0.15" />
                            <TextBlock Text="4" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="进入相册，单击「上传至相册」" FontSize="14.5" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="打开刚创建的相册，点右上角的「上传至相册」按钮。"
                                       FontSize="13" LineHeight="19" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Border CornerRadius="8" BorderThickness="1" HorizontalAlignment="Left"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Image x:Name="StepImage3" Stretch="Uniform" MaxHeight="360" />
                    </Border>
                </StackPanel>

                <!-- 第 5 步 -->
                <StackPanel Margin="0,22,0,0" Spacing="10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="24" Height="24" VerticalAlignment="Top">
                            <Border CornerRadius="12"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Opacity="0.15" />
                            <TextBlock Text="5" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="添加照片 / 视频并上传" FontSize="14.5" FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="在「上传」窗口点「添加照片/视频」，选中用于说明问题的截图或录屏，再点「开始上传」。"
                                       FontSize="13" LineHeight="19" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <Border CornerRadius="8" BorderThickness="1" HorizontalAlignment="Left"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Image x:Name="StepImage4" Stretch="Uniform" MaxHeight="360" />
                    </Border>
                </StackPanel>

                <!-- 收尾提示 -->
                <Border Margin="0,26,0,0" CornerRadius="8" BorderThickness="1"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        Padding="16,14,16,14">
                    <TextBlock FontSize="12.5" LineHeight="19" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               Text="群相册中的内容对全体群成员可见，请勿上传含密码、手机号等敏感信息的截图。若反馈信息在剪贴板中已被覆盖，可回到反馈中心重新复制。" />
                </Border>

                <!-- 动作 -->
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,18,0,0">
                    <Button Content="再复制一次" Click="CopyAgain_Click" Padding="18,8,18,8" />
                    <Button Content="关闭" Click="Close_Click" Padding="18,8,18,8" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
