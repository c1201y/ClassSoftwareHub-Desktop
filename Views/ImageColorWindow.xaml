<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClassSoftwareHub.Desktop.Views.ImageColorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      图片取色浮窗（2026-11-04）。

      来由：侧边栏那颗「取色」以前是 Kind=Page，点一下会把整个主界面拉出来再跳页 ——
      讲课时想从课件截图里取个配色，为这件事把应用整个调出来太重。
      现在跟「哈希校验」「查阅单词」同一套：单开一扇小窗，用完关掉，主界面不动。

      · 内容就是 <c>Pages/Tools/ImageColorToolPage</c> 本身（构造参数 embedded: true），
        ⛔ 不要再抄一份取色界面/算法出来 —— 两个入口必须长得一样、取得一样。
      · 窗口是系统标题栏 + 自绘 32px 条，跟哈希校验窗同一套。
    -->

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <!-- 自绘标题栏：内容延伸进去，系统按钮浮在右上角 -->
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarHost" Grid.Row="0" Padding="16,0,140,0" Background="Transparent">
            <TextBlock Text="图片取色" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
        </Grid>

        <ContentControl x:Name="ContentHost" Grid.Row="1"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
