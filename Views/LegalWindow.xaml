<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClassSoftwareHub.Desktop.Views.LegalWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    



















    <Grid x:Name="Root">
        <Grid.Resources>
            
            <Style x:Key="LegalHeadingStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="Margin" Value="0,18,0,2" />
            </Style>

            
            <Style x:Key="LegalBodyStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="LineHeight" Value="21" />
            </Style>

            
            <Style x:Key="LegalIntroStyle" TargetType="TextBlock"
                   BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="IsTextSelectionEnabled" Value="True" />
                <Setter Property="LineHeight" Value="21" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="Margin" Value="0,2,0,4" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarHost" Grid.Row="0" Padding="20,0,140,0" Background="Transparent">
            <TextBlock Text="条款与声明" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
        </Grid>

        
        <StackPanel Grid.Row="1" Margin="28,4,28,10" Spacing="4">
            <TextBlock x:Name="DocTitle" FontSize="26" FontWeight="Bold" TextWrapping="Wrap" />
            <TextBlock x:Name="DocVersion" FontSize="12" Opacity="0.75" />
            
            <SelectorBar x:Name="DocSelector" Margin="0,8,0,0" HorizontalAlignment="Left"
                         SelectionChanged="DocSelector_SelectionChanged" />

            


            <InfoBar x:Name="SourceBar" IsOpen="False" IsClosable="False"
                     Severity="Informational" Margin="0,8,0,0" />
        </StackPanel>

        

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            
            <StackPanel x:Name="BodyHost" Margin="28,2,28,44" MaxWidth="820" />
        </ScrollViewer>
    </Grid>
</Window>
