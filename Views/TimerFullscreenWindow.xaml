<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClassSoftwareHub.Desktop.Views.TimerFullscreenWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      全屏倒计时：铺满屏幕，把源计时器的剩余时间显示出来。
      它是**只读投影** —— 时间由打开它的那个控件提供（浮窗版课堂计时），全屏窗口自己不含计时状态。
      结构照全屏秒表：大字 + 状态行 + 进度条 + 自动淡出的退出入口。
    -->
    <Grid x:Name="Root" IsTabStop="True" KeyDown="Root_KeyDown" DoubleTapped="Root_DoubleTapped"
          Background="#FF101418">
        <!-- 背景层：「使用全屏时钟背景设置」开着时由 ClockBackdrop 铺成时钟那套外观（默认整层隐藏） -->
        <Image x:Name="BgImage" Stretch="UniformToFill" IsHitTestVisible="False" Visibility="Collapsed" />
        <Border x:Name="BgVeil" IsHitTestVisible="False" />

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
            <TextBlock x:Name="TimeText" Text="00:00" FontSize="300" FontWeight="Bold"
                       FontFamily="Bahnschrift" Foreground="#FFF2F4F7" HorizontalAlignment="Center" />
            <!-- 进度条：剩余时间的直觉读法（满 → 空） -->
            <ProgressBar x:Name="Bar" Width="620" Minimum="0" Maximum="100" Value="100"
                         Height="6" CornerRadius="3"
                         Foreground="#80FFFFFF" Background="#22FFFFFF" />
            <TextBlock x:Name="StateText" FontSize="34" Opacity="0.75" HorizontalAlignment="Center"
                       Foreground="#FFF2F4F7" Text="未开始" />
        </StackPanel>

        <!-- 退出入口：跟全屏秒表/全屏时钟同一套（进来亮几秒后淡出，动一下再亮） -->
        <Border x:Name="ExitBar" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,18,18,0" CornerRadius="8" Padding="16,6,8,6"
                Opacity="0" IsHitTestVisible="False"
                Background="#CC1A1A1A" BorderBrush="#40FFFFFF" BorderThickness="1">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="按 Esc、双击屏幕，或单击此处退出" FontSize="14"
                           Foreground="#FFFFFFFF" VerticalAlignment="Center" />
                <Button Click="Exit_Click" MinWidth="36" MinHeight="36" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="退出全屏倒计时">
                    <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="#FFFFFFFF" />
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
