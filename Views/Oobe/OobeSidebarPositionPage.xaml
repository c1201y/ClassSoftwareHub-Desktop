<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Views.Oobe.OobeSidebarPositionPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <!--
      第 6 步：侧边栏位置。
      「放置模式」决定可选边：贴靠模式只有左右（还能左右两条），自由模式四条边都能吸。
      选项与「侧边布局」页同源，改了只记草稿，收尾时统一重建侧边栏。
    -->
    <Grid>
        <StackPanel x:Name="ContentRoot" Width="600"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <StackPanel Spacing="6" Margin="0,0,0,12">
                <TextBlock Text="侧边栏位置" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
            </StackPanel>

            <controls:SettingsCard x:Name="ModeCard" Header="侧边栏放置模式">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7C4;" />
                </controls:SettingsCard.HeaderIcon>
                <controls:SettingsCard.Description>
                    <TextBlock x:Name="ModeHint" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </controls:SettingsCard.Description>
                <ComboBox x:Name="ModeCombo" MinWidth="170" SelectionChanged="Mode_SelectionChanged">
                    <ComboBoxItem Content="贴靠模式" Tag="dock" />
                    <ComboBoxItem Content="自由模式" Tag="free" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard x:Name="EdgeCard" Header="侧边栏贴在哪条边">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A0;" />
                </controls:SettingsCard.HeaderIcon>
                <controls:SettingsCard.Description>
                    <TextBlock x:Name="EdgeHint" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </controls:SettingsCard.Description>
                <ComboBox x:Name="EdgeCombo" MinWidth="170" SelectionChanged="Edge_SelectionChanged" />
            </controls:SettingsCard>

            <controls:SettingsCard x:Name="GapCard" Header="收起时离屏幕边缘"
                                   Description="仅对收起状态生效。">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE71D;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox x:Name="GapCombo" MinWidth="170" SelectionChanged="Gap_SelectionChanged">
                    <ComboBoxItem Content="0（紧贴边缘）" Tag="0" />
                    <ComboBoxItem Content="2" Tag="2" />
                    <ComboBoxItem Content="4" Tag="4" />
                    <ComboBoxItem Content="6（默认）" Tag="6" />
                    <ComboBoxItem Content="10" Tag="10" />
                    <ComboBoxItem Content="16" Tag="16" />
                </ComboBox>
            </controls:SettingsCard>

            <TextBlock x:Name="OffHint" Text="侧边栏当前处于关闭状态，此处选项暂不生效。"
                       FontSize="12" Opacity="0.6" Margin="0,12,0,0" Visibility="Collapsed"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</Page>
