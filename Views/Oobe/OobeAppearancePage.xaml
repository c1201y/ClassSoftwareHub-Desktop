<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Views.Oobe.OobeAppearancePage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <!--
      第 4 步：外观。

      主题卡用三个 RadioButton 组成一组，把默认的圆点模板换成纯 ContentPresenter ——
      选中态由外圈强调色描边表达，预览图不会被单选控件自己的底纹压脏。

      预览图是 Nick 2026-10-31 给的三张图（跟随系统 / 浅色 / 深色），内嵌后由
      EmbeddedAssets 释放到缓存再交给 Image —— 单文件发布也没有散落文件。

      ⚠️ 三张卡用等分列铺满 600，和下面的 SettingsCard 左右对齐 ——
         以前是 144 定宽横排、靠内容自然宽度居中，两侧比下面那张卡窄一截，看着很别扭。

      下面三项与「设置 → 外观」同一套：窗口背景效果 / 桌面悬浮窗单独设置外观 / 外部组件外观。
    -->
    <Grid>
        <StackPanel x:Name="ContentRoot" Width="600"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>

            <StackPanel Spacing="6" Margin="0,0,0,12">
                <TextBlock Text="外观" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
            </StackPanel>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <RadioButton x:Name="ThemeSystem" Grid.Column="0" GroupName="OobeTheme" Tag="system"
                             Checked="Theme_Checked" AutomationProperties.Name="跟随系统"
                             HorizontalAlignment="Stretch">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </ControlTemplate>
                    </RadioButton.Template>
                    <Grid>
                        <Border CornerRadius="8" BorderThickness="1"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                Padding="6,8,6,6">
                            <StackPanel Spacing="6">
                                <Border Height="101" CornerRadius="6">
                                    <Image x:Name="SystemPreview" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="跟随系统" FontSize="13" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="RingSystem" CornerRadius="8" BorderThickness="2"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                </RadioButton>

                <RadioButton x:Name="ThemeLight" Grid.Column="1" GroupName="OobeTheme" Tag="light"
                             Checked="Theme_Checked" AutomationProperties.Name="浅色"
                             HorizontalAlignment="Stretch">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </ControlTemplate>
                    </RadioButton.Template>
                    <Grid>
                        <Border CornerRadius="8" BorderThickness="1"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                Padding="6,8,6,6">
                            <StackPanel Spacing="6">
                                <Border Height="101" CornerRadius="6">
                                    <Image x:Name="LightPreview" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="浅色" FontSize="13" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="RingLight" CornerRadius="8" BorderThickness="2"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                </RadioButton>

                <RadioButton x:Name="ThemeDark" Grid.Column="2" GroupName="OobeTheme" Tag="dark"
                             Checked="Theme_Checked" AutomationProperties.Name="深色"
                             HorizontalAlignment="Stretch">
                    <RadioButton.Template>
                        <ControlTemplate TargetType="RadioButton">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                        </ControlTemplate>
                    </RadioButton.Template>
                    <Grid>
                        <Border CornerRadius="8" BorderThickness="1"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                Padding="6,8,6,6">
                            <StackPanel Spacing="6">
                                <Border Height="101" CornerRadius="6">
                                    <Image x:Name="DarkPreview" Stretch="UniformToFill" />
                                </Border>
                                <TextBlock Text="深色" FontSize="13" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="RingDark" CornerRadius="8" BorderThickness="2"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                </RadioButton>
            </Grid>

            <controls:SettingsCard Header="桌面悬浮窗单独设置外观"
                                   Description="只影响侧边栏与常用工具浮窗。">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE772;" />
                </controls:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="SplitThemeSwitch" OnContent="开" OffContent="关" MinWidth="0"
                              Toggled="SplitTheme_Toggled" />
            </controls:SettingsCard>

            <controls:SettingsCard x:Name="ExtThemeCard" Header="外部组件外观">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE772;" />
                </controls:SettingsCard.HeaderIcon>
                <controls:SettingsCard.Description>
                    <TextBlock x:Name="ExtThemeHint" TextWrapping="Wrap"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </controls:SettingsCard.Description>
                <ComboBox x:Name="ExtThemeCombo" MinWidth="170" SelectionChanged="ExtTheme_SelectionChanged">
                    <ComboBoxItem Content="跟随系统" Tag="system" />
                    <ComboBoxItem Content="浅色" Tag="light" />
                    <ComboBoxItem Content="深色" Tag="dark" />
                </ComboBox>
            </controls:SettingsCard>

            <controls:SettingsCard Header="窗口背景效果"
                                   Description="截图框选层与钉图不参与。">
                <controls:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE81E;" />
                </controls:SettingsCard.HeaderIcon>
                <ComboBox x:Name="BackdropCombo" MinWidth="170" SelectionChanged="Backdrop_SelectionChanged">
                    <ComboBoxItem Content="亚克力（半透明）" Tag="acrylic" />
                    <ComboBoxItem Content="云母（更接近系统窗口）" Tag="mica" />
                    <ComboBoxItem Content="纯色（最省性能）" Tag="solid" />
                </ComboBox>
            </controls:SettingsCard>
        </StackPanel>
    </Grid>
</Page>
