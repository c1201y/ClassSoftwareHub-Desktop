<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ClassSoftwareHub.Desktop.Views.Oobe.OobeFinishPage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      第 12 步：完成。照 ClassIsland 的 FinishPage：三张卡横滑轮播，
      没到最后一张时「下一步」在，到最后一张换成「完成」；第一张再往回就退回上一步。

      每一屏都是「图标 + 标题 + 一句说明 + 应用截图」（Nick 2026-10-31 定的口径：
      光摆文字太生硬）。前两屏用两张窗口截图叠着摆，最后一屏换成版本大图 dv1.2。
      ⚠️ 截图有深色 / 浅色两套，按本页 ActualTheme 取 —— 深浅色主题下都不会突兀。
    -->
    <Grid>
        <StackPanel x:Name="ContentRoot" Width="600"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">

            <Grid x:Name="SlideHost" MinHeight="300">
                <StackPanel x:Name="Slide1" Spacing="6"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE896;" FontSize="26"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock Text="软件下载" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="常用软件集中下载，自动校验与缓存。" FontSize="13" Opacity="0.65"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />

                    <Grid Width="470" Height="266" Margin="0,8,0,0">
                        <Border Width="372" Height="198" HorizontalAlignment="Left" VerticalAlignment="Top"
                                CornerRadius="8" BorderThickness="1"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                            <Image x:Name="DownloadsBack" Stretch="UniformToFill" />
                        </Border>
                        <Border Width="372" Height="198" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                CornerRadius="8" BorderThickness="1"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                            <Image x:Name="DownloadsFront" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="Slide2" Spacing="6" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="64" Height="64" CornerRadius="32" HorizontalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE71D;" FontSize="26"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock Text="课堂工具" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="计时器、函数图像、教室喊话等常用工具。" FontSize="13" Opacity="0.65"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />

                    <Grid Width="470" Height="266" Margin="0,8,0,0">
                        <Border Width="372" Height="198" HorizontalAlignment="Left" VerticalAlignment="Top"
                                CornerRadius="8" BorderThickness="1"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                            <Image x:Name="ToolsBack" Stretch="UniformToFill" />
                        </Border>
                        <Border Width="372" Height="198" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                CornerRadius="8" BorderThickness="1"
                                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                            <Image x:Name="ToolsFront" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel x:Name="Slide3" Spacing="8" Visibility="Collapsed"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="设置完成" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="完成后即可开始使用。" FontSize="13" Opacity="0.65"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <Border Width="520" Height="245" Margin="0,8,0,0" CornerRadius="10"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
                        <Image x:Name="FinishBanner" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center"
                                Margin="0,10,0,0">
                        <Button Content="浏览软件" Click="GoDownloads_Click" />
                        <Button Content="系统优化" Click="GoTweaks_Click" />
                        <Button Content="Hub AI 设置" Click="GoAi_Click" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                        Margin="0,4,0,0">
                <Ellipse x:Name="Dot1" Width="6" Height="6"
                         Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="1" />
                <Ellipse x:Name="Dot2" Width="6" Height="6"
                         Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.25" />
                <Ellipse x:Name="Dot3" Width="6" Height="6"
                         Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.25" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
