<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClassSoftwareHub.Desktop.Views.QuickLookupWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      查阅单词悬浮窗（2026-11-01）。

      来由：讲课时想把一个词甩到屏幕上，走主界面 → 查阅单词太重，还会把整扇主窗口拉出来盖住课件。
      这扇窗单开、小、可一直摆在旁边，查完就关。

      · 跟主页面一样**分成两块**：上面查单词、下面翻译句子，各用各的输入框（Nick 定：不共用一个框）。
      · 窗口是**系统标题栏 + 自绘 32px 条**，跟哈希校验窗、学科工具窗同一套（ModernWindow.ApplyTitleBar）。
      · 结果只在代码里构造，⛔ 不用 ItemTemplate + x:Bind（MustRead §3）。
    -->

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarHost" Grid.Row="0" Padding="16,0,140,0" Background="Transparent">
            <TextBlock Text="查阅单词" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
        </Grid>

        <ScrollViewer Grid.Row="1" Padding="16,4,16,14" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="ContentPanel" Spacing="10" VerticalAlignment="Top">

                <!-- ═══ 查单词 ═══ -->
                <AutoSuggestBox x:Name="WordBox" FontSize="14"
                                PlaceholderText="输入英文单词"
                                QueryIcon="Find"
                                UpdateTextOnSelect="True"
                                TextChanged="WordBox_TextChanged"
                                QuerySubmitted="WordBox_QuerySubmitted" />

                <InfoBar x:Name="WordNotice" IsOpen="False" IsClosable="False"
                         Severity="Informational" Message="" />

                <StackPanel x:Name="WordBlock" Spacing="8" Visibility="Collapsed">
                    <StackPanel Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock x:Name="WordText" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="PhoneticText" FontSize="12.5" Opacity="0.6"
                                       VerticalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="WordSource" FontSize="11.5" Opacity="0.45" />
                    </StackPanel>

                    <StackPanel x:Name="SensePanel" Spacing="8" />
                </StackPanel>

                <!-- ═══ 翻译句子 ═══ -->
                <Border Height="1" Margin="0,4" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <TextBox x:Name="SentenceBox" AcceptsReturn="True" TextWrapping="Wrap" FontSize="13"
                         MinHeight="62" MaxHeight="110" Padding="10,6"
                         PlaceholderText="粘贴一段话，中英都行" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="DirectionHint" Text="自动识别方向" FontSize="11.5" Opacity="0.45"
                               VerticalAlignment="Center" />

                    <Button x:Name="TranslateButton" Grid.Column="1" Content="翻译" FontSize="12.5"
                            Style="{StaticResource AccentButtonStyle}" Padding="18,5"
                            Click="Translate_Click" />
                </Grid>

                <InfoBar x:Name="TransNotice" IsOpen="False" IsClosable="False"
                         Severity="Informational" Message="" />

                <StackPanel x:Name="TransBlock" Spacing="6" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="TransDirection" FontSize="11.5" Opacity="0.55"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="TransProvider" FontSize="11.5" Opacity="0.4"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock x:Name="TransTarget" FontSize="16" TextWrapping="Wrap"
                               IsTextSelectionEnabled="True" />

                    <TextBlock x:Name="TransSource" FontSize="11.5" Opacity="0.45" TextWrapping="Wrap"
                               MaxLines="3" TextTrimming="CharacterEllipsis" />

                    <HyperlinkButton Content="复制译文" FontSize="12" Padding="0,2,0,2"
                                     HorizontalAlignment="Left" Click="CopyTranslation_Click" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
