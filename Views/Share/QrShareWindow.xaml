<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClassSoftwareHub.Desktop.Views.Share.QrShareWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 独立分享窗口：链接或文件生成二维码，侧边栏与右键菜单都直接进这里。 -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarHost" Grid.Row="0" Padding="20,0,150,0" Background="Transparent">
            <TextBlock Text="二维码分享" FontSize="12" Opacity="0.65" VerticalAlignment="Center" />
        </Grid>

        <Grid x:Name="HostRoot" Grid.Row="1" />
    </Grid>
</Window>
