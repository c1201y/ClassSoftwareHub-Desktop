<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClassSoftwareHub.Desktop.Views.SubmitWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <!-- 只有这一个页面用网页版：提交软件（表单逻辑不重写） -->
        <WebView2 x:Name="Web" Opacity="0" />

        <StackPanel x:Name="LoadingPanel" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressRing x:Name="Ring" IsActive="True" Width="38" Height="38" />
            <TextBlock x:Name="LoadingText" Text="正在打开提交页…" Opacity="0.7" />
        </StackPanel>

        <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Spacing="12" MaxWidth="380"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE783;" FontSize="26" Opacity="0.5" HorizontalAlignment="Center" />
            <TextBlock Text="网络出现错误，请稍后重试" HorizontalAlignment="Center" FontWeight="SemiBold" />
            <TextBlock x:Name="ErrorTip" Opacity="0.6" FontSize="12" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center" />
            <Button Content="重试" HorizontalAlignment="Center" Click="Retry_Click"
                    Style="{StaticResource AccentButtonStyle}" />
            <!-- 兜底：WebView2 缺失 / 站点打不开时，至少还能去浏览器提交 -->
            <Button Content="用浏览器打开提交页" HorizontalAlignment="Center" Click="Browser_Click" />
        </StackPanel>
    </Grid>
</Window>
