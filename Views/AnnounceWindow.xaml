<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClassSoftwareHub.Desktop.Views.AnnounceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      全屏喊话窗（2026-10-25 第三版：动画与音效）。
      结构：变暗层 → 强调色顶条 → 顶栏标记 → 正文（单块 / 分行两种载体）→ 右下署名 → 底部进度。
      ⚠️ 底色带 alpha：窗口挂 DesktopAcrylicBackdrop，半透明深色盖在模糊的桌面上，
         观感就是「屏幕变暗」；取不到亚克力时退化成接近纯黑，不影响可读性。
      出场方式见设置项 AnnounceAnimation：none / typewriter / slide / pop。
    -->
    <Grid x:Name="Root" IsTabStop="True" KeyDown="Root_KeyDown" Background="Transparent">

        <!-- 变暗层：入场 0→1，出场 1→0（「屏幕变暗/变回去」就是它） -->
        <Border x:Name="DimLayer" Background="#000000" Opacity="0" />

        <!-- 顶部强调色窄条 -->
        <Border x:Name="AccentBar" VerticalAlignment="Top" Height="8" Opacity="0" />

        <!-- 顶栏：身份标记 + 关闭 -->
        <Grid x:Name="TopBar" VerticalAlignment="Top" Margin="40,30,26,0" Opacity="0">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                <FontIcon x:Name="AccentIcon" Glyph="&#xE720;" FontSize="17" VerticalAlignment="Center" />
                <TextBlock Text="远程喊话" FontSize="18" Foreground="#D9F2F4F7"
                           CharacterSpacing="180" VerticalAlignment="Center" />
            </StackPanel>
            <Button x:Name="CloseButton" Click="Close_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                    MinWidth="38" MinHeight="38" Padding="0" Background="#26FFFFFF" BorderThickness="0" CornerRadius="9"
                    ToolTipService.ToolTip="关闭喊话（Esc）">
                <FontIcon Glyph="&#xE711;" FontSize="14" Foreground="#CCF2F4F7" />
            </Button>
        </Grid>

        <!-- 正文：一个宿主，两种载体 —— 单块（打字机/弹入/无动画）或分行（交错划入） -->
        <Grid x:Name="BodyHost" HorizontalAlignment="Center" VerticalAlignment="Center"
              Margin="140,120,140,150">
            <TextBlock x:Name="BodyText" FontSize="88" Foreground="#FFF7F8FA"
                       FontFamily="ms-appx:///Assets/Fonts/HarmonyOS_Sans_SC_Medium.ttf#HarmonyOS Sans SC"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            <StackPanel x:Name="LinesPanel" Spacing="4" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Visibility="Collapsed" />
        </Grid>

        <!-- 署名：右下角（2026-10-25 Nick：直接显示「教务处」，不要「教务处说」） -->
        <TextBlock x:Name="FromText" FontSize="26" Foreground="#CCF7F8FA" Opacity="0"
                   FontFamily="ms-appx:///Assets/Fonts/HarmonyOS_Sans_SC_Light.ttf#HarmonyOS Sans SC"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,64,58" TextAlignment="Right" />

        <!-- 底部：剩余时间进度 + 说明 -->
        <StackPanel x:Name="Footer" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Spacing="12" Margin="0,0,0,52" Opacity="0">
            <ProgressBar x:Name="RemainBar" Width="460" Height="4" Minimum="0" Maximum="100" Value="100"
                         CornerRadius="2" Background="#2EFFFFFF" BorderThickness="0" />
            <TextBlock x:Name="CountText" FontSize="14" Foreground="#8CF2F4F7" HorizontalAlignment="Center"
                       FontFamily="ms-appx:///Assets/Fonts/HarmonyOS_Sans_SC_Light.ttf#HarmonyOS Sans SC" />
        </StackPanel>
    </Grid>
</Window>
