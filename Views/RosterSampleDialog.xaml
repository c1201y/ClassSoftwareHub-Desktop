<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="ClassSoftwareHub.Desktop.Views.RosterSampleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="示例名单">

    



    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">940</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14">

            <TextBlock FontSize="13" Opacity="0.75" TextWrapping="Wrap"
                       Text="两种写法任选其一，一格或一行一个名字。" />

            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                


                <StackPanel Spacing="6">
                    <TextBlock Text="做法一：Excel 表格（.xlsx）" FontSize="12.5" FontWeight="SemiBold" />
                    <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                               Text="姓名放在同一列即可，前面有没有序号列、上面有没有表头都行。" />
                    <Border Height="380" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource ControlFillColorDefaultBrush}">
                        <Image x:Name="ExcelImage" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="做法二：纯文本（.txt / .csv）" FontSize="12.5" FontWeight="SemiBold" />
                    <TextBlock FontSize="12" Opacity="0.6" TextWrapping="Wrap"
                               Text="一行一个名字，也可用逗号、顿号或分号隔开。" />
                    <Border Height="380" CornerRadius="8" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource ControlFillColorDefaultBrush}">
                        <Image x:Name="TxtImage" Stretch="Uniform"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>

            


            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="UseButton" Content="用示例名单试一下"
                            Style="{StaticResource AccentButtonStyle}"
                            Click="Use_Click"
                            ToolTipService.ToolTip="把这些姓名装进抽取池，可立刻抽号或分组" />
                    <Button x:Name="DownloadExcelButton" Content="下载 Excel 示例"
                            Click="DownloadExcel_Click"
                            ToolTipService.ToolTip="另存一份 .xlsx 示例，照着改就行" />
                    <Button x:Name="DownloadTxtButton" Content="下载 txt 示例"
                            Click="DownloadTxt_Click"
                            ToolTipService.ToolTip="另存一份 .txt 示例，照着改就行" />
                </StackPanel>

                <Button Grid.Column="1" Content="关闭" Click="Close_Click" />
            </Grid>

            <TextBlock x:Name="NoteText" FontSize="12" Opacity="0.7" TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
