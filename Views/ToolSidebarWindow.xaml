<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClassSoftwareHub.Desktop.Views.ToolSidebarWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      屏幕边缘侧边栏：贴在屏幕的某一条边上（上下左右都能放）。
      用处：老师前台全屏放 PPT / 视频时够不到任务栏，直接从边上点工具。
        · 收起 = 一小截圆角抓手（亚克力底）：点一下展开、按住可以拖
        · 展开 = 四个工具（图标 + 名字）+ 底下「收起 / 位置复原 / 隐藏」
      按钮都去掉自带边框（免得像一个个小方框），点击有大触屏尺寸 + 回弹动画。
    -->
    <Grid x:Name="Root" Background="Transparent">
        <Border x:Name="Panel" CornerRadius="8" BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid>
                <!-- 收起状态：短短一截抓手（整条窗口都是点击区，也是拖拽区） -->
                <Grid x:Name="CollapsedView" Background="Transparent"
                      ToolTipService.ToolTip="点一下展开；按住可以拖到别处/别的边"
                      PointerPressed="Strip_PointerPressed"
                      PointerMoved="Strip_PointerMoved"
                      PointerReleased="Strip_PointerReleased"
                      PointerCaptureLost="Strip_PointerReleased">
                    <StackPanel x:Name="GripStack" Orientation="Vertical" Spacing="6"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="Grip" Width="5" Height="48" CornerRadius="3" Opacity="0.6"
                                Background="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>

                <!-- 展开状态 -->
                <Grid x:Name="ExpandedView" Visibility="Collapsed" Padding="5,5,5,6">
                    <StackPanel x:Name="ExpandedStack" Orientation="Vertical" Spacing="3">

                        <StackPanel x:Name="TitleRow" Orientation="Horizontal" Spacing="5"
                                    HorizontalAlignment="Center" Opacity="0.7" Margin="0,2,0,2">
                            <FontIcon Glyph="&#xE71D;" FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="常用工具" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel x:Name="ToolStack" Orientation="Vertical" Spacing="3">
                            <Button x:Name="SidePick" Tag="pick-number" Click="Tool_Click" MinWidth="0"
                                    MinHeight="52" Padding="0,8" Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    ToolTipService.ToolTip="随机抽号">
                                <StackPanel Spacing="3">
                                    <FontIcon Glyph="&#xE716;" FontSize="20" HorizontalAlignment="Center" />
                                    <TextBlock Text="抽号" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SideTimer" Tag="timer" Click="Tool_Click" MinWidth="0"
                                    MinHeight="52" Padding="0,8" Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    ToolTipService.ToolTip="课堂计时">
                                <StackPanel Spacing="3">
                                    <FontIcon Glyph="&#xE81C;" FontSize="20" HorizontalAlignment="Center" />
                                    <TextBlock Text="计时" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SideStopwatch" Tag="stopwatch" Click="Tool_Click" MinWidth="0"
                                    MinHeight="52" Padding="0,8" Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    ToolTipService.ToolTip="秒表计时">
                                <StackPanel Spacing="3">
                                    <FontIcon Glyph="&#xE916;" FontSize="20" HorizontalAlignment="Center" />
                                    <TextBlock Text="秒表" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="SideClock" Tag="clock" Click="Tool_Click" MinWidth="0"
                                    MinHeight="52" Padding="0,8" Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    ToolTipService.ToolTip="全屏时钟">
                                <StackPanel Spacing="3">
                                    <FontIcon Glyph="&#xE740;" FontSize="20" HorizontalAlignment="Center" />
                                    <TextBlock Text="时钟" FontSize="11" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border x:Name="Sep" Height="1" Margin="2,3" Opacity="0.2"
                                Background="{ThemeResource TextFillColorSecondaryBrush}" />

                        <!-- 底下三个按钮：图标固定一列（文字起点对齐，不会被截断） -->
                        <StackPanel x:Name="FooterStack" Orientation="Vertical" Spacing="2">
                            <Button x:Name="FoldButton" Click="Collapse_Click" MinWidth="0" MinHeight="44"
                                    Padding="8,4" Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    ToolTipService.ToolTip="收起来（还能再展开）">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon x:Name="FoldIcon" Glyph="&#xE76C;" FontSize="13"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="收起" FontSize="12"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="ResetButton" Click="Reset_Click" MinWidth="0" MinHeight="44"
                                    Padding="8,4" Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    ToolTipService.ToolTip="回到右边的居中位置">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE777;" FontSize="13"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="位置复原" FontSize="12"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <Button x:Name="HideButton" Click="Hide_Click" MinWidth="0" MinHeight="44"
                                    Padding="8,4" Background="Transparent" BorderThickness="0"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    ToolTipService.ToolTip="隐藏（以后不显示，想找回来去「内置工具」页或系统托盘图标菜单）">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8BB;" FontSize="13"
                                              HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="隐藏" FontSize="12"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
