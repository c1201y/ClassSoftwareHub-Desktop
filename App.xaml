<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ClassSoftwareHub.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:csh="using:ClassSoftwareHub.Desktop.Core">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            
            <csh:NullToCollapsed x:Key="NullToCollapsed" />
            <csh:NotNullToCollapsed x:Key="NotNullToCollapsed" />

            




            <Style x:Key="CshCardItemStyle" TargetType="GridViewItem">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            


















            <Style x:Key="CshModeCardStyle" TargetType="RadioButton">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Card" CornerRadius="10" BorderThickness="1.5" Padding="0"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid>
                                    

                                    <Border x:Name="Tint" CornerRadius="9" Opacity="0"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                    
                                    <Border x:Name="Hover" CornerRadius="9" Opacity="0"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}" />

                                    <Grid x:Name="Body" Padding="15,11" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center" />
                                        <FontIcon x:Name="CheckGlyph" Grid.Column="1" Glyph="&#xE73E;"
                                                  FontSize="15" FontWeight="SemiBold" Visibility="Collapsed"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.7" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.4" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>

                                <VisualStateGroup x:Name="CheckedStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Card"
                                                                           Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                    Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="BorderThickness"
                                                             To="2" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="Tint"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.13" Duration="0" />
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph"
                                                                           Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>

                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused" />
                                    <VisualState x:Name="PointerFocused" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            










            <Style x:Key="CshCardStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            









            <Style x:Key="CshNavCardStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,18" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            








            <Style x:Key="CshResultRowStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="0" />
                


                <Setter Property="Padding" Value="14,8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                



                <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
            </Style>

            

















            <Style TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            



















            <Style TargetType="ScrollViewer">
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <SolidColorBrush x:Key="GridViewItemBackground" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBorderBrushSelected" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBorderBrushSelectedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBorderBrushSelectedPressed" Color="Transparent" />

            







            










            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="HubAiCardBackground" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#ECF3F0" Offset="0" />
                        <GradientStop Color="#EBEFF6" Offset="0.52" />
                        <GradientStop Color="#F4ECEF" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="HubAiCardBorder" Color="#E7E4DF" />
                    <SolidColorBrush x:Key="HubAiIconBackground" Color="#DED8D0" />
                    <SolidColorBrush x:Key="HubAiIconForeground" Color="#3E382F" />
                    <SolidColorBrush x:Key="HubAiTitleForeground" Color="#15181A" />
                    <SolidColorBrush x:Key="HubAiSubForeground" Color="#69726F" />
                    <SolidColorBrush x:Key="HubAiPanelBackground" Color="#FCFCFD" />
                    <SolidColorBrush x:Key="HubAiPanelBorder" Color="#DFE2E2" />
                    <SolidColorBrush x:Key="HubAiBubbleBackground" Color="#F1F2F2" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    






                    <LinearGradientBrush x:Key="HubAiCardBackground" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#292F33" Offset="0" />
                        <GradientStop Color="#292E36" Offset="0.52" />
                        <GradientStop Color="#2B2E35" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="HubAiCardBorder" Color="#3E4449" />
                    <SolidColorBrush x:Key="HubAiIconBackground" Color="#413C35" />
                    <SolidColorBrush x:Key="HubAiIconForeground" Color="#EDE6DC" />
                    <SolidColorBrush x:Key="HubAiTitleForeground" Color="#E8EDF0" />
                    <SolidColorBrush x:Key="HubAiSubForeground" Color="#93A0A6" />
                    

                    <SolidColorBrush x:Key="HubAiPanelBackground" Color="#FF202020" />
                    <SolidColorBrush x:Key="HubAiPanelBorder" Color="#FF3A3A3A" />
                    <SolidColorBrush x:Key="HubAiBubbleBackground" Color="#2E3338" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <LinearGradientBrush x:Key="HubAiCardBackground" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{ThemeResource SystemColorWindowColor}" Offset="0" />
                        <GradientStop Color="{ThemeResource SystemColorWindowColor}" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="HubAiCardBorder" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="HubAiIconBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="HubAiIconForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="HubAiTitleForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="HubAiSubForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="HubAiPanelBackground" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="HubAiPanelBorder" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="HubAiBubbleBackground" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
