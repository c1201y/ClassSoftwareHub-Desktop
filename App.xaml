<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ClassSoftwareHub.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
              ⚠️ 卡片外面那圈矩形框 = GridViewItem 自带的「焦点框 / 悬停底色」。
              卡片是自己画的 Border（带外边距），容器再画一层就套不上 → 这里把容器整套 chrome 关掉，
              悬停反馈改由卡片自己的 PointerEntered/PointerExited 做（和首页卡片一致）。
            -->
            <Style x:Key="CshCardItemStyle" TargetType="GridViewItem">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="FocusVisualPrimaryThickness" Value="0" />
                <Setter Property="FocusVisualSecondaryThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!--
              ═══════════════════════════════════════════════════════════════════════════════
              CshModeCardStyle —— 把「模式选择」做成一张看得见、点得懂的卡片。

              用途：页面里有「两种以上玩法」需要用户先选一个的场合（抽号 / 分组、号码 / 名单、
              文件校验 / 文本编解码、倒计时 / 秒表…）。原来这些都用小号 RadioButton 或一列
              平铺按钮，未选中的那一边几乎等于不存在，用户根本不知道这个页面还有另一种用法。

              为什么用 RadioButton 而不是自己写 Button：
                · GroupName 自带互斥，不用手写"选中状态"逻辑；
                · 方向键切换、屏幕阅读器朗读（RadioButton 语义）都是白送的；
                · ⚠️ 但 RadioButton 的 IsChecked **不能在 XAML 里写 True**（会运行时报
                  「Failed to assign to property」，整页加载失败）—— 一律在代码里赋初值。

              卡片长什么样：整块可点，内容自定（通常是「图标 + 标题 + 一句话说明」）。
                · 未选中：普通卡片底 + 普通描边；
                · 选中：强调色描边 2px + 强调色淡底 + 右侧一个对勾 —— 三处同时变，绝不靠颜色一项。
              ═══════════════════════════════════════════════════════════════════════════════
            -->
            <Style x:Key="CshModeCardStyle" TargetType="RadioButton">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="UseSystemFocusVisuals" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Card" CornerRadius="10" BorderThickness="1.5" Padding="0"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                                <Grid>
                                    <!-- 选中时的强调色淡底：作为最底下的一层铺满整卡（内容区自带 16,13 内边距，
                                         所以这里不需要负边距）。上面再压内容，文字永远清晰。 -->
                                    <Border x:Name="Tint" CornerRadius="9" Opacity="0"
                                            Background="{ThemeResource AccentFillColorDefaultBrush}" />
                                    <!-- 悬停 / 按下时的浅灰底（未选中才有感，选中时被 Tint 盖住也不难看） -->
                                    <Border x:Name="Hover" CornerRadius="9" Opacity="0"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}" />

                                    <Grid x:Name="Body" Padding="15,11" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center" />
                                        <FontIcon x:Name="CheckGlyph" Grid.Column="1" Glyph="&#xE73E;"
                                                  FontSize="15" FontWeight="SemiBold" Visibility="Collapsed"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.7" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.4" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>

                                <VisualStateGroup x:Name="CheckedStates">
                                    <VisualState x:Name="Unchecked" />
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Card"
                                                                           Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                    Value="{ThemeResource AccentFillColorDefaultBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="Card"
                                                             Storyboard.TargetProperty="BorderThickness"
                                                             To="2" Duration="0" />
                                            <DoubleAnimation Storyboard.TargetName="Tint"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.13" Duration="0" />
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckGlyph"
                                                                           Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>

                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Hover"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused" />
                                    <VisualState x:Name="PointerFocused" />
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
              卡片容器统一样式（2026-10-02 建；同日二改：圆角 8→4、补统一内边距 16,12）。
              全站内容卡片统一走这一套「4px 圆角 + 系统卡片底 + 系统描边 + 16,12 内边距」，
              别再每页手写 CornerRadius/Background/BorderBrush/BorderThickness 四件套。

              ⛔⛔ 圆角必须是 4，不是 8（Nick 2026-10-02 抓的「劣质第三方绘制」根源）：
                  - 4 = 系统 ControlCornerRadius —— 原生 SettingsCard / Button / ComboBox 全是 4；
                  - 8 = OverlayCornerRadius —— 那是**浮层/弹窗**该用的值，不是卡片。
                  手写卡片写 8 摆在原生控件旁边，一眼就能看出"两个来源"，即所谓劣质感。
              ⛔ 别再往 Style 外手写卡片外壳；内边距要不同就在本地覆盖 Padding。
            -->
            <Style x:Key="CshCardStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>

            <!--
              只读结果行（编码 / 哈希工具的四条哈希值）。
              2026-10-02 建（Nick：「用 Border 堆叠的表单表格，所有块都是方块包方块」）：
              这类"一行一条结果"的内容改用 ListView 承载 —— 每一行自带系统悬停底色、
              圆角走 ControlCornerRadius，不再需要外面再套一张大卡片。
              ⛔ 配合 ListView 用：SelectionMode=None、IsItemClickEnabled=False、
                 ScrollViewer.VerticalScrollBarVisibility=Disabled（它本来就待在外层滚动区里，
                 不禁用会出现内外两层滚动条）。
            -->
            <Style x:Key="CshResultRowStyle" TargetType="ListViewItem">
                <Setter Property="MinHeight" Value="0" />
                <!-- 左右 14 = 与同页其它内容（拖拽区、核对行）同一条内缩线；
                     ⛔ 别靠给 ListView 加负 Margin 去"让悬停铺满" —— 那会把行内容顶出 960 内容列，
                        右侧的复制键会比页面里所有其它按钮都凸出来约 10px（实测过）。 -->
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>

            <!--
              ═══════════════════════════════════════════════════════════════════════════════
              ⚠️⚠️ 弹窗圆角。2026-09-29 Nick 抓到的 bug：「名单」「示例名单」两个弹窗四角是**直角**，
              在 Win 11 上看着像 Win 10。

              弹窗是进程内的浮层（不是独立窗口），DWM 的圆角管不到它 —— 圆角只能来自 XAML 模板。

              ⛔ 为什么覆盖主题资源 `OverlayCornerRadius` 没用（试过，无效）：
                 这个版本里 ContentDialog 模板画底色那个 Border 的圆角绑的是
                 `{TemplateBinding CornerRadius}`，也就是 **ContentDialog.CornerRadius** ——
                 实测 dump 模板树，覆盖 OverlayCornerRadius 后它仍然是 0。
                 而 ContentDialog.CornerRadius 的默认值就是 0（不像 WinUI 2 里默认 8），
                 所以四角开箱即直角，且不报任何错。

              → 修法：给所有 ContentDialog 设上 CornerRadius，隐式 Style 让全站一次生效。
                ⛔ BasedOn 不能省 —— 不写就等于把默认样式整个换掉，弹窗的模板会直接消失。
              ═══════════════════════════════════════════════════════════════════════════════
            -->
            <Style TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}">
                <Setter Property="CornerRadius" Value="8" />
            </Style>

            <!--
              ═══════════════════════════════════════════════════════════════════════════════
              ⚠️⚠️ 滚动区"死区"。2026-09-29 Nick 抓到的 bug：「设置页每个标题上面那一块区域，
              鼠标放上去滚轮就不动了」。

              ⛔ 真因不是哪个控件吞了滚轮 —— 实测（进程内 AddHandler 打事件 + 逐点扫描）：
                 卡住的位置，滚轮事件**根本没有到达 ScrollViewer**（应用内一条日志都没有）。
                 原因：ScrollViewer 默认 `Background` 是 null，它内层的 Grid / StackPanel 也没有背景
                 → 这些元素**不参与命中测试**。于是落到"没有任何控件"的缝隙上时，命中测试直接穿过去，
                 事件从 ScrollViewer 外面的元素开始冒泡，ScrollViewer 自己永远收不到。

                 缝隙长什么样：分区标题上方的 `Margin="0,24,0,8"`、卡片之间的 StackPanel 间距、
                 ScrollViewer 自己的 Padding —— 全是"看着有地方、其实没有东西"的区域。

              → 修法：全站 ScrollViewer 统一给一个 Transparent 底。
                `Transparent` 不画任何像素（外观与 null 完全一致），但会让整块矩形参与命中测试，
                事件因此能正常冒泡到 ScrollViewer。
                ⛔ 别改成 `{x:Null}`（等于没设）；页面里若显式写了 Background，会盖住这条样式，也要一并去掉。
              ═══════════════════════════════════════════════════════════════════════════════
            -->
            <Style TargetType="ScrollViewer">
                <Setter Property="Background" Value="Transparent" />
            </Style>

            <SolidColorBrush x:Key="GridViewItemBackground" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBorderBrushPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBorderBrushPressed" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBorderBrushSelected" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBorderBrushSelectedPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="GridViewItemBorderBrushSelectedPressed" Color="Transparent" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
