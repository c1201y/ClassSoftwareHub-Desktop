<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ClassSoftwareHub.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:pages="using:ClassSoftwareHub.Desktop.Pages"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="{x:Null}">

        <!-- ============ 原生界面（全部页面 WinUI3 自绘，唯一的界面） ============ -->
        <pages:ShellPage x:Name="NativeShell" />

        <!-- ============ 缺少 WebView2 运行时（全局最上层） ============ -->
        <Grid x:Name="RuntimePanel"
              Visibility="Collapsed"
              Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <StackPanel MaxWidth="480" Spacing="14"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE7BA;" FontSize="34" HorizontalAlignment="Center"
                          Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                <TextBlock Text="缺少 Microsoft Edge WebView2 运行时"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock FontSize="13" Opacity="0.75" TextAlignment="Center" TextWrapping="Wrap"
                           Text="ClassSoftwareHub 需要系统安装 WebView2 运行时才能显示网页内容。安装后重新打开本应用即可。" />
                <CheckBox x:Name="NoPromptCheck" Content="不再提示（记住该选择）" />
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Button Content="立即安装" Style="{StaticResource AccentButtonStyle}" Click="InstallRuntime_Click" />
                    <Button Content="在浏览器中打开" Click="OpenInBrowser_Click" />
                    <Button Content="退出" Click="ExitApp_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <!-- ============ 应用内网页浮层（官网 / 网页版；由下往上淡入的「窗中窗」） ============ -->
        <Grid x:Name="WebSheet" Visibility="Collapsed">
            <Rectangle Fill="#66000000" Tapped="WebSheetScrim_Tapped" />

            <Border x:Name="WebSheetCard" Opacity="0"
                    Margin="28,52,28,28"
                    CornerRadius="12"
                    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="WebSheetShift" Y="150" />
                </Border.RenderTransform>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 小标题栏 -->
                    <Grid Grid.Row="0" Padding="16,10,10,10" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE774;" FontSize="14" Opacity="0.7"
                                  VerticalAlignment="Center" />
                        <TextBlock x:Name="WebSheetTitle" Grid.Column="1"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   FontWeight="SemiBold" />

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                    VerticalAlignment="Center">
                            <ProgressRing x:Name="WebSheetRing" Width="16" Height="16" IsActive="False" />
                            <Button Content="在浏览器打开" Click="WebSheetExternal_Click" />
                            <Button Click="WebSheetClose_Click" Padding="9,5">
                                <FontIcon Glyph="&#xE711;" FontSize="12" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <WebView2 x:Name="SheetWeb" Grid.Row="1" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
